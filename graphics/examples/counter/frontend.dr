// The smallest std.graphics program: a model, its messages, a view.
//
//     mind run            # in this directory: serves it at http://127.0.0.1:8000/
//     mind run --desktop  # or in a window, with its backend
import std.graphics as ui;
import std.graphics.browser;
import std.graphics.css;
import std.graphics.html;

mapping Model {
    count : :integer = 0
    status : :string = "Ready"
}

union Msg {
    increment
    decrement
    save
    saved(answer : Result :any :string)
}

let update! : Msg -> Model -> Model;
let update! msg model = match msg {
    Msg.increment => Model.set_count (Model.count model + 1) model,
    Msg.decrement => Model.set_count (Model.count model - 1) model,
    Msg.save => {
        browser.invoke! "echo" (Model.count model) Msg.saved
        Model.set_status "Waiting for the backend…" model
    },
    Msg.saved(Result.ok(n)) => Model.set_status ("The backend says " + to_string n) model,
    Msg.saved(Result.error(why)) => Model.set_status ("No backend: " + why) model,
};

let view : Model -> ui.Node;
let view model = html.main [html.class "counter"] [
    html.h1 [] [html.text "Dream graphics"],
    html.p [] [html.text "The frontend and backend are written in Dream."],
    html.output [html.aria "live" "polite"] [html.text (to_string (Model.count model))],
    html.div [html.class "actions"] [
        html.button [html.on_click Msg.decrement, html.aria "label" "Decrease count"] [html.text "−"],
        html.button [html.on_click Msg.increment, html.aria "label" "Increase count"] [html.text "+"],
        html.button [html.on_click Msg.save] [html.text "Call Dream backend"],
    ],
    html.p [html.role "status"] [html.text (Model.status model)],
];

let styles = [
    css.rule ".counter" %{ "padding" => "32px", "display" => "grid", "gap" => "16px", "max-width" => "720px" },
    css.rule ".counter output" %{ "font-size" => "48px" },
    css.rule ".actions" %{ "display" => "flex", "gap" => "12px" },
];

let main! = browser.run! (ui.App.new () |> ui.title "Dream counter" |> ui.App.set_init (Model.new ())
    |> ui.App.set_update update! |> ui.App.set_view view |> ui.App.set_styles styles);
