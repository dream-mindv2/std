// The part of a native program's runtime that is ordinary Dream: the builtins that
// have to force what they are given, which a function in the dialect cannot do. It
// is compiled exactly as a program is, so laziness, the collector and deep recursion
// are simply what they are everywhere else, and no builtin needs a protocol for
// being suspended partway through.
//
// `rt.native` names functions of rt/main.dr, which take forced arguments. Nothing here
// may use a builtin of the kind it defines: this is what they are.

import rt.native;
import std.json;

// --- rendering --------------------------------------------------------------------

let quoted v = match type_of v {
    :string => native.concat3 "\"" (native.escape_string v) "\"",
    :char => native.concat3 "'" (show v) "'",
    _ => show v,
};

let join_items xs = concat_list (separated xs);

let separated xs = match xs {
    [] => [],
    [x] => [quoted x],
    [x, ..rest] => quoted x :: ", " :: separated rest,
};

/// A list, whose tail may turn out not to be a list at all.
let show_list xs = native.concat3 "[" (join_items xs) "]";

let pair_text p = native.concat3 (quoted p.[0]) " => " (quoted p.[1]);

let separated_pairs ps = match ps {
    [] => [],
    [x] => [pair_text x],
    [x, ..rest] => pair_text x :: ", " :: separated_pairs rest,
};

let show v = {
    let t = type_of v;
    match t {
        :string => v,
        :integer => native.big_or_int_text v,
        :float => native.float_text v,
        :atom => native.concat2 ":" (native.atom_name v),
        :char => native.char_text v,
        :bool => if v { "true" } else { "false" },
        :unit => "()",
        :list => show_list v,
        :array => native.concat3 "#[" (join_items (native.array_to_list v)) "]",
        :map => native.concat3 "%{" (concat_list (separated_pairs (native.map_pairs v))) "}",
        :error => native.concat3 "<error " (native.concat3 (quoted (native.error_kind v)) " " (show (native.error_payload v))) ">",
        :pure_fn => show_function v,
        :impure_fn => show_function v,
        :process => native.process_text v,
        :trunk => native.concat3 "trunk[" (join_items (native.trunk_to_list v)) "]",
        :tensor => show_tensor v,
        :module => native.concat3 "<module " (native.module_name v) ">",
        _ => show_record v,
    }
};

let show_function f = native.concat3 "<fn " (native.closure_name f) ">";

let show_record r = {
    let name = native.record_display (native.record_id r);
    match native.record_size r {
        // A variant with no fields is written as a value; a record with none is a call.
        0 => if native.str_find_any name "." 0 >= 0 { name } else { native.concat2 name "()" },
        _ => concat_list [name, "(", join_items (native.array_to_list (native.record_fields r)), ")"],
    }
};

// --- lengths and forcing -------------------------------------------------------------

let length_from xs !n = match xs {
    [] => n,
    [_, ..rest] => length_from rest (n + 1),
};

let length v = match type_of v {
    :list => length_from v 0,
    _ => native.size v,
};

/// All the way down.
let deep! v = if settle v { v } else { v };

let settle_list xs = match xs {
    [] => true,
    [x, ..rest] => { let done = settle x; done && settle_list rest },
};

let settle v = match type_of v {
    :list => settle_list v,
    :array => settle_list (native.array_to_list v),
    :map => settle_list (native.map_pairs v),
    :error => settle (native.error_payload v),
    :integer => true, :float => true, :string => true, :atom => true, :char => true,
    :bool => true, :unit => true, :pure_fn => true, :impure_fn => true, :process => true,
    :trunk => settle_list (native.trunk_to_list v),
    :tensor => true,
    :module => true,
    _ => settle_list (native.array_to_list (native.record_fields v)),
};

let forced v = { let t = type_of v; true };

// --- strings and arrays from lists ----------------------------------------------------

let array_fill a xs !i = match xs {
    [] => a,
    [x, ..rest] => array_fill (native.array_store a i x) rest (i + 1),
};

let array_of_list xs = array_fill (native.array_new (length_from xs 0) ()) xs 0;

/// Each element evaluated where it lies.
let array_forced a !i !n =
    if i >= n { a }
    else { array_forced (native.array_force_store a i (native.match_at a i)) (i + 1) n };

let forced_array xs = {
    let a = array_of_list xs;
    array_forced a 0 (native.size a)
};

let concat_list xs = native.join_strings (forced_array xs);

let text_array a !i !n =
    if i >= n { a }
    else { array_forced_text a i n };

let array_forced_text a !i !n =
    text_array (native.array_force_store a i (show (native.match_at a i))) (i + 1) n;

let str_interp xs = {
    let a = array_of_list xs;
    native.join_strings (text_array a 0 (native.size a))
};

let str_of_chars cs = {
    let a = array_of_list cs;
    native.join_strings (char_texts a 0 (native.size a))
};

let char_texts a !i !n =
    if i >= n { a }
    else { char_texts (native.array_force_store a i (native.char_text (native.match_at a i))) (i + 1) n };

let str_of_bytes bs = native.string_of_bytes (forced_array bs);

// --- structure ------------------------------------------------------------------------

let concat_lists xs ys = match xs {
    [] => ys,
    [x, ..rest] => x :: concat_lists rest ys,
};

let lists_equal xs ys = match [xs, ys] {
    [[], []] => true,
    [[x, ..xr], [y, ..yr]] => x == y && lists_equal xr yr,
    _ => false,
};

let equal a b = match [type_of a, type_of b] {
    [:list, :list] => lists_equal a b,
    [:array, :array] => lists_equal (native.array_to_list a) (native.array_to_list b),
    [:trunk, :trunk] => lists_equal (native.trunk_to_list a) (native.trunk_to_list b),
    [:map, :map] => native.size a == native.size b && map_within (native.map_pairs a) b,
    [:error, :error] => native.error_kind a == native.error_kind b && native.error_payload a == native.error_payload b,
    [:integer, :integer] => false,
    [:string, :string] => false,
    [:float, :float] => false,
    [:pure_fn, :pure_fn] => false,
    [:impure_fn, :impure_fn] => false,
    _ => native.is_record_value a && native.is_record_value b && native.record_id a == native.record_id b
         && lists_equal (native.array_to_list (native.record_fields a)) (native.array_to_list (native.record_fields b)),
};

let map_within ps m = match ps {
    [] => true,
    [[k, v], ..rest] => match native.match_key m k {
        [w] => v == w && map_within rest m,
        _ => false,
    },
};

let not_equal a b = not (equal a b);

let compare_lists xs ys = match [xs, ys] {
    [[], []] => 0,
    [[], _] => -1,
    [_, []] => 1,
    [[x, ..xr], [y, ..yr]] => {
        let c = compare_values x y;
        if c != 0 { c } else { compare_lists xr yr }
    },
};

let compare_values a b = match native.flat_compare a b {
    3 => match type_of a {
        :list => compare_lists a b,
        :array => compare_lists (native.array_to_list a) (native.array_to_list b),
        :map => compare_lists (native.map_pairs a) (native.map_pairs b),
        :tensor => match compare_lists (native.tensor_shape a) (native.tensor_shape b) {
            0 => compare_lists (native.tensor_flat a) (native.tensor_flat b),
            c => c,
        },
        _ => if native.is_record_value a && native.is_record_value b {
                 match compare_values (native.atom_name (native.record_id a)) (native.atom_name (native.record_id b)) {
                     0 => compare_lists (native.array_to_list (native.record_fields a)) (native.array_to_list (native.record_fields b)),
                     c => c,
                 }
             } else { 0 },
    },
    c => c,
};

// --- positions in a list ---------------------------------------------------------------

let list_at xs i !walked fallback = match xs {
    [] => fallback walked,
    [x, ..rest] => if i == walked { x } else { list_at rest i (walked + 1) fallback },
};

let index_of_list xs i = {
    let off_the_end = fn walked -> lib_raise (native.past_end_error i walked);
    if type_of i != :integer || i < 0 { off_the_end 0 }
    else { list_at xs i 0 off_the_end }
};

let index_of_list_else xs i fallback =
    if type_of i != :integer || i < 0 { fallback }
    else { list_at xs i 0 (fn _ -> fallback) };

/// The cells in front of the position are walked now, as a `set` does, so that one
/// past the end raises where it was written and not when the list is next read.
let list_set_from xs i v !walked before = match xs {
    [] => lib_raise (native.past_end_error i walked),
    [x, ..rest] => if i == walked { rev_onto before (v :: rest) } else { list_set_from rest i v (walked + 1) (x :: before) },
};

let list_set xs i v = list_set_from xs i v 0 [];

let lib_raise e = native.raise_value e;

// --- sorting, by keys --------------------------------------------------------------------

let merge_pairs xs ys = match [xs, ys] {
    [[], _] => ys,
    [_, []] => xs,
    [[x, ..xr], [y, ..yr]] =>
        if compare_values y.[0] x.[0] < 0 { y :: merge_pairs xs yr } else { x :: merge_pairs xr ys },
};

let split_at xs !n acc = if n == 0 { [native.array_to_list (array_of_list (rev_onto acc [])), xs] } else {
    match xs { [x, ..rest] => split_at rest (n - 1) (x :: acc), [] => [rev_onto acc [], []] }
};

let rev_onto xs ys = match xs {
    [] => ys,
    [x, ..rest] => rev_onto rest (x :: ys),
};

let merge_sort xs !n =
    if n < 2 { xs }
    else {
        let half = n / 2;
        let [left, right] = split_at xs half [];
        merge_pairs (merge_sort left half) (merge_sort right (n - half))
    };

let pair_up ks vs = match [ks, vs] {
    [[k, ..kr], [v, ..vr]] => [k, v] :: pair_up kr vr,
    _ => [],
};

let seconds ps = match ps {
    [] => [],
    [p, ..rest] => p.[1] :: seconds rest,
};

let sort_keyed keys items = {
    let vs = native.array_to_list items;
    seconds (merge_sort (pair_up keys vs) (length_from vs 0))
};

let type_assert ok why v = if ok { v } else { lib_raise (native.error_new :type_error why) };

let match_fail v path line col = lib_raise (native.error_new :match_error [v, path, line, col]);

let error_trace! e = native.error_where e;

let json_encode v = json.encode_value v;

let raise_any! v = native.raise_or_wrap v;

let cons_of x xs = x :: xs;

let send_value! pid message = if settle message { native.send_forced pid message } else { () };

let kill_value! pid reason = if settle reason { native.kill_forced pid reason } else { () };

/// The run is over: what failed unjoined is said, and is the exit status.
let finish! u = {
    let failures = native.unjoined_failures ();
    report_failures! failures;
    native.exit (match failures { [] => 0, _ => 1 })
};

let report_failures! es = match es {
    [] => (),
    [e, ..rest] => {
        native.write_err (native.concat3 "dream: uncaught error in a process: " (show e) "\n");
        report_failures! rest
    },
};

// --- files and directories, in terms of what the runtime has ---------------------------

let merge_strings xs ys = match [xs, ys] {
    [[], _] => ys,
    [_, []] => xs,
    [[x, ..xr], [y, ..yr]] => if y < x { y :: merge_strings xs yr } else { x :: merge_strings xr ys },
};

let sort_strings xs !n =
    if n < 2 { xs }
    else {
        let half = n / 2;
        let [left, right] = split_at xs half [];
        merge_strings (sort_strings left half) (sort_strings right (n - half))
    };

let list_dir! path = {
    let names = native.dir_list path;
    deep! (sort_strings names (length_from names 0))
};

let path_join a b = native.concat3 a "/" b;

let remove_all! path = match native.io_lstat path {
    () => 0,
    [_, _, kind] => if kind == :dir {
        let rec go! names !count = match names {
            [] => count,
            [n, ..rest] => go! rest (count + remove_all! (path_join path n)),
        };
        let inside = go! (list_dir! path) 0;
        native.io_remove path;
        inside + 1
    } else {
        native.io_remove path;
        1
    },
};

let mkdir_all! path = {
    let parent = parent_of path;
    if native.io_is_dir path { () }
    else {
        if parent != "" && not (native.io_is_dir parent) { mkdir_all! parent };
        native.io_mkdir path
    }
};

let parent_of path = {
    let i = native.str_rfind path "/" (native.size path);
    if i <= 0 { "" } else { native.str_slice_any path 0 i }
};

/// Every regular file under a directory, sorted, each as a path from that directory.
let walk! root = {
    let rec under! dir prefix acc = {
        let rec go! names acc1 = match names {
            [] => acc1,
            [n, ..rest] => {
                let full = path_join dir n;
                let shown = if prefix == "" { n } else { path_join prefix n };
                // A link to a file is a file, and a link to a directory is not walked,
                // since that is how a walk goes round for ever.
                match [native.io_lstat full, native.io_stat full] {
                    [[_, _, :dir], _] => go! rest (under! full shown acc1),
                    [_, [_, _, :file]] => go! rest (shown :: acc1),
                    _ => go! rest acc1,
                }
            },
        };
        go! (list_dir! dir) acc
    };
    let found = under! root "" [];
    deep! (sort_strings found (length_from found 0))
};

// --- running a program ---------------------------------------------------------------------

let read_all! h acc = {
    let chunk = native.io_read_m h 65536;
    if native.size chunk == 0 { concat_list (rev_onto acc []) }
    else { read_all! h (chunk :: acc) }
};

/// Wait for a child, killing it past `deadline` (0 for none); `[code, timed_out]`.
let wait_child! pid deadline !delay !killed = match native.child_status pid {
    () => {
        let late = deadline > 0 && native.now_ns_value () > deadline;
        if late && not killed { native.child_kill pid };
        native.sleep_until_m (native.now_ns_value () + delay);
        wait_child! pid deadline (if delay < 20000000 { delay * 2 } else { delay }) (killed || late)
    },
    code => [code, killed],
};

let exec_full! dir env program args ms joined = {
    let [pid, out, err] = native.spawn_child dir (forced_array env) program (forced_array args) joined;
    let deadline = if ms > 0 { native.now_ns_value () + ms * 1000000 } else { 0 };
    // Waiting is a process of its own, so that a child past its time is killed even
    // while reading its output is what has not finished.
    let waiter = spawn! $( wait_child! pid deadline 100000 false );
    let err_reader = spawn! $( read_all! err [] );
    let got = read_all! out [];
    let got_err = join! err_reader;
    native.io_close out;
    native.io_close err;
    let [code, timed_out] = join! waiter;
    %{:code => code, :out => got, :err => got_err, :timed_out => timed_out}
};

let exec! program args = exec_full! () [] program args 0 false;
let exec_for! program args ms = exec_full! () [] program args ms false;
let exec_in! dir program args ms = exec_full! dir [] program args ms false;
let valid_env env = match env {
    [] => true,
    [kv, ..rest] => {
        let at = native.str_find_any kv "=" 0;
        if at <= 0 { lib_raise (native.error_new :bad_argument (native.concat3 "exec_with!: `" kv "` is not NAME=value")) }
        else { valid_env rest }
    },
};

let exec_with! dir env program args ms = if valid_env env { exec_full! dir env program args ms false } else { () };
let exec_joined! dir env program args ms = if valid_env env { exec_full! dir env program args ms true } else { () };

/// `vm.share!`: a value made safe to hand to any process. With one heap, being forced
/// all the way down is all that takes.
let share! v = if share_check v { v } else { v };

/// What a process could not read if it were in another heap is refused here as it would
/// be there, so that a program is told the same on either.
let share_check v = match type_of v {
    :pure_fn => lib_raise (native.error_new :type_error "vm.share! cannot share a function"),
    :impure_fn => lib_raise (native.error_new :type_error "vm.share! cannot share a function"),
    :list => share_list v,
    :array => share_list (native.array_to_list v),
    :map => share_list (native.map_pairs v),
    :integer => true, :float => true, :string => true, :atom => true, :char => true,
    :bool => true, :unit => true, :process => true, :error => true, :tensor => true,
    :trunk => share_list (native.trunk_to_list v),
    _ => share_list (native.array_to_list (native.record_fields v)),
};

let share_list xs = match xs {
    [] => true,
    [x, ..rest] => { let done = share_check x; done && share_list rest },
};

// --- trunks: what looks at elements ---------------------------------------------------------

let trunk_of xs = trunk_fill xs (native.trunk_empty ());
let trunk_fill xs t = match xs {
    [] => t,
    [x, ..rest] => trunk_fill rest (native.trunk_push x t),
};

let trunk_concat a b = trunk_fill (native.trunk_to_list b) a;

let trunk_index_from xs x !i = match xs {
    [] => -1,
    [y, ..rest] => if y == x { i } else { trunk_index_from rest x (i + 1) },
};

let trunk_index_of x t = trunk_index_from (native.trunk_to_list t) x 0;
let trunk_contains x t = trunk_index_of x t >= 0;

let trunk_count_from xs x !n = match xs {
    [] => n,
    [y, ..rest] => trunk_count_from rest x (if y == x { n + 1 } else { n }),
};
let trunk_count x t = trunk_count_from (native.trunk_to_list t) x 0;

/// An association trunk's `[key, value]` pairs: the position of the first with this key.
let trunk_lookup_from xs key !i = match xs {
    [] => -1,
    [p, ..rest] => if p.[0] == key { i } else { trunk_lookup_from rest key (i + 1) },
};
let trunk_lookup key t = trunk_lookup_from (native.trunk_to_list t) key 0;

let trunk_put key v t = {
    let at = trunk_lookup key t;
    if at >= 0 { native.trunk_set at [key, v] t } else { native.trunk_push [key, v] t }
};

// --- ed25519 ---------------------------------------------------------------------------------
//
// RFC 8032, in the plainest arithmetic: integers and the extended twisted Edwards formulas.
// Dream's integers are exact, so nothing here is more than the RFC's own reference code.

let ed_p = native.pow 2 255 - 19;
let ed_l = native.pow 2 252 + 27742317777372353535851937790883648493;
let ed_d = mod_p (-121665 * mod_inverse 121666);
let ed_i = pow_mod 2 ((ed_p - 1) / 4) ed_p;

let mod_p !x = {
    let r = x % ed_p;
    if r < 0 { r + ed_p } else { r }
};

let pow_mod !b !e !m =
    if e == 0 { 1 }
    else {
        let half = pow_mod (b * b % m) (e / 2) m;
        if e % 2 == 1 { half * b % m } else { half }
    };

let mod_inverse x = pow_mod (mod_p x) (ed_p - 2) ed_p;

let ed_recover y sign = {
    let xx = mod_p ((y * y - 1) * mod_inverse (ed_d * y * y + 1));
    if xx == 0 && sign != 0 { () }
    else {
        let root = pow_mod xx ((ed_p + 3) / 8) ed_p;
        let fixed = if mod_p (root * root - xx) != 0 { mod_p (root * ed_i) } else { root };
        if mod_p (fixed * fixed - xx) != 0 { () }
        else if fixed % 2 != sign { ed_p - fixed }
        else { fixed }
    }
};

let ed_base = {
    let y = mod_p (4 * mod_inverse 5);
    let x = ed_recover y 0;
    [x, y, 1, mod_p (x * y)]
};

let ed_add a b = {
    let [x1, y1, z1, t1] = a;
    let [x2, y2, z2, t2] = b;
    let aa = mod_p ((y1 - x1) * (y2 - x2));
    let bb = mod_p ((y1 + x1) * (y2 + x2));
    let cc = mod_p (2 * t1 * t2 * ed_d);
    let dd = mod_p (2 * z1 * z2);
    let e = bb - aa;
    let f = dd - cc;
    let g = dd + cc;
    let h = bb + aa;
    forced_point [mod_p (e * f), mod_p (g * h), mod_p (f * g), mod_p (e * h)]
};

/// Each coordinate computed now, so that a long multiplication is not a long chain.
let forced_point q = {
    let [a, b, c, d] = q;
    if a + b + c + d >= 0 { q } else { q }
};

let ed_mul !s q = {
    let rec go !k base acc = if k == 0 { acc } else {
        let next = if k % 2 == 1 { ed_add acc base } else { acc };
        go (k / 2) (ed_add base base) next
    };
    go s q [0, 1, 1, 0]
};

let ed_encode q = {
    let [x, y, z, _] = q;
    let zi = mod_inverse z;
    let xx = mod_p (x * zi);
    let yy = mod_p (y * zi);
    le_bytes (yy + (if xx % 2 == 1 { native.pow 2 255 } else { 0 })) 32
};

let le_bytes !v !n = if n == 0 { "" } else {
    native.concat2 (native.string_of_bytes (forced_array [v % 256])) (le_bytes (v / 256) (n - 1))
};

let ed_decode s = {
    let raw = native.le_int s;
    let sign = (raw / native.pow 2 255) % 2;
    let y = raw % native.pow 2 255;
    if y >= ed_p { () }
    else {
        match ed_recover y sign {
            () => (),
            x => [x, y, 1, mod_p (x * y)],
        }
    }
};

let ed_secret seed = {
    let h = native.crypto_sha512 seed;
    let low = native.le_int (native.str_slice_any h 0 32);
    let clamped = (low - low % 8) % native.pow 2 254 + native.pow 2 254;
    [clamped, native.str_slice_any h 32 32]
};

let need_seed seed what = if type_of seed != :string || native.size seed != 32 {
    lib_raise (native.error_new :type_error what)
} else { true };

let ed25519_public seed = if need_seed seed "ed25519_public needs a 32-byte seed" {
    let [a, _] = ed_secret seed;
    ed_encode (ed_mul a ed_base)
} else { "" };

let ed25519_sign seed message = if need_seed seed "ed25519_sign needs a 32-byte seed" {
    let [a, prefix] = ed_secret seed;
    let public = ed_encode (ed_mul a ed_base);
    let r = native.le_int (native.crypto_sha512 (native.concat2 prefix message)) % ed_l;
    let big_r = ed_encode (ed_mul r ed_base);
    let h = native.le_int (native.crypto_sha512 (native.concat3 big_r public message)) % ed_l;
    native.concat2 big_r (le_bytes ((r + h * a) % ed_l) 32)
} else { "" };

let ed25519_verify key message signature =
    if type_of key != :string || type_of message != :string || type_of signature != :string {
        lib_raise (native.error_new :type_error "ed25519_verify needs a key, a message and a signature, all strings")
    }
    else if native.size key != 32 || native.size signature != 64 { false }
    else {
        let big_r = native.str_slice_any signature 0 32;
        let s = native.le_int (native.str_slice_any signature 32 32);
        match [ed_decode key, ed_decode big_r] {
            [(), _] => false,
            [_, ()] => false,
            [a, r] => s < ed_l && {
                let h = native.le_int (native.crypto_sha512 (native.concat3 big_r key message)) % ed_l;
                ed_encode (ed_mul s ed_base) == ed_encode (ed_add r (ed_mul h a))
            },
        }
    };

/// What a person reads of an uncaught error. A function and the value it made, side by
/// side, are one place, and a run of the standard library is one line.
let error_text e = match type_of e {
    :error => concat_list [describe_error e, trace_lines (kept_places (native.error_where e) ()) true],
    _ => show e,
};

let describe_error e = match [native.error_kind e, native.error_payload e] {
    [:match_error, [value, path, line, col]] =>
        concat_list [path, ":", show line, ":", show col, ": no pattern fits ", show value],
    _ => show e,
};

let kept_places places last = match places {
    [] => [],
    [at, ..rest] => {
        let this = [at.[1], at.[2], at.[3]];
        if last == this { kept_places rest last } else { at :: kept_places rest this }
    },
};

let in_std at = native.str_find_any at.[2] "std/" 0 == 0;

let std_run places = match places {
    [at, ..rest] => if in_std at { 1 + std_run rest } else { 0 },
    [] => 0,
};

let drop_some xs !n = if n == 0 { xs } else { match xs { [_, ..rest] => drop_some rest (n - 1), [] => [] } };

let trace_lines places first = match places {
    [] => "",
    [at, ..rest] => {
        let run = if first { 0 } else { std_run places };
        if run >= 3 {
            concat_list ["\n    ... ", show run, " more in std", trace_lines (drop_some places run) false]
        } else {
            let [how, name, path, line, col] = at;
            concat_list [if how == :made { "\n    forcing a value made in `" } else { "\n    in `" }, name, "`",
                         if line == 0 { "" } else { concat_list [" (", path, ":", show line, ":", show col, ")"] },
                         trace_lines rest false]
        }
    },
};

/// An error nothing caught ends the program, saying what it was.
let uncaught! e = {
    native.write_err (native.concat3 "dream: uncaught error: " (error_text e) "\n");
    native.exit 1
};

// The compiler's own reasons to keep each root: it names them, and a program must
// have an entry to compile at all.
let main! () = 0;

// --- tensors: everything but the loops ----------------------------------------------------------

let shape_error why = lib_raise (native.error_new :shape_error why);
let type_error why = lib_raise (native.error_new :type_error why);

/// Shape and numbers of nested lists and arrays, read off the nesting; every row must match.
let as_items v = match type_of v {
    :list => v,
    :array => native.array_to_list v,
    _ => (),
};

let nest_shape v = match as_items v {
    () => [],
    [] => shape_error "a tensor cannot be empty",
    items => length_from items 0 :: nest_shape items.[0],
};

let check_number w = if native.is_number_value w { w } else {
    type_error (native.concat2 "a tensor holds numbers, not " (native.describe_value w))
};

let flat_onto v shape acc = match shape {
    [] => check_number v :: acc,
    [n, ..rest] => {
        let items = as_items v;
        if type_of items == :unit || length_from items 0 != n {
            shape_error "every row of a tensor must have the same shape"
        } else { flat_items items rest acc }
    },
};

let flat_items items rest acc = match items {
    [] => acc,
    [x, ..more] => flat_items more rest (flat_onto x rest acc),
};

let as_tensor v = if native.is_tensor_value v { v } else {
    match type_of v {
        :list => tensor_from v,
        :array => tensor_from v,
        _ => type_error (native.concat2 "a tensor is made from lists or arrays of numbers, not " (native.describe_value v)),
    }
};

let tensor_from v = {
    let shape = nest_shape v;
    native.tensor_of_flat (forced_array shape) (forced_array (rev_onto (flat_onto v shape []) []))
};

let read_shape v = match as_items v {
    () => type_error (native.concat2 "a shape is a list of integers, not " (native.describe_value v)),
    items => {
        let n = length_from items 0;
        if n == 0 || n > 6 { shape_error "a shape has between 1 and 6 axes" }
        else if check_dims items { forced_array items }
        else { () }
    },
};

let check_dims items = match items {
    [] => true,
    [d, ..rest] => if type_of d != :integer || d < 0 {
        shape_error (native.concat2 "a shape's axes are positive integers, not " (show d))
    } else { check_dims rest },
};

let tensor_to_list v = {
    let t = as_tensor v;
    nest_rows (native.tensor_flat t) (native.tensor_shape t)
};

let take_n xs !n = if n == 0 { [[], xs] } else {
    match xs {
        [x, ..rest] => {
            let [front, back] = take_n rest (n - 1);
            [x :: front, back]
        },
        [] => [[], []],
    }
};

let nest_rows flat shape = match shape {
    [_] => flat,
    [n, ..rest] => {
        let per = list_product rest;
        let rec go xs !i = if i == 0 { [] } else {
            let [front, back] = take_n xs per;
            nest_rows front rest :: go back (i - 1)
        };
        go flat n
    },
};

let list_product xs = match xs {
    [] => 1,
    [x, ..rest] => x * list_product rest,
};

let rendered_axis flat shape = match shape {
    [_] => join_items flat,
    [n, ..rest] => {
        let per = list_product rest;
        let rec go xs !i = if i == 0 { [] } else {
            let [front, back] = take_n xs per;
            let row = native.concat3 "[" (rendered_axis front rest) "]";
            if i == 1 { [row] } else { row :: ", " :: go back (i - 1) }
        };
        concat_list (go flat n)
    },
};

let show_tensor t = {
    let shape = native.tensor_shape t;
    if native.tensor_size t > 1000 {
        native.concat2 "tensor of shape " (native.shape_text t)
    } else {
        concat_list ["tensor[", rendered_axis (native.tensor_flat t) shape, "]"]
    }
};

let t_zeros s = native.tensor_fill (read_shape s) 0;
let t_ones s = native.tensor_fill (read_shape s) 1;
let t_fill s x = if native.is_number_value x { native.tensor_fill (read_shape s) x }
    else { type_error (native.concat2 "`fill` fills with a number, not " (native.describe_value x)) };
let t_identity n = native.tensor_identity (forced_array [n, n]);
let t_range n = native.tensor_range (forced_array [n]);
let seed_check seed what = if type_of seed != :integer {
    type_error (concat_list ["`", what, "` takes an integer seed, not ", native.describe_value seed])
} else { true };
let t_random seed s = if seed_check seed "random" { native.tensor_random seed (read_shape s) } else { () };
let t_normal seed s = if seed_check seed "normal" { native.tensor_normal seed (read_shape s) } else { () };
let t_random_like seed t = if type_of seed != :integer { type_error "`random_like` takes an integer seed" }
    else { native.tensor_random_like seed (as_tensor t) };
let t_shape t = native.tensor_shape (as_tensor t);
let t_rank t = native.tensor_rank (as_tensor t);
let t_size t = native.tensor_size (as_tensor t);
let t_device t = if native.is_tensor_value (as_tensor t) { :host } else { :host };
let t_dtype t = if native.is_tensor_value (as_tensor t) { :f64 } else { :f64 };

let t_reshape s v = {
    let t = as_tensor v;
    let shape = read_shape s;
    if list_product (native.array_to_list shape) != native.tensor_size t {
        shape_error (concat_list ["cannot reshape ", show (native.tensor_size t), " numbers (shape ", native.shape_text t,
                                  ") to shape ", show_shape (native.array_to_list shape)])
    } else { native.tensor_reshape shape t }
};

let show_shape xs = native.concat3 "[" (join_items xs) "]";

let t_transpose v = {
    let t = as_tensor v;
    if native.tensor_rank t > 2 {
        shape_error (native.concat2 "`transpose` takes a matrix or a vector, not shape " (native.shape_text t))
    } else { native.tensor_transpose t }
};

let at_offset items shape !offset !axis = match [items, shape] {
    [[], []] => offset,
    [[i, ..more], [d, ..rest]] =>
        if type_of i != :integer || i < 0 || i >= d {
            lib_raise (native.error_new :out_of_bounds (concat_list ["index ", native.describe_value i, " is outside axis ", show axis, " of length ", show d]))
        } else { at_offset more rest (offset * d + i) (axis + 1) },
    _ => 0,
};

let t_at v indices = {
    let t = as_tensor v;
    match as_items indices {
        () => type_error "`at` takes a list of indices",
        items => {
            let shape = native.tensor_shape t;
            if length_from items 0 != length_from shape 0 {
                shape_error (concat_list ["`at` needs one index per axis: ", show (length_from shape 0), ", not ", show (length_from items 0)])
            } else { native.tensor_at t (at_offset items shape 0 0) }
        },
    }
};

let t_matmul x y = {
    let a = as_tensor x;
    let b = as_tensor y;
    let ra = native.tensor_rank a;
    let rb = native.tensor_rank b;
    let sa = native.tensor_shape a;
    let sb = native.tensor_shape b;
    if ra == 3 && (rb == 3 || rb == 2) {
        if (rb == 3 && (sa.[0] != sb.[0] || sa.[2] != sb.[1])) || (rb == 2 && sa.[2] != sb.[0]) {
            mismatch a b
        } else { native.tensor_matmul a b }
    }
    else if ra > 2 || rb > 2 {
        shape_error (concat_list ["`@` multiplies matrices and vectors (or `[b, m, k] @ [b, k, n]`, ",
                                  "or `[b, m, k] @ [k, n]`), not tensors of shape ", native.shape_text a, " and ", native.shape_text b])
    }
    else {
        let ka = if ra == 2 { sa.[1] } else { sa.[0] };
        let kb = sb.[0];
        if ka != kb { mismatch a b } else { native.tensor_matmul a b }
    }
};

let mismatch a b = {
    let sa = native.tensor_shape a;
    let sb = native.tensor_shape b;
    let ka = list_last sa;
    let kb = if native.tensor_rank b == 3 { sb.[1] } else { sb.[0] };
    shape_error (concat_list ["`@` needs the inner dimensions to agree: ", show ka, " and ", show kb,
                              " (shapes ", native.shape_text a, " and ", native.shape_text b, ")"])
};

let list_last xs = match xs { [x] => x, [_, ..rest] => list_last rest };

let t_dot x y = {
    let a = as_tensor x;
    let b = as_tensor y;
    if native.tensor_rank a != 1 || native.tensor_rank b != 1 {
        shape_error (concat_list ["`dot` takes two vectors, not shapes ", native.shape_text a, " and ", native.shape_text b, "; `@` multiplies matrices"])
    } else { t_matmul a b }
};

let t_outer x y = {
    let a = as_tensor x;
    let b = as_tensor y;
    if native.tensor_rank a != 1 || native.tensor_rank b != 1 { shape_error "`outer` takes two vectors" }
    else {
        t_matmul (native.tensor_reshape (forced_array [native.tensor_size a, 1]) a)
                 (native.tensor_reshape (forced_array [1, native.tensor_size b]) b)
    }
};

let t_sum v = native.tensor_sum (as_tensor v);
let t_sum_tensor v = as_tensor [t_sum v];
let t_minimum v = native.tensor_min (as_tensor v);
let t_maximum v = native.tensor_max (as_tensor v);
let t_mean v = native.tensor_mean (as_tensor v);
let t_norm v = native.tensor_norm (as_tensor v);

let axis_call op name axis v = {
    let t = as_tensor v;
    if type_of axis != :integer || axis < 0 || axis >= native.tensor_rank t {
        shape_error (concat_list ["`", name, "` takes an axis of shape ", native.shape_text t, ", not ", native.describe_value axis])
    } else if native.tensor_rank t == 1 {
        // A vector has nothing left once its axis is gone: the answer is a number, and
        // for a position, an integer.
        let one = native.tensor_axis op 0 (native.tensor_reshape (forced_array [1, native.tensor_size t]) t) ;
        match op {
            0 => native.tensor_sum t,
            1 => native.tensor_min t,
            2 => native.tensor_max t,
            _ => native.to_int (native.tensor_at (native.tensor_axis op 1 (native.tensor_reshape (forced_array [1, native.tensor_size t]) t)) 0),
        }
    } else { native.tensor_axis op axis t }
};

let t_sum_axis a v = axis_call 0 "sum_axis" a v;
let t_min_axis a v = axis_call 1 "min_axis" a v;
let t_max_axis a v = axis_call 2 "max_axis" a v;
let t_argmin_axis a v = axis_call 3 "argmin_axis" a v;
let t_argmax_axis a v = axis_call 4 "argmax_axis" a v;

let t_sqrt v = native.tensor_unary 0 (as_tensor v);
let t_exp v = native.tensor_unary 1 (as_tensor v);
let t_log v = native.tensor_unary 2 (as_tensor v);
let t_abs v = native.tensor_unary 3 (as_tensor v);
let t_tanh v = native.tensor_unary 4 (as_tensor v);
let t_sin v = native.tensor_unary 5 (as_tensor v);
let t_cos v = native.tensor_unary 6 (as_tensor v);
let t_relu v = native.tensor_unary 7 (as_tensor v);
let t_sigmoid v = native.tensor_unary 8 (as_tensor v);
let t_floor v = native.tensor_unary 9 (as_tensor v);
let t_ceil v = native.tensor_unary 10 (as_tensor v);
let t_round v = native.tensor_unary 11 (as_tensor v);
let t_sign v = native.tensor_unary 12 (as_tensor v);
let t_erf v = native.tensor_unary 13 (as_tensor v);

/// A number stays a number, so that it broadcasts; a list becomes a tensor.
let operand v = if native.is_number_value v { v } else { as_tensor v };
let binary op a b = native.tensor_binary op (operand a) (operand b);
let t_max a b = binary 5 a b;
let t_min a b = binary 6 a b;
let t_pow a b = binary 7 a b;
let t_lt a b = binary 8 a b;
let t_le a b = binary 9 a b;
let t_gt a b = binary 10 a b;
let t_ge a b = binary 11 a b;
let t_eq a b = binary 12 a b;
let t_ne a b = binary 13 a b;

let t_fill_like v x = if native.is_number_value x { native.tensor_fill_like (as_tensor v) x }
    else { type_error (native.concat2 "`fill_like` fills with a number, not " (native.describe_value x)) };

let count_arg n what = if type_of n != :integer || n < 0 {
    type_error (concat_list ["`", what, "` takes a length, not ", native.describe_value n])
} else { n };

let t_repeat n v = native.tensor_repeat (count_arg n "repeat") (as_tensor v);

let t_slice start count v = {
    let t = as_tensor v;
    let rows = native.tensor_len t;
    if type_of start != :integer || start < 0 || start > rows {
        lib_raise (native.error_new :out_of_bounds (concat_list ["`slice` starts at row ", native.describe_value start, " of ", show rows]))
    }
    else if start + count_arg count "slice" > rows {
        lib_raise (native.error_new :out_of_bounds (concat_list ["`slice` of ", show count, " rows from row ", show start,
                                                                 " runs past the end of ", show rows]))
    }
    else { native.tensor_take (forced_array (count_up start count)) t }
};

let count_up !from !n = if n == 0 { [] } else { from :: count_up (from + 1) (n - 1) };

let row_list rows what limit = {
    let items = if native.is_tensor_value rows { map_to_int (native.tensor_flat rows) } else {
        match as_items rows {
            () => type_error (concat_list ["`", what, "` takes a list of row numbers, not ", native.describe_value rows]),
            xs => xs,
        }
    };
    if check_rows items what limit { items } else { [] }
};

let map_to_int xs = match xs {
    [] => [],
    [x, ..rest] => native.to_int x :: map_to_int rest,
};

let check_rows items what limit = match items {
    [] => true,
    [r, ..rest] => if type_of r != :integer || r < 0 || r >= limit {
        lib_raise (native.error_new :out_of_bounds (concat_list ["`", what, "` row ", native.describe_value r, " is outside ", show limit]))
    } else { check_rows rest what limit },
};

let t_take rows v = {
    let t = as_tensor v;
    match row_list rows "take" (native.tensor_len t) {
        [] => shape_error "`take` needs at least one row: a tensor cannot be empty",
        items => native.tensor_take (forced_array items) t,
    }
};

let shape_rest t = match native.tensor_shape t { [_, ..rest] => rest };

let same_tail ts first = match ts {
    [] => true,
    [t, ..rest] => if shape_rest t == shape_rest first { same_tail rest first } else {
        shape_error (concat_list ["`concat` joins tensors whose shapes agree after the first axis, not ",
                                  native.shape_text first, " and ", native.shape_text t])
    },
};

let tensors_of xs = match xs {
    [] => [],
    [x, ..rest] => as_tensor x :: tensors_of rest,
};

let t_concat ts = match as_items ts {
    () => type_error "`concat` takes a list of tensors",
    [] => shape_error "`concat` needs at least one tensor",
    items => {
        let parts = tensors_of items;
        if same_tail parts parts.[0] { native.tensor_concat (forced_array parts) } else { () }
    },
};

let t_one_hot n classes = {
    let width = count_arg n "one_hot";
    match row_list classes "one_hot" width {
        [] => shape_error "`one_hot` needs at least one index",
        items => native.tensor_one_hot width (forced_array items),
    }
};

let t_to_bytes v = native.tensor_to_bytes (as_tensor v);
let t_of_bytes s b = {
    let shape = read_shape s;
    if type_of b != :string { type_error (native.concat2 "`of_bytes` reads a string of bytes, not " (native.describe_value b)) }
    else {
        let need = list_product (native.array_to_list shape) * 8;
        if native.size b != need {
            shape_error (concat_list ["`of_bytes` needs ", show need, " bytes for shape ", show_shape (native.array_to_list shape), ", not ", show (native.size b)])
        } else { native.tensor_of_bytes shape b }
    }
};

let t_permute axes v = {
    let t = as_tensor v;
    let rank = native.tensor_rank t;
    let items = as_items axes;
    let unique_axes = fn ok -> ok;
    match items {
        () => type_error "`permute` takes a list of axes",
        _ => if length_from items 0 == rank && axes_ok items rank [] {
            native.tensor_permute (forced_array items) t
        } else {
            shape_error (concat_list ["`permute` takes each axis of shape ", native.shape_text t, " once, in its new order"])
        },
    }
};

let axes_ok items rank seen = match items {
    [] => true,
    [a, ..rest] => type_of a == :integer && a >= 0 && a < rank && not (list_has seen a) && axes_ok rest rank (a :: seen),
};

let list_has xs x = match xs {
    [] => false,
    [y, ..rest] => y == x || list_has rest x,
};

let t_im2col kh kw stride pad v = {
    let x = as_tensor v;
    if native.tensor_rank x != 4 { shape_error (native.concat2 "`im2col` takes images `[n, h, w, c]`, not shape " (native.shape_text x)) }
    else {
        match native.tensor_shape x {
            [_, h, w, _] => match window_size "im2col" h w kh kw stride pad {
                [_, _] => native.tensor_im2col (forced_array [kh, kw, stride, pad]) x,
            },
        }
    }
};

let window_size what h w kh kw stride pad =
    if type_of kh != :integer || type_of kw != :integer || type_of stride != :integer || type_of pad != :integer
       || kh <= 0 || kw <= 0 || stride <= 0 || pad < 0 || h + 2 * pad < kh || w + 2 * pad < kw {
        shape_error (concat_list ["`", what, "` takes a window that fits images of height ", show h, " and width ", show w])
    } else { [(h + 2 * pad - kh) / stride + 1, (w + 2 * pad - kw) / stride + 1] };

let t_col2im shape kh kw stride pad cols = {
    let c = as_tensor cols;
    let s = read_shape shape;
    let dims = native.array_to_list s;
    match dims {
        [n, h, w, ch] => {
            let [oh, ow] = window_size "col2im" h w kh kw stride pad;
            let rows = n * oh * ow;
            let k = kh * kw * ch;
            if native.tensor_shape c != [rows, k] {
                shape_error (concat_list ["`col2im` needs the rows `im2col` makes for images of shape ", show_shape dims,
                                          ", which are [", show rows, ", ", show k, "], not ", native.shape_text c])
            } else { native.tensor_col2im s (forced_array [kh, kw, stride, pad]) c }
        },
        _ => shape_error (native.concat2 "`col2im` makes images `[n, h, w, c]`, not shape " (show_shape dims)),
    }
};

let no_gpu t = lib_raise (native.error_new :no_gpu "no GPU is available: a native build has no OpenCL");
let t_gpu t = no_gpu t;
let t_gpu64 t = no_gpu t;
let t_host v = as_tensor v;
let t_gpu_available u = false;
let t_gpu_name u = ();
let t_cpu_kernels u = "baseline";

// --- the wire format --------------------------------------------------------------------------
//
// `std.wire`'s, every kind included: records and trunks are spelled here as in
// dream/src/builtins.cpp, whose format this is, so a native program and the VM read each
// other's messages. `wire_pack` writes the plain form, which `decode` reads either way:
// packing is a matter of size, and a native program has no unit cache to shrink.

let le_field v !w = native.str_le v w;

let wire_tagged tag payload = native.concat2 (le_field tag 1) payload;
let counted tag n rest = tag_and_count tag n :: rest;
let tag_and_count tag n = native.concat2 (le_field tag 1) (le_field n 4);

let wire_pieces v rest = match type_of v {
    :unit => le_field 0 1 :: rest,
    :bool => le_field (if v { 2 } else { 1 }) 1 :: rest,
    :integer => wire_integer v rest,
    :float => wire_tagged 4 (native.float_bytes v) :: rest,
    :string => tag_and_count 5 (native.size v) :: v :: rest,
    :atom => { let name = native.atom_name v; tag_and_count 6 (native.size name) :: name :: rest },
    :char => wire_tagged 7 (le_field (native.char_code v) 4) :: rest,
    :list => { let n = length_from v 0; tag_and_count 8 n :: wire_items v rest },
    :array => tag_and_count 9 (native.size v) :: wire_items (native.array_to_list v) rest,
    :map => {
        let pairs = native.map_pairs v;
        let n = length_from pairs 0;
        tag_and_count 10 n :: wire_map_items (merge_sort pairs n) rest
    },
    :tensor => wire_tensor v rest,
    :trunk => tag_and_count 14 (native.trunk_len v) :: wire_items (native.trunk_to_list v) rest,
    :pure_fn => wire_text v rest,
    :impure_fn => wire_text v rest,
    :process => wire_text v rest,
    :error => wire_text v rest,
    _ => wire_record v rest,
};

let wire_text v rest = { let t = show v; tag_and_count 5 (native.size t) :: t :: rest };

let wire_items xs rest = match xs {
    [] => rest,
    [x, ..more] => wire_pieces x (wire_items more rest),
};

let wire_map_items ps rest = match ps {
    [] => rest,
    [[k, v], ..more] => wire_pieces k (wire_pieces v (wire_map_items more rest)),
};

let wire_integer n rest =
    if n <= native.pow 2 63 - 1 && n >= 0 - native.pow 2 63 { wire_tagged 3 (le_field n 8) :: rest }
    else {
        let w = big_width n 9 (native.pow 2 71);
        tag_and_count 11 w :: le_field n w :: rest
    };

let big_width n !w half = if n < half && n >= 0 - half { w } else { big_width n (w + 1) (half * 256) };

let wire_record v rest = {
    let id = native.record_id v;
    let name = native.atom_name id;
    let n = native.record_size v;
    let variant = native.str_find_any (native.record_display id) "." 0 >= 0;
    tag_and_count 13 (native.size name) :: name :: le_field (if variant { 1 } else { 0 }) 1 :: le_field n 4
        :: wire_items (native.array_to_list (native.record_fields v)) rest
};

let wire_tensor t rest = {
    let dims = native.tensor_shape t;
    let rec dim_pieces ds = match ds { [] => [native.tensor_to_bytes t], [d, ..more] => le_field d 4 :: dim_pieces more };
    wire_tagged 12 (le_field (native.tensor_rank t) 1) :: list_append (dim_pieces dims) rest
};

let list_append xs ys = concat_lists xs ys;

let wire_encode v = if settle v { concat_list (wire_pieces v []) } else { "" };
let wire_pack v = wire_encode v;

let le_at s at !n = if n == 0 { 0 } else { le_at s (at + 1) (n - 1) * 256 + native.str_byte_any s at };

let signed_at s at !n = {
    let v = le_at s at n;
    if v >= native.pow 2 (8 * n - 1) { v - native.pow 2 (8 * n) } else { v }
};

/// `[value, next]`, or `()` for what is not one, as `std.wire`'s reader answers.
let wire_read s at = {
    let size = native.size s;
    let has = fn n -> at + n <= size;
    let next = at + 1;
    let fits = fn n -> next + n <= size;
    if not (has 1) { () } else {
        match native.str_byte_any s at {
            0 => [(), next],
            1 => [false, next],
            2 => [true, next],
            3 => if fits 8 { [signed_at s next 8, next + 8] } else { () },
            4 => if fits 8 { [native.float_of_bytes (native.str_slice_any s next 8), next + 8] } else { () },
            5 => wire_read_bytes s next (fn text -> text),
            6 => wire_read_bytes s next (fn name -> native.to_existing_atom name),
            7 => if fits 4 { [native.char_of_code (le_at s next 4), next + 4] } else { () },
            8 => wire_read_seq s next (fn xs -> xs),
            9 => wire_read_seq s next (fn xs -> forced_lazy_array xs),
            14 => wire_read_seq s next (fn xs -> trunk_of xs),
            10 => if fits 4 { wire_read_map s (next + 4) (le_at s next 4) (native.map_empty ()) } else { () },
            11 => if fits 4 {
                let n = le_at s next 4;
                if next + 4 + n <= size { [signed_at s (next + 4) n, next + 4 + n] } else { () }
            } else { () },
            12 => wire_read_tensor s next,
            13 => wire_read_record s next,
            _ => (),
        }
    }
};

let forced_lazy_array xs = array_of_list xs;

let wire_read_bytes s at f =
    if at + 4 > native.size s { () } else {
        let n = le_at s at 4;
        if at + 4 + n > native.size s { () }
        else {
            let v = f (native.str_slice_any s (at + 4) n);
            [v, at + 4 + n]
        }
    };

let wire_read_items s at !n acc = if n == 0 { [rev_onto acc [], at] } else {
    match wire_read s at {
        () => (),
        [v, next] => wire_read_items s next (n - 1) (v :: acc),
    }
};

let wire_read_seq s at f =
    if at + 4 > native.size s { () } else {
        match wire_read_items s (at + 4) (le_at s at 4) [] {
            () => (),
            [xs, next] => [f xs, next],
        }
    };

let wire_read_map s at !n m = if n == 0 { [m, at] } else {
    match wire_read s at {
        () => (),
        [k, next] => match wire_read s next {
            () => (),
            [v, after] => wire_read_map s after (n - 1) (native.map_put m k v),
        },
    }
};

let wire_read_record s at =
    if at + 4 > native.size s { () } else {
        let n = le_at s at 4;
        let after = at + 4 + n;
        if after + 5 > native.size s { () } else {
            match native.to_existing_atom (native.str_slice_any s (at + 4) n) {
                () => (),
                id => match wire_read_items s (after + 5) (le_at s (after + 1) 4) [] {
                    () => (),
                    [fields, next] => [native.record_of id (native.str_byte_any s after == 1) (forced_lazy_array fields), next],
                },
            }
        }
    };

let wire_read_tensor s at =
    if at + 1 > native.size s { () } else {
        let rank = native.str_byte_any s at;
        let dims_at = at + 1;
        let data_at = dims_at + rank * 4;
        if data_at > native.size s { () } else {
            let dims = wire_dims s dims_at rank;
            let bytes = list_product dims * 8;
            if data_at + bytes > native.size s { () }
            else { [native.tensor_of_bytes (forced_array dims) (native.str_slice_any s data_at bytes), data_at + bytes] }
        }
    };

let wire_dims s at !n = if n == 0 { [] } else { le_at s at 4 :: wire_dims s (at + 4) (n - 1) };

let wire_decode text = if type_of text != :string { lib_raise (native.error_new :type_error "wire_decode needs a string") } else {
    match wire_read text 0 {
        () => Result.error "not a wire value",
        [v, at] => if at == native.size text { Result.ok v } else { Result.error "trailing bytes after a wire value" },
    }
};

/// `vm.host_members`: `[name, arity]` of a module, in the order they were written, or `()`
/// for a module there is none of.
let host_members_in table module_ = {
    let prefix = native.concat2 module_ ".";
    let found = table_lines table 0 prefix;
    match found { [] => (), _ => found }
};

let table_lines table !at prefix = {
    if at >= native.size table { [] } else {
        let nl = native.str_find_any table "\n" at;
        let stop = if nl < 0 { native.size table } else { nl };
        let line = native.str_slice_any table at (stop - at);
        let n = native.size prefix;
        let rest = table_lines table (stop + 1) prefix;
        if native.str_slice_any line 0 n == prefix {
            let space = native.str_find_any line " " n;
            [native.str_slice_any line n (space - n), native.parse_int (native.str_slice_any line (space + 1) (native.size line))] :: rest
        } else { rest }
    }
};

// --- tls, what a map of options is -------------------------------------------------------------

let string_option m key what = match native.match_key m key {
    [] => (),
    [v] => match type_of v {
        :string => v,
        :unit => (),
        _ => lib_raise (native.error_new :bad_argument what),
    },
};

let bool_option m key fallback what = match native.match_key m key {
    [] => fallback,
    [v] => if type_of v == :bool { v } else { lib_raise (native.error_new :bad_argument what) },
};

let alpn_wire xs = match xs {
    [] => "",
    [n, ..rest] => {
        if type_of n != :string { lib_raise (native.error_new :bad_argument "`:alpn` is a list of protocol names") }
        else if native.size n == 0 || native.size n > 255 { alpn_wire rest }
        else { native.concat3 (le_field (native.size n) 1) n (alpn_wire rest) }
    },
};

let tls_config options server = {
    let m = match type_of options {
        :unit => native.map_empty (),
        :map => options,
        _ => lib_raise (native.error_new :bad_argument "the options are a map, such as %{ :host => \"example.com\" }"),
    };
    let host = string_option m :host "`:host` is a string";
    let verify = bool_option m :verify (not server) "`:verify` is true or false";
    let check_name = bool_option m :check_name true "`:check_name` is true or false";
    let identity = string_option m :identity "`:identity` is a string holding a PKCS#12 bundle";
    let alpn = match native.match_key m :alpn {
        [] => (),
        [xs] => if type_of xs == :list { alpn_wire xs } else { lib_raise (native.error_new :bad_argument "`:alpn` is a list of protocol names") },
    };
    if not server && verify && check_name && type_of host != :string {
        lib_raise (native.error_new :bad_argument "a client that verifies needs `:host`, the name the certificate must carry; `:check_name => false` checks the chain alone, and `:verify => false` checks nothing")
    }
    else if server && type_of identity != :string {
        lib_raise (native.error_new :bad_argument "a server needs `:identity`, a PKCS#12 bundle of its certificate and key")
    }
    else {
        forced_array [host, string_option m :ca "`:ca` is a string of PEM certificates",
                      string_option m :crl "`:crl` is a string of PEM revocation lists", identity,
                      string_option m :password "`:password` is a string", verify, check_name, alpn]
    }
};

let tls_upgrade! h options server = {
    let handle = native.tls_start h server (tls_config options server);
    native.tls_handshake_m handle
};

let tls_connect! h options = tls_upgrade! h options false;
let tls_accept! h options = tls_upgrade! h options true;

let tls_info! h = match native.tls_info_parts h {
    () => (),
    [version, cipher, alpn, peer] => %{:version => version, :cipher => cipher, :alpn => alpn, :peer => peer},
};

// --- what the supercompiler writes -----------------------------------------------------------
//
// In a release build a loop's accumulator or membership test may be rewritten to one of
// these. Each may answer "cannot say", `()`, and the code it was written into then does what
// the program said in the first place, so a set or a tally here that knows nothing is correct
// and only as fast as the program was before it was rewritten. The ones that have to answer
// do so plainly.

let indexed v = match type_of v { :list => array_of_list v, _ => v };
let append_rev xs ys = concat_lists xs (rev_onto ys []);
let str_append_rev s parts = concat_list (s :: rev_onto parts []);
let set_of xs = ();
let set_add s v = s;
let set_lookup s v = ();
let set_refresh s xs = s;
let tally xs = ();
let tally_lookup t xs v = ();
let index_new xs path sorted = ();
let index_find i v = ();
let trunk_recall key t = ();

let list_drop !n xs = if n <= 0 { xs } else {
    match xs { [] => [], [_, ..rest] => list_drop (n - 1) rest }
};

let memo_fill a f !i !n = if i >= n { a } else { memo_fill (native.array_store a i (f i)) f (i + 1) n };
let memo_cells n f = memo_fill (native.array_new n ()) f 0 n;

/// A heap, as the sorted list it stands for: `compare` on the elements, first met first.
let sorted_values xs = {
    let n = length_from xs 0;
    seconds (merge_sort (pair_up xs xs) n)
};
let heap_of xs = sorted_values xs;
let heap_empty h = match h { [] => true, _ => false };
let heap_min h = match h {
    [x, .._] => x,
    [] => lib_raise (native.error_new :type_error "head needs a non-empty list"),
};
let heap_pop h = match h {
    [_, ..rest] => rest,
    [] => lib_raise (native.error_new :type_error "tail needs a non-empty list"),
};
let heap_insert h x = match h {
    [] => [x],
    [y, ..rest] => if compare_values x y < 0 { x :: h } else { y :: heap_insert rest x },
};
let heap_push h xs = match xs {
    [] => h,
    [x, ..rest] => heap_push (heap_insert h x) rest,
};

// --- std.ffi -------------------------------------------------------------------------------------
//
// A signature is data, and so is everything said about it, so this is an ordinary program
// over the runtime's one real operation (`ffi_call!`). A foreign function is a closure of the
// arguments it wants. The one thing missing is `[:callback, ..]`: C calling back into a program
// needs an entry from C onto a process's stack, which a native build does not have yet, and a
// signature that asks for one is an error saying so.

let ffi_fail why = lib_raise (native.error_new :ffi_error why);

let ffi_kind_of name = match name {
    "void" => [0, 0, 1], "bool" => [1, 1, 1],
    "i8" => [2, 1, 1], "char" => [2, 1, 1], "i16" => [3, 2, 2], "short" => [3, 2, 2],
    "i32" => [4, 4, 4], "int" => [4, 4, 4], "i64" => [5, 8, 8], "long" => [5, 8, 8], "longlong" => [5, 8, 8],
    "ssize" => [5, 8, 8], "intptr" => [5, 8, 8],
    "u8" => [6, 1, 1], "uchar" => [6, 1, 1], "u16" => [7, 2, 2], "ushort" => [7, 2, 2],
    "u32" => [8, 4, 4], "uint" => [8, 4, 4], "u64" => [9, 8, 8], "ulong" => [9, 8, 8], "ulonglong" => [9, 8, 8],
    "size" => [9, 8, 8], "uintptr" => [9, 8, 8],
    "f32" => [10, 4, 4], "f64" => [11, 8, 8], "double" => [11, 8, 8],
    "ptr" => [12, 8, 8], "cstr" => [13, 8, 8], "bytes" => [14, 8, 8],
    _ => (),
};

let ffi_scalar name = ffi_kind_of name;

/// A type as `[:scalar, kind]`, `[:handle, tag]`, `[:own, tag, dtor]`, `[:borrow, tag]`,
/// `[:take_cstr, dtor]` or `[:out, inner]`.
let ffi_parse v lib pos = match type_of v {
    :atom => {
        let name = native.atom_name v;
        if name == "buffer" && pos == :arg { [:handle, "buffer"] } else {
            match ffi_scalar name {
                () => ffi_fail (concat_list ["`:", name, "` is not an FFI type"]),
                k => {
                    let code = k.[0];
                    if code == 0 && pos != :ret { ffi_fail "`:void` is only a return type" }
                    else if code == 14 && pos != :arg { ffi_fail "`:bytes` is only an argument type: C cannot say how long a pointer's bytes are" }
                    else { [:scalar, code] }
                },
            }
        }
    },
    :list => match v {
        [:handle, tag] => if pos != :arg { ffi_fail "`[:handle, tag]` is an argument type; a result that is a pointer is `[:own, tag, destructor]` or `[:borrow, tag]`" } else { [:handle, tag] },
        [:own, tag, dtor] => if pos == :arg { ffi_fail "`[:own, tag, destructor]` is a result type; an argument is `[:handle, tag]`" } else { [:own, tag, ffi_destructor lib dtor] },
        [:borrow, tag] => if pos == :arg { ffi_fail "`[:borrow, tag]` is a result type; an argument is `[:handle, tag]`" } else { [:borrow, tag] },
        [:cstr, dtor] => if pos == :arg { ffi_fail "`[:cstr, destructor]` is a result type; an argument is `:cstr`" } else { [:take_cstr, ffi_destructor lib dtor] },
        [:out, inner] => if pos != :arg { ffi_fail "`[:out, t]` is an argument type" } else { [:out, ffi_parse inner lib :out_inner] },
        [:callback, args, ret] => if pos != :arg { ffi_fail "`[:callback, args, result]` is an argument type" } else { ffi_parse_callback args ret lib },
        _ => ffi_fail "a compound type is `[:handle, tag]`, `[:own, tag, destructor]`, `[:borrow, tag]`, `[:cstr, destructor]`, `[:out, t]` or `[:callback, args, result]`",
    },
    _ => ffi_fail "a type is an atom such as `:i32`, or a list such as `[:own, \"db\", \"db_close\"]`",
};

let ffi_parse_callback args ret lib = {
    let kinds = ffi_callback_kinds (as_items args) lib;
    match ffi_parse ret lib :ret {
        [:scalar, k] => if k == 13 || k == 14 { ffi_fail "a callback cannot answer a `:cstr`" } else { [:callback, kinds, k] },
        _ => ffi_fail "a callback answers a number, `:ptr` or `:void`",
    }
};

let ffi_callback_kinds items lib = match items {
    [] => [],
    [t, ..rest] => match ffi_parse t lib :arg {
        [:scalar, k] => if k == 14 { ffi_fail "a callback's arguments are numbers, `:ptr` or `:cstr`" } else { k :: ffi_callback_kinds rest lib },
        _ => ffi_fail "a callback's arguments are numbers, `:ptr` or `:cstr`",
    },
};

let ffi_destructor lib name = {
    let found = native.ffi_dlsym lib name;
    if found != 0 { found } else {
        let own = native.ffi_dlsym (native.ffi_dlopen ()) name;
        if own != 0 { own } else {
            ffi_fail (concat_list ["cannot find the destructor `", name, "`"])
        }
    }
};

// --- libraries --------------------------------------------------------------------------------

let ffi_open_one v = match type_of v {
    :unit => [native.ffi_dlopen (), "<this program>"],
    :string => {
        let h = native.ffi_dlopen v;
        if h == 0 { (concat_list ["cannot open ", v, ": ", native.ffi_dlerror ()]) } else { [h, if v == "" { "<this program>" } else { v }] }
    },
    :list => match v {
        [:any, choices] => ffi_open_any choices "",
        [:search, name, files, dirs] => ffi_search name files dirs,
        [:payload, which] => ffi_open_payload which,
        _ => "a library is a path, `()` for this program, `[:any, choices]`, `[:search, ..]` or `[:payload, name]`",
    },
    _ => "a library is a path, `()` for this program, `[:any, choices]`, `[:search, ..]` or `[:payload, name]`",
};

let ffi_open_any choices why = match choices {
    [] => if why == "" { "`any` was given no libraries to choose from" } else { native.concat2 "none of the libraries could be opened:" why },
    [c, ..rest] => match ffi_open_one c {
        [h, where] => [h, where],
        text => ffi_open_any rest (concat_list [why, "\n", text]),
    },
};

let ffi_try_files dirs files = match dirs {
    [] => ffi_try_plain files,
    [d, ..more] => match ffi_try_in d files {
        () => ffi_try_files more files,
        found => found,
    },
};

let ffi_try_in dir files = match files {
    [] => (),
    [f, ..rest] => {
        let path = path_join dir f;
        let h = native.ffi_dlopen path;
        if h != 0 { [h, path] } else { ffi_try_in dir rest }
    },
};

let ffi_try_plain files = match files {
    [] => (),
    [f, ..rest] => {
        let h = native.ffi_dlopen f;
        if h != 0 { [h, f] } else { ffi_try_plain rest }
    },
};

let ffi_search name files dirs = {
    let env_name = native.concat2 "DREAM_LIB_" (native.str_ascii_case name true);
    let named = native.os_env env_name;
    let from_env = match type_of named {
        :string => { let h = native.ffi_dlopen named; if h != 0 { [h, named] } else { () } },
        _ => (),
    };
    match from_env {
        () => match ffi_try_files dirs files {
            () => concat_list ["cannot find the C library `", name, "`: looked for ", join_items files, " in ", join_items dirs, " and on the loader's path; `$", env_name, "` names it"],
            found => found,
        },
        found => found,
    }
};

let ffi_open_payload which = {
    let index = match type_of which { :string => native.payload_index which, _ => which };
    match type_of index {
        :integer => if index >= 0 && index < native.data_count () {
            let h = native.ffi_open_bytes (native.data_at index) index;
            if h == 0 { concat_list ["cannot open payload `", show which, "`: ", native.ffi_dlerror ()] }
            else { [h, concat_list ["payload `", show which, "`"]] }
        } else { concat_list ["this image carries no payload ", show which] },
        _ => concat_list ["this image carries no payload called `", show which, "`; build it with `--payload ", show which, "=FILE`"],
    }
};

let ffi_library desc = match ffi_open_one desc {
    [h, where] => [h, where],
    why => ffi_fail why,
};

let ffi_locate! lib = match ffi_open_one lib {
    [_, where] => Result.ok where,
    why => Result.error why,
};

// --- handles ------------------------------------------------------------------------------------
//
// `[owner, tag, pointer, destructor, size, parents]`, by id, in the runtime's table.

let ffi_adopt! tag ptr dtor size parents = {
    let id = native.foreign_new_id ();
    // An array of forced fields, because the runtime reads one when the process that owns it
    // ends, and nothing can be forced by then.
    native.foreign_set_table (native.map_put (native.foreign_table ()) id (forced_array [native.current_pid_id (), tag, ptr, dtor, size, parents]));
    [:foreign, tag, id]
};

let ffi_entry h = match h {
    [:foreign, tag, id] => match native.match_key (native.foreign_table ()) id {
        [e] => if e.[1] == tag && e.[0] == native.current_pid_id () { [id, e] }
               else { concat_list ["the `", tag, "` handle ", show id, " has been released, or belongs to another process"] },
        _ => concat_list ["the `", tag, "` handle ", show id, " has been released, or belongs to another process"],
    },
    _ => "expected a handle, `[:foreign, tag, id]`",
};

let ffi_live h = match ffi_entry h {
    [id, e] => [id, e],
    why => ffi_fail why,
};

/// What goes wrong marshalling an argument is said of the argument.
let ffi_said prefix why = lib_raise (native.error_new :ffi_error (native.concat2 prefix why));

let ffi_live_as h prefix = match ffi_entry h {
    [id, e] => [id, e],
    why => ffi_said prefix why,
};

let ffi_children id ps = match ps {
    [] => [],
    [[k, e], ..rest] => if list_has e.[5] id { k :: ffi_children id rest } else { ffi_children id rest },
};

let ffi_release_id! id = match native.match_key (native.foreign_table ()) id {
    [e] => {
        ffi_release_all! (rev_onto (sort_strings_any (ffi_children id (native.map_pairs (native.foreign_table ())))) []);
        native.ffi_destroy e.[3] e.[2];
        native.foreign_set_table (native.map_remove (native.foreign_table ()) id);
        ()
    },
    _ => (),
};

let sort_strings_any xs = sort_strings xs (length_from xs 0);

let ffi_release_all! ids = match ids {
    [] => (),
    [i, ..rest] => { ffi_release_id! i; ffi_release_all! rest },
};

let ffi_release! h = {
    let [id, _] = ffi_live_as h "release!: ";
    ffi_release_id! id
};

let ffi_alive! h = match ffi_entry h {
    [_, _] => true,
    _ => false,
};

let ffi_owned_pairs ps me = match ps {
    [] => [],
    [[id, e], ..rest] => if e.[0] == me { [:foreign, e.[1], id] :: ffi_owned_pairs rest me } else { ffi_owned_pairs rest me },
};
/// Oldest first, which is what a table keyed by id reads as on the VM and a map here does not.
let ffi_owned! u = ffi_by_id (ffi_owned_pairs (native.map_pairs (native.foreign_table ())) (native.current_pid_id ()));
let ffi_by_id hs = match hs {
    [] => [],
    [h, ..rest] => {
        let older = ffi_by_id (ffi_older rest h.[2] true);
        let newer = ffi_by_id (ffi_older rest h.[2] false);
        concat_lists older (h :: newer)
    },
};
let ffi_older hs id below = match hs {
    [] => [],
    [h, ..rest] => if (h.[2] < id) == below { h :: ffi_older rest id below } else { ffi_older rest id below },
};

let ffi_buffer! n = if type_of n != :integer || n < 0 { ffi_fail "buffer! needs a size in bytes" } else {
    ffi_adopt! "buffer" (native.ffi_calloc n) (native.ffi_dlsym (native.ffi_dlopen ()) "free") n []
};

let ffi_size! h = {
    let [_, e] = ffi_live_as h "size!: ";
    if e.[4] == 0 { () } else { e.[4] }
};

let ffi_address! h = {
    let [_, e] = ffi_live_as h "address!: ";
    e.[2]
};

let ffi_span h off n who = {
    let [_, e] = ffi_live h;
    let size = e.[4];
    if size == 0 { ffi_fail (concat_list [who, ": a `", e.[1], "` handle has no known size; only a buffer does"]) }
    else if type_of off != :integer || off < 0 { ffi_fail (native.concat2 who " needs an offset") }
    else if off > size || n > size - off {
        ffi_fail (concat_list [who, ": ", show n, " bytes at ", show off, " is outside a buffer of ", show size])
    }
    else { e.[2] + off }
};

let ffi_peekable t = match type_of t {
    :atom => match ffi_scalar (native.atom_name t) {
        () => ffi_fail "peek! and poke! read a number or a pointer",
        k => if k.[0] == 0 || k.[0] == 13 || k.[0] == 14 { ffi_fail "peek! and poke! read a number or a pointer" } else { k },
    },
    _ => ffi_fail "peek! and poke! read a number or a pointer",
};

let ffi_peek! h off t = {
    let k = ffi_peekable t;
    native.ffi_peek_at k.[0] (ffi_span h off k.[1] "peek!")
};

let ffi_poke! h off t v = {
    let k = ffi_peekable t;
    native.ffi_store_at k.[0] (ffi_span h off k.[1] "poke!") v
};

let ffi_read! h off n = if type_of n != :integer || n < 0 { ffi_fail "read! needs a byte count" } else {
    native.ffi_read_bytes (ffi_span h off n "read!") n
};

let ffi_read_string! h off = {
    let [_, e] = ffi_live h;
    let at = ffi_span h off 1 "read_string!";
    let rest = native.ffi_read_bytes at (e.[4] - off);
    let stop = native.str_find_any rest (native.string_of_bytes (forced_array [0])) 0;
    if stop < 0 { ffi_fail "read_string!: no NUL before the end of the buffer" } else { native.str_slice_any rest 0 stop }
};

let ffi_write! h off s = if type_of s != :string { ffi_fail "write! needs a string" } else {
    native.ffi_write_bytes (ffi_span h off (native.size s) "write!") s
};

let ffi_sizeof t = (ffi_peekable_any t).[1];
let ffi_alignof t = (ffi_peekable_any t).[2];
let ffi_peekable_any t = match type_of t {
    :atom => match ffi_scalar (native.atom_name t) {
        () => ffi_fail (concat_list ["`:", native.atom_name t, "` is not an FFI type"]),
        k => k,
    },
    _ => ffi_fail "sizeof and alignof take a scalar type",
};

let ffi_payload_index name = native.payload_index name;

// --- calling ------------------------------------------------------------------------------------

let ffi_needed types = match types {
    [] => 0,
    [[:out, _], ..rest] => ffi_needed rest,
    [_, ..rest] => 1 + ffi_needed rest,
};

/// The word for one argument: its value and its code, and any parent handle it names.
let ffi_marshal t v prefix = match t {
    [:handle, tag] => {
        let [id, e] = ffi_live_as v prefix;
        if e.[1] != tag { ffi_said prefix (concat_list ["expected a `", tag, "` handle, not a `", e.[1], "` one"]) }
        else { [e.[2], 0, [id]] }
    },
    [:callback, kinds, ret] => match type_of v {
        :impure_fn => ffi_said prefix "a callback must be a pure function: C cannot wait while it performs an effect",
        :pure_fn => [forced_array [v, forced_array kinds, ret], 5, []],
        _ => ffi_said prefix "a callback is a function",
    },
    [:scalar, 13] => match type_of v {
        :string => [v, 3, []],
        :unit => [(), 3, []],
        :list => [(), 3, []],
        _ => ffi_said prefix "expected a string",
    },
    [:scalar, 14] => match type_of v {
        :string => [v, 3, []],
        :unit => [(), 3, []],
        _ => ffi_said prefix "expected a string or a payload view",
    },
    [:scalar, 12] => match type_of v {
        :list => { let [id, e] = ffi_live_as v prefix; [e.[2], 0, [id]] },
        :integer => [v, 0, []],
        :unit => [0, 0, []],
        _ => ffi_said prefix "expected an address, which is carried as an integer",
    },
    [:scalar, 10] => if native.is_number_value v { [v, 2, []] } else { ffi_said prefix "expected a number" },
    [:scalar, 11] => if native.is_number_value v { [v, 1, []] } else { ffi_said prefix "expected a number" },
    [:scalar, 1] => [if v == true { 1 } else { 0 }, 0, []],
    [:scalar, _] => match type_of v {
        :integer => [v, 0, []],
        :float => [native.to_int v, 0, []],
        _ => ffi_said prefix "expected a number",
    },
    _ => ffi_said prefix "not an argument type",
};

/// An out parameter's place: a small buffer of C's, read when the call has returned.
let ffi_out_place! u = native.ffi_calloc 16;

let ffi_invoke! binding args = {
    let [f, name, types, ret] = binding;
    let rec fill! ts given values codes parents outs !at = match ts {
        [] => [rev_onto values [], rev_onto codes [], parents, rev_onto outs []],
        [[:out, inner], ..more] => {
            let place = ffi_out_place! ();
            fill! more given (place :: values) (0 :: codes) parents ([inner, place] :: outs) at
        },
        [t, ..more] => match given {
            [v, ..rest] => {
                let [word, code, named] = ffi_marshal t v (concat_list ["argument ", show at, " of `", name, "`: "]);
                fill! more rest (word :: values) (code :: codes) (concat_lists named parents) outs (at + 1)
            },
            [] => ffi_fail (concat_list ["`", name, "` needs more arguments"]),
        },
    };
    let [values, codes, parents, outs] = fill! types args [] [] [] [] 1;
    let answer = native.ffi_call_m f (forced_array [forced_array values, forced_array codes, ffi_raw_kind ret]);
    let result = ffi_result! ret answer parents;
    match outs {
        [] => result,
        _ => result :: ffi_out_results! outs parents,
    }
};

let ffi_raw_kind t = match t {
    [:scalar, k] => k,
    [:take_cstr, _] => 12,
    _ => 12,
};

let ffi_result! t raw parents = match t {
    [:own, tag, dtor] => match raw { () => (), _ => ffi_adopt! tag raw dtor 0 parents },
    [:borrow, tag] => match raw { () => (), _ => ffi_adopt! tag raw 0 0 parents },
    [:take_cstr, dtor] => match raw {
        () => (),
        _ => {
            // Read before the free, which a suspension would not be.
            let text = strict! (native.ffi_read_text raw);
            native.ffi_destroy dtor raw;
            text
        },
    },
    _ => raw,
};

let ffi_out_results! outs parents = match outs {
    [] => [],
    [[inner, place], ..rest] => {
        let raw = native.ffi_peek_at (ffi_raw_kind inner) place;
        let one = ffi_result! inner raw parents;
        native.ffi_raw_free place;
        one :: ffi_out_results! rest parents
    },
};

/// A function of `n` arguments, collected one at a time: what `apply` makes of any number.
let ffi_curried! binding !n got =
    if n == 0 { ffi_invoke! binding (rev_onto got []) }
    else { fn x -> ffi_curried! binding (n - 1) (x :: got) };

let ffi_bind_in! lib label symbol args ret = {
    if type_of symbol != :string || symbol == "" { ffi_fail "a foreign function needs a name" }
    else {
        let types = ffi_parse_all args lib;
        let result = ffi_parse ret lib :ret;
        let f = native.ffi_dlsym lib symbol;
        if f == 0 { ffi_fail (concat_list ["cannot find `", symbol, "` in ", label]) }
        else {
            let binding = [f, symbol, types, result];
            let visible = ffi_needed types;
            if visible == 0 { fn u -> ffi_invoke! binding [] }
            else { ffi_curried! binding visible [] }
        }
    }
};

let ffi_parse_all args lib = match as_items args {
    () => ffi_fail "the argument types must be a list",
    items => if length_from items 0 > 16 { ffi_fail "more than 16 arguments" } else { ffi_parse_items items lib },
};

let ffi_parse_items items lib = match items {
    [] => [],
    [t, ..rest] => ffi_parse t lib :arg :: ffi_parse_items rest lib,
};

let ffi_function! lib symbol args ret = {
    let [h, where] = ffi_library lib;
    ffi_bind_in! h where symbol args ret
};
let ffi_pure_function! lib symbol args ret = ffi_function! lib symbol args ret;

let ffi_call! f args = match as_items args {
    () => ffi_fail "call!'s arguments must be a list",
    [] => f (),
    items => ffi_apply_all f items,
};
let ffi_apply_all f items = match items {
    [x] => f x,
    [x, ..rest] => ffi_apply_all (f x) rest,
};

// The older interface, by number: a number here is the library's own handle.
let ffi_open! lib = (ffi_library lib).[0];
let ffi_close! h = ();
let ffi_bind! h symbol args ret = ffi_bind_in! h "the library" symbol args ret;
let ffi_load! lib symbol args ret = ffi_function! lib symbol args ret;
let ffi_alloc! n = native.ffi_malloc n;
let ffi_free! a = native.ffi_raw_free a;
let ffi_read_cstr! a = native.ffi_read_text a;
let ffi_read_u8! a i = native.ffi_peek_at 6 (a + i);
let ffi_write_u8! a i v = native.ffi_store_at 6 (a + i) v;
