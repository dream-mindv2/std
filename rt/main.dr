// The runtime of a native program, below the language: memory, collection and how
// a value is entered and applied. It is written in the dialect of
// dreams/src/aot/dialect.dr, so a value here is one raw machine word, nothing is
// lazy, and nothing allocates except by asking `alloc!`. dreams/docs/aot.md is the
// design, and none of it is shared with the VM's.
//
// A word is a Dream value by its low bits: `..1` a fixnum, `..010` an immediate,
// `..000` the address of an object. An object starts with the address of its
// info, static data the compiler writes:
//
//     0  code   what entering the object runs
//     8  kind   the numbers below
//    16  size   words of payload, or 0 where the object says for itself
//    24  arity  for a closure
//    32  call   a closure's function: `code` is what entering it does, which for any
//               value is only to answer itself, and applying one is another matter
//
// A frame on a process's stack starts with an info too, whose size is the whole
// frame in words, or 0 when its second word holds that, tagged. Every other word
// of a frame or a payload is a value, so the collector need know nothing about
// what any of them is for. The exceptions are the kinds with raw payloads, and an
// address in static data, which the collector leaves alone: a code address among
// a frame's words is one of those.
//
// Machine functions all take `(p, sp, a, b, c, d)`, in registers, so that a
// `musttail` never has to grow a stack-argument area.

import rt.prim;

// --- the context --------------------------------------------------------------

let ctx_hp = 0;
let ctx_limit = 8;
// The word every function entry compares its stack pointer with. Asking a process to
// stop for anything, a collection above all, is setting it above every address, so
// that one compare is the whole of what a function pays for all of them.
let ctx_guard = 16;
let ctx_retry = 24;
let ctx_retry_stack = 32;
let ctx_stack_top = 40;
let ctx_chunks = 48;
let ctx_to = 56;
let ctx_total = 64;
let ctx_error = 72;
let ctx_scratch = 80;
let ctx_scratch2 = 88;
let ctx_want_gc = 96;
let ctx_floor = 104;
let ctx_current = 112;
let ctx_current_id = 120;
let ctx_run_head = 152;
let ctx_run_tail = 160;
let ctx_collections = 240;
let ctx_ffi_sp = 272;
let ctx_in_callback = 280;
let ctx_cb_error = 288;
let ctx_cb_text = 296;
let ctx_spare = 312;
let ctx_poll_tick = 344;
// The copy between heaps in progress (`copy_out!`): where it writes, its segments, and the
// objects it has marked in the heap it reads, to be put back.
let ctx_xc_to = 368;
let ctx_xc_limit = 376;
let ctx_xc_mode = 384;
let ctx_xc_first = 392;
let ctx_xc_last = 400;
let ctx_xc_bytes = 408;
let ctx_xc_log = 416;
let ctx_xc_log_n = 424;
let ctx_xc_log_cap = 432;
/// Small chunks by size, one free list for each power of two (`chunk_get!`).
let ctx_classes = 440;
/// Memory of the runtime's own for what runs between processes, which has no heap to use.
let ctx_timebuf = 448;
let ctx_pollbuf = 456;
let ctx_pollbuf_cap = 464;
// This worker's run queue's lock and length, and its place among the workers.
let ctx_run_lock = 472;
let ctx_run_count = 480;
let ctx_index = 488;
/// Whether this worker holds the scheduler's lock, which a push made under it must not take again.
let ctx_sched_held = 496;
/// Stacks of the first size that processes run here have finished with, to start new ones on.
let ctx_stacks = 504;
let ctx_stack_count = 512;
/// Small cells of raw memory -- a waiting message, a joiner's id -- freed here, to be used again.
let ctx_cells = 520;
/// The census's work: shared objects marked and not yet traced, the context it collects a parked
/// process in, whether that context holds the process's record, and whether this collection reports.
let ctx_marks = 528;
let ctx_marks_n = 536;
let ctx_marks_cap = 544;
let ctx_census_ctx = 552;
let ctx_holds_pcb = 560;
let ctx_reporting = 568;
/// Receives that went on without parking since this worker last scheduled (`fair_turn!`).
let ctx_quick = 576;
/// Where cells are carved from next, and where that slab ends (`cell_get!`).
let ctx_cell_cursor = 584;
let ctx_cell_end = 592;
/// For each kind of promotion, the block this context's go on filling, where, and the sweep it
/// was kept under: one after it may have freed it (`copy_out!`).
let ctx_shared_cur = 600;
let ctx_short_cur = 624;
/// Whether this worker is running a process on the process's own stack, and where the
/// scheduler's own stack stood when it switched to it (`dispatch!`).
let ctx_on_process = 648;
let ctx_sched_sp = 656;
/// Native stacks finished processes gave back here, kept for new ones, and how many.
let ctx_nstacks = 664;
let ctx_nstack_count = 672;
/// The chunks a collection in progress keeps where they are, because a word on a stack points
/// into them (`pin_range!`).
let ctx_pinned = 680;
let ctx_size = 688;

let kind_thunk = 0;
let kind_ind = 1;
let kind_hole = 2;
let kind_closure = 3;
let kind_pap = 4;
let kind_cons = 5;
let kind_float = 6;
let kind_string = 7;
let kind_array = 8;
let kind_record = 9;
let kind_map = 10;
let kind_leaf = 11;
let kind_big = 12;
let kind_error = 13;
let kind_process = 14;
let kind_trunk = 15;
let kind_tensor = 16;
let kind_module = 17;

// What a frame is, in its info's kind: nothing the unwinder need notice, or one of these.
let frame_catch = 20;
let frame_thunk = 21;
let frame_halt = 22;
let frame_cleanup = 23;
let frame_shared = 24;

let info_code = 0;
let info_kind = 8;
let info_size = 16;
let info_arity = 24;
let info_call = 32;
let info_name = 40;
let info_impure = 48;
let info_place = 56;

let word = 8;
/// Everything below this is the executable; the heap and stacks are `mmap`ed far
/// above it. What is static is not the collector's, and neither is the shared region,
/// which starts here and grows upwards (`shared_more!`), so that one compare with its
/// end says an address is no process's to move.
let static_limit = 4294967296;
/// A chunk is `[next, size, end, 0]`, then objects, as a segment is: `end` is where they stop
/// once allocation has gone on elsewhere (`new_chunk!`), so that a chunk can be walked object by
/// object, which a pinned one is (`scan_pinned!`).
let chunk_header = 32;
let min_chunk = 8388608;
/// A process's first allocation area. It doubles at each collection up to `max_budget`, so one
/// that does little costs little, and the chunks of one that does a lot stay small enough to come
/// from the free lists: at `min_chunk`, as the first process has, two hundred busy connections each
/// mapped and unmapped a to-space at every collection, and faulted in every page of it again. A
/// process with more live data than that still gets chunks to fit it (`new_chunk!`), and one with a
/// deep stack a budget to match it (`collect!`).
let first_budget = 4096;
let max_budget = 65536;
let stack_bytes = 268435456;
/// A process's first stack. A new process uses a few hundred bytes of it, and it doubles when it
/// needs more (`move_stack!`); at 32 KB, each process's first page was a fault of its own, and
/// starting 50,000 of them was a hundred milliseconds of the kernel's.
let first_stack = 2048;
let stack_margin = 1048576;

let tag_fix !n = n * 2 + 1;
let untag_fix !v = v >> 1;

let is_object !v = v & 7 == 0 && v != 0;

let map_memory! !bytes = {
    let at = prim.c6! "mmap" 0 bytes 3 16418 (0 - 1) 0;
    if at == 0 - 1 { fatal! "dream: out of memory\n" } else { at }
};

let fatal! s = {
    prim.c3! "write" 2 s (prim.str_len s);
    prim.c1! "exit" 70
};

// --- allocation ----------------------------------------------------------------
//
// Every process has a heap of its own, which only it allocates in and only it collects:
// a list of chunks, the one being allocated in at its end. The context holds the running
// process's, and `save_heap!` and `load_heap!` move it to and from the process's record
// when another runs. A collection is therefore of one stack and one heap, however many
// processes there are, and nothing else is stopped for it. What crosses between heaps is
// copied (`copy_out!`), apart from what is static or in the shared region.

/// A power of two, so that what one collection frees fits what the next one asks for.
let round_chunk! !want !size = if size >= want { size } else { round_chunk! want (size * 2) };

// A chunk of a megabyte or less comes from a free list of its size, carved from slabs of two
// megabytes. A program of a hundred thousand processes has a hundred thousand small heaps, and a
// system call for each was the cost of starting one. Anything larger is mapped, and the largest
// few that are freed are kept, since a page the program has touched costs no fault, and faults
// were a tenth of a run that allocates.

let small_chunk = 512;
let small_class_count = 12;
let slab_bytes = 2097152;

let class_of !size !c = if size <= small_chunk { c } else { class_of (size / 2) (c + 1) };

/// A class's state: `[free list, cursor, end]`, the cursor walking the slab it carves from.
let class_words = 3;

let class_head! !p !size = prim.load64! (p + ctx_classes) + class_of size 0 * class_words * word;

// A slab is carved as it is used, one chunk at a time, not all at once: carving the whole of it
// wrote a link into every chunk and so touched all 512 of its pages, a fault each, before the
// first one was handed out. A worker new to a size paid a millisecond or two for that, in the
// middle of whatever it was doing.
let chunk_get! !p !size =
    if size > slab_bytes / 2 { take_chunk! p size }
    else {
        let head = class_head! p size;
        let csize = small_chunk << class_of size 0;
        let c = prim.load64! head;
        if c != 0 {
            prim.store64! head (prim.load64! c);
            c
        } else {
            if prim.load64! (head + word) + csize > prim.load64! (head + 2 * word) {
                let slab = map_memory! slab_bytes;
                prim.store64! (head + word) slab;
                prim.store64! (head + 2 * word) (slab + slab_bytes);
            };
            let fresh_ = prim.load64! (head + word);
            prim.store64! (head + word) (fresh_ + csize);
            prim.store64! (fresh_ + word) csize;
            fresh_
        }
    };

let chunk_put! !p !c = {
    let size = prim.load64! (c + word);
    if size > slab_bytes / 2 { spare_put! p c }
    else {
        let head = class_head! p size;
        prim.store64! c (prim.load64! head);
        prim.store64! head c;
        0
    }
};

let take_chunk! !p !size = {
    let c = spare_fit! (p + ctx_spare) (prim.load64! (p + ctx_spare)) size;
    if c != 0 { c } else { map_memory! size }
};

let spare_fit! !link !c !size =
    if c == 0 { 0 }
    else if prim.load64! (c + word) >= size {
        prim.store64! link (prim.load64! c);
        c
    } else { spare_fit! c (prim.load64! c) size };

let spare_put! !p !c = {
    if prim.load64! (c + word) <= 128 * min_chunk && spare_count! (prim.load64! (p + ctx_spare)) 0 < 4 {
        prim.store64! c (prim.load64! (p + ctx_spare));
        prim.store64! (p + ctx_spare) c;
    } else {
        prim.c2! "munmap" c (prim.load64! (c + word));
    };
    0
};

/// A chunk of at least `bytes`, made the place allocation continues. Nothing moves
/// here, which is what lets a compiled function hold values in registers across an
/// allocation: running out only asks for a collection at the next function entry.
let new_chunk! !p !bytes = {
    let want = bytes + chunk_header;
    let size = round_chunk! want (prim.load64! (current! p + pcb_budget));
    ended_at! (prim.load64! (p + ctx_chunks)) (prim.load64! (p + ctx_hp));
    let chunk = chunk_get! p size;
    prim.store64! chunk (prim.load64! (p + ctx_chunks));
    prim.store64! (chunk + word) size;
    prim.store64! (chunk + 2 * word) 0;
    prim.store64! (p + ctx_chunks) chunk;
    prim.store64! (p + ctx_total) (prim.load64! (p + ctx_total) + size);
    prim.store64! (p + ctx_hp) (chunk + chunk_header);
    prim.store64! (p + ctx_limit) (chunk + size);
    chunk
};

/// Where allocation stopped, `hp`, written as the end of the chunk of `c`'s list it is in.
let ended_at! !c !hp = if c == 0 { 0 }
    else if prim.ult c hp && prim.ule hp (c + prim.load64! (c + word)) { prim.store64! (c + 2 * word) hp; 0 }
    else { ended_at! (prim.load64! c) hp };

/// The slow path of a compiled allocation, and every allocation made here.
let more! !p !bytes = {
    prim.store64! (p + ctx_want_gc) 1;
    if prim.load64! (p + ctx_in_callback) == 0 { prim.store64! (p + ctx_guard) (0 - 1); };
    new_chunk! p bytes;
    alloc! p bytes
};

/// Every allocation is whole words, whatever was asked for, because the low bits of an
/// object's address are what say it is one.
let alloc! !p !asked = {
    let bytes = (asked + 7) & (0 - 8);
    let at = prim.load64! (p + ctx_hp);
    let next = at + bytes;
    if prim.ugt next (prim.load64! (p + ctx_limit)) { more! p bytes }
    else {
        prim.store64! (p + ctx_hp) next;
        at
    }
};

/// The running process's heap, from the context to its record and back.
let save_heap! !p !pcb = {
    prim.store64! (pcb + pcb_hp) (prim.load64! (p + ctx_hp));
    prim.store64! (pcb + pcb_limit) (prim.load64! (p + ctx_limit));
    prim.store64! (pcb + pcb_chunks) (prim.load64! (p + ctx_chunks));
    prim.store64! (pcb + pcb_total) (prim.load64! (p + ctx_total));
    prim.store64! (pcb + pcb_want_gc) (prim.load64! (p + ctx_want_gc));
    0
};

let load_heap! !p !pcb = {
    prim.store64! (p + ctx_hp) (prim.load64! (pcb + pcb_hp));
    prim.store64! (p + ctx_limit) (prim.load64! (pcb + pcb_limit));
    prim.store64! (p + ctx_chunks) (prim.load64! (pcb + pcb_chunks));
    prim.store64! (p + ctx_total) (prim.load64! (pcb + pcb_total));
    prim.store64! (p + ctx_want_gc) (prim.load64! (pcb + pcb_want_gc));
    // A collection it asked for before it last stopped is still owed.
    if prim.load64! (pcb + pcb_want_gc) != 0 { prim.store64! (p + ctx_guard) (0 - 1); };
    0
};

/// The heap of a process that has ended, all of it at once. Nothing can reach into it:
/// what it answered was promoted to the shared region first.
let free_heap! !p = {
    free_chunks! p (prim.load64! (p + ctx_chunks));
    prim.store64! (p + ctx_chunks) 0;
    prim.store64! (p + ctx_total) 0;
    prim.store64! (p + ctx_hp) 0;
    prim.store64! (p + ctx_limit) 0;
    prim.store64! (p + ctx_want_gc) 0;
    0
};

/// Room for what the runtime does between processes, where there is no heap to allocate in.
let poll_buffer! !p !bytes = {
    if bytes > prim.load64! (p + ctx_pollbuf_cap) {
        let cap = round_chunk! bytes 256;
        prim.store64! (p + ctx_pollbuf) (prim.c2! "realloc" (prim.load64! (p + ctx_pollbuf)) cap);
        prim.store64! (p + ctx_pollbuf_cap) cap;
    };
    prim.load64! (p + ctx_pollbuf)
};

// --- the shared region ---------------------------------------------------------------
//
// What every process may read by reference: the value of a CAF, what a process answered, a kill's
// reason, a callback's function. It is mapped at a fixed address above the executable and grows
// upwards, so that it is one range and the collector's test of an address is one compare against
// its end. Nothing in it points into a process's heap, which is what lets a collection leave it
// alone. The world block (`prim.info "world"`) is the state no one process owns.
//
// It is made of blocks of a megabyte, filled as a message fills segments, a large object taking a
// run of them. A census (below) finds which blocks anything still reaches; one nothing does is
// given back to the system and used again, and so the range stays one range.

let w_shared_top = 0;
let w_shared_hp = 8;
// What was every process's on one thread, and is still: the table of processes, the handles,
// the program's arguments, what has been opened, and who is waiting for the system.
let w_table = 16;
let w_table_cap = 24;
let w_next_id = 32;
let w_live = 40;
let w_unique = 48;
let w_ticking = 56;
let w_handles = 64;
let w_handle_cap = 72;
let w_handle_count = 80;
let w_argc = 88;
let w_argv = 96;
let w_k512 = 104;
let w_ssl = 112;
/// The foreign handles' table, its live list's ends (see "the table of foreign handles").
let w_foreign = 120;
let w_foreign_next = 128;
let w_opened = 136;
let w_wait_ids = 144;
let w_wait_count = 152;
let w_wait_cap = 160;
let w_ptys = 168;
// The scheduler's: its lock and condition, who is asleep and who is polling, and the workers.
let w_sched_lock = 176;
let w_cond = 184;
let w_idle = 192;
let w_started = 200;
let w_wanted = 208;
let w_worker_ctx = 216;
let w_polling = 224;
let w_wakefd = 232;
let w_earliest = 240;
/// What promoting into the shared region, and waiting on a shared thunk, take.
let w_shared_lock = 248;
/// Everything else every process shares: opened libraries, terminals, the foreign table.
let w_lock = 256;
/// Which worker a thread is, for a callback from C.
let w_cb_key = 264;
let w_spinning = 272;
/// The `epoll` descriptor, the table of descriptors' waiters, and how many processes wait on one.
let w_epfd = 280;
let w_fds = 288;
let w_fd_waiting = 296;
/// The blocking pool's jobs, its lock and condition, and how many threads it has.
let w_pool_lock = 304;
let w_pool_cond = 312;
let w_pool_head = 320;
let w_pool_tail = 328;
let w_pool_started = 336;
/// Jobs handed to the pool and not finished: while there are any, nothing is deadlocked.
let w_pool_pending = 344;
let w_foreign_head = 352;
let w_foreign_tail = 360;
/// The shared region's blocks, those free, and where promotion writes now (see "the census").
let w_blocks = 368;
let w_free_blocks = 376;
let w_free_n = 384;
let w_epoch = 392;
let w_census = 400;
let w_census_lock = 408;
let w_census_waiting = 416;
let w_pids_seen = 424;
let w_shared_since = 432;
let w_finished_since = 440;
let w_shared_live = 448;
let w_cb_roots = 456;
let w_shared_cur = 464;
/// `DREAM_CENSUS_TRACE` set: each round said on standard error.
let w_census_trace = 472;
let w_short_cur = 480;
let w_short_hp = 488;
/// A callback was called from a thread that may not run it (`cb_enter!`).
let w_cb_refused = 496;
// The atoms made while the program runs (`vm_intern_atom!`), after the ones it was compiled with:
// a table of their names mapped at its largest and touched as it fills, as the handle table is,
// so that a reader on another worker never sees it move, and how many it holds.
let w_atoms_more = 504;
let w_atoms_more_n = 512;
// For a record whose declaration the compiler did not see -- dre makes records of the types of the
// image it runs -- what `atom_display` and `atom_types` say of the others: how it is written and
// what `type_of` calls it, by its atom, worked out from the atom's name when the first is made.
let w_atoms_shown = 520;
let w_atoms_type = 528;
/// The processes there were when the census round going now began: only those can be reaped by it.
let w_census_n = 536;
/// Promotions under way: copies into the shared region not yet finished, which a sweep waits for.
let w_promoting = 544;
/// A sweep waiting for them, which no promotion starts behind.
let w_sweep_wanted = 552;
/// Sweeps so far: a block a context kept from before the last one may be gone.
let w_sweeps = 560;
/// How much address space a process's native stack is reserved with: 0 until the first.
let w_stack_reserved = 568;
/// `DREAM_TIMELINE`'s file, plus one, or 0; and when the run began.
let w_timeline = 576;
let w_timeline_t0 = 584;
/// 1 when a collection reads the process's own frames for pins too, as it reads a native stack:
/// `DREAM_GC_PIN_TEST`, which tries the pinning where code that jumps never needs it.
let w_pin_test = 592;

let world_at! !field = prim.info "world" + field;

/// The end of what is not any process's to move: the static data, then the shared region.
let not_heap_limit! () = prim.load64! (world_at! w_shared_top);

let is_heap_object! !v = is_object v && prim.uge v (not_heap_limit! ());

let shared_block = 1048576;
let max_blocks = 16384;
/// A block's entry: `[state, epoch, marks, marked, head, mode]`, the mode the promotion that
/// took it was in (`xc_shared` or `xc_short`).
let block_words = 6;
let block_unused = 0;
let block_used = 1;
let block_free = 2;
let block_tail = 3;

let block_entry! !i = prim.load64! (world_at! w_blocks) + i * block_words * word;
let block_index !v = (v - static_limit) / shared_block;
let block_at !i = static_limit + i * shared_block;

/// The region made larger by `bytes`, directly after where it ends.
let shared_more! !bytes = {
    let top = prim.load64! (world_at! w_shared_top);
    // MAP_FIXED_NOREPLACE: a mapping already there is an answer of another address, not lost data.
    let at = prim.c6! "mmap" top bytes 3 1065010 (0 - 1) 0;
    if at != top || block_index (top + bytes) > max_blocks { fatal! "dream: the shared region cannot grow\n" } else {
        prim.store64! (world_at! w_shared_top) (top + bytes);
        top
    }
};

let shared_init! () = {
    prim.store64! (world_at! w_shared_top) static_limit;
    prim.store64! (world_at! w_blocks) (prim.c2! "calloc" (max_blocks * block_words) word);
    prim.store64! (world_at! w_free_blocks) (prim.c2! "calloc" max_blocks word);
    0
};

/// A block, or a run of `n` of them for an object that needs it, with the shared lock held:
/// one freed before if a single will do, and otherwise more of the region.
let take_blocks! !n !mode = {
    let free_n = prim.load64! (world_at! w_free_n);
    let at = if n == 1 && free_n > 0 {
        prim.store64! (world_at! w_free_n) (free_n - 1);
        block_at (prim.load64! (prim.load64! (world_at! w_free_blocks) + (free_n - 1) * word))
    } else { shared_more! (n * shared_block) };
    let head = block_index at;
    mark_run! head 0 n;
    prim.store64! (block_entry! head + 5 * word) mode;
    prim.store64! at 0;
    prim.store64! (at + word) (n * shared_block);
    prim.store64! (at + 2 * word) 0;
    prim.store64! (at + 3 * word) 0;
    at
};

let mark_run! !head !i !n = if i >= n { 0 } else {
    let e = block_entry! (head + i);
    prim.store64! e (if i == 0 { block_used } else { block_tail });
    prim.store64! (e + word) (prim.load64! (world_at! w_epoch));
    prim.store64! (e + 3 * word) 0;
    prim.store64! (e + 4 * word) head;
    mark_run! head (i + 1) n
};

/// What a promotion writes into is new in this epoch, and no census of it frees it.
let touch_block! !at = if at == 0 { 0 } else {
    let head = prim.load64! (block_entry! (block_index at) + 4 * word);
    prim.store64! (block_entry! head + word) (prim.load64! (world_at! w_epoch));
    0
};

// --- copying between heaps ----------------------------------------------------------
//
// A value another process will read is copied, once, by the process that has it: a message, a
// new process's work, and into the shared region what is promoted there. The copy is the
// collector's, a breadth-first walk with forwarding addresses, written into the objects it has
// copied and put back after from a log, since the heap it reads goes on being used. What it
// writes is a list of segments the receiver takes into its own heap as chunks, with no second
// copy, or, promoting, the shared region. Sharing and cycles survive, and what is static or
// already shared is not copied.
//
// A suspension travels as itself, and is evaluated again by whoever receives it, as on the VM. A
// thunk being evaluated cannot travel, since its work is on its own process's stack, and arrives
// as an error, as on the VM. Promoted, a suspension becomes a shared thunk (`code_shared!`).

let xc_message = 0;
let xc_shared = 1;
/// Into the shared region too, but into blocks of their own: what a process answered and a kill's
/// reason, which go with their process. Mixed with what lives for the run -- a CAF's list, forced a
/// cell at a time between answers -- one live cell kept every block it was in (see "the census").
let xc_short = 2;
/// A segment: `[next, size, end, 0]`, then objects. Taken into a heap, it is a chunk like any
/// other, as a chunk's header is its first two words.
let seg_header = 32;
let first_segment = 512;

let xc_more! !p !bytes =
    if prim.load64! (p + ctx_xc_mode) != xc_message {
        let need = bytes + seg_header;
        let l = prim.load64! (world_at! w_shared_lock);
        lock! l;
        let blk = take_blocks! ((need + shared_block - 1) / shared_block) (prim.load64! (p + ctx_xc_mode));
        unlock! l;
        let last = prim.load64! (p + ctx_xc_last);
        prim.store64! (last + 2 * word) (prim.load64! (p + ctx_xc_to));
        prim.store64! last blk;
        prim.store64! (p + ctx_xc_last) blk;
        prim.store64! (p + ctx_xc_bytes) (prim.load64! (p + ctx_xc_bytes) + prim.load64! (blk + word));
        prim.store64! (p + ctx_xc_to) (blk + seg_header);
        prim.store64! (p + ctx_xc_limit) (blk + prim.load64! (blk + word));
        0
    } else {
        let last = prim.load64! (p + ctx_xc_last);
        let size = round_chunk! (bytes + seg_header) (if last == 0 { first_segment } else { prim.load64! (last + word) * 2 });
        let seg = chunk_get! p size;
        prim.store64! seg 0;
        prim.store64! (seg + word) size;
        prim.store64! (seg + 2 * word) 0;
        if last == 0 { prim.store64! (p + ctx_xc_first) seg; }
        else {
            prim.store64! (last + 2 * word) (prim.load64! (p + ctx_xc_to));
            prim.store64! last seg;
        };
        prim.store64! (p + ctx_xc_last) seg;
        prim.store64! (p + ctx_xc_bytes) (prim.load64! (p + ctx_xc_bytes) + size);
        prim.store64! (p + ctx_xc_to) (seg + seg_header);
        prim.store64! (p + ctx_xc_limit) (seg + size);
        0
    };

let xc_alloc! !p !bytes = {
    let at = prim.load64! (p + ctx_xc_to);
    if prim.ugt (at + bytes) (prim.load64! (p + ctx_xc_limit)) {
        xc_more! p bytes;
        xc_alloc! p bytes
    } else {
        prim.store64! (p + ctx_xc_to) (at + bytes);
        at
    }
};

/// `v` marked as copied to `to`, and noted so that it can be put back.
let xc_forward! !p !v !info !to = {
    let n = prim.load64! (p + ctx_xc_log_n);
    if n >= prim.load64! (p + ctx_xc_log_cap) {
        let cap = if n == 0 { 256 } else { n * 2 };
        prim.store64! (p + ctx_xc_log) (prim.c2! "realloc" (prim.load64! (p + ctx_xc_log)) (cap * 2 * word));
        prim.store64! (p + ctx_xc_log_cap) cap;
    };
    let at = prim.load64! (p + ctx_xc_log) + n * 2 * word;
    prim.store64! at v;
    prim.store64! (at + word) info;
    prim.store64! (p + ctx_xc_log_n) (n + 1);
    prim.store64! v (to + 1);
    to
};

let xc_restore! !log !i !n = if i >= n { 0 } else {
    let at = log + i * 2 * word;
    prim.store64! (prim.load64! at) (prim.load64! (at + word));
    xc_restore! log (i + 1) n
};

let xc_copy_object! !p !v !info = {
    let n = object_words! v info;
    let to = xc_alloc! p (n * word);
    copy_words! v to n;
    xc_forward! p v info to
};

let xc_evac! !p !v =
    if not (is_object v) { v }
    else if prim.ult v (not_heap_limit! ()) {
        // Left in place: during a census, marked, as this copy may be what moves it past one.
        if census_on! () { census_mark! p v; };
        v
    }
    else {
        let info = prim.load64! v;
        if info & 1 == 1 { info - 1 }
        else {
            let kind = prim.load64! (info + info_kind);
            if kind == kind_process && census_on! () { census_pid! (untag_fix (prim.load64! (v + word))); };
            if kind == kind_ind { xc_evac! p (prim.load64! (v + word)) }
            else if kind == kind_hole {
                let e = xc_alloc! p (4 * word);
                prim.store64! e (prim.info "error");
                prim.store64! (e + word) (atom_word 0);
                prim.store64! (e + 2 * word) unit_word;
                prim.store64! (e + 3 * word) unit_word;
                xc_forward! p v info e
            }
            else if kind == kind_thunk && prim.load64! (p + ctx_xc_mode) != xc_message {
                // The suspension itself, as data, and the shared thunk that stands for it.
                let n = object_words! v info;
                let t = xc_alloc! p (n * word);
                copy_words! v t n;
                let s = xc_alloc! p (4 * word);
                prim.store64! s (prim.info "shared");
                prim.store64! (s + word) t;
                prim.store64! (s + 2 * word) 0;
                prim.store64! (s + 3 * word) 0;
                xc_forward! p v info s
            }
            else { xc_copy_object! p v info }
        }
    };

let xc_evac_range! !p !at !stop = if prim.uge at stop { 0 } else {
    prim.store64! at (xc_evac! p (prim.load64! at));
    xc_evac_range! p (at + word) stop
};

let has_values !kind = kind != kind_float && kind != kind_string && kind != kind_hole && kind != kind_big && kind != kind_tensor;

/// One object copied: its values copied in turn. Answers its size in bytes.
let xc_scan_one! !p !at = {
    let info = prim.load64! at;
    let n = object_words! at info;
    if has_values (prim.load64! (info + info_kind)) { xc_evac_range! p (at + word) (at + n * word); };
    n * word
};

let xc_scan_segments! !p !seg !at = {
    let last = prim.load64! (p + ctx_xc_last);
    let stop = if seg == last { prim.load64! (p + ctx_xc_to) } else { prim.load64! (seg + 2 * word) };
    if prim.ult at stop { xc_scan_segments! p seg (at + xc_scan_one! p at) }
    else if seg == last { 0 }
    else {
        let next = prim.load64! seg;
        xc_scan_segments! p next (next + seg_header)
    }
};

/// `v` copied out of the running process's heap: into segments of its own, which
/// `ctx_xc_first` and `ctx_xc_bytes` then name (0 when nothing needed copying), or into
/// the shared region.
let copy_out! !p !v !mode =
    if not (is_heap_object! v) {
        prim.store64! (p + ctx_xc_first) 0;
        prim.store64! (p + ctx_xc_bytes) 0;
        // A shared value handed on as itself moves a reference as much as a copy does.
        if census_on! () { census_mark! p v; mark_drain! p; };
        v
    } else {
        prim.store64! (p + ctx_xc_mode) mode;
        prim.store64! (p + ctx_xc_first) 0;
        prim.store64! (p + ctx_xc_last) 0;
        prim.store64! (p + ctx_xc_bytes) 0;
        prim.store64! (p + ctx_xc_log_n) 0;
        let cur_at = world_at! (if mode == xc_short { w_short_cur } else { w_shared_cur });
        let hp_at = world_at! (if mode == xc_short { w_short_hp } else { w_shared_hp });
        if mode != xc_message {
            // Into the block this context's promotions are filling, its own and new in this epoch
            // now, or if it has none from since the last sweep, a block of the region's.
            let l = prim.load64! (world_at! w_shared_lock);
            lock_to_promote! l;
            prim.store64! (world_at! w_promoting) (prim.load64! (world_at! w_promoting) + 1);
            let mine = p + (if mode == xc_short { ctx_short_cur } else { ctx_shared_cur });
            let own = if prim.load64! (mine + 2 * word) == prim.load64! (world_at! w_sweeps) { prim.load64! mine } else { 0 };
            let had = if own != 0 { 0 } else { prim.load64! cur_at };
            let cur = if own != 0 { own } else if had == 0 { take_blocks! 1 mode } else { had };
            let from = if own != 0 { prim.load64! (mine + word) } else if had == 0 { cur + seg_header } else { prim.load64! hp_at };
            if own == 0 && had != 0 { prim.store64! cur_at 0; };
            prim.store64! mine 0;
            touch_block! cur;
            unlock! l;
            prim.store64! (p + ctx_xc_first) cur;
            prim.store64! (p + ctx_xc_last) cur;
            prim.store64! (p + ctx_xc_to) from;
            prim.store64! (p + ctx_xc_limit) (cur + prim.load64! (cur + word));
        } else {
            prim.store64! (p + ctx_xc_to) 0;
            prim.store64! (p + ctx_xc_limit) 0;
        };
        let start = prim.load64! (p + ctx_xc_to);
        let out = xc_evac! p v;
        if mode != xc_message {
            xc_scan_segments! p (prim.load64! (p + ctx_xc_first)) start;
            let last = prim.load64! (p + ctx_xc_last);
            prim.store64! (last + 2 * word) (prim.load64! (p + ctx_xc_to));
            let l = prim.load64! (world_at! w_shared_lock);
            lock! l;
            // Kept for this context's next promotion to go on filling.
            let mine = p + (if mode == xc_short { ctx_short_cur } else { ctx_shared_cur });
            prim.store64! mine last;
            prim.store64! (mine + word) (prim.load64! (p + ctx_xc_to));
            prim.store64! (mine + 2 * word) (prim.load64! (world_at! w_sweeps));
            prim.store64! (world_at! w_shared_since) (prim.load64! (world_at! w_shared_since) + prim.load64! (p + ctx_xc_bytes));
            prim.store64! (world_at! w_promoting) (prim.load64! (world_at! w_promoting) - 1);
            unlock! l;
            prim.store64! (p + ctx_xc_first) 0;
            prim.store64! (p + ctx_xc_bytes) 0;
        } else {
            let first = prim.load64! (p + ctx_xc_first);
            xc_scan_segments! p first (first + seg_header);
            prim.store64! (prim.load64! (p + ctx_xc_last) + 2 * word) (prim.load64! (p + ctx_xc_to));
        };
        xc_restore! (prim.load64! (p + ctx_xc_log)) 0 (prim.load64! (p + ctx_xc_log_n));
        if census_on! () { mark_drain! p; };
        out
    };

/// `v` where every process may read it, for as long as anything does. Promotions copy at once,
/// each into blocks of its own (`copy_out!`): one at a time, a part of a compile answering a large
/// value held every other process's answer behind it, and a compile ran on one core.
let promote! !p !v = promote_as! p v xc_shared;

/// The promotion mode of the block holding `s`; anything static -- a CAF -- lives for the run.
let shared_mode_of! !s = if prim.ult s static_limit { xc_shared } else {
    let e = block_entry! (block_index s);
    prim.load64! (block_entry! (prim.load64! (e + 4 * word)) + 5 * word)
};

/// `v` promoted with what goes when its process does: an answer, a kill's reason.
let promote_short! !p !v = promote_as! p v xc_short;

let promote_as! !p !v !mode = if not (is_heap_object! v) { v } else {
    let out = copy_out! p v mode;
    census_maybe! p;
    out
};

/// Segments copied out for another heap, taken into the running process's as chunks.
let adopt_segments! !p !first !bytes = if first == 0 { 0 } else {
    adopt_link! p first;
    prim.store64! (p + ctx_chunks) first;
    prim.store64! (p + ctx_total) (prim.load64! (p + ctx_total) + bytes);
    0
};

let adopt_link! !p !seg = if prim.load64! seg == 0 { prim.store64! seg (prim.load64! (p + ctx_chunks)); 0 }
    else { adopt_link! p (prim.load64! seg) };

/// Segments nobody took, a message to a process that ended.
let free_segments! !p !seg = if seg == 0 { 0 } else {
    let next = prim.load64! seg;
    chunk_put! p seg;
    free_segments! p next
};

// --- the census --------------------------------------------------------------------------
//
// Which shared blocks are still reached, and which finished processes still are, found without
// stopping anything: each process says what it reaches at a collection of its own. A round
// begins when the region has grown past a threshold, or many processes have finished since the
// last; every live process is then due to report. One that is running reports at its next
// collection, which its next function entry is asked for; one that is parked is collected on its
// behalf, by whoever began the round, holding its record so that nothing can wake it meanwhile.
// A report marks every shared object the collection meets, traced through the region, and every
// process id it finds a pid object of. The last report marks what no heap holds: answers, kill
// reasons, CAFs, foreign handles, callbacks. Then a finished process whose pid nobody holds can be
// joined by nobody, and goes, record and answer (a failure nobody joined stays, for the report at
// the end); and a block nothing marked, and nothing wrote to since the round began, is free.
//
// A reference must not slip past the round by moving, while it runs, from a process yet to report
// into one that has. It moves only by being copied -- a message, a spawn, a promotion -- so a copy
// made during a round marks every shared object it leaves in place and every pid it carries.
// Reading a CAF or joining is reading a root, which the last report marks.

let census_min = 33554432;
let census_finished = 65536;

let census_on! () = prim.load64! (world_at! w_census) != 0;

/// The mark of a word in the region, set: answers whether it was not set before.
let census_mark! !p !v = if not (is_object v) || prim.ult v static_limit || prim.uge v (prim.load64! (world_at! w_shared_top)) { 0 } else {
    let e = block_entry! (block_index v);
    let bits0 = prim.load64! (e + 2 * word);
    let bits = if bits0 != 0 { bits0 } else {
        let fresh_ = prim.c2! "calloc" (shared_block / word / 8) 1;
        let old = prim.cas64! (e + 2 * word) 0 fresh_;
        if old == 0 { fresh_ } else { prim.c1! "free" fresh_; old }
    };
    let n = (v - block_at (block_index v)) / word;
    let at = bits + (n / 64) * word;
    let bit = 1 << (n & 63);
    if set_bit! at bit {
        prim.store64! (e + 3 * word) 1;
        mark_push! p v;
    };
    0
};

let set_bit! !at !bit = {
    let old = prim.load64! at;
    if old & bit != 0 { false }
    else if prim.cas64! at old (old | bit) == old { true }
    else { set_bit! at bit }
};

let mark_push! !p !v = {
    let n = prim.load64! (p + ctx_marks_n);
    if n >= prim.load64! (p + ctx_marks_cap) {
        let cap = if n == 0 { 1024 } else { n * 2 };
        prim.store64! (p + ctx_marks) (prim.c2! "realloc" (prim.load64! (p + ctx_marks)) (cap * word));
        prim.store64! (p + ctx_marks_cap) cap;
    };
    prim.store64! (prim.load64! (p + ctx_marks) + n * word) v;
    prim.store64! (p + ctx_marks_n) (n + 1);
    0
};

/// A process id met: someone may still join it.
let census_pid! !id = if id > 0 && id < table_cap {
    let at = prim.load64! (world_at! w_pids_seen) + (id / 64) * word;
    set_bit! at (1 << (id & 63));
    0
} else { 0 };

/// What is marked, traced: each object's values, and the ids of the pids among them.
let mark_drain! !p = {
    let n = prim.load64! (p + ctx_marks_n);
    if n == 0 { 0 } else {
        let v = prim.load64! (prim.load64! (p + ctx_marks) + (n - 1) * word);
        prim.store64! (p + ctx_marks_n) (n - 1);
        census_trace! p v;
        mark_drain! p
    }
};

let census_trace! !p !v = {
    let info = prim.load64! v;
    let kind = prim.load64! (info + info_kind);
    // A shared thunk claimed, or finished: its suspension or its value.
    if kind == kind_hole || kind == kind_ind { census_mark! p (prim.load64! (v + word)) }
    else {
        if kind == kind_process { census_pid! (untag_fix (prim.load64! (v + word))); };
        if has_values kind { census_range! p (v + word) (v + object_words! v info * word); };
        0
    }
};

let census_range! !p !at !stop = if prim.uge at stop { 0 } else {
    census_mark! p (prim.load64! at);
    census_range! p (at + word) stop
};

/// What a heap object holds that the census wants, as a collection or a copy meets it.
let census_heap_object! !p !v !info = {
    if prim.load64! (info + info_kind) == kind_process { census_pid! (untag_fix (prim.load64! (v + word))); };
    0
};

/// Objects laid end to end -- a message's segments -- read for what the census wants.
let census_objects! !p !at !stop = if prim.uge at stop { 0 } else {
    let info = prim.load64! at;
    let n = object_words! at info;
    let kind = prim.load64! (info + info_kind);
    if kind == kind_process { census_pid! (untag_fix (prim.load64! (at + word))); };
    if has_values kind { census_range! p (at + word) (at + n * word); };
    census_objects! p (at + n * word) stop
};

let census_segments! !p !seg = if seg == 0 { 0 } else {
    let stop = prim.load64! (seg + 2 * word);
    census_objects! p (seg + seg_header) (if stop == 0 { seg + prim.load64! (seg + word) } else { stop });
    census_segments! p (prim.load64! seg)
};

/// A round begun, if none is going and one is due.
let census_maybe! !p = if census_on! () { 0 } else {
    let grown = prim.load64! (world_at! w_shared_since);
    let finished = prim.load64! (world_at! w_finished_since);
    let threshold = if prim.load64! (world_at! w_shared_live) > census_min { prim.load64! (world_at! w_shared_live) } else { census_min };
    if grown > threshold || finished > census_finished { census_begin! p } else { 0 }
};

let census_begin! !p = {
    let l = prim.load64! (world_at! w_census_lock);
    lock! l;
    if census_on! () { unlock! l; 0 } else {
        let round = prim.load64! (world_at! w_epoch) + 1;
        prim.store64! (world_at! w_epoch) round;
        prim.store64! (world_at! w_shared_since) 0;
        prim.store64! (world_at! w_finished_since) 0;
        prim.c3! "memset" (prim.load64! (world_at! w_pids_seen)) 0 (table_cap / 8);
        // One more than there will be, held by this until it has asked them all, so that no report
        // can end the round while this is still counting.
        prim.store64! (world_at! w_census_waiting) 1;
        // On before the processes are counted, and fenced, so that one this does not count was
        // made after the round began: its work was copied with the round on, and the copy marked
        // every pid it carried (`spawn!` says the rest).
        prim.store_rel! (world_at! w_census) round;
        prim.fence! ();
        let n = prim.load64! (world_at! w_next_id);
        prim.store64! (world_at! w_census_n) n;
        due_all! p 1 n round;
        unlock! l;
        ask_all! p 1 n round;
        census_reported! p round
    }
};

/// Every process not finished, due to report. Its record held: a process finishes under the same
/// lock and then looks whether it was due (`census_gone!`), so either it is seen finished here or
/// it sees that it was due. Counted before it is due, since it may report the moment it is.
let due_all! !p !id !n !round = if id >= n { 0 } else {
    let pcb = table_at! p id;
    if pcb != 0 {
        pcb_lock! pcb;
        if prim.load64! (pcb + pcb_state) != state_done {
            prim.xadd64! (world_at! w_census_waiting) 1;
            prim.store64! (pcb + pcb_census_due) round;
        };
        pcb_unlock! pcb;
    };
    due_all! p (id + 1) n round
};

/// Every process due: the parked collected here, the others asked to collect.
let ask_all! !p !id !n !round = if id >= n { 0 } else {
    let pcb = table_at! p id;
    if pcb != 0 && pcb != current! p { ask_one! p pcb round; };
    if pcb != 0 && pcb == current! p { prim.store64! (p + ctx_guard) (0 - 1); };
    ask_all! p (id + 1) n round
};

let ask_one! !p !pcb !round = {
    pcb_lock! pcb;
    if prim.load64! (pcb + pcb_census_due) == round && prim.load64! (pcb + pcb_state) == state_waiting {
        // Its collection is its report (`collect!`).
        census_for! p pcb;
        pcb_unlock! pcb;
        0
    } else {
        let w = prim.load64! (pcb + pcb_worker);
        if w != 0 { prim.store64! (w + ctx_guard) (0 - 1); };
        pcb_unlock! pcb;
        0
    }
};

/// A parked process collected by this worker, in a context kept for the purpose, its record held.
let census_for! !p !pcb = {
    let s0 = prim.load64! (p + ctx_census_ctx);
    let s = if s0 != 0 { s0 } else {
        let c = prim.c2! "calloc" 1 ctx_size;
        prim.store64! (c + ctx_classes) (prim.load64! (p + ctx_classes));
        prim.store64! (c + ctx_timebuf) (prim.load64! (p + ctx_timebuf));
        prim.store64! (p + ctx_census_ctx) c;
        c
    };
    prim.store64! (s + ctx_current) pcb;
    prim.store64! (s + ctx_current_id) (tag_fix (prim.load64! (pcb + pcb_id)));
    prim.store64! (s + ctx_holds_pcb) 1;
    load_heap! s pcb;
    collect! s (prim.load64! (pcb + pcb_sp));
    save_heap! s pcb;
    prim.store64! (s + ctx_holds_pcb) 0;
    0
};

/// One fewer to hear from; the last ends the round.
let census_reported! !p !round = if prim.load64! (world_at! w_census) != round { 0 } else {
    if prim.xadd64! (world_at! w_census_waiting) (0 - 1) == 1 { census_finish! p round } else { 0 }
};

/// A process that was due finishes: it has nothing more to say, and what it answered is a root.
let census_gone! !p !pcb = {
    let round = prim.load64! (pcb + pcb_census_due);
    if round != 0 {
        prim.store64! (pcb + pcb_census_due) 0;
        census_reported! p round
    } else { 0 }
};

let census_finish! !p !round = {
    let n = prim.load64! (world_at! w_next_id);
    mark_roots! p 1 n;
    let cafs = prim.info "cafs";
    mark_cafs! p cafs 0 (prim.load64! cafs);
    mark_foreign! p (prim.load64! (world_at! w_foreign_head));
    mark_callbacks! p (prim.load64! (world_at! w_cb_roots));
    mark_drain! p;
    // Only what was there when the round began. A process started since was never due, and its
    // pid is made where it is spawned, not copied there, so nothing marked it: the parent that
    // reported early in the round and spawned a thousand children after holds pids no report
    // saw, and a child that finished quickly was reaped while the parent still had to join it.
    let reaped = reap! p 2 (prim.load64! (world_at! w_census_n)) 0;
    let l = prim.load64! (world_at! w_shared_lock);
    lock_unpromoting! l;
    let kept = sweep! p 0 (block_index (prim.load64! (world_at! w_shared_top))) round 0;
    prim.store64! (world_at! w_shared_live) kept;
    unlock! l;
    if prim.load64! (world_at! w_census_trace) != 0 { census_trace_line! p round reaped kept; };
    prim.store_rel! (world_at! w_census) 0;
    0
};

let mark_roots! !p !id !n = if id >= n { 0 } else {
    let pcb = table_at! p id;
    if pcb != 0 {
        census_mark! p (prim.load64! (pcb + pcb_result));
        let k = prim.load64! (pcb + pcb_kill);
        if k != 0 { census_mark! p k; };
    };
    mark_roots! p (id + 1) n
};

let mark_cafs! !p !table !i !n = if i >= n { 0 } else {
    let caf = prim.load64! (table + word * (i + 1));
    census_mark! p (prim.load64! (caf + word));
    mark_cafs! p table (i + 1) n
};

let mark_foreign! !p !entry = if entry == 0 { 0 } else {
    census_range! p (entry + fe_fields) (entry + fe_fields + 5 * word);
    mark_foreign! p (prim.load64! (entry + fe_next))
};

let mark_callbacks! !p !cell = if cell == 0 { 0 } else {
    census_mark! p (prim.load64! (cell + word));
    mark_callbacks! p (prim.load64! cell)
};

/// Finished processes nobody can join any more, gone. Answers how many.
let reap! !p !id !n !count = if id >= n { count } else {
    let pcb = table_at! p id;
    if pcb != 0 && prim.load64! (pcb + pcb_state) == state_done && not (pid_seen! id)
        && not (prim.load64! (pcb + pcb_failed) != 0 && prim.load64! (pcb + pcb_joined) == 0) {
        prim.store_rel! (prim.load64! (world_at! w_table) + id * word) 0;
        prim.c1! "free" pcb;
        reap! p (id + 1) n (count + 1)
    } else { reap! p (id + 1) n count }
};

let census_trace_line! !p !round !reaped !kept = {
    let buf = prim.c1! "malloc" 160;
    let fmt = "dream: census %ld: %ld processes reaped, %ld KB of the shared region kept, %ld blocks free\n";
    prim.c6! "snprintf" buf 160 fmt round reaped (kept / 1024) (prim.load64! (world_at! w_free_n));
    prim.c3! "write" 2 buf (prim.c1! "strlen" buf);
    prim.c1! "free" buf;
    0
};

let pid_seen! !id = prim.load64! (prim.load64! (world_at! w_pids_seen) + (id / 64) * word) & (1 << (id & 63)) != 0;

/// The shared lock, held when no promotion is under way: a block one is filling may have been
/// taken before the round began, and is neither marked nor written in it as a sweep reads it.
/// None starts while this holds the lock, and none waits on the census, so it is soon.
let lock_unpromoting! !l = {
    lock! l;
    if prim.load64! (world_at! w_promoting) != 0 {
        prim.store64! (world_at! w_sweep_wanted) 1;
        unlock! l;
        prim.c0! "sched_yield";
        lock_unpromoting! l
    } else {
        prim.store64! (world_at! w_sweep_wanted) 0;
        prim.store64! (world_at! w_sweeps) (prim.load64! (world_at! w_sweeps) + 1);
        0
    }
};

/// The shared lock, to start a promotion: not while a sweep waits to begin.
let lock_to_promote! !l = {
    lock! l;
    if prim.load64! (world_at! w_sweep_wanted) != 0 {
        unlock! l;
        prim.c0! "sched_yield";
        lock_to_promote! l
    } else { 0 }
};

/// Blocks nothing marked and nothing wrote to in this round, freed: answers the bytes kept.
let sweep! !p !i !n !round !kept = if i >= n { kept } else {
    let e = block_entry! i;
    if prim.load64! e != block_used { sweep! p (i + 1) n round kept }
    else {
        let len_ = run_length! i (i + 1) n;
        let keep = prim.load64! (e + word) >= round || run_marked! i len_ || run_holds! i len_ (prim.load64! (world_at! w_shared_cur))
            || run_holds! i len_ (prim.load64! (world_at! w_short_cur));
        if keep { clear_marks! i len_; } else { free_run! i len_; };
        sweep! p (i + len_) n round (if keep { kept + len_ * shared_block } else { kept })
    }
};

let run_length! !head !i !n = if i < n && prim.load64! (block_entry! i) == block_tail && prim.load64! (block_entry! i + 4 * word) == head { run_length! head (i + 1) n } else { i - head };

let run_marked! !head !len_ = len_ > 0 && (prim.load64! (block_entry! head + 3 * word) != 0 || run_marked! (head + 1) (len_ - 1));

let run_holds! !head !len_ !at = at != 0 && prim.uge at (block_at head) && prim.ult at (block_at (head + len_));

let clear_marks! !i !len_ = if len_ == 0 { 0 } else {
    let e = block_entry! i;
    if prim.load64! (e + 3 * word) != 0 {
        prim.c3! "memset" (prim.load64! (e + 2 * word)) 0 (shared_block / word / 8);
        prim.store64! (e + 3 * word) 0;
    };
    clear_marks! (i + 1) (len_ - 1)
};

/// Given back to the system, the pages, and kept as single blocks to be used again.
let free_run! !i !len_ = if len_ == 0 { 0 } else {
    let e = block_entry! i;
    prim.c3! "madvise" (block_at i) shared_block 4;
    if prim.load64! (e + 2 * word) != 0 { prim.c1! "free" (prim.load64! (e + 2 * word)); };
    prim.store64! e block_free;
    prim.store64! (e + 2 * word) 0;
    prim.store64! (e + 3 * word) 0;
    let n = prim.load64! (world_at! w_free_n);
    prim.store64! (prim.load64! (world_at! w_free_blocks) + n * word) i;
    prim.store64! (world_at! w_free_n) (n + 1);
    free_run! (i + 1) (len_ - 1)
};

// --- the collector ----------------------------------------------------------------
//
// A semispace copy of the running process's heap. To-space is one chunk as large as
// everything allocated, so it cannot overflow and the scan is one walk. A word whose low
// bit is set in an object's first position is a forwarding address, because an info is
// aligned. The roots are the process's own: its stack, what it was given to resume with,
// and the messages it has taken in. Nothing outside the process points into its heap.

let object_words! !o !info = {
    let kind = prim.load64! (info + info_kind);
    if kind == kind_string {
        2 + (prim.load64! (o + word) + word) / word
    } else if kind == kind_array || kind == kind_pap || kind == kind_map || kind == kind_tensor {
        2 + untag_fix (prim.load64! (o + word))
    } else if kind == kind_record || kind == kind_big {
        3 + untag_fix (prim.load64! (o + word))
    } else if kind == kind_hole || kind == kind_ind {
        2
    } else {
        1 + prim.load64! (info + info_size)
    }
};

let copy_words! !from !to !n = if n == 0 { 0 } else {
    prim.store64! to (prim.load64! from);
    copy_words! (from + word) (to + word) (n - 1)
};

let evacuate! !p !v =
    if not (is_object v) { v }
    else if prim.ult v (not_heap_limit! ()) {
        if prim.load64! (p + ctx_reporting) != 0 { census_mark! p v; };
        v
    }
    else {
        let info = prim.load64! v;
        if info & 1 == 1 { info - 1 }
        // Kept where it is, and a root already (`scan_pinned!`).
        else if prim.load64! (p + ctx_pinned) != 0 && in_chunks! (prim.load64! (p + ctx_pinned)) v { v }
        // Copying through an indirection is how the collector removes it. Nothing
        // has to be written in it: whoever else reads it arrives at the same target,
        // by then forwarded, or an immediate.
        else if prim.load64! (info + info_kind) == kind_ind { evacuate! p (prim.load64! (v + word)) }
        else {
            if prim.load64! (p + ctx_reporting) != 0 { census_heap_object! p v info; };
            let n = object_words! v info;
            let to = prim.load64! (p + ctx_to);
            copy_words! v to n;
            prim.store64! (p + ctx_to) (to + n * word);
            prim.store64! v (to + 1);
            to
        }
    };

let evacuate_at! !p !at = prim.store64! at (evacuate! p (prim.load64! at));

let evacuate_range! !p !at !stop = if prim.uge at stop { 0 } else {
    evacuate_at! p at;
    evacuate_range! p (at + word) stop
};

let scan! !p !at =
    if prim.uge at (prim.load64! (p + ctx_to)) { 0 }
    else {
        let info = prim.load64! at;
        let n = object_words! at info;
        if has_values (prim.load64! (info + info_kind)) {
            evacuate_range! p (at + word) (at + n * word);
        };
        scan! p (at + n * word)
    };

let frame_words! !at !info = {
    let size = prim.load64! (info + info_size);
    if size == 0 { untag_fix (prim.load64! (at + word)) } else { size }
};

let scan_stack! !p !at !top = if prim.uge at top { 0 } else {
    let n = frame_words! at (prim.load64! at);
    evacuate_range! p (at + word) (at + n * word);
    scan_stack! p (at + n * word) top
};

/// The messages a process has taken into its heap, which are its own to move.
let scan_mail! !p !entry = if entry == 0 { 0 } else {
    let segs = prim.load64! (entry + mail_segments);
    if segs == 0 { evacuate_at! p (entry + mail_value); }
    else if prim.load64! (p + ctx_reporting) != 0 {
        // Not taken in yet, and the census still wants what it holds.
        census_segments! p segs;
        census_mark! p (prim.load64! (entry + mail_value));
    };
    scan_mail! p (prim.load64! entry)
};

// A word on a stack that points into a chunk pins it: the chunk is kept where it is, every
// object in it is a root, and the rest of the heap is copied as ever. A native stack is read
// this way because what LLVM keeps there is not described (dreams/docs/aot-direct.md, "The
// collector finds roots on a stack conservatively"); the heap stays precise. Only a word that
// could be an object -- aligned, and above the shared region -- is looked up, and a wrong guess
// keeps a chunk one collection longer.

/// Whether `v` is inside one of the chunks of the list from `c`.
let in_chunks! !c !v = if c == 0 { false }
    else if prim.ule c v && prim.ult v (c + prim.load64! (c + word)) { true }
    else { in_chunks! (prim.load64! c) v };

/// The chunk that `v` is inside taken off the list whose link is at `link` and put on the pinned
/// list, if it is on the first.
let pin_from! !p !link !v = {
    let c = prim.load64! link;
    if c == 0 { 0 }
    else if prim.ule c v && prim.ult v (c + prim.load64! (c + word)) {
        prim.store64! link (prim.load64! c);
        prim.store64! c (prim.load64! (p + ctx_pinned));
        prim.store64! (p + ctx_pinned) c;
        0
    }
    else { pin_from! p c v }
};

let pin_word! !p !w = if not (is_object w) || prim.ult w (not_heap_limit! ()) { 0 } else { pin_from! p (p + ctx_chunks) w };

let pin_range! !p !at !stop = if prim.uge at stop { 0 } else {
    pin_word! p (prim.load64! at);
    pin_range! p (at + word) stop
};

/// Every object of every pinned chunk a root, walked from the chunk's start to its end.
let scan_pinned! !p !c = if c == 0 { 0 } else {
    let stop = prim.load64! (c + 2 * word);
    let reached = scan_objects! p (c + chunk_header) stop;
    if reached != stop { fatal! "dream: a pinned chunk did not walk to its end\n"; };
    scan_pinned! p (prim.load64! c)
};

let scan_objects! !p !at !stop = if prim.uge at stop { at } else {
    let info = prim.load64! at;
    let n = object_words! at info;
    let kind = prim.load64! (info + info_kind);
    if prim.load64! (p + ctx_reporting) != 0 { census_heap_object! p at info; };
    if has_values kind { evacuate_range! p (at + word) (at + n * word); };
    scan_objects! p (at + n * word) stop
};

/// The pinned chunks' bytes, which are the heap's as much as what was copied.
let pinned_bytes! !c !n = if c == 0 { n } else { pinned_bytes! (prim.load64! c) (n + prim.load64! (c + word)) };

/// The pinned chunks put after `to` in the list of chunks, which they are part of again.
let unpin! !p !to = {
    let c = prim.load64! (p + ctx_pinned);
    if c != 0 {
        let last = last_chunk! c;
        prim.store64! last (prim.load64! to);
        prim.store64! to c;
        prim.store64! (p + ctx_pinned) 0;
    };
    0
};

let last_chunk! !c = if prim.load64! c == 0 { c } else { last_chunk! (prim.load64! c) };

let free_chunks! !p !c = if c == 0 { 0 } else {
    let next = prim.load64! c;
    chunk_put! p c;
    free_chunks! p next
};

/// The process's native stack read for pins, from `here` to its top when this is running on it,
/// or from where it stopped when it is parked with a stack to come back to (`pcb_nsp`). Only
/// where the code keeps values there (`@i_native_frames`, `machine.assemble`), or to test the
/// pinning (`DREAM_GC_PIN_TEST`).
let pin_native! !p !pcb !here = {
    let base = prim.load64! (pcb + pcb_nstack);
    let top = base + prim.load64! (pcb + pcb_nstack_size);
    if base == 0 || (prim.load64! (prim.info "native_frames") == 0 && prim.load64! (world_at! w_pin_test) == 0) { 0 }
    else if prim.ult base here && prim.ult here top { pin_range! p here top }
    else if prim.load64! (pcb + pcb_nsp) != 0 { pin_range! p (prim.load64! (pcb + pcb_nsp)) top }
    else { 0 }
};

let spare_count! !c !n = if c == 0 { n } else { spare_count! (prim.load64! c) (n + 1) };

let collect! !p !sp = {
    // First, so that whatever a caller kept in a callee-saved register is on the stack below
    // which the pinning reads.
    let here = prim.stack_here! ();
    let pcb = current! p;
    // Due to the census: this collection is the report.
    let due = prim.load64! (pcb + pcb_census_due);
    let reporting = due != 0 && due == prim.load64! (world_at! w_census);
    prim.store64! (p + ctx_reporting) (if reporting { 1 } else { 0 });
    let budget = prim.load64! (pcb + pcb_budget);
    let space = round_chunk! (prim.load64! (p + ctx_total) + (if budget >= min_chunk { min_chunk } else { chunk_header })) budget;
    let to = chunk_get! p space;
    let start = to + chunk_header;
    prim.store64! to 0;
    prim.store64! (to + word) space;
    prim.store64! (p + ctx_to) start;
    prim.store64! (pcb + pcb_sp) sp;
    // Pinning first, before anything has moved: the chunks a stack points into come off the list
    // of those to be freed, each with where its objects end.
    ended_at! (prim.load64! (p + ctx_chunks)) (prim.load64! (p + ctx_hp));
    pin_native! p pcb here;
    if prim.load64! (world_at! w_pin_test) != 0 { pin_range! p sp (stack_top! pcb); };
    let old = prim.load64! (p + ctx_chunks);
    scan_stack! p sp (stack_top! pcb);
    evacuate_at! p (pcb + pcb_resume);
    evacuate_at! p (pcb + pcb_kept);
    scan_mail! p (prim.load64! (pcb + pcb_mail_head));
    scan_pinned! p (prim.load64! (p + ctx_pinned));
    scan! p start;
    free_chunks! p old;
    let live = prim.load64! (p + ctx_to) - start;
    let pinned = pinned_bytes! (prim.load64! (p + ctx_pinned)) 0;
    prim.store64! (to + 2 * word) (prim.load64! (p + ctx_to));
    prim.store64! (p + ctx_chunks) to;
    unpin! p to;
    prim.store64! (p + ctx_hp) 0;
    // What is in use, not what was mapped for it: counting the unused end of to-space would grow
    // the next to-space by its own size each time, and then no mapping is ever reused.
    prim.store64! (p + ctx_total) (live + pinned);
    prim.store64! (p + ctx_want_gc) 0;
    prim.store64! (p + ctx_guard) (prim.load64! (p + ctx_floor));
    prim.store64! (p + ctx_collections) (prim.load64! (p + ctx_collections) + 1);
    // A collection scans the whole stack, so a deep one asks for room in proportion, or a deep
    // recursion that allocates would scan its stack every few kilobytes.
    let deep = round_chunk! ((stack_top! pcb - sp) * 2) budget;
    let grown = if budget < max_budget { budget * 2 } else { budget };
    prim.store64! (pcb + pcb_budget) (if deep > grown { if deep > min_chunk { min_chunk } else { deep } } else { grown });
    new_chunk! p (live * 2);
    if reporting {
        mark_drain! p;
        prim.store64! (p + ctx_reporting) 0;
        prim.store64! (pcb + pcb_census_due) 0;
        census_reported! p due;
    };
    0
};

// --- returning, entering, applying ---------------------------------------------

/// Answer `v`, which is in weak head normal form, to the frame on top of the stack.
let return! !p !sp !v = prim.jump! (prim.load64! (prim.load64! sp)) p sp v 0 0 0;

/// Evaluate `v` and answer it to the frame on top of the stack.
let enter! !p !sp !v =
    if v & 7 != 0 { return! p sp v }
    else { prim.jump! (prim.load64! (prim.load64! v)) p sp v 0 0 0 };

/// A value's code: it is already what it evaluates to.
let code_value! !p !sp !self !b !c !d = return! p sp self;

/// What `prim.arch ()` answers, as the compiler numbers machines.
let arch_aarch64 = 1;

/// An indirection followed. A shared thunk's update writes its value and then, with release, the
/// info that says it is there, and whoever read that info reads the value next: x86-64 keeps two
/// loads in order, and aarch64 needs telling.
let code_ind! !p !sp !self !b !c !d = {
    if prim.arch () == arch_aarch64 { prim.fence! (); };
    enter! p sp (prim.load64! (self + word))
};

/// A thunk being evaluated is reached again. By the one evaluating it, it depends on
/// itself; by another process, that one has only to finish.
let code_hole! !p !sp !self !b !c !d =
    if prim.load64! (self + word) == prim.load64! (p + ctx_current_id) {
        fail! p atom_loop "value depends on itself";
        native_failed! p sp 0 0 0 0
    } else {
        let at = sp - 2 * word;
        prim.store64! at (prim.info "enter_again");
        prim.store64! (at + word) self;
        yield_now! p at unit_word 0 0 0
    };

// A shared thunk is a suspension every process may force: a CAF, or one reached in promoting a
// value. It is `[info, suspension, owner, waiters]`, claimed by a compare-and-swap of its info, and the suspension is data: whoever claims the shared
// thunk evaluates a copy of it in its own heap, and promotes the answer. The suspension itself is
// never written, so a kill in the middle gives the claim back rather than leaving the value
// raising for every process, and a raise does the same, which is only to evaluate it again.

let code_shared! !p !sp !self !b !c !d =
    if prim.cas64! self (prim.info "shared") (prim.info "shared_hole") != prim.info "shared" {
        // Someone else's now, or finished: whichever, entering it again says.
        enter! p sp self
    } else {
    prim.store64! (self + 2 * word) (prim.load64! (p + ctx_current_id));
    let t = prim.load64! (self + word);
    let n = object_words! t (prim.load64! t);
    let mine = alloc! p (n * word);
    copy_words! t mine n;
    let at = sp - 2 * word;
    prim.store64! at (prim.info "shared_update");
    prim.store64! (at + word) self;
    enter! p at mine
    };

/// A shared thunk someone is evaluating: by this process, it depends on itself; by another, this
/// one waits on it, and is woken when it is finished or given back.
let code_shared_hole! !p !sp !self !b !c !d =
    if prim.load64! (self + 2 * word) == prim.load64! (p + ctx_current_id) {
        fail! p atom_loop "value depends on itself";
        native_failed! p sp 0 0 0 0
    } else {
        let l = prim.load64! (world_at! w_shared_lock);
        lock! l;
        if prim.load64! self == prim.info "shared_hole" {
            prim.store64! (self + 3 * word) (id_push! p (prim.load64! (self + 3 * word)) (prim.load64! (current! p + pcb_id)));
            unlock! l;
            park! p sp (prim.load64! (prim.info "m_enter")) self unit_word unit_word
        } else {
            unlock! l;
            enter! p sp self
        }
    };

let frame_shared_update! !p !sp !v !b !c !d = {
    let s = prim.load64! (sp + word);
    // Its value goes where it is: a thunk inside an answer lives as long as the answer does.
    prim.store64! (s + word) (promote_as! p v (shared_mode_of! s));
    // The value before the info that says it is there, for a reader on another core.
    prim.store_rel! s (prim.info "ind");
    // A census that marked the thunk while it was a hole traced the suspension, not this value,
    // and does not trace a marked object again, so during a round the value is marked here. The
    // fence orders the store above before the load of the round's flag, against a census starting
    // on another core: either it reads the thunk after the store and traces the value, or this
    // reads that it has begun.
    prim.fence! ();
    if census_on! () { census_mark! p (prim.load64! (s + word)); mark_drain! p; };
    wake_shared_waiters! p s;
    return! p (sp + 2 * word) v
};

let wake_shared_waiters! !p !s = {
    let l = prim.load64! (world_at! w_shared_lock);
    lock! l;
    let waiters = prim.load64! (s + 3 * word);
    prim.store64! (s + 3 * word) 0;
    unlock! l;
    wake_list! p waiters;
    id_free! p waiters
};

/// A shared thunk's claim given back, on the way out of a raise or a kill.
let release_shared! !p !s = {
    prim.store64! (s + 2 * word) 0;
    prim.store_rel! s (prim.info "shared");
    wake_shared_waiters! p s;
    0
};

let frame_update! !p !sp !v !b !c !d = {
    let thunk = prim.load64! (sp + word);
    prim.store64! (thunk + word) v;
    prim.store64! thunk (prim.info "ind");
    return! p (sp + 2 * word) v
};

/// A collection asked for at a function's entry. The registers are saved as a frame
/// with the code to go back to, so the collector sees them as it sees any frame.
let collect_at_entry! !p !sp !a !b !c !d =
    if prim.ult sp (prim.load64! (p + ctx_floor)) && prim.load64! (p + ctx_want_gc) == 0
        && prim.load64! (current! p + pcb_stack_size) < stack_bytes && prim.load64! (p + ctx_in_callback) == 0 {
        // A small stack run out: go on from a larger one.
        let size = prim.load64! (current! p + pcb_stack_size);
        collect_at_entry! p (move_stack! p sp (size * 2)) a b c d
    } else if prim.ult sp (prim.load64! (p + ctx_floor)) && prim.load64! (p + ctx_want_gc) == 0 {
        // The guard was the real one, so this is the stack running out.
        prim.store64! (p + ctx_guard) (prim.load64! (p + ctx_floor) - stack_margin / 2);
        fail! p atom_stack_overflow "recursion too deep";
        native_failed! p sp 0 0 0 0
    } else {
        let extra = prim.load64! (p + ctx_retry_stack);
        let at = sp - 8 * word;
        prim.store64! at (prim.info "retry");
        prim.store64! (at + word) (tag_fix (8 + extra));
        prim.store64! (at + 2 * word) (prim.load64! (p + ctx_retry));
        prim.store64! (at + 3 * word) (tag_fix extra);
        prim.store64! (at + 4 * word) a;
        prim.store64! (at + 5 * word) b;
        prim.store64! (at + 6 * word) c;
        prim.store64! (at + 7 * word) d;
        let inside_c = prim.load64! (p + ctx_in_callback) != 0;
        if (prim.load64! (p + ctx_want_gc) != 0 || prim.load64! (current! p + pcb_census_due) != 0) && not inside_c { collect! p at; };
        prim.store64! (p + ctx_guard) (prim.load64! (p + ctx_floor));
        // Asked for by the clock, or by a kill: another's turn, if there is another,
        // and a kill is seen where the process next resumes. One waiting for a time or for
        // the system is another too, since only the scheduler looks at those: a process that
        // never parks would otherwise keep a sleeper from waking until it finished.
        if not inside_c && (prim.load64! (p + ctx_run_head) != 0 || prim.load64! (current! p + pcb_kill) != 0
                            || (waiting_on_system! () && prim.load64! (world_at! w_polling) == 0)) {
            yield_now! p at unit_word 0 0 0
        } else {
            frame_resume_entry! p at unit_word 0 0 0
        }
    };

/// Call the closure `f`, whose arguments are on the stack, first on top, with
/// exactly as many as it takes: up to three go in registers, the rest stay.
let call_exact! !p !sp !f !arity = {
    let code = prim.load64! (prim.load64! f + info_call);
    if arity == 0 { prim.jump! code p sp f 0 0 0 }
    else if arity == 1 { prim.jump! code p (sp + word) f (prim.load64! sp) 0 0 }
    else if arity == 2 { prim.jump! code p (sp + 2 * word) f (prim.load64! sp) (prim.load64! (sp + word)) 0 }
    else {
        prim.jump! code p (sp + 3 * word) f (prim.load64! sp) (prim.load64! (sp + word))
            (prim.load64! (sp + 2 * word))
    }
};

let move_words_down! !from !to !n = if n == 0 { 0 } else {
    prim.store64! to (prim.load64! from);
    move_words_down! (from + word) (to + word) (n - 1)
};

let move_words_up! !from !to !n = if n == 0 { 0 } else {
    prim.store64! (to + (n - 1) * word) (prim.load64! (from + (n - 1) * word));
    move_words_up! from to (n - 1)
};

let not_a_function! !p !sp !f = {
    fail_value! p atom_not_a_function (concat2! p (describe! p f) (text_of! p " is not a function"));
    native_failed! p sp 0 0 0 0
};

/// Apply `f`, in weak head normal form, to the `n` arguments on the stack.
let apply! !p !sp !f !n !c !d = {
    if not (is_object f) { not_a_function! p (sp + n * word) f }
    else {
        let info = prim.load64! f;
        let kind = prim.load64! (info + info_kind);
        if kind == kind_pap {
            let held = untag_fix (prim.load64! (f + word)) - 1;
            let below = sp - held * word;
            copy_words! (f + 3 * word) below held;
            apply! p below (prim.load64! (f + 2 * word)) (n + held) 0 0
        }
        else if kind != kind_closure {
            not_a_function! p (sp + n * word) f
        }
        else {
            let arity = prim.load64! (info + info_arity);
            if n == arity { call_exact! p sp f arity }
            else if prim.ult n arity {
                // Too few: the closure and these arguments, kept for the rest.
                let o = alloc! p ((3 + n) * word);
                prim.store64! o (prim.info "pap");
                prim.store64! (o + word) (tag_fix (n + 1));
                prim.store64! (o + 2 * word) f;
                copy_words! sp (o + 3 * word) n;
                return! p (sp + n * word) o
            }
            else {
                // Too many: what is left applies to what comes back, so a frame goes
                // in between the two runs of arguments.
                let extra = n - arity;
                let below = sp - 2 * word;
                move_words_down! sp below arity;
                let frame = below + arity * word;
                prim.store64! frame (prim.info "apply_rest");
                prim.store64! (frame + word) (tag_fix (extra + 2));
                call_exact! p below f arity
            }
        }
    }
};

let frame_apply_rest! !p !sp !v !b !c !d = {
    let n = untag_fix (prim.load64! (sp + word)) - 2;
    // No arguments, which is a process's work: only a function waiting for none runs.
    if n == 0 && not (is_object v && kind_of! v == kind_closure && prim.load64! (prim.load64! v + info_arity) == 0) {
        return! p (sp + 2 * word) v
    } else {
        apply! p (sp + 2 * word) v n 0 0
    }
};

// --- errors --------------------------------------------------------------------

/// What the machine itself runs into, before a value can even be made of it.
let raise_text! !p !sp s = {
    fail! p atom_type_error s;
    native_failed! p sp 0 0 0 0
};

// --- starting ------------------------------------------------------------------

/// A process's context and its empty stack, whose top holds the frame that ends it.
let init! () = {
    let p = prim.c2! "calloc" 1 ctx_size;
    prim.store64! (p + ctx_classes) (prim.c2! "calloc" (small_class_count * class_words) word);
    prim.store64! (p + ctx_timebuf) (prim.c2! "calloc" 2 word);
    world_init! p;
    timeline_open! ();
    if prim.c1! "getenv" "DREAM_GC_PIN_TEST" != 0 { prim.store64! (world_at! w_pin_test) 1; };
    note_context! p;
    init_handles! p;
    // A peer that has gone is an error from the write, not the end of the program.
    prim.c2! "signal" 13 1;
    make_current! p (new_pcb! p);
    new_chunk! p min_chunk;
    p
};

// --- what library code and the builtins call --------------------------------------
//
// A native takes the context first and its arguments forced. It may allocate but
// never collects, and it answers a value, or 0 to raise what it left in the context.

let new_string! !p !bytes = {
    let o = alloc! p ((2 + (bytes + word) / word) * word);
    prim.store64! o (prim.info "string");
    prim.store64! (o + word) bytes;
    prim.store8! (o + 2 * word + bytes) 0;
    o
};

/// `bytes` of room that are not an object, for C to write into: a string's header in front of them,
/// so that the chunk they are in can still be walked object by object (`scan_pinned!`).
let scratch! !p !bytes = new_string! p bytes + 2 * word;

/// The `words` words from `at` made a filler: what is left of an object that became a smaller one
/// where it is, as a thunk becomes a hole (`machine.filled`) or a string is cut to what was read.
let filler! !at !words =
    if words <= 0 { 0 }
    else if words == 1 { prim.store64! at (prim.info "fill"); 0 }
    else if words == 2 { prim.store64! at (prim.info "fill"); prim.store64! (at + word) (prim.info "fill"); 0 }
    else { prim.store64! at (prim.info "string"); prim.store64! (at + word) ((words - 3) * word); 0 };

/// String `s`, made for `room` bytes, cut to its first `n`, what is left of it a filler.
let string_cut! !s !room !n = {
    prim.store64! (s + word) n;
    prim.store8! (string_bytes s + n) 0;
    let before = 2 + (room + word) / word;
    let after = 2 + (n + word) / word;
    filler! (s + after * word) (before - after);
    s
};

/// An error: a kind, and what it carries.
let error_new! !p !kind !payload = {
    let o = alloc! p (4 * word);
    prim.store64! o (prim.info "error");
    prim.store64! (o + word) kind;
    prim.store64! (o + 2 * word) payload;
    prim.store64! (o + 3 * word) unit_word;
    o
};

let string_bytes !s = s + 2 * word;
let string_len! !s = prim.load64! (s + word);

let digit_count !n = if n < 10 { 1 } else { 1 + digit_count (n / 10) };

let write_digits! !at !n = {
    prim.store8! at (48 + n % 10);
    if n < 10 { 0 } else { write_digits! (at - 1) (n / 10) }
};

let int_to_string! !p !v = {
    let n = untag_fix v;
    let negative = n < 0;
    let size = 0 - n;
    let magnitude = if negative { size } else { n };
    let digits = digit_count magnitude;
    let total = if negative { digits + 1 } else { digits };
    let s = new_string! p total;
    let bytes = string_bytes s;
    if negative { prim.store8! bytes 45; };
    write_digits! (bytes + total - 1) magnitude;
    s
};

let concat2! !p !a !b = {
    let n = string_len! a;
    let m = string_len! b;
    let s = new_string! p (n + m);
    prim.c3! "memcpy" (string_bytes s) (string_bytes a) n;
    prim.c3! "memcpy" (string_bytes s + n) (string_bytes b) m;
    s
};

/// A character as UTF-8, the only thing a string holds.
let char_text! !p !v = {
    let c = v >> 8;
    if c < 128 {
        let s = new_string! p 1;
        prim.store8! (string_bytes s) c;
        s
    } else if c < 2048 {
        let s = new_string! p 2;
        prim.store8! (string_bytes s) (192 + (c >> 6));
        prim.store8! (string_bytes s + 1) (128 + (c & 63));
        s
    } else if c < 65536 {
        let s = new_string! p 3;
        prim.store8! (string_bytes s) (224 + (c >> 12));
        prim.store8! (string_bytes s + 1) (128 + ((c >> 6) & 63));
        prim.store8! (string_bytes s + 2) (128 + (c & 63));
        s
    } else {
        let s = new_string! p 4;
        prim.store8! (string_bytes s) (240 + (c >> 18));
        prim.store8! (string_bytes s + 1) (128 + ((c >> 12) & 63));
        prim.store8! (string_bytes s + 2) (128 + ((c >> 6) & 63));
        prim.store8! (string_bytes s + 3) (128 + (c & 63));
        s
    }
};

let concat3! !p !a !b !c = concat2! p (concat2! p a b) c;

let string_eq! !a !b = string_len! a == string_len! b
    && prim.sext32 (prim.c3! "memcmp" (string_bytes a) (string_bytes b) (string_len! a)) == 0;

let is_string! !v = is_object v && prim.load64! (prim.load64! v + info_kind) == kind_string;

let io_stdout! !p !unit = tag_fix 1;
let io_stderr! !p !unit = tag_fix 2;

// The atoms the compiler numbers first, always in this order (`machine.first_atoms`),
// so that this can say them without a table.
let atom_word !i = i * 256 + 26;

let kind_of! !v = prim.load64! (prim.load64! v + info_kind);

/// `type_of`. A record answers the name of its type, which the compiler worked out
/// for each record's atom (`atom_types`).
let type_of! !p !v =
    if v & 1 == 1 { atom_word 0 }
    else if v & 7 == 0 {
        let kind = kind_of! v;
        if kind == kind_float { atom_word 1 }
        else if kind == kind_big { atom_word 0 }
        else if kind == kind_string { atom_word 5 }
        else if kind == kind_cons { atom_word 7 }
        else if kind == kind_array { atom_word 8 }
        else if kind == kind_map { atom_word 9 }
        else if kind == kind_error { atom_word 12 }
        else if kind == kind_process { atom_process }
        else if kind == kind_trunk { prim.atom "trunk" }
        else if kind == kind_tensor { prim.atom "tensor" }
        else if kind == kind_module { prim.atom "module" }
        else if kind == kind_record {
            let i = prim.load64! (v + 2 * word) >> 8;
            let learned = learned_shape! i w_atoms_type;
            if learned != 0 { atom_word learned } else { atom_word (prim.load64! (prim.info "atom_types" + word * i)) }
        }
        else if kind == kind_closure { if prim.load64! (prim.load64! v + info_impure) != 0 { atom_impure_fn } else { atom_pure_fn } }
        else if kind == kind_pap { type_of! p (prim.load64! (v + 2 * word)) }
        else { atom_word 11 }
    } else {
        let imm = (v >> 3) & 31;
        if imm == 0 { atom_word 4 }
        else if imm == 1 { atom_word 3 }
        else if imm == 2 { atom_word 2 }
        else if imm == 3 { atom_word 6 }
        else { atom_word 7 }
    };

let atom_name! !p !v = {
    let i = v >> 8;
    let n = prim.load64! (prim.info "atom_count");
    if i < n { prim.load64! (prim.info "atoms" + word * i) } else { prim.load64! (prim.load64! (world_at! w_atoms_more) + word * (i - n)) }
};

let size! !p !v = if is_string! v { tag_fix (string_len! v) }
    else if is_kind! v kind_array { prim.load64! (v + word) }
    else if is_kind! v kind_map { prim.load64! (v + 2 * word) }
    else if is_trunk! v { prim.load64! (v + 2 * word) }
    else if is_tensor! v { tag_fix (t_dim! v 0) }
    else { type_fail! p "len needs a string, a list, an array or a map" };

let str_le! !p !v !width = {
    let n = untag_fix width;
    let out = new_string! p n;
    if is_fix v { write_le! (string_bytes out) (untag_fix v) n; }
    else { big_le! (string_bytes out) v 0 n (if big_sign! v == 1 { 1 } else { 0 }); };
    out
};

/// A bignum's two's complement, a byte at a time: the limbs, inverted with a carry when
/// it is negative, and its sign for as long as the field goes on.
let big_le! !at !v !i !n !carry = if i >= n { 0 } else {
    let limb = big_limb! v (i / 4);
    let byte = prim.ushr limb ((i % 4) * 8) & 255;
    if big_sign! v == 1 {
        let t = (byte ^ 255) + carry;
        prim.store8! (at + i) t;
        big_le! at v (i + 1) n (t >> 8)
    } else {
        prim.store8! (at + i) byte;
        big_le! at v (i + 1) n 0
    }
};

let write_le! !at !v !n = if n == 0 { 0 } else {
    prim.store8! at v;
    write_le! (at + 1) (v >> 8) (n - 1)
};

// --- failing ------------------------------------------------------------------------
//
// A native that fails leaves an error in the context and answers 0; the compiled call
// sees the 0 and raises it. An atom's number is its place in `machine.first_atoms`.

let atom_error = atom_word 12;
let atom_no_such_key = atom_word 13;
let atom_out_of_bounds = atom_word 14;
let atom_type_error = atom_word 15;
let atom_divide_by_zero = atom_word 16;
let atom_not_a_function = atom_word 17;
let atom_loop = atom_word 18;
let atom_match_error = atom_word 19;
let atom_pure_fn = atom_word 20;
let atom_impure_fn = atom_word 21;
let atom_process = atom_word 22;
let atom_stack_overflow = atom_word 23;
let atom_killed = atom_word 24;
let atom_ok = atom_word 25;
let atom_timeout = atom_word 26;
let atom_none = atom_word 27;
let atom_down = atom_word 28;
let atom_result_ok = atom_word 29;
let atom_result_error = atom_word 30;

/// A value as an error message names it.
let describe! !p !v =
    if is_fix v { concat2! p (text_of! p "integer ") (int_to_string! p v) }
    else if v == unit_word { text_of! p "unit" }
    else if v == true_word { text_of! p "bool true" }
    else if v == false_word { text_of! p "bool false" }
    else if v == nil_word { text_of! p "the empty list" }
    else if v & 7 == 2 {
        if (v >> 3) & 31 == 2 { text_of! p "a char" }
        else { concat2! p (text_of! p ":") (atom_name! p v) }
    }
    else if is_object v {
        let kind = kind_of! v;
        text_of! p (
            if kind == kind_string { "a string" } else if kind == kind_float { "a float" }
            else if kind == kind_cons { "a list" } else if kind == kind_array { "a array" }
            else if kind == kind_map { "a map" } else if kind == kind_closure { "a function" }
            else if kind == kind_pap { "a function" } else if kind == kind_record { "a record" }
            else if kind == kind_big { "a integer" } else if kind == kind_error { "a error" }
            else { "a value" })
    }
    else { text_of! p "a value" };

let concat_parts! !p !a !b !c = concat2! p (concat2! p (text_of! p a) b) (text_of! p c);

let fail_text! !p !kind !t = fail_value! p kind t;

let text_of! !p s = {
    let n = prim.str_len s;
    let o = new_string! p n;
    prim.c3! "memcpy" (string_bytes o) s n;
    o
};

let fail! !p !kind s = {
    prim.store64! (p + ctx_error) (error_new! p kind (text_of! p s));
    0
};

let fail_value! !p !kind !v = {
    prim.store64! (p + ctx_error) (error_new! p kind v);
    0
};

let type_fail! !p s = fail! p atom_type_error s;

// --- walking out of a raise ---------------------------------------------------------

/// Which worker's queue holds `pcb`, or -1.
let queued_on! !pcb !i !n = if i >= n { 0 - 1 } else {
    let w = prim.load64! (prim.load64! (world_at! w_worker_ctx) + i * word);
    if in_queue! (prim.load64! (w + ctx_run_head)) pcb { i } else { queued_on! pcb (i + 1) n }
};

let in_queue! !q !pcb = q != 0 && (q == pcb || in_queue! (prim.load64! (q + pcb_next)) pcb);

/// `DREAM_DUMP`: every process's state, on standard error, when the first one fails -- for finding
/// what a program that went wrong was waiting on.
let dump_processes! !p !id !n = if id >= n { 0 } else {
    let pcb = table_at! p id;
    if pcb != 0 {
        let buf = prim.c1! "malloc" 300;
        prim.c6! "snprintf" buf 300 "process %ld: state %ld mail %ld wake_at %ld\n" id (prim.load64! (pcb + pcb_state))
            (prim.load64! (pcb + pcb_mail_count)) (prim.load64! (pcb + pcb_wake_at));
        prim.c3! "write" 2 buf (prim.c1! "strlen" buf);
        prim.c6! "snprintf" buf 300 "    fd %ld worker %p woken %ld pinned %p\n" (prim.load64! (pcb + pcb_wait_fd)) (prim.load64! (pcb + pcb_worker))
            (prim.load64! (pcb + pcb_woken)) (prim.load64! (pcb + pcb_pinned));
        prim.c3! "write" 2 buf (prim.c1! "strlen" buf);
        prim.c6! "snprintf" buf 300 "    queued on %ld\n" (queued_on! pcb 0 (prim.load64! (world_at! w_started))) 0;
        prim.c3! "write" 2 buf (prim.c1! "strlen" buf);
        prim.c1! "free" buf;
    };
    dump_processes! p (id + 1) n
};

/// Every thunk being forced on the way up is left raising the same error, because
/// what it would have computed is gone, and forcing it again must not pretend.
let unwind! !p !at !e !b !c !d = {
    let info = prim.load64! at;
    let kind = prim.load64! (info + info_kind);
    let killing = prim.load64! (current! p + pcb_killing) == 1;
    if kind == frame_cleanup {
        // While a killed process runs a cleanup, the cleanup may handle its own errors.
        if killing { prim.store64! (current! p + pcb_killing) 2; };
        prim.jump! (prim.load64! (info + info_call)) p at e 0 0 0
    } else if kind == frame_catch && prim.load64! (current! p + pcb_killing) != 1 {
        prim.jump! (prim.load64! (info + info_call)) p at e 0 0 0
    } else if kind == frame_halt {
        // The first process failing ends the run; what it was is the library's to say.
        if prim.load64! (current! p + pcb_id) == 1 {
            if prim.c1! "getenv" "DREAM_DUMP" != 0 { dump_processes! p 1 (prim.load64! (world_at! w_next_id)); };
            prim.store64! (at - word) e;
            apply! p (at - word) (prim.info "lib_uncaught") 1 0 0
        } else { finish! p e 1 0 0 0 }
    } else {
        if kind == frame_shared { release_shared! p (prim.load64! (at + word)); };
        if kind == frame_thunk {
            let thunk = prim.load64! (at + word);
            let raised = alloc! p (2 * word);
            prim.store64! raised (prim.info "raised");
            prim.store64! (raised + word) e;
            prim.store64! (thunk + word) raised;
            prim.store64! thunk (prim.info "ind");
        };
        unwind! p (at + frame_words! at info * word) e 0 0 0
    }
};

let code_raised! !p !sp !self !b !c !d = unwind! p sp (prim.load64! (self + word)) 0 0 0;

let frame_catch_return! !p !sp !v !b !c !d =
    return! p (sp + frame_words! sp (prim.load64! sp) * word) v;

/// An error about to have where it was raised written on it, made the running process's own if
/// it is not: one in the shared region is every process's, and must not point into this heap.
let own_error! !p !e = if is_object e && kind_of! e == kind_error && not (is_heap_object! e) {
    let o = alloc! p (4 * word);
    copy_words! e o 4;
    o
} else { e };

let native_failed! !p !sp !a !b !c !d = {
    let e = own_error! p (prim.load64! (p + ctx_error));
    if is_object e && kind_of! e == kind_error { locate! p e sp 0; };
    unwind! p sp e 0 0 0
};

// Where an error was raised, written on it once: a `catch` that raises it again keeps
// where it started. A place is the compiler's static `[name, path, line, col, made]`,
// found by a frame's info, and at most so many are kept, because what is read is the
// top of it and a stack may be a million frames deep.

let trace_limit = 12;
let trace_scan = 512;

let place_entry! !p !place = {
    let tail_ = new_cons! p (tag_fix (prim.load64! (place + 2 * word)))
        (new_cons! p (tag_fix (prim.load64! (place + 3 * word))) nil_word);
    new_cons! p (if prim.load64! (place + 4 * word) != 0 { prim.atom "made" } else { prim.atom "in" })
        (new_cons! p (prim.load64! place) (new_cons! p (prim.load64! (place + word)) tail_))
};

let places_from! !p !at !left !room !last = {
    let info = prim.load64! at;
    let kind = prim.load64! (info + info_kind);
    if kind == frame_halt || left == 0 || room == 0 { nil_word }
    else {
        let place = prim.load64! (info + info_place);
        let next = at + frame_words! at info * word;
        if place != 0 && place != last {
            let entry = place_entry! p place;
            new_cons! p entry (places_from! p next (left - 1) (room - 1) place)
        } else { places_from! p next (left - 1) room last }
    }
};

let locate! !p !e !sp !site = if prim.load64! (e + 3 * word) == unit_word {
    let below = places_from! p sp trace_scan (if site != 0 { trace_limit - 1 } else { trace_limit }) site;
    prim.store64! (e + 3 * word) (if site != 0 { new_cons! p (place_entry! p site) below } else { below });
    0
} else { 0 };

let error_where! !p !e = {
    let w = prim.load64! (e + 3 * word);
    if w == unit_word { nil_word } else { w }
};

let not_bool! !p !sp !a !b !c !d = {
    fail_value! p atom_type_error (concat2! p (text_of! p "`if` needs a bool, got ") (describe! p a));
    native_failed! p sp 0 0 0 0
};

/// `raise!`: an error goes up as it is, anything else inside one.
let raise! !p !sp !site !v0 !c !d = {
    let v = own_error! p v0;
    if is_object v && kind_of! v == kind_error {
        locate! p v sp site;
        // The kill itself going on up after a cleanup: nothing may catch it from here.
        if prim.load64! (v + word) == atom_killed && prim.load64! (current! p + pcb_kill) != 0 {
            prim.store64! (current! p + pcb_killing) 1;
        };
        unwind! p sp v 0 0 0
    }
    else {
        let e = error_new! p atom_error v;
        locate! p e sp site;
        unwind! p sp e 0 0 0
    }
};

/// A thunk the runtime makes, for what only the library can finish: `[f, a, b]`.
let deferred2! !p !f !a !b = {
    let o = alloc! p (4 * word);
    prim.store64! o (prim.info "deferred2");
    prim.store64! (o + word) f;
    prim.store64! (o + 2 * word) a;
    prim.store64! (o + 3 * word) b;
    o
};

let code_deferred2! !p !sp !self !b !c !d = {
    let f = prim.load64! (self + word);
    let x = prim.load64! (self + 2 * word);
    let y = prim.load64! (self + 3 * word);
    let at = sp - 4 * word;
    prim.store64! (at + 2 * word) (prim.info "update");
    prim.store64! (at + 3 * word) self;
    prim.store64! self (prim.info "hole");
    prim.store64! (self + word) (prim.load64! (p + ctx_current_id));
    // What is left of it a filler, as a compiled thunk's is (`machine.filled`).
    prim.store64! (self + 2 * word) (prim.info "fill");
    prim.store64! (self + 3 * word) (prim.info "fill");
    prim.store64! at x;
    prim.store64! (at + word) y;
    apply! p at f 2 0 0
};

// --- floats -------------------------------------------------------------------------

let new_float! !p !bits = {
    let o = alloc! p (2 * word);
    prim.store64! o (prim.info "float");
    prim.store64! (o + word) bits;
    o
};

let is_kind! !v !kind = is_object v && kind_of! v == kind;
let is_float! !v = is_kind! v kind_float;
let is_big! !v = is_kind! v kind_big;
let is_fix !v = v & 1 == 1;
let is_int! !v = is_fix v || is_big! v;
let is_number! !v = is_fix v || is_kind! v kind_float || is_big! v;

let float_bits! !v =
    if is_fix v { prim.i2f (untag_fix v) }
    else if is_big! v { big_to_float! v }
    else { prim.load64! (v + word) };

// --- bignums ------------------------------------------------------------------------
//
// Sign and magnitude, a limb being 32 bits held in a whole word, least significant
// first, so that a product of two limbs and a carry always fits. The layout is
// `[info, n tagged, sign tagged, limbs..]`. Only a value past a fixnum is ever a
// bignum, so two integers are equal only if they are the same kind.

let limb_base = 4294967296;
let limb_mask = 4294967295;

let new_big! !p !n !sign = {
    let o = alloc! p ((3 + n) * word);
    prim.store64! o (prim.info "big");
    prim.store64! (o + word) (tag_fix n);
    prim.store64! (o + 2 * word) (tag_fix sign);
    o
};

let big_n! !b = untag_fix (prim.load64! (b + word));
let big_sign! !b = untag_fix (prim.load64! (b + 2 * word));
let limb_at !b !i = b + (3 + i) * word;
let big_limb! !b !i = if i >= big_n! b { 0 } else { prim.load64! (limb_at b i) };

/// Any integer as a bignum, for the arithmetic: a fixnum becomes a short one, which
/// is never an answer until `big_fix!` has looked at it.
let as_big! !p !v = if is_big! v { v } else {
    let n = untag_fix v;
    let negative = n < 0;
    let m = if negative { 0 - n } else { n };
    let b = new_big! p 2 (if negative { 1 } else { 0 });
    prim.store64! (limb_at b 0) (m & limb_mask);
    prim.store64! (limb_at b 1) (prim.ushr m 32);
    b
};

let trimmed! !b !n = if n > 0 && prim.load64! (limb_at b (n - 1)) == 0 { trimmed! b (n - 1) } else { n };

/// A finished result: a fixnum if it fits, which must be checked before anyone can
/// compare it, and otherwise the object with its top zero limbs dropped.
let big_fix! !b = {
    let n = trimmed! b (big_n! b);
    let top = if n == 0 { 0 } else { prim.load64! (limb_at b (n - 1)) };
    let fits = n == 0 || n == 1 || (n == 2 && prim.ult top 1073741824);
    if fits {
        let low = if n == 0 { 0 } else { prim.load64! (limb_at b 0) };
        let high = if n == 2 { top } else { 0 };
        let m = low + (high << 32);
        tag_fix (if big_sign! b == 1 { 0 - m } else { m })
    } else {
        big_trimmed! b n;
        b
    }
};

/// Bignum `b` cut to its low `n` limbs where it is, the rest of it a filler (`filler!`).
let big_trimmed! !b !n = {
    filler! (limb_at b n) (big_n! b - n);
    prim.store64! (b + word) (tag_fix n);
    0
};

let magnitude_order_at! !a !b !i =
    if i < 0 { 0 }
    else {
        let x = big_limb! a i;
        let y = big_limb! b i;
        if prim.ult x y { 0 - 1 } else if prim.ult y x { 1 } else { magnitude_order_at! a b (i - 1) }
    };

let magnitude_order! !a !b = {
    let n = big_n! a;
    let m = big_n! b;
    magnitude_order_at! a b ((if n > m { n } else { m }) - 1)
};

let add_limbs! !a !b !out !i !n !carry = if i >= n { carry } else {
    let t = big_limb! a i + big_limb! b i + carry;
    prim.store64! (limb_at out i) (t & limb_mask);
    add_limbs! a b out (i + 1) n (prim.ushr t 32)
};

let magnitude_add! !p !a !b !sign = {
    let n = big_n! a;
    let m = big_n! b;
    let top = if n > m { n } else { m };
    let out = new_big! p (top + 1) sign;
    prim.store64! (limb_at out top) (add_limbs! a b out 0 top 0);
    out
};

let sub_limbs! !a !b !out !i !n !borrow = if i >= n { 0 } else {
    let t = big_limb! a i - big_limb! b i - borrow;
    prim.store64! (limb_at out i) (t & limb_mask);
    sub_limbs! a b out (i + 1) n (if t < 0 { 1 } else { 0 })
};

/// `|a| - |b|`, with `|a| >= |b|`.
let magnitude_sub! !p !a !b !sign = {
    let n = big_n! a;
    let out = new_big! p n sign;
    sub_limbs! a b out 0 n 0;
    out
};

let big_add! !p !a !b !flip = {
    let sa = big_sign! a;
    let sb = if flip { 1 - big_sign! b } else { big_sign! b };
    if sa == sb { big_fix! (magnitude_add! p a b sa) }
    else if magnitude_order! a b >= 0 { big_fix! (magnitude_sub! p a b sa) }
    else { big_fix! (magnitude_sub! p b a sb) }
};

let mul_row! !at !x !b !j !m !carry = if j >= m {
    let t = prim.load64! at + carry;
    prim.store64! at (t & limb_mask);
    prim.store64! (at + word) (prim.load64! (at + word) + prim.ushr t 32);
    0
} else {
    let t = prim.load64! at + x * prim.load64! (limb_at b j) + carry;
    prim.store64! at (t & limb_mask);
    mul_row! (at + word) x b (j + 1) m (prim.ushr t 32)
};

let mul_rows! !a !b !out !i !n !m = if i >= n { 0 } else {
    mul_row! (limb_at out i) (prim.load64! (limb_at a i)) b 0 m 0;
    mul_rows! a b out (i + 1) n m
};

let zero_words! !at !n = if n == 0 { 0 } else {
    prim.store64! at 0;
    zero_words! (at + word) (n - 1)
};

let big_mul! !p !a !b = {
    let n = big_n! a;
    let m = big_n! b;
    let out = new_big! p (n + m + 1) (if big_sign! a == big_sign! b { 0 } else { 1 });
    zero_words! (limb_at out 0) (n + m + 1);
    mul_rows! a b out 0 n m;
    big_fix! out
};

/// Divide the magnitude by one limb in place, answering the remainder.
let div_small! !b !i !d !rem = if i < 0 { rem } else {
    let cur = (rem << 32) + prim.load64! (limb_at b i);
    prim.store64! (limb_at b i) (prim.udiv cur d);
    div_small! b (i - 1) d (prim.urem cur d)
};

/// A copy with `n` limbs of room, the top ones zero.
let big_copy! !p !a !n = {
    let out = new_big! p n (big_sign! a);
    zero_words! (limb_at out 0) n;
    copy_words! (limb_at a 0) (limb_at out 0) (big_n! a);
    out
};

/// Shift-and-subtract long division, one bit at a time. It is linear in the bits times
/// the limbs, which is slow for huge numbers and exact for all of them.
let long_div_bits! !p !a !b !q !r !bit =
    if bit < 0 { 0 } else {
        shift_in! r (big_n! r) 0 (prim.ushr (prim.load64! (limb_at a (bit / 32))) (bit % 32) & 1);
        if magnitude_order! r b >= 0 {
            sub_limbs! r b r 0 (big_n! r) 0;
            let at = limb_at q (bit / 32);
            prim.store64! at (prim.load64! at | (1 << (bit % 32)));
        };
        long_div_bits! p a b q r (bit - 1)
    };

let shift_in! !r !n !i !carry = if i >= n { 0 } else {
    let t = prim.load64! (limb_at r i);
    prim.store64! (limb_at r i) (((t << 1) | carry) & limb_mask);
    shift_in! r n (i + 1) (prim.ushr t 31 & 1)
};

/// `[quotient, remainder]` of two magnitudes, left in the context's scratch words.
let big_divmod! !p !a !b = {
    let n = big_n! a;
    let q = new_big! p n (if big_sign! a == big_sign! b { 0 } else { 1 });
    zero_words! (limb_at q 0) n;
    let r = new_big! p (big_n! b + 1) (big_sign! a);
    zero_words! (limb_at r 0) (big_n! b + 1);
    long_div_bits! p a b q r (n * 32 - 1);
    prim.store64! (p + ctx_scratch) (big_fix! q);
    prim.store64! (p + ctx_scratch2) (big_fix! r);
    0
};

/// Writing backwards from `at`, the next free byte; answers where it stopped.
let big_digits! !b !at = {
    let n = trimmed! b (big_n! b);
    big_trimmed! b n;
    if n == 0 { at } else {
        // Nine digits a step, the most that always fit under one limb's division.
        let rem = div_small! b (n - 1) 1000000000 0;
        let more = trimmed! b n != 0;
        big_digits! b (digit_group! at rem (if more { 9 } else { 0 }) - 1)
    }
};

let digit_group! !at !v !pad =
    if v == 0 && pad <= 0 { at + 1 }
    else {
        prim.store8! at (48 + v % 10);
        digit_group! (at - 1) (v / 10) (pad - 1)
    };

let big_to_string! !p !v = {
    let copy = big_copy! p v (big_n! v);
    // Ten digits to a limb is an overestimate, and the buffer is thrown away.
    let room = big_n! v * 10 + 2;
    let buf = scratch! p ((room + 8) / word * word + word);
    let last = buf + room - 1;
    let first = big_digits! copy last + 1;
    let digits = last + 1 - first;
    let negative = big_sign! v == 1;
    let s = new_string! p (digits + (if negative { 1 } else { 0 }));
    let bytes = string_bytes s;
    if negative { prim.store8! bytes 45; };
    prim.c3! "memcpy" (bytes + (if negative { 1 } else { 0 })) first digits;
    s
};

let big_to_float_at! !b !i !acc = if i < 0 { acc } else {
    big_to_float_at! b (i - 1) (prim.fadd (prim.fmul acc (prim.i2f limb_base)) (prim.i2f (prim.load64! (limb_at b i))))
};

let big_to_float! !b = {
    let m = big_to_float_at! b (big_n! b - 1) (prim.i2f 0);
    if big_sign! b == 1 { prim.fsub (prim.i2f 0) m } else { m }
};

// --- arithmetic that is not two fixnums that fit ------------------------------------

let number_fail! !p s = fail! p atom_type_error s;

let cannot_apply! !p name !a !b = fail_value! p atom_type_error
    (concat2! p (concat_parts! p "cannot apply `" (text_of! p name) "` to ")
                (concat2! p (describe! p a) (concat2! p (text_of! p " and ") (describe! p b))));

let int_or_float_op! !p !op !a !b =
    if (is_float! a || is_float! b) && op == 3 && b == tag_fix 0 { fail! p atom_divide_by_zero "division by zero" }
    else if is_float! a || is_float! b {
        let x = float_bits! a;
        let y = float_bits! b;
        new_float! p (if op == 0 { prim.fadd x y } else if op == 1 { prim.fsub x y }
                      else if op == 2 { prim.fmul x y } else if op == 3 { prim.fdiv x y }
                      else { prim.d2! "fmod" x y })
    } else if op == 0 { big_add! p (as_big! p a) (as_big! p b) false }
    else if op == 1 { big_add! p (as_big! p a) (as_big! p b) true }
    else if op == 2 { big_mul! p (as_big! p a) (as_big! p b) }
    else if b == tag_fix 0 {
        if op == 3 { fail! p atom_divide_by_zero "division by zero" } else { fail! p atom_divide_by_zero "remainder by zero" }
    } else {
        big_divmod! p (as_big! p a) (as_big! p b);
        prim.load64! (p + (if op == 3 { ctx_scratch } else { ctx_scratch2 }))
    };

let is_listish! !v = v == nil_word || is_kind! v kind_cons;

/// The test every float operation asks first, so that one costs a call and not a walk past
/// tensors, strings and lists.
let both_float! !a !b = (a | b) & 7 == 0 && prim.load64! a == prim.info "float" && prim.load64! b == prim.info "float";

let add_slow! !p !a !b =
    if both_float! a b { new_float! p (prim.fadd (prim.load64! (a + word)) (prim.load64! (b + word))) }
    else if is_tensor! a || is_tensor! b { tensor_op! p 0 a b }
    else if is_string! a && is_string! b { concat2! p a b }
    else if is_number! a && is_number! b { int_or_float_op! p 0 a b }
    else if is_listish! a && is_listish! b { deferred2! p (prim.info "lib_concat_lists") a b }
    else { cannot_apply! p "add" a b };

let sub_slow! !p !a !b = if both_float! a b { new_float! p (prim.fsub (prim.load64! (a + word)) (prim.load64! (b + word))) } else if is_tensor! a || is_tensor! b { tensor_op! p 1 a b } else if is_number! a && is_number! b { int_or_float_op! p 1 a b } else { cannot_apply! p "sub" a b };
let mul_slow! !p !a !b = if both_float! a b { new_float! p (prim.fmul (prim.load64! (a + word)) (prim.load64! (b + word))) } else if is_tensor! a || is_tensor! b { tensor_op! p 2 a b } else if is_number! a && is_number! b { int_or_float_op! p 2 a b } else { cannot_apply! p "mul" a b };
let div_slow! !p !a !b = if both_float! a b { new_float! p (prim.fdiv (prim.load64! (a + word)) (prim.load64! (b + word))) } else if is_tensor! a || is_tensor! b { tensor_op! p 3 a b } else if is_number! a && is_number! b { int_or_float_op! p 3 a b } else { cannot_apply! p "div" a b };
let mod_slow! !p !a !b = if is_tensor! a || is_tensor! b { tensor_op! p 4 a b } else if is_number! a && is_number! b { int_or_float_op! p 4 a b } else { cannot_apply! p "mod" a b };

let neg! !p !v =
    if is_tensor! v { tensor_neg! p v }
    else if is_float! v { new_float! p (prim.fneg (prim.load64! (v + word))) }
    else if is_int! v { int_or_float_op! p 1 (tag_fix 0) v }
    else { fail_value! p atom_type_error (concat2! p (text_of! p "cannot negate ") (describe! p v)) };

// --- comparison ---------------------------------------------------------------------

let true_word = 266;
let false_word = 10;
let nil_word = 34;
let unit_word = 2;

let as_word !bit = if bit == 0 { false_word } else { true_word };

let numeric_order! !a !b =
    if is_float! a || is_float! b {
        let x = float_bits! a;
        let y = float_bits! b;
        if prim.flt x y { 0 - 1 } else if prim.flt y x { 1 } else if prim.feq x y { 0 } else { 2 }
    } else if is_fix a && is_fix b {
        if a < b { 0 - 1 } else if a == b { 0 } else { 1 }
    } else {
        // A bignum is past every fixnum, so its sign says.
        let sa = if is_fix a { 2 } else { big_sign! a };
        let sb = if is_fix b { 2 } else { big_sign! b };
        if sa == 2 { if sb == 1 { 1 } else { 0 - 1 } }
        else if sb == 2 { if sa == 1 { 0 - 1 } else { 1 } }
        else if sa != sb { if sa == 1 { 0 - 1 } else { 1 } }
        else {
            let m = magnitude_order! a b;
            if sa == 1 { 0 - m } else { m }
        }
    };

let string_order! !a !b = {
    let n = string_len! a;
    let m = string_len! b;
    let least = if n < m { n } else { m };
    let c = prim.sext32 (prim.c3! "memcmp" (string_bytes a) (string_bytes b) least);
    if c < 0 { 0 - 1 } else if c > 0 { 1 } else if n < m { 0 - 1 } else if n > m { 1 } else { 0 }
};

/// `==`, or a thunk of the library's walk when both are structures: forcing what is
/// inside them is not something a native can do.
let eq_slow! !p !a !b = {
    if is_number! a && is_number! b { as_word (numeric_order! a b == 0) }
    else if is_string! a && is_string! b { as_word (string_eq! a b) }
    else if a == b && not (is_float! a) { true_word }
    else if is_kind! a kind_process && is_kind! b kind_process { as_word (prim.load64! (a + word) == prim.load64! (b + word)) }
    else if is_tensor! a && is_tensor! b { tensor_equal! p a b }
    else if is_object a && is_object b && kind_of! a == kind_of! b && kind_of! a != kind_closure {
        deferred2! p (prim.info "lib_equal") a b
    }
    else if a == nil_word && is_kind! b kind_cons { false_word }
    else { false_word }
};

let ne_slow! !p !a !b = {
    let r = eq_slow! p a b;
    if r == true_word { false_word } else if r == false_word { true_word }
    else { deferred2! p (prim.info "lib_not_equal") a b }
};

let ordered! !p !op !a !b = {
    let c =
        if is_number! a && is_number! b { numeric_order! a b }
        else if is_string! a && is_string! b { string_order! a b }
        else if is_char_word a && is_char_word b { if a < b { 0 - 1 } else if a == b { 0 } else { 1 } }
        else { 3 };
    if c == 3 {
        fail_value! p atom_type_error (concat2! p (concat2! p (text_of! p "cannot order ") (describe! p a))
                                       (concat2! p (text_of! p " against ") (describe! p b)))
    }
    // The VM's rule: a NaN is neither below nor above, so it reads as equal to both.
    else if c == 2 { as_word (op == 1 || op == 3) }
    else { as_word (if op == 0 { c < 0 } else if op == 1 { c <= 0 } else if op == 2 { c > 0 } else { c >= 0 }) }
};

let is_char_word !v = v & 255 == 18;

let lt_slow! !p !a !b = ordered! p 0 a b;
let le_slow! !p !a !b = ordered! p 1 a b;
let gt_slow! !p !a !b = ordered! p 2 a b;
let ge_slow! !p !a !b = ordered! p 3 a b;

/// `compare` on what has an order of its own: -1, 0 or 1 tagged, or 3 tagged when the
/// library must look inside. Different types order by the number of their type.
let type_rank! !v =
    if is_fix v || is_float! v || is_big! v { 1 }
    else if v == unit_word { 0 }
    else if v & 7 == 2 {
        let imm = (v >> 3) & 31;
        if imm == 1 { 2 } else if imm == 2 { 3 } else if imm == 3 { 5 } else { 6 }
    }
    else if is_string! v { 4 }
    else if is_kind! v kind_cons { 6 }
    else if is_kind! v kind_array { 7 }
    else if is_kind! v kind_record { 8 }
    else if is_kind! v kind_map { 9 }
    else { 10 };

let flat_compare! !p !a !b = {
    let ra = type_rank! a;
    let rb = type_rank! b;
    if ra != rb { tag_fix (if ra < rb { 0 - 1 } else { 1 }) }
    else if ra == 1 {
        let c = numeric_order! a b;
        tag_fix (if c == 2 { 0 } else { c })
    }
    else if ra == 4 { tag_fix (string_order! a b) }
    else if ra == 5 { tag_fix (string_order! (atom_name! p a) (atom_name! p b)) }
    else if ra == 2 || ra == 3 || ra == 0 {
        tag_fix (if a < b { 0 - 1 } else if a == b { 0 } else { 1 })
    }
    else { tag_fix 3 }
};

// --- bit operations -----------------------------------------------------------------

let both_fix !a !b = is_fix a && is_fix b;

/// A limb of an integer's two's complement, as if it went on for ever.
let tc_limb! !v !i !carry_at = {
    let raw = big_limb! v i;
    if big_sign! v == 0 { raw } else {
        // Inverted, and one added at the lowest limb that takes it.
        let lower_zero = limbs_zero! v i;
        (if lower_zero { (raw ^ limb_mask) + 1 } else { raw ^ limb_mask }) & limb_mask
    }
};

let limbs_zero! !v !i = if i == 0 { true } else { big_limb! v (i - 1) == 0 && limbs_zero! v (i - 1) };

let bits_into! !out !a !b !op !i !n = if i >= n { 0 } else {
    let x = tc_limb! a i 0;
    let y = tc_limb! b i 0;
    prim.store64! (limb_at out i) (if op == 0 { x & y } else if op == 1 { x | y } else { x ^ y });
    bits_into! out a b op (i + 1) n
};

/// Two's complement the whole way, however long: the answer's top limb says its sign.
let big_bits! !p !a !b !op = {
    let x = as_big! p a;
    let y = as_big! p b;
    let n = (if big_n! x > big_n! y { big_n! x } else { big_n! y }) + 1;
    let out = new_big! p n 0;
    bits_into! out x y op 0 n;
    if prim.load64! (limb_at out (n - 1)) & 2147483648 != 0 {
        // Negative: its magnitude is the complement of what is there, plus one.
        negate_limbs! out 0 n 1;
        prim.store64! (out + 2 * word) (tag_fix 1);
    };
    big_fix! out
};

let negate_limbs! !out !i !n !carry = if i >= n { 0 } else {
    let t = (prim.load64! (limb_at out i) ^ limb_mask) + carry;
    prim.store64! (limb_at out i) (t & limb_mask);
    negate_limbs! out (i + 1) n (prim.ushr t 32)
};

let int_pair! !a !b = is_int! a && is_int! b;

let bit_and! !p !a !b = if both_fix a b { a & b } else if int_pair! a b { big_bits! p a b 0 } else { bit_need! p "`&`" a b };
let bit_or! !p !a !b = if both_fix a b { a | b } else if int_pair! a b { big_bits! p a b 1 } else { bit_need! p "`|`" a b };
let bit_xor! !p !a !b = if both_fix a b { tag_fix (untag_fix a ^ untag_fix b) } else if int_pair! a b { big_bits! p a b 2 } else { bit_need! p "`^`" a b };

let bit_need! !p what !a !b = fail_value! p atom_type_error
    (concat2! p (concat_parts! p "" (text_of! p what) " needs two integers, got ")
                (concat3! p (describe! p a) (text_of! p " and ") (describe! p b)));

let bit_not! !p !a =
    if is_fix a { tag_fix (0 - 1 - untag_fix a) }
    else if is_big! a { int_or_float_op! p 1 (tag_fix (0 - 1)) a }
    else { fail_value! p atom_type_error (concat2! p (text_of! p "`~` needs an integer, got ") (describe! p a)) };

let shift_left! !p !a !b =
    if not (is_int! a && is_fix b) { bit_need! p "`<<`" a b }
    else if untag_fix b < 0 { number_fail! p "a negative shift" }
    else if is_fix a && untag_fix b < 62 && ((untag_fix a << untag_fix b) >> untag_fix b) == untag_fix a
            && (untag_fix a << untag_fix b) < (1 << 62) && (untag_fix a << untag_fix b) >= 0 - (1 << 62) {
        tag_fix (untag_fix a << untag_fix b)
    }
    else { big_shift_left! p a (untag_fix b) };

/// A shift past a fixnum, by the arithmetic it is short for.
let big_shift_left! !p !a !n = if n == 0 { a } else {
    let step = if n > 30 { 30 } else { n };
    big_shift_left! p (big_mul! p (as_big! p a) (as_big! p (tag_fix (1 << step)))) (n - step)
};

let shift_right! !p !a !b =
    if not (is_int! a && is_fix b) { bit_need! p "`>>`" a b }
    else if untag_fix b < 0 { number_fail! p "a negative shift" }
    else if is_fix a { tag_fix (untag_fix a >> (if untag_fix b > 63 { 63 } else { untag_fix b })) }
    else {
        // Towards negative infinity, as a shift of two's complement goes.
        let unit_ = big_shift_left! p (tag_fix 1) (untag_fix b);
        let bottom = if big_sign! a == 1 { int_or_float_op! p 1 (int_or_float_op! p 0 a (tag_fix 1)) unit_ } else { a };
        int_or_float_op! p 3 bottom unit_
    };

// --- numbers ------------------------------------------------------------------------

let to_float! !p !v = if is_float! v { v } else if is_int! v { new_float! p (float_bits! v) } else { number_fail! p "to_float needs a number" };

let to_int! !p !v =
    if is_int! v { v }
    else if is_float! v {
        let bits = prim.load64! (v + word);
        if prim.feq bits bits && prim.flt (prim.fabs bits) (prim.i2f (1 << 62)) { tag_fix (prim.f2i bits) }
        else if prim.feq bits bits && prim.flt (prim.fabs bits) (prim.d1! "exp" (prim.i2f 700)) { float_to_big! p bits }
        else { fail! p atom_type_error "to_int: this float is not a finite number" }
    }
    else { number_fail! p "to_int needs a number" };

/// A float too large for a fixnum, whose digits past 53 bits are all zero anyway.
let float_to_big! !p !bits = {
    let negative = prim.flt bits (prim.i2f 0);
    let m = prim.fabs bits;
    let rec_ = float_limbs! p m (tag_fix 1) (tag_fix 0);
    if negative { neg! p rec_ } else { rec_ }
};

let float_limbs! !p !m !scale !acc =
    if prim.flt m (prim.i2f 1) { acc }
    else {
        let q = prim.d1! "floor" (prim.fdiv m (prim.i2f limb_base));
        let limb = prim.f2i (prim.fsub m (prim.fmul q (prim.i2f limb_base)));
        let part = big_mul! p (as_big! p scale) (as_big! p (tag_fix limb));
        float_limbs! p q (big_mul! p (as_big! p scale) (as_big! p (tag_fix limb_base)))
            (big_add! p (as_big! p acc) (as_big! p part) false)
    };

let float_bytes! !p !v = {
    let s = new_string! p 8;
    prim.store64! (string_bytes s) (float_bits! v);
    s
};

let float_of_bytes! !p !s = new_float! p (prim.load64! (string_bytes s));

/// Python's `repr`: the shortest digits that read back as the same number, positional
/// from 1e-4 up to 1e16.
let shortest_prec! !buf !bits !prec =
    if prec >= 17 { 17 } else {
        prim.fmt_double! buf 64 "%.*g" prec bits;
        if prim.feq (prim.strtod! buf) bits { prec } else { shortest_prec! buf bits (prec + 1) }
    };

let float_text! !p !v = {
    let bits = prim.load64! (v + word);
    let buf = scratch! p 128;
    let prec = shortest_prec! buf bits 1;
    prim.fmt_double! buf 64 "%.*g" prec bits;
    let finite = prim.feq bits bits && prim.flt (prim.fabs bits) (prim.d1! "exp" (prim.i2f 710));
    if finite && not (prim.feq bits (prim.i2f 0)) && prim.c2! "strchr" buf 101 != 0 {
        let exponent = prim.f2i (prim.d1! "floor" (prim.d1! "log10" (prim.fabs bits)));
        if exponent >= 0 - 4 && exponent < 16 {
            let places = prec - 1 - exponent;
            prim.fmt_double! buf 64 "%.*f" (if places < 0 { 0 } else { places }) bits;
        };
    };
    let n = prim.c1! "strlen" buf;
    let s = new_string! p n;
    prim.c3! "memcpy" (string_bytes s) buf n;
    s
};

let digits_value! !s !i !n !acc =
    if i >= n { acc } else {
        let d = prim.load8! (s + i) - 48;
        digits_value! s (i + 1) n (neg_free! acc d)
    };

let neg_free! !acc !d = acc * 10 + d;

let parse_digits_big! !p !s !i !n !acc =
    if i >= n { acc } else {
        let d = prim.load8! (s + i) - 48;
        parse_digits_big! p s (i + 1) n
            (big_add! p (as_big! p (big_mul! p (as_big! p acc) (as_big! p (tag_fix 10)))) (as_big! p (tag_fix d)) false)
    };

let all_digits! !s !i !n = if i >= n { true } else {
    let d = prim.load8! (s + i);
    d >= 48 && d <= 57 && all_digits! s (i + 1) n
};

/// `_parse_int`: decimal digits with an optional sign; unit for anything else.
let parse_int! !p !v = {
    let s = string_bytes v;
    let n = string_len! v;
    let signed = n > 0 && (prim.load8! s == 45 || prim.load8! s == 43);
    let from = if signed { 1 } else { 0 };
    if from >= n || not (all_digits! s from n) { unit_word }
    else {
        let m = if n - from <= 18 { tag_fix (digits_value! s from n 0) } else { parse_digits_big! p s from n (tag_fix 0) };
        if signed && prim.load8! s == 45 { neg! p m } else { m }
    }
};

let parse_float! !p !v = {
    let s = string_bytes v;
    let n = string_len! v;
    if n == 0 { unit_word } else {
        let end = scratch! p word;
        let bits = prim.strtod_end! s end;
        if prim.load64! end == s + n { new_float! p bits } else { unit_word }
    }
};

let pow_int! !p !base !e !acc =
    if e == 0 { acc }
    else {
        let next = if e & 1 == 1 { big_mul! p (as_big! p acc) (as_big! p base) } else { acc };
        if e == 1 { next } else { pow_int! p (big_mul! p (as_big! p base) (as_big! p base)) (e >> 1) next }
    };

let pow! !p !a !b =
    if is_int! a && is_fix b && untag_fix b >= 0 { pow_int! p a (untag_fix b) (tag_fix 1) }
    else if is_number! a && is_number! b { new_float! p (prim.d2! "pow" (float_bits! a) (float_bits! b)) }
    else { number_fail! p "pow needs numbers" };

// --- text ---------------------------------------------------------------------------

let big_or_int_text! !p !v = if is_fix v { int_to_string! p v } else { big_to_string! p v };

/// A slice, clamped as the primitive is.
let clamp !v !low !high = if v < low { low } else if v > high { high } else { v };

let str_slice_any! !p !s !from !n = {
    let size = string_len! s;
    let start = clamp (untag_fix from) 0 size;
    let count = clamp (untag_fix n) 0 (size - start);
    let out = new_string! p count;
    prim.c3! "memcpy" (string_bytes out) (string_bytes s + start) count;
    out
};

let str_byte_any! !p !s !i = {
    let at = untag_fix i;
    if at < 0 || at >= string_len! s { tag_fix (0 - 1) } else { tag_fix (prim.load8! (string_bytes s + at)) }
};

let find_at! !h !hn !n !nn !at =
    if at + nn > hn { 0 - 1 }
    else if prim.sext32 (prim.c3! "memcmp" (h + at) n nn) == 0 { at }
    else { find_at! h hn n nn (at + 1) };

let str_find_any! !p !hay !needle !from = {
    let start = clamp (untag_fix from) 0 (string_len! hay);
    tag_fix (find_at! (string_bytes hay) (string_len! hay) (string_bytes needle) (string_len! needle) start)
};

let rfind_at! !h !n !nn !at =
    if at < 0 { 0 - 1 }
    else if prim.sext32 (prim.c3! "memcmp" (h + at) n nn) == 0 { at }
    else { rfind_at! h n nn (at - 1) };

let str_rfind! !p !hay !needle !from = {
    let top = string_len! hay - string_len! needle;
    let start = if untag_fix from > top { top } else { untag_fix from };
    tag_fix (rfind_at! (string_bytes hay) (string_bytes needle) (string_len! needle) start)
};

let in_set! !b !set !i !n = i < n && (prim.load8! (set + i) == b || in_set! b set (i + 1) n);

let span_at! !s !n !set !m !at !wanted =
    if at >= n { n }
    else if in_set! (prim.load8! (s + at)) set 0 m == wanted { span_at! s n set m (at + 1) wanted }
    else { at };

let str_span! !p !s !from !set = tag_fix (span_at! (string_bytes s) (string_len! s) (string_bytes set) (string_len! set) (clamp (untag_fix from) 0 (string_len! s)) true);
let str_upto! !p !s !from !set = tag_fix (span_at! (string_bytes s) (string_len! s) (string_bytes set) (string_len! set) (clamp (untag_fix from) 0 (string_len! s)) false);

let span_back_at! !s !set !m !at =
    if at <= 0 { 0 }
    else if in_set! (prim.load8! (s + at - 1)) set 0 m { span_back_at! s set m (at - 1) }
    else { at };

let str_span_back! !p !s !until !set = tag_fix (span_back_at! (string_bytes s) (string_bytes set) (string_len! set) (clamp (untag_fix until) 0 (string_len! s)));

/// How many bytes the character at `at` takes, and its value, decoded leniently: what
/// does not spell a scalar is one replacement character per byte.
let utf8_len! !s !n !at = {
    let b = prim.load8! (s + at);
    let want = if b < 128 { 1 } else if b >= 194 && b < 224 { 2 } else if b >= 224 && b < 240 { 3 } else if b >= 240 && b < 245 { 4 } else { 1 };
    if want == 1 || at + want > n || not (continuations! s (at + 1) (want - 1)) { 1 }
    else {
        // Overlong forms, surrogates and what is past the last scalar spell nothing.
        let c = utf8_value! s at want;
        if (want == 3 && (c < 2048 || (c >= 55296 && c <= 57343))) || (want == 4 && (c < 65536 || c > 1114111)) { 1 }
        else { want }
    }
};

let continuations! !s !at !left = left == 0 || (prim.load8! (s + at) & 192 == 128 && continuations! s (at + 1) (left - 1));

let utf8_value! !s !at !len = {
    let b = prim.load8! (s + at);
    if len == 1 { if b < 128 { b } else { 65533 } }
    else if len == 2 { ((b & 31) << 6) + (prim.load8! (s + at + 1) & 63) }
    else if len == 3 { ((b & 15) << 12) + ((prim.load8! (s + at + 1) & 63) << 6) + (prim.load8! (s + at + 2) & 63) }
    else { ((b & 7) << 18) + ((prim.load8! (s + at + 1) & 63) << 12) + ((prim.load8! (s + at + 2) & 63) << 6) + (prim.load8! (s + at + 3) & 63) }
};

let count_chars! !s !n !at !acc = if at >= n { acc } else { count_chars! s n (at + utf8_len! s n at) (acc + 1) };

let str_char_count! !p !v = tag_fix (count_chars! (string_bytes v) (string_len! v) 0 0);

let new_cons! !p !h !t = {
    let o = alloc! p (3 * word);
    prim.store64! o (prim.info "cons");
    prim.store64! (o + word) h;
    prim.store64! (o + 2 * word) t;
    o
};

let char_word !c = c * 256 + 18;

/// Built whole and front to back, keeping the last cell to link the next to.
let chars_from! !p !s !n !at !last = if at >= n { 0 } else {
    let len = utf8_len! s n at;
    let cell = new_cons! p (char_word (utf8_value! s at len)) nil_word;
    prim.store64! (last + 2 * word) cell;
    chars_from! p s n (at + len) cell
};

let str_chars! !p !v = {
    let s = string_bytes v;
    let n = string_len! v;
    if n == 0 { nil_word } else {
        let len = utf8_len! s n 0;
        let first = new_cons! p (char_word (utf8_value! s 0 len)) nil_word;
        chars_from! p s n len first;
        first
    }
};

let case_bytes! !from !to !n !upper = if n == 0 { 0 } else {
    let b = prim.load8! from;
    let changed = if upper { if b >= 97 && b <= 122 { b - 32 } else { b } }
                  else { if b >= 65 && b <= 90 { b + 32 } else { b } };
    prim.store8! to changed;
    case_bytes! (from + 1) (to + 1) (n - 1) upper
};

let str_ascii_case! !p !v !upper = {
    let n = string_len! v;
    let out = new_string! p n;
    case_bytes! (string_bytes v) (string_bytes out) n (upper == true_word);
    out
};

let char_code! !p !c = tag_fix (c >> 8);
let char_of_code! !p !n = {
    let c = untag_fix n;
    if c < 0 || c > 1114111 || (c >= 55296 && c <= 57343) { fail! p atom_type_error "that is not a Unicode scalar value" } else { char_word c }
};

/// Every string of an array of them, joined, copying each once.
let joined_size! !a !i !n !acc = if i >= n { acc } else {
    joined_size! a (i + 1) n (acc + string_len! (prim.load64! (a + (2 + i) * word)))
};

let join_at! !a !i !n !to = if i >= n { 0 } else {
    let s = prim.load64! (a + (2 + i) * word);
    let m = string_len! s;
    prim.c3! "memcpy" to (string_bytes s) m;
    join_at! a (i + 1) n (to + m)
};

let all_strings! !a !i !n = i >= n || (is_string! (prim.load64! (a + (2 + i) * word)) && all_strings! a (i + 1) n);

let join_strings! !p !a = if not (all_strings! a 0 (untag_fix (prim.load64! (a + word)))) {
    type_fail! p "str_concat needs a list of strings"
} else {
    let n = untag_fix (prim.load64! (a + word));
    let out = new_string! p (joined_size! a 0 n 0);
    join_at! a 0 n (string_bytes out);
    out
};

let bytes_into! !p !a !i !n !to = if i >= n { 1 } else {
    let v = prim.load64! (a + (2 + i) * word);
    if not (is_fix v) { fail! p atom_type_error "str_of_bytes needs a list of integers" }
    else if untag_fix v < 0 || untag_fix v > 255 {
        fail_value! p atom_type_error (concat2! p (text_of! p "str_of_bytes needs bytes in 0..255, got ") (int_to_string! p v))
    }
    else {
        prim.store8! (to + i) (untag_fix v);
        bytes_into! p a (i + 1) n to
    }
};

let string_of_bytes! !p !a = {
    let n = untag_fix (prim.load64! (a + word));
    let out = new_string! p n;
    if bytes_into! p a 0 n (string_bytes out) == 0 { 0 } else { out }
};

// --- arrays and records -------------------------------------------------------------

let new_array! !p !n = {
    let o = alloc! p ((2 + n) * word);
    prim.store64! o (prim.info "array");
    prim.store64! (o + word) (tag_fix n);
    o
};

let fill_words! !at !n !v = if n == 0 { 0 } else {
    prim.store64! at v;
    fill_words! (at + word) (n - 1) v
};

let array_new! !p !n !fill = {
    let m = untag_fix n;
    if m < 0 { fail! p atom_type_error "array.new: a negative length" }
    else {
        let o = new_array! p m;
        fill_words! (o + 2 * word) m fill;
        o
    }
};

/// A slot of an array still being built, by the library.
let array_store! !p !a !i !v = {
    prim.store64! (a + (2 + untag_fix i) * word) v;
    a
};

// Whether a value is evaluated all the way down, by a walk that forces nothing and makes nothing:
// what `strict!`, `lazy.settled` and `vm.share!` ask first (rt/lib.dr, `settle`), since what they
// are given has most often been forced already -- a compiler shares its whole loader before each
// phase -- and walking it in the library was a call or two for every cell. False as soon as a
// suspension is met, and the library walks it, forcing as it goes. `functions` says whether a
// function counts as done: to `vm.share!` it does not, since what one captured is asked after.

let quick_settled! !p !v = as_word (all_evaluated! v 1);
let quick_shareable! !p !v = as_word (all_evaluated! v 0);

// A cell, an array, a record or a map found evaluated all the way down is given the twin of its
// info that says so (`@i_cons_s` and the rest, with the same kind and layout), and is not walked
// again: a value never changes once it is made, the mark travels with every copy the collector
// and promotion make, and without it a value shared n levels deep was walked 2^n times -- the
// VM keeps the same mark in its header (`AUX_DEEP_FORCED`). A trunk is remade, never changed
// (`trunk_push!`), so it is marked too, once all of the map under it is evaluated: a window on
// a map may leave some of it out, and asking all of it only ever says no too often. Only a walk
// for `settle` marks or trusts a mark, since to `vm.share!` a function's captures matter and
// the mark says nothing of them.

/// Whether `info` is one of the marked twins: settled, or shareable, which says more.
let settled_info! !info = info == prim.info "cons_s" || info == prim.info "array_s" || info == prim.info "record_s"
    || info == prim.info "map_s" || info == prim.info "map_leaf_s" || info == prim.info "trunk_s" || shareable_info! info;

/// Whether `info` says shareable: evaluated all the way down, and every closure under it has its
/// captures evaluated, which is everything `vm.share!` asks (rt/lib.dr, `share_check`).
let shareable_info! !info = info == prim.info "cons_x" || info == prim.info "array_x" || info == prim.info "record_x"
    || info == prim.info "map_x" || info == prim.info "trunk_x";

/// Whether a walk with `functions` may stop at an object with `info`.
let walked_info! !info !functions = if functions == 1 { settled_info! info } else { shareable_info! info };

/// `v` given its marked twin for a walk with `functions`, when it has one. Settled does not take
/// the place of shareable.
let mark_settled! !v !kind !functions = {
    if functions == 0 {
        if kind == kind_cons { prim.store64! v (prim.info "cons_x"); }
        else if kind == kind_array { prim.store64! v (prim.info "array_x"); }
        else if kind == kind_record { prim.store64! v (prim.info "record_x"); }
        else if kind == kind_map { prim.store64! v (prim.info "map_x"); }
        else if kind == kind_trunk { prim.store64! v (prim.info "trunk_x"); };
    } else if not (shareable_info! (prim.load64! v)) {
        if kind == kind_cons { prim.store64! v (prim.info "cons_s"); }
        else if kind == kind_array { prim.store64! v (prim.info "array_s"); }
        else if kind == kind_record { prim.store64! v (prim.info "record_s"); }
        else if kind == kind_map { prim.store64! v (prim.info "map_s"); }
        else if kind == kind_leaf { prim.store64! v (prim.info "map_leaf_s"); }
        else if kind == kind_trunk { prim.store64! v (prim.info "trunk_s"); };
    };
    1
};

/// Whether `v` carries the shareable mark: where `share_check` stops (rt/lib.dr).
let marked_shareable! !p !v = as_word (is_object v && shareable_info! (prim.load64! v));

/// Whether `v` carries the mark: what `settle_walk` asks before it walks (rt/lib.dr).
let marked_settled! !p !v = as_word (is_object v && settled_info! (prim.load64! v));

let all_evaluated! !v !functions = if not (is_object v) { 1 }
    else if walked_info! (prim.load64! v) functions { 1 }
    else {
    let kind = kind_of! v;
    if kind == kind_ind { all_evaluated! (prim.load64! (v + word)) functions }
    else if kind == kind_thunk || kind == kind_hole { 0 }
    else if kind == kind_cons {
        // A spine is a loop, checked and then marked: walked cell by cell the way the rest is,
        // a long list was as many frames on the machine's stack.
        if spine_evaluated! v functions == 0 { 0 } else { mark_spine! v functions }
    }
    else if kind == kind_array {
        if all_in! (v + 2 * word) (untag_fix (prim.load64! (v + word))) functions == 0 { 0 }
        else { mark_settled! v kind functions }
    }
    else if kind == kind_record {
        if all_in! (v + 3 * word) (untag_fix (prim.load64! (v + word))) functions == 0 { 0 }
        else { mark_settled! v kind functions }
    }
    else if kind == kind_map || kind == kind_leaf { map_evaluated! v functions }
    else if kind == kind_error { all_evaluated! (prim.load64! (v + 2 * word)) functions }
    // To a share, a closure is done when what it captured is evaluated, as `share_check` asks.
    else if kind == kind_closure {
        if functions == 1 || settled_words! v 1 (prim.load64! (prim.load64! v + info_size)) { 1 } else { 0 }
    }
    else if kind == kind_pap { 1 }
    else if kind == kind_trunk {
        if map_evaluated! (trunk_map! v) functions == 0 { 0 } else { mark_settled! v kind functions }
    }
    else { 1 }
};

/// Whether every head along the spine from cell `c` is evaluated all the way down, and whatever
/// ends it.
let spine_evaluated! !c !functions =
    if all_evaluated! (prim.load64! (c + word)) functions == 0 { 0 } else {
        let t = followed! (prim.load64! (c + 2 * word));
        if is_object t && kind_of! t == kind_cons && not (walked_info! (prim.load64! t) functions) {
            spine_evaluated! t functions
        } else { all_evaluated! t functions }
    };

/// Every cell of the spine from `c` marked, to the first that is already or the end.
let mark_spine! !c !functions = {
    mark_settled! c kind_cons functions;
    let t = followed! (prim.load64! (c + 2 * word));
    if is_object t && kind_of! t == kind_cons && not (walked_info! (prim.load64! t) functions) { mark_spine! t functions } else { 1 }
};

/// `v` past any indirections.
let followed! !v = if is_object v && kind_of! v == kind_ind { followed! (prim.load64! (v + word)) } else { v };

let all_in! !at !n !functions = if n <= 0 { 1 }
    else if all_evaluated! (prim.load64! at) functions == 0 { 0 }
    else { all_in! (at + word) (n - 1) functions };

/// A map's branches are marked as they are found evaluated, not only the root: a map is copied
/// along one path for each change, so a new version shares nearly every branch of the last, and
/// marked only at its root, each version was walked again whole.
let map_evaluated! !v !functions = if walked_info! (prim.load64! v) functions { 1 }
    else if kind_of! v == kind_leaf { leaf_evaluated! v functions }
    else if map_children! v 0 (popcount (branch_bitmap! v)) functions == 0 { 0 }
    else { mark_settled! v kind_map functions };

let map_children! !b !i !n !functions = if i >= n { 1 }
    else if map_evaluated! (prim.load64! (branch_slot b i)) functions == 0 { 0 }
    else { map_children! b (i + 1) n functions };

let leaf_evaluated! !l !functions = if l == nil_word { 1 }
    else if all_evaluated! (prim.load64! (l + 2 * word)) functions == 0 { 0 }
    else if all_evaluated! (prim.load64! (l + 3 * word)) functions == 0 { 0 }
    else { leaf_evaluated! (prim.load64! (l + 4 * word)) functions };

/// `a` with its `i`th element the head of the cell `xs`, as the cell holds it: what
/// `array.of_list` stores, with no suspension made of reading it (rt/lib.dr, `array_fill`).
let array_store_head! !p !a !i !xs = {
    prim.store64! (a + (2 + untag_fix i) * word) (prim.load64! (xs + word));
    a
};

let list_of_words! !p !at !n !tail = if n == 0 { tail } else {
    list_of_words! p at (n - 1) (new_cons! p (prim.load64! (at + (n - 1) * word)) tail)
};

let array_to_list! !p !a = list_of_words! p (a + 2 * word) (untag_fix (prim.load64! (a + word))) nil_word;

let new_record! !p !id !n = {
    let o = alloc! p ((3 + n) * word);
    prim.store64! o (prim.info "record");
    prim.store64! (o + word) (tag_fix n);
    prim.store64! (o + 2 * word) id;
    o
};

let is_record! !v = is_kind! v kind_record;

let record_is! !p !id !v = as_word (is_record! v && prim.load64! (v + 2 * word) == id);
let record_id! !p !v = if is_record! v { prim.load64! (v + 2 * word) } else { unit_word };
let record_fields! !p !v = {
    let n = untag_fix (prim.load64! (v + word));
    let a = new_array! p n;
    copy_words! (v + 3 * word) (a + 2 * word) n;
    a
};
let record_of! !p !id !variant !a = {
    note_record_shape! p id (variant == true_word);
    let n = untag_fix (prim.load64! (a + word));
    let r = new_record! p id n;
    copy_words! (a + 2 * word) (r + 3 * word) n;
    r
};
let record_size! !p !v = prim.load64! (v + word);
let record_display! !p !id = {
    let shown = learned_shape! (id >> 8) w_atoms_shown;
    if shown != 0 { shown } else { prim.load64! (prim.info "atom_display" + word * (id >> 8)) }
};

/// What was learned of the record with atom number `i`, in the table at `field`, or 0.
let learned_shape! !i !field = {
    let table = prim.load_acq! (world_at! field);
    if table == 0 || i >= prim.load64! (prim.info "atom_count") + atoms_more_cap { 0 } else { prim.load_acq! (table + i * word) }
};

/// A record of a type the compiler did not know made for the first time: its written name and its
/// type's name, as the VM derives them (`record_type_name` in dream/src/interp.cpp). `app.Point` is a
/// `Point`, and the variant `app.Shape.circle` a `Shape` written `Shape.circle`.
let note_record_shape! !p !id !variant = {
    let i = id >> 8;
    let known = i < prim.load64! (prim.info "atom_count") && prim.load64! (prim.info "atom_types" + word * i) != i;
    if known || learned_shape! i w_atoms_shown != 0 { 0 } else {
        let name = atom_name! p id;
        let n = string_len! name;
        let end = if variant { last_dot! (string_bytes name) n } else { n };
        let dot = last_dot! (string_bytes name) end;
        let start = if dot < end { dot + 1 } else { 0 };
        let type_name = byte_slice! p name start (if end < 0 { n } else { end });
        let shown = if variant { concat2! p type_name (byte_slice! p name end n) } else { type_name };
        let type_atom = vm_intern_atom! p type_name;
        let kept = keep_forever! p shown;
        let l = prim.load64! (world_at! w_lock);
        lock! l;
        if prim.load64! (world_at! w_atoms_shown) == 0 {
            let cap = prim.load64! (prim.info "atom_count") + atoms_more_cap;
            prim.store64! (world_at! w_atoms_type) (map_memory! (cap * word));
            prim.store_rel! (world_at! w_atoms_shown) (map_memory! (cap * word));
        };
        prim.store64! (prim.load64! (world_at! w_atoms_type) + i * word) (type_atom >> 8);
        prim.store_rel! (prim.load64! (world_at! w_atoms_shown) + i * word) kept;
        unlock! l;
        0
    }
};

/// The position of the last `.` before `end`, or `end` if there is none.
let last_dot! !at !end = last_dot_from! at (end - 1) end;
let last_dot_from! !at !i !end = if i < 0 { end } else if prim.load8! (at + i) == 46 { i } else { last_dot_from! at (i - 1) end };

/// Bytes `from` to `to` of a string, as a new one.
let byte_slice! !p !s !from !to = {
    let out = new_string! p (to - from);
    prim.c3! "memcpy" (string_bytes out) (string_bytes s + from) (to - from);
    out
};

/// Whether a function keeps only values: what `vm.share!` asks of one, as the VM's shared area
/// refuses a closure that captured a suspension. A capture already forced is its value.
let captures_settled! !p !v = as_word (not (is_kind! v kind_closure) || settled_words! v 1 (prim.load64! (prim.load64! v + info_size)));

let settled_words! !v !i !n = if i > n { true } else {
    let w = prim.load64! (v + i * word);
    let pending = is_object w && (kind_of! w == kind_thunk || kind_of! w == kind_hole);
    if pending { false } else { settled_words! v (i + 1) n }
};

/// `v` where every process can read it, and a root of the census for the rest of the run.
let keep_forever! !p !v = {
    let kept = promote! p v;
    let sl = prim.load64! (world_at! w_shared_lock);
    lock! sl;
    let cell = prim.c1! "malloc" (2 * word);
    prim.store64! cell (prim.load64! (world_at! w_cb_roots));
    prim.store64! (cell + word) kept;
    prim.store64! (world_at! w_cb_roots) cell;
    unlock! sl;
    kept
};

/// `_match_at`: unforced, for an array or a record's fields.
let match_at! !p !v !i = {
    let at = untag_fix i;
    if is_kind! v kind_array {
        if at >= 0 && at < untag_fix (prim.load64! (v + word)) { prim.load64! (v + (2 + at) * word) }
        else { fail! p atom_out_of_bounds "index out of bounds" }
    } else if is_record! v {
        if at >= 0 && at < untag_fix (prim.load64! (v + word)) { prim.load64! (v + (3 + at) * word) }
        else { fail! p atom_out_of_bounds "index out of bounds" }
    } else if is_string! v { fail! p atom_type_error "a string is not indexed this way" }
    else { fail! p atom_type_error "a pattern read a position of something with none" }
};

let error_kind! !p !e = if is_kind! e kind_error { prim.load64! (e + word) } else { type_fail! p "error_kind needs an error" };
let error_payload! !p !e = if is_kind! e kind_error { prim.load64! (e + 2 * word) } else { type_fail! p "error_payload needs an error" };
let is_error! !v = is_kind! v kind_error;

// --- maps ---------------------------------------------------------------------------
//
// A hash trie, five bits a level. A branch is `[info, n, count, bitmap, slots..]`, `n`
// counting what follows it, and everything tagged; a leaf is `[info, hash, key, value,
// next]`, the hash tagged and so short of its top bit, which is why the level of a key
// is worked out from those 63 bits everywhere. The hash of a string or an integer is
// the VM's, so that a map of them iterates in the order programs have been printing;
// a structure hashes by kind alone, since it moves and has no room for an identity, and
// is found by a walk of the chain. Nothing here forces, and the key has been.

let fnv_prime = 1099511628211;
let fnv_start = 1469598103934665603;

let bytes_hash! !s !n !i !h = if i >= n { h } else {
    bytes_hash! s n (i + 1) ((h ^ prim.load8! (s + i)) * fnv_prime)
};

let mix !h = {
    let a = h ^ prim.ushr h 33;
    let b = a * ((4283543511 << 32) | 3981806797);
    b ^ prim.ushr b 33
};

let key_hash! !v = {
    let h =
        if is_string! v { bytes_hash! (string_bytes v) (string_len! v) 0 fnv_start }
        else if is_float! v { mix (prim.load64! (v + word)) }
        else if is_big! v { mix (prim.load64! (limb_at v 0)) }
        else if is_object v {
            if is_record! v && prim.load64! (v + word) == tag_fix 0 { mix (prim.load64! (v + 2 * word)) }
            else { mix (kind_of! v) }
        }
        else { mix v };
    prim.ushr (h << 1) 1
};

let key_equal! !a !b = {
    if a == b { true }
    else if not (is_object a) || not (is_object b) { false }
    else if is_string! a && is_string! b { string_eq! a b }
    else if is_float! a && is_float! b { prim.feq (prim.load64! (a + word)) (prim.load64! (b + word)) }
    else if is_big! a && is_big! b { numeric_order! a b == 0 }
    else if is_kind! a kind_process && is_kind! b kind_process { prim.load64! (a + word) == prim.load64! (b + word) }
    else if is_record! a && is_record! b {
        prim.load64! (a + word) == tag_fix 0 && prim.load64! (b + word) == tag_fix 0
            && prim.load64! (a + 2 * word) == prim.load64! (b + 2 * word)
    }
    else { false }
};

let popcount !x = {
    let a = x - (prim.ushr x 1 & 1431655765);
    let b = (a & 858993459) + (prim.ushr a 2 & 858993459);
    let c = (b + prim.ushr b 4) & 252645135;
    prim.ushr ((c * 16843009) & 4294967295) 24
};

let branch_count! !b = untag_fix (prim.load64! (b + 2 * word));
let branch_bitmap! !b = untag_fix (prim.load64! (b + 3 * word));
let branch_slot !b !i = b + (4 + i) * word;

let new_branch! !p !slots !count !bitmap = {
    let o = alloc! p ((4 + slots) * word);
    prim.store64! o (prim.info "map");
    prim.store64! (o + word) (tag_fix (slots + 2));
    prim.store64! (o + 2 * word) (tag_fix count);
    prim.store64! (o + 3 * word) (tag_fix bitmap);
    o
};

let map_empty! !p = new_branch! p 0 0 0;

let new_leaf! !p !h !k !v !next = {
    let o = alloc! p (5 * word);
    prim.store64! o (prim.info "map_leaf");
    prim.store64! (o + word) (tag_fix h);
    prim.store64! (o + 2 * word) k;
    prim.store64! (o + 3 * word) v;
    prim.store64! (o + 4 * word) next;
    o
};

let is_leaf! !v = is_kind! v kind_leaf;
let leaf_hash! !l = prim.ushr (prim.load64! (l + word)) 1;

let chain_find! !l !k = if l == nil_word { 0 }
    else if key_equal! (prim.load64! (l + 2 * word)) k { l }
    else { chain_find! (prim.load64! (l + 4 * word)) k };

/// The leaf holding `k`, or 0.
let map_find! !node !h !k !shift = {
    let bit = 1 << (prim.ushr h shift & 31);
    let bitmap = branch_bitmap! node;
    if bitmap & bit == 0 { 0 } else {
        let child = prim.load64! (branch_slot node (popcount (bitmap & (bit - 1))));
        if is_leaf! child { chain_find! child k } else { map_find! child h k (shift + 5) }
    }
};

let chain_replace! !p !l !k !v = if key_equal! (prim.load64! (l + 2 * word)) k {
    new_leaf! p (leaf_hash! l) (prim.load64! (l + 2 * word)) v (prim.load64! (l + 4 * word))
} else {
    new_leaf! p (leaf_hash! l) (prim.load64! (l + 2 * word)) (prim.load64! (l + 3 * word))
        (chain_replace! p (prim.load64! (l + 4 * word)) k v)
};

/// Two leaves of different hashes, under a new branch at `shift`.
let split_leaves! !p !a !b !count !shift = {
    let ia = prim.ushr (leaf_hash! a) shift & 31;
    let ib = prim.ushr (leaf_hash! b) shift & 31;
    if ia == ib {
        let inner = split_leaves! p a b count (shift + 5);
        let o = new_branch! p 1 count (1 << ia);
        prim.store64! (branch_slot o 0) inner;
        o
    } else {
        let o = new_branch! p 2 count ((1 << ia) | (1 << ib));
        prim.store64! (branch_slot o (if ia < ib { 0 } else { 1 })) a;
        prim.store64! (branch_slot o (if ia < ib { 1 } else { 0 })) b;
        o
    }
};

let chain_length! !l = if l == nil_word { 0 } else { 1 + chain_length! (prim.load64! (l + 4 * word)) };

/// `node` with `k` set. Whether it was added is left in the context, since the counts
/// on the way back up depend on it.
let map_assoc! !p !node !h !k !v !shift = {
    let bit = 1 << (prim.ushr h shift & 31);
    let bitmap = branch_bitmap! node;
    let at = popcount (bitmap & (bit - 1));
    let slots = popcount bitmap;
    if bitmap & bit == 0 {
        prim.store64! (p + ctx_scratch) 1;
        let o = new_branch! p (slots + 1) (branch_count! node + 1) (bitmap | bit);
        copy_words! (branch_slot node 0) (branch_slot o 0) at;
        prim.store64! (branch_slot o at) (new_leaf! p h k v nil_word);
        copy_words! (branch_slot node at) (branch_slot o (at + 1)) (slots - at);
        o
    } else {
        let child = prim.load64! (branch_slot node at);
        let replaced =
            if is_leaf! child {
                if leaf_hash! child == h {
                    if chain_find! child k != 0 {
                        prim.store64! (p + ctx_scratch) 0;
                        chain_replace! p child k v
                    } else {
                        prim.store64! (p + ctx_scratch) 1;
                        new_leaf! p h k v child
                    }
                } else {
                    prim.store64! (p + ctx_scratch) 1;
                    split_leaves! p child (new_leaf! p h k v nil_word) (chain_length! child + 1) (shift + 5)
                }
            } else { map_assoc! p child h k v (shift + 5) };
        let o = new_branch! p slots (branch_count! node + prim.load64! (p + ctx_scratch)) bitmap;
        copy_words! (branch_slot node 0) (branch_slot o 0) slots;
        prim.store64! (branch_slot o at) replaced;
        o
    }
};

let map_put! !p !m !k !v = map_assoc! p m (key_hash! k) k v 0;

let map_has! !p !m !k = as_word (is_kind! m kind_map && map_find! m (key_hash! k) k 0 != 0);

let chain_without! !p !l !k = if key_equal! (prim.load64! (l + 2 * word)) k { prim.load64! (l + 4 * word) } else {
    new_leaf! p (leaf_hash! l) (prim.load64! (l + 2 * word)) (prim.load64! (l + 3 * word)) (chain_without! p (prim.load64! (l + 4 * word)) k)
};

/// A branch without slot `at`, or with it replaced when `child` is not `nil_word`.
let branch_changed! !p !node !at !bit !child !count = {
    let slots = popcount (branch_bitmap! node);
    if child == nil_word {
        let o = new_branch! p (slots - 1) count (branch_bitmap! node ^ bit);
        copy_words! (branch_slot node 0) (branch_slot o 0) at;
        copy_words! (branch_slot node (at + 1)) (branch_slot o at) (slots - at - 1);
        o
    } else {
        let o = new_branch! p slots count (branch_bitmap! node);
        copy_words! (branch_slot node 0) (branch_slot o 0) slots;
        prim.store64! (branch_slot o at) child;
        o
    }
};

let map_without! !p !node !h !k !shift = {
    let bit = 1 << (prim.ushr h shift & 31);
    let bitmap = branch_bitmap! node;
    let at = popcount (bitmap & (bit - 1));
    let child = prim.load64! (branch_slot node at);
    if is_leaf! child {
        branch_changed! p node at bit (chain_without! p child k) (branch_count! node - 1)
    } else {
        let inner = map_without! p child h k (shift + 5);
        branch_changed! p node at bit (if popcount (branch_bitmap! inner) == 0 { nil_word } else { inner }) (branch_count! node - 1)
    }
};

let map_remove! !p !m !k = {
    let h = key_hash! k;
    if map_find! m h k 0 == 0 { m } else { map_without! p m h k 0 }
};

let pair_of! !p !k !v = new_cons! p k (new_cons! p v nil_word);

let chain_pairs! !p !l !tail = if l == nil_word { tail } else {
    new_cons! p (pair_of! p (prim.load64! (l + 2 * word)) (prim.load64! (l + 3 * word)))
        (chain_pairs! p (prim.load64! (l + 4 * word)) tail)
};

let node_pairs! !p !node !i !tail = if i < 0 { tail } else {
    let child = prim.load64! (branch_slot node i);
    let with_child = if is_leaf! child { chain_pairs! p child tail }
                     else { node_pairs! p child (popcount (branch_bitmap! child) - 1) tail };
    node_pairs! p node (i - 1) with_child
};

let map_pairs! !p !m = if is_kind! m kind_map { node_pairs! p m (popcount (branch_bitmap! m) - 1) nil_word } else { type_fail! p "map_pairs needs a map" };

/// `_unshared_parts`: the keys and values of `m`, one after another in a list, from every leaf
/// not under a branch already marked shareable: what `share_check` walks of a map (rt/lib.dr).
/// A map is copied along one path for each change, so a new version shares nearly every branch
/// with the last one shared, and walking all of its pairs again made each share of a compiler's
/// loader cost the whole loader -- half of a native compile's serial time.
let unshared_parts! !p !m = if not (is_kind! m kind_map) { type_fail! p "unshared_parts needs a map" }
    else if shareable_info! (prim.load64! m) { nil_word }
    else { unshared_from! p m (popcount (branch_bitmap! m) - 1) nil_word };

let unshared_from! !p !node !i !tail = if i < 0 { tail } else {
    let child = prim.load64! (branch_slot node i);
    let with_child = if not (is_object child) { tail }
                     else if is_leaf! child { leaf_parts! p child tail }
                     else if shareable_info! (prim.load64! child) { tail }
                     else { unshared_from! p child (popcount (branch_bitmap! child) - 1) tail };
    unshared_from! p node (i - 1) with_child
};

let leaf_parts! !p !l !tail = if l == nil_word { tail } else {
    new_cons! p (prim.load64! (l + 2 * word)) (new_cons! p (prim.load64! (l + 3 * word)) (leaf_parts! p (prim.load64! (l + 4 * word)) tail))
};

let map_size! !p !m = tag_fix (branch_count! m);

/// `_match_key`: `[value]` or `[]`, the value unforced.
let match_key! !p !m !k = {
    let l = if is_kind! m kind_map { map_find! m (key_hash! k) k 0 } else { 0 };
    if l == 0 { nil_word } else { new_cons! p (prim.load64! (l + 3 * word)) nil_word }
};

// --- c.[k] and c.[k => v] -----------------------------------------------------------

/// The element, unforced, or 0 when there is none. A list is the library's, since
/// walking one forces it, and is told apart before this.
let peek! !p !c !k =
    if is_kind! c kind_map { let l = map_find! c (key_hash! k) k 0; if l == 0 { 0 } else { prim.load64! (l + 3 * word) } }
    else if is_trunk! c {
        if is_fix k && untag_fix k >= 0 && untag_fix k < trunk_size! c { trunk_read! p k c } else { 0 }
    }
    else if is_fix k && is_tensor! c {
        if untag_fix k >= 0 && untag_fix k < t_dim! c 0 { tensor_index! p c k } else { 0 }
    }
    else if is_fix k && (is_kind! c kind_array || is_record! c) {
        let i = untag_fix k;
        let off = if is_record! c { 3 } else { 2 };
        if i >= 0 && i < untag_fix (prim.load64! (c + word)) { prim.load64! (c + (off + i) * word) } else { 0 }
    }
    else { 0 };

/// Why `peek!` found nothing, as the raise that follows when no `else` was written.
let index_absent! !p !c !k =
    if is_tensor! c {
        fail_value! p atom_out_of_bounds (concat2! p (concat_parts! p "index " (describe! p k) " is outside a tensor of length ")
                                                  (int_to_string! p (tag_fix (t_dim! c 0))))
    }
    else if is_trunk! c {
        fail_value! p atom_out_of_bounds (concat2! p (concat_parts! p "index " (describe! p k) " is outside a trunk of ")
                                                  (int_to_string! p (prim.load64! (c + 2 * word))))
    }
    else if is_kind! c kind_map { fail_value! p atom_no_such_key (concat2! p (text_of! p "the map has no key ") (describe! p k)) }
    else if is_record! c {
        if is_fix k {
            fail_value! p atom_out_of_bounds (concat2! p (concat_parts! p "field " (int_to_string! p k) " is outside ") (describe! p c))
        } else { fail_value! p atom_type_error (concat2! p (text_of! p "a field of a record is read by position, not ") (describe! p k)) }
    }
    else if is_kind! c kind_array {
        if is_fix k {
            fail_value! p atom_out_of_bounds (concat2! p (concat_parts! p "index " (int_to_string! p k) " is outside an array of ")
                                                      (int_to_string! p (prim.load64! (c + word))))
        } else { fail_value! p atom_type_error (concat2! p (text_of! p "an array is indexed by an integer, not ") (describe! p k)) }
    }
    else { fail_value! p atom_type_error (concat2! p (text_of! p "`.[ ]` reads a map, an array, a list or a trunk, not ") (describe! p c)) };

/// A list's walk ran out, the library having counted how far.
let past_end_error! !p !k !walked =
    error_new! p atom_out_of_bounds (concat2! p (concat_parts! p "index " (int_to_string! p k) " is past the end of a list of ")
                                             (int_to_string! p walked));

let index_set! !p !c !k !v =
    if is_kind! c kind_map { map_put! p c k v }
    else if is_trunk! c { trunk_set! p k v c }
    else if is_fix k && (is_kind! c kind_array || is_record! c) {
        let n = untag_fix (prim.load64! (c + word));
        let i = untag_fix k;
        if i < 0 || i >= n { fail! p atom_out_of_bounds "index out of bounds" }
        else {
            let off = if is_record! c { 3 } else { 2 };
            let o = alloc! p ((off + n) * word);
            copy_words! c o (off + n);
            prim.store64! (o + (off + i) * word) v;
            o
        }
    }
    else { fail! p atom_type_error "this value cannot be updated" };

// --- what the library needs of the runtime --------------------------------------------

let exit! !p !code = prim.c1! "exit" (untag_fix code);

let write_err! !p !s = {
    prim.c3! "write" 2 (string_bytes s) (string_len! s);
    unit_word
};

let closure_name! !p !f = prim.load64! (prim.load64! f + info_name);
let is_process! !v = is_kind! v kind_process;

let is_record_value! !p !v = as_word (is_record! v);

/// For the library, which raises by calling this: the 0 is what raises.
let raise_value! !p !e = {
    prim.store64! (p + ctx_error) e;
    0
};

let process_text! !p !v = concat3! p (text_of! p "<process ") (int_to_string! p (prim.load64! (v + word))) (text_of! p ">");

let concat_any_text! !p !v = v;

/// The same with the value forced, as the caller's call has made it.
let array_force_store! !p !a !i !v = array_store! p a i v;

let raise_or_wrap! !p !v = {
    prim.store64! (p + ctx_error) (if is_error! v { v } else { error_new! p atom_error v });
    0
};

/// What a `switch_atom` keys on: a record is told by its id.
let atom_key! !p !v = if is_record! v { prim.load64! (v + 2 * word) } else { v };

/// What a `switch_head` looks at, unforced: a cell's head or an array's first item,
/// and for anything else a word no key can equal.
let head_of! !p !v =
    if is_kind! v kind_cons { prim.load64! (v + word) }
    else if is_kind! v kind_array && prim.load64! (v + word) != tag_fix 0 { prim.load64! (v + 2 * word) }
    else { unit_word };

/// A cell's parts, unforced, for where the program may ask of something that is not one.
let list_head! !p !v = if is_kind! v kind_cons { prim.load64! (v + word) } else { fail! p atom_type_error "head needs a non-empty list" };
let list_tail! !p !v = if is_kind! v kind_cons { prim.load64! (v + 2 * word) } else { fail! p atom_type_error "tail needs a non-empty list" };

// --- processes ------------------------------------------------------------------------
//
// Green, on one OS thread, each with a heap of its own. A message, a new process's work and
// a process's answer are copied (`copy_out!`), so no process points into another's heap. A
// process is a control block of raw words and a stack of its own, reserved and touched
// as needed; what other processes leave in its record -- messages, joiners, monitors -- is
// raw memory too, since a record is read and written from outside it. Everything here runs in tail position on the machine stack, so a switch is
// a jump to the next process's top frame. What may block is a machine function: when
// it cannot go on it pushes a frame that will call it again, and that frame is what the
// process resumes in; nothing has to be undone and nothing is half done.

let pcb_id = 0;
let pcb_sp = 8;
let pcb_state = 16;
let pcb_stack = 24;
let pcb_mail_head = 40;
let pcb_mail_tail = 48;
let pcb_mail_count = 56;
let pcb_result = 64;
let pcb_failed = 72;
let pcb_monitors = 80;
let pcb_wake_at = 88;
let pcb_next = 96;
let pcb_joiners = 104;
let pcb_kill = 112;
let pcb_resume = 120;
let pcb_joined = 128;
let pcb_killing = 136;
let pcb_wait_fd = 144;
let pcb_wait_write = 152;
let pcb_stack_size = 160;
let pcb_listed = 168;
// Its heap, while another runs (`save_heap!`).
let pcb_hp = 176;
let pcb_limit = 184;
let pcb_chunks = 192;
let pcb_total = 200;
let pcb_want_gc = 208;
let pcb_budget = 216;
/// The first message not yet taken into the heap, or 0: what came before it has been.
let pcb_mail_fresh = 224;
/// The worker running it, or 0: what a kill sets the guard of.
let pcb_worker = 232;
/// A wake that came while it was not parked (see "locks").
let pcb_woken = 240;
/// A word spun on (see "locks").
let pcb_lock = 248;
/// The worker it is pinned to, or 0: one that has called C runs on that thread from then on.
let pcb_pinned = 256;
/// The census round it is to report to, or 0.
let pcb_census_due = 264;
/// What `vm.per_process` has answered it, or 0: a list in its heap, a key and its value in turn.
let pcb_kept = 272;
/// Its native stack, or 0 before it first runs: the machine's stack while it does
/// (dreams/docs/aot-direct.md, "Stacks").
let pcb_nstack = 280;
/// 1 while a worker is on that stack: a process made runnable as it parks is still running there
/// until it reaches the scheduler and switches off, and another worker taking it waits for that.
let pcb_on_stack = 288;
/// How much address space that stack was given.
let pcb_nstack_size = 296;
/// Where its native stack stood when it stopped with something on it to come back to, or 0: under
/// code that jumps, a process parks with nothing there and is run again from the top.
let pcb_nsp = 304;
let pcb_size = 312;

// A message waiting: `[next, value, segments, bytes]`. Until its receiver takes its segments into
// its heap (`take_mail!`) they are nobody's, and the value is only in them.
let mail_value = 8;
let mail_segments = 16;
let mail_bytes = 24;

let state_ready = 0;
let state_running = 1;
let state_waiting = 2;
let state_done = 3;

// --- locks ------------------------------------------------------------------------------
//
// A record is written by other processes, which on many workers means other threads: its state,
// its mailbox, its joiners and monitors, its kill. All of that is under its lock, held for a few
// stores and never across a park. Parking is check-then-sleep, and the lost wake is closed by
// `pcb_woken`: a wake of a process that is not parked yet is remembered, and the park that
// follows goes round again instead of sleeping. Locks are taken in one order -- a record's, then
// a run queue's or the scheduler's -- and none is held while another record's is taken.

let lock! !m = prim.c1! "pthread_mutex_lock" m;
let unlock! !m = prim.c1! "pthread_mutex_unlock" m;
let try_lock! !m = prim.sext32 (prim.c1! "pthread_mutex_trylock" m) == 0;

let new_lock! () = prim.c2! "calloc" 1 64;

// A record's lock and a run queue's are a word, spun on: what they guard is a few stores, and a
// mutex that sleeps cost a system call each time two workers met at one, which on a run where
// fifty thousand processes answer one was most of its time. The scheduler's own lock is a mutex,
// as it is waited on with a condition and held across a scan of the waiters.

let spin_lock! !m = if prim.cas64! m 0 1 == 0 { 0 } else { spin_wait! m 0 };

let spin_wait! !m !n =
    if prim.load_acq! m != 0 {
        if n > 4096 { prim.c0! "sched_yield"; } else { prim.pause! (); };
        spin_wait! m (n + 1)
    }
    else if prim.cas64! m 0 1 == 0 { 0 }
    else { spin_wait! m (n + 1) };

let spin_unlock! !m = prim.store_rel! m 0;

let pcb_lock! !pcb = spin_lock! (pcb + pcb_lock);
let pcb_unlock! !pcb = spin_unlock! (pcb + pcb_lock);

let table_cap = 16777216;

let table_at! !p !id = prim.load64! (prim.load64! (world_at! w_table) + id * word);

let pcb_of_pid! !p !pid = table_at! p (untag_fix (prim.load64! (pid + word)));

let new_pid! !p !id = {
    let o = alloc! p (2 * word);
    prim.store64! o (prim.info "process");
    prim.store64! (o + word) (tag_fix id);
    o
};

// --- run queues -------------------------------------------------------------------------
//
// One a worker, of processes ready to run. A wake puts the woken on the waker's own queue, so a
// pair of processes passing messages stays on one core; a worker with nothing takes half of
// another's. Only its own worker adds to a queue, which is why an empty one can be seen to be
// empty without its lock.

let run_push! !p !pcb = run_push_on! p p pcb;

/// `pcb` on worker `w`'s queue, from this context, which is `w` itself but for the blocking pool.
let run_push_on! !p !w0 !pcb = {
    let pinned = prim.load64! (pcb + pcb_pinned);
    let w = if pinned != 0 { pinned } else { w0 };
    prim.store64! (pcb + pcb_next) 0;
    let l = prim.load64! (w + ctx_run_lock);
    spin_lock! l;
    let tail = prim.load64! (w + ctx_run_tail);
    if tail == 0 { prim.store64! (w + ctx_run_head) pcb; } else { prim.store64! (tail + pcb_next) pcb; };
    prim.store64! (w + ctx_run_tail) pcb;
    prim.store64! (w + ctx_run_count) (prim.load64! (w + ctx_run_count) + 1);
    spin_unlock! l;
    // Someone asleep may have nothing, and this is something; unless someone is already looking,
    // who will find it without a trip through the kernel. On another worker's queue it is for that
    // worker -- it is pinned there, or the pool chose it -- and every sleeper is woken, as which
    // of them a signal wakes is the kernel's choice, and only that one may take a pinned process.
    if prim.load_acq! (world_at! w_idle) != 0 {
        if w != p { nudge_all! p; } else if prim.load_acq! (world_at! w_spinning) == 0 { nudge! p; };
    };
    // And the worker it is for may be the one waiting in `epoll`, which no condition reaches.
    if w != p && prim.load_acq! (world_at! w_polling) != 0 { interrupt_poll! p; };
    0
};

let nudge! !p = if prim.load64! (p + ctx_sched_held) != 0 {
    prim.c1! "pthread_cond_signal" (prim.load64! (world_at! w_cond))
} else {
    sched_lock! p;
    prim.c1! "pthread_cond_signal" (prim.load64! (world_at! w_cond));
    sched_unlock! p;
    0
};

let nudge_all! !p = if prim.load64! (p + ctx_sched_held) != 0 {
    prim.c1! "pthread_cond_broadcast" (prim.load64! (world_at! w_cond))
} else {
    sched_lock! p;
    prim.c1! "pthread_cond_broadcast" (prim.load64! (world_at! w_cond));
    sched_unlock! p;
    0
};

let sched_lock! !p = {
    lock! (prim.load64! (world_at! w_sched_lock));
    prim.store64! (p + ctx_sched_held) 1;
    0
};

let sched_unlock! !p = {
    prim.store64! (p + ctx_sched_held) 0;
    unlock! (prim.load64! (world_at! w_sched_lock))
};

let run_pop! !p = if prim.load64! (p + ctx_run_head) == 0 { 0 } else {
    let l = prim.load64! (p + ctx_run_lock);
    spin_lock! l;
    let pcb = prim.load64! (p + ctx_run_head);
    if pcb != 0 {
        let next = prim.load64! (pcb + pcb_next);
        prim.store64! (p + ctx_run_head) next;
        if next == 0 { prim.store64! (p + ctx_run_tail) 0; };
        prim.store64! (p + ctx_run_count) (prim.load64! (p + ctx_run_count) - 1);
    };
    spin_unlock! l;
    pcb
};

let unpinned_run! !pcb !n !k = if k >= n || pcb == 0 || prim.load64! (pcb + pcb_pinned) != 0 { k }
    else { unpinned_run! (prim.load64! (pcb + pcb_next)) n (k + 1) };

/// The first `n` of a queue cut off it: the rest, which stays.
let cut_after! !pcb !n = if n <= 1 || prim.load64! (pcb + pcb_next) == 0 { pcb } else { cut_after! (prim.load64! (pcb + pcb_next)) (n - 1) };

/// Half of another worker's queue, the first of it to run and the rest on this one's.
let steal_from! !p !w = if w == p || prim.load64! (w + ctx_run_head) == 0 { 0 } else {
    let l = prim.load64! (w + ctx_run_lock);
    spin_lock! l;
    let head = prim.load64! (w + ctx_run_head);
    let count = prim.load64! (w + ctx_run_count);
    let got = if head == 0 || prim.load64! (head + pcb_pinned) != 0 { 0 } else {
        // Half, but no further than the first that is pinned here.
        let n = unpinned_run! head ((count + 1) / 2) 0;
        let last = cut_after! head n;
        let rest = prim.load64! (last + pcb_next);
        prim.store64! (w + ctx_run_head) rest;
        if rest == 0 { prim.store64! (w + ctx_run_tail) 0; };
        prim.store64! (w + ctx_run_count) (count - n);
        prim.store64! (last + pcb_next) 0;
        head
    };
    spin_unlock! l;
    if got == 0 { 0 } else {
        let more = prim.load64! (got + pcb_next);
        if more != 0 { requeue! p more; };
        got
    }
};

let requeue! !p !pcb = if pcb == 0 { 0 } else {
    let next = prim.load64! (pcb + pcb_next);
    run_push! p pcb;
    requeue! p next
};

let steal_round! !p !i !n !start = if i >= n { 0 } else {
    let w = prim.load64! (prim.load64! (world_at! w_worker_ctx) + ((start + i) % n) * word);
    let got = steal_from! p w;
    if got != 0 { got } else { steal_round! p (i + 1) n start }
};

let steal! !p = {
    let n = prim.load64! (world_at! w_started);
    if n <= 1 { 0 } else { steal_round! p 0 n (prim.load64! (p + ctx_index) + 1) }
};

/// Anything in any queue, pinned or not: what the deadlock test asks, since a worker woken for
/// a process pinned to it may not have taken the lock again yet.
let any_queue! !i !n = i < n && (prim.load64! (prim.load64! (prim.load64! (world_at! w_worker_ctx) + i * word) + ctx_run_head) != 0 || any_queue! (i + 1) n);

/// Anything this worker could run: its own queue, or another's not starting with one pinned there.
let anything_queued! !p !i !n = if i >= n { false } else {
    let w = prim.load64! (prim.load64! (world_at! w_worker_ctx) + i * word);
    let head = prim.load64! (w + ctx_run_head);
    (head != 0 && (w == p || prim.load64! (head + pcb_pinned) == 0)) || anything_queued! p (i + 1) n
};

/// Runnable again, if it was parked; if not, it is told, so that the park it may be about
/// to make does not sleep through this.
let wake! !p !pcb = {
    pcb_lock! pcb;
    if prim.load64! (pcb + pcb_state) == state_waiting {
        prim.store64! (pcb + pcb_state) state_ready;
        prim.store64! (pcb + pcb_wake_at) (0 - 1);
        pcb_unlock! pcb;
        run_push! p pcb
    } else {
        prim.store64! (pcb + pcb_woken) 1;
        pcb_unlock! pcb;
        0
    }
};

let new_pcb! !p = {
    let id = prim.xadd64! (world_at! w_next_id) 1;
    if id >= table_cap { fatal! "dream: too many processes\n"; };
    let pcb = prim.c2! "calloc" 1 pcb_size;
    prim.store64! (pcb + pcb_id) id;
    prim.store64! (pcb + pcb_budget) (if id == 1 { min_chunk } else { first_budget });
    prim.store64! (pcb + pcb_result) unit_word;
    prim.store64! (pcb + pcb_resume) unit_word;
    prim.store64! (pcb + pcb_wake_at) (0 - 1);
    prim.store64! (pcb + pcb_kill) 0;
    let size = if id == 1 { stack_bytes } else { first_stack };
    let stack = if size == first_stack { first_stack_memory! p } else { stack_memory! size };
    prim.store64! (pcb + pcb_stack) stack;
    prim.store64! (pcb + pcb_stack_size) size;
    let top = stack + size;
    prim.store64! (top - word) (prim.info "halt");
    prim.store64! (pcb + pcb_sp) (top - word);
    prim.xadd64! (world_at! w_live) 1;
    prim.store_rel! (prim.load64! (world_at! w_table) + id * word) pcb;
    pcb
};

let stack_top! !pcb = prim.load64! (pcb + pcb_stack) + prim.load64! (pcb + pcb_stack_size);

// A process starts on a small stack and moves to one twice the size when it runs out, at the one
// place that can happen, a function's entry. It can move because nothing holds an address on it:
// frames hold values, and only the running process moves, whose stack pointer is in hand. A call into C is the exception, since C may call back onto this stack
// while its caller still holds where it was: it makes room first, and a callback cannot grow.
// The first process does not start small, as it is where a deep recursion usually is, and
// mapping costs nothing it does not touch.

let stack_memory! !size = if size >= 1048576 { map_memory! size } else { prim.c1! "malloc" size };

// A first stack is kept by the worker that freed it, a few hundred of them: a program that starts
// and ends processes by the thousand otherwise asks `malloc` for each, and on many threads a stack
// freed on one worker and taken on another is a trip through the allocator's locks.
let kept_stacks = 256;

let first_stack_memory! !p = {
    let s = prim.load64! (p + ctx_stacks);
    if s == 0 { stack_memory! first_stack } else {
        prim.store64! (p + ctx_stacks) (prim.load64! s);
        prim.store64! (p + ctx_stack_count) (prim.load64! (p + ctx_stack_count) - 1);
        s
    }
};

let stack_done! !p !at !size = if size == first_stack && prim.load64! (p + ctx_stack_count) < kept_stacks {
    prim.store64! at (prim.load64! (p + ctx_stacks));
    prim.store64! (p + ctx_stacks) at;
    prim.store64! (p + ctx_stack_count) (prim.load64! (p + ctx_stack_count) + 1);
    0
} else { stack_release! at size };

let stack_release! !at !size = {
    if size >= 1048576 { prim.c2! "munmap" at size; } else { prim.c1! "free" at; };
    0
};

/// The stack moved to one of `size` bytes: the new stack pointer.
let move_stack! !p !sp !size = {
    let pcb = current! p;
    let top = stack_top! pcb;
    let used = top - sp;
    let fresh_ = stack_memory! size;
    let below = fresh_ + size - used;
    prim.c3! "memcpy" below sp used;
    stack_release! (prim.load64! (pcb + pcb_stack)) (prim.load64! (pcb + pcb_stack_size));
    prim.store64! (pcb + pcb_stack) fresh_;
    prim.store64! (pcb + pcb_stack_size) size;
    make_current! p pcb;
    below
};

/// The process in hand: what the context's fast fields are of.
let make_current! !p !pcb = {
    // Room below the guard for what runs between two entries, and at full size for reporting
    // that the recursion has gone too deep.
    let size = prim.load64! (pcb + pcb_stack_size);
    // A small stack keeps half of itself below the guard: what is pushed between two entries -- a
    // frame, a call's arguments past the third, a partial application's -- lands there before
    // anything asks whether it fits.
    let floor = prim.load64! (pcb + pcb_stack) + (if size >= stack_bytes { stack_margin } else if size <= 65536 { size / 2 } else { size / 4 });
    prim.store64! (p + ctx_current) pcb;
    prim.store64! (p + ctx_current_id) (tag_fix (prim.load64! (pcb + pcb_id)));
    prim.store64! (p + ctx_stack_top) (stack_top! pcb);
    prim.store64! (p + ctx_floor) floor;
    prim.store64! (p + ctx_guard) floor;
    prim.store64! (pcb + pcb_state) state_running;
    prim.store64! (pcb + pcb_worker) p;
    0
};

let current! !p = prim.load64! (p + ctx_current);

/// The running process put down: its heap saved, and nothing of it left where this worker
/// might allocate before the next one runs.
let leave! !p !pcb = {
    save_heap! p pcb;
    prim.store64! (pcb + pcb_worker) 0;
    prim.store64! (p + ctx_hp) 0;
    prim.store64! (p + ctx_limit) 0;
    0
};

// --- the timeline -----------------------------------------------------------------------
//
// `DREAM_TIMELINE=FILE`, as the VM writes it (dream/src/scheduler.cpp): each slice a process ran,
// each spawn and each join that had to wait, a line each, which `dream/tools/timeline.py` follows
// back from the root's exit to find what a run's wall clock is made of. A line is written as it
// happens, to a file opened to append, so that workers' lines never interleave.

let timeline_open! () = {
    let path = prim.c1! "getenv" "DREAM_TIMELINE";
    if path != 0 {
        // O_WRONLY|O_CREAT|O_TRUNC|O_APPEND, 0644.
        let fd = prim.c3! "open" path 1601 420;
        if fd >= 0 { prim.store64! (world_at! w_timeline) (fd + 1); prim.store64! (world_at! w_timeline_t0) (clock_ns! ()); };
    };
    0
};

let timeline_on! () = prim.load64! (world_at! w_timeline) != 0;

/// The monotonic clock in nanoseconds, with a buffer of its own.
let clock_ns! () = {
    let buf = prim.c1! "malloc" 16;
    prim.c2! "clock_gettime" 1 buf;
    let ns = prim.load64! buf * 1000000000 + prim.load64! (buf + word);
    prim.c1! "free" buf;
    ns
};

/// Microseconds since the run began.
let timeline_now! () = (clock_ns! () - prim.load64! (world_at! w_timeline_t0)) / 1000;

/// One line: `kind end worker 1 pid other t0 t1 -`, the kind and the end as `kind * 256 + end`.
let timeline_line! !p !kind_end !pid !other !t0 !t1 = if timeline_on! () {
    let buf = prim.c1! "malloc" 256;
    prim.c6! "snprintf" buf 96 "%c %c %ld 1 " (kind_end / 256) (kind_end % 256) (prim.load64! (p + ctx_index));
    let a = prim.c1! "strlen" buf;
    prim.c5! "snprintf" (buf + a) 80 "%ld %ld " pid other;
    let b = prim.c1! "strlen" buf;
    prim.c5! "snprintf" (buf + b) 80 "%ld %ld -\n" t0 t1;
    prim.c3! "write" (prim.load64! (world_at! w_timeline) - 1) buf (prim.c1! "strlen" buf);
    prim.c1! "free" buf;
    0
} else { 0 };

// --- time -------------------------------------------------------------------------------

let now_ns! !p = {
    let buf = prim.load64! (p + ctx_timebuf);
    prim.c2! "clock_gettime" 1 buf;
    prim.load64! buf * 1000000000 + prim.load64! (buf + word)
};

// Who is waiting for a time or for the system. Timers are a binary heap of `[at, id]`, earliest
// first, under the scheduler's lock; a process woken some other way leaves its entry behind, which
// is dropped when it comes to the top and is found not to be the process's timer any more.
//
// A descriptor has a slot, `[lock, ready, waiters, registered]`, in a table the size of the handle
// table, under a lock of its own: every wait on a socket takes it, and with one lock for all of
// them workers queued there, a system call each. It is registered with `epoll` once, the first
// time anyone waits on it, edge-triggered, so that a wait is no system call at all. An edge that
// comes with nobody waiting sets `ready`, and a process about to wait that finds its direction
// there goes round again instead: the edge may have come after its read found nothing. Each
// waiter says which direction it wants, and only those an event is for are woken. Before this,
// the poller built its list from every waiter on every call, which was quadratic in sockets.

let fd_slots = 1048576;

// `struct epoll_event` is packed on x86-64, twelve bytes with its data at 4; on aarch64 it is
// sixteen, with its data at 8.
let epoll_event_size! () = if prim.arch () == arch_aarch64 { 16 } else { 12 };
let epoll_data_at! () = if prim.arch () == arch_aarch64 { 8 } else { 4 };
let epoll_in = 1;
let epoll_out = 4;
let epoll_err = 8;
let epoll_hup = 16;
let epoll_rdhup = 8192;
let epoll_et = 2147483648;
let epoll_batch = 128;
let slot_words = 4;

/// Anyone waiting for a time or a descriptor.
let waiting_on_system! () = prim.load64! (world_at! w_wait_count) != 0 || prim.load64! (world_at! w_fd_waiting) != 0;

let timer_at! !i = prim.load64! (world_at! w_wait_ids) + i * 2 * word;

let timer_swap! !i !j = {
    let a = timer_at! i;
    let b = timer_at! j;
    let at = prim.load64! a;
    let id = prim.load64! (a + word);
    prim.store64! a (prim.load64! b);
    prim.store64! (a + word) (prim.load64! (b + word));
    prim.store64! b at;
    prim.store64! (b + word) id;
    0
};

let timer_up! !i = if i == 0 { 0 } else {
    let parent = (i - 1) / 2;
    if prim.load64! (timer_at! i) < prim.load64! (timer_at! parent) { timer_swap! i parent; timer_up! parent } else { 0 }
};

let timer_down! !i !n = {
    let l = 2 * i + 1;
    let r = l + 1;
    let least = if l < n && prim.load64! (timer_at! l) < prim.load64! (timer_at! i) { l } else { i };
    let least2 = if r < n && prim.load64! (timer_at! r) < prim.load64! (timer_at! least) { r } else { least };
    if least2 != i { timer_swap! i least2; timer_down! least2 n } else { 0 }
};

let timer_push! !at !id = {
    let n = prim.load64! (world_at! w_wait_count);
    if n >= prim.load64! (world_at! w_wait_cap) {
        let cap = if n == 0 { 64 } else { n * 2 };
        prim.store64! (world_at! w_wait_ids) (prim.c2! "realloc" (prim.load64! (world_at! w_wait_ids)) (cap * 2 * word));
        prim.store64! (world_at! w_wait_cap) cap;
    };
    prim.store64! (timer_at! n) at;
    prim.store64! (timer_at! n + word) id;
    prim.store64! (world_at! w_wait_count) (n + 1);
    timer_up! n;
    0
};

let timer_pop! () = {
    let n = prim.load64! (world_at! w_wait_count) - 1;
    timer_swap! 0 n;
    prim.store64! (world_at! w_wait_count) n;
    timer_down! 0 n;
    0
};

let earliest_timer! () = if prim.load64! (world_at! w_wait_count) == 0 { 0 - 1 } else { prim.load64! (timer_at! 0) };

/// Every timer that has run out, its process woken if it is still that process's.
let expire_timers! !p !now = if prim.load64! (world_at! w_wait_count) == 0 || prim.load64! (timer_at! 0) > now { 0 } else {
    let id = prim.load64! (timer_at! 0 + word);
    timer_pop! ();
    let pcb = table_at! p id;
    // Gone, if the census reaped it: a finished process waits for nothing.
    if pcb != 0 { expire! p pcb now; };
    expire_timers! p now
};

/// The heap with only the timers some process is still waiting on: what the deadlock test asks.
let live_timers! !p !i !kept = if i >= prim.load64! (world_at! w_wait_count) {
    prim.store64! (world_at! w_wait_count) kept;
    rebuild_timers! (kept / 2) kept;
    kept
} else {
    let at = prim.load64! (timer_at! i);
    let id = prim.load64! (timer_at! i + word);
    let pcb = table_at! p id;
    if prim.load64! (pcb + pcb_state) != state_done && prim.load64! (pcb + pcb_wake_at) == at {
        prim.store64! (timer_at! kept) at;
        prim.store64! (timer_at! kept + word) id;
        live_timers! p (i + 1) (kept + 1)
    } else { live_timers! p (i + 1) kept }
};

let rebuild_timers! !i !n = if i < 0 { 0 } else { timer_down! i n; rebuild_timers! (i - 1) n };

/// After a new waiter: whoever is polling sees the change, or someone asleep wakes to poll.
let tell_poller! !p = {
    if prim.load64! (world_at! w_polling) != 0 { interrupt_poll! p; }
    else if prim.load64! (world_at! w_idle) != 0 { prim.c1! "pthread_cond_signal" (prim.load64! (world_at! w_cond)); };
    0
};

/// A time `pcb` is to be woken at, noted where the scheduler looks.
let note_timer! !p !pcb !at = {
    sched_lock! p;
    timer_push! at (prim.load64! (pcb + pcb_id));
    let e = prim.load64! (world_at! w_earliest);
    if e < 0 || at < e {
        prim.store64! (world_at! w_earliest) at;
        // A poll waiting longer than this has to be cut short.
        if prim.load64! (world_at! w_polling) != 0 { interrupt_poll! p; };
    };
    if prim.load64! (world_at! w_polling) == 0 && prim.load64! (world_at! w_idle) != 0 {
        prim.c1! "pthread_cond_signal" (prim.load64! (world_at! w_cond));
    };
    sched_unlock! p;
    0
};

let interrupt_poll! !p = {
    let buf = prim.load64! (p + ctx_timebuf);
    prim.store64! buf 1;
    prim.c3! "write" (prim.load64! (world_at! w_wakefd)) buf 8;
    0
};

let fd_slot! !fd = prim.load64! (world_at! w_fds) + fd * slot_words * word;

/// `fd` registered with `epoll`, if it is not yet. Answers whether the system will tell, which
/// for a regular file it will not. The slot's lock is held.
let epoll_register! !p !fd !slot = if prim.load64! (slot + 3 * word) != 0 { true } else {
    let ev = prim.load64! (p + ctx_timebuf);
    prim.store32! ev (epoll_in | epoll_out | epoll_rdhup | epoll_et);
    prim.store64! (ev + epoll_data_at! ()) fd;
    let ep = prim.load64! (world_at! w_epfd);
    let ok = prim.sext32 (prim.c4! "epoll_ctl" ep 1 fd ev) == 0 || errno! () == 17;
    if ok {
        prim.store64! (slot + 3 * word) 1;
        // Whatever is already readable or writable came before the registration and is no edge.
        prim.store64! (slot + word) (epoll_in | epoll_out);
    };
    ok
};

let wait_none = 0;
let wait_parked = 1;
let wait_again = 2;

/// `pcb` waits for `fd`: parked, or to go round again at once because the system said ready
/// while nobody was waiting, or not at all because the system cannot say.
let note_fd! !p !pcb !fd !write = if fd < 0 || fd >= fd_slots { wait_none } else {
    let slot = fd_slot! fd;
    let want = if write { epoll_out } else { epoll_in };
    spin_lock! slot;
    let answer = if not (epoll_register! p fd slot) { wait_none }
        else if prim.load64! (slot + word) & want != 0 {
            prim.store64! (slot + word) (prim.load64! (slot + word) & (0 - 1 - want));
            wait_again
        } else {
            let cell = id_push! p (prim.load64! (slot + 2 * word)) (prim.load64! (pcb + pcb_id));
            prim.store64! (cell + 2 * word) want;
            prim.store64! (slot + 2 * word) cell;
            prim.xadd64! (world_at! w_fd_waiting) 1;
            wait_parked
        };
    spin_unlock! slot;
    // Nobody is asking the system, and someone could: they are woken to.
    if answer == wait_parked && prim.load_acq! (world_at! w_polling) == 0 && prim.load_acq! (world_at! w_idle) != 0 { nudge! p; };
    answer
};

/// What `epoll` said of `fd`: whoever waits for it in a direction it is ready in is woken, and
/// a direction nobody waited for is remembered.
let fd_event! !p !fd !events = if fd < 0 || fd >= fd_slots { 0 } else {
    let broken = events & (epoll_err | epoll_hup | epoll_rdhup) != 0;
    let ready = (if events & epoll_in != 0 || broken { epoll_in } else { 0 }) | (if events & epoll_out != 0 || broken { epoll_out } else { 0 });
    let slot = fd_slot! fd;
    spin_lock! slot;
    let all = prim.load64! (slot + 2 * word);
    prim.store64! (slot + 2 * word) 0;
    let woken = split_waiters! all ready 0 slot;
    // Only what nobody was woken for: a waiter woken reads or writes until it finds no more,
    // and would otherwise go round once for nothing before it waited again.
    prim.store64! (slot + word) (prim.load64! (slot + word) | (ready & (0 - 1 - wants_of! woken 0)));
    spin_unlock! slot;
    wake_fd_waiters! p woken fd;
    id_free! p woken
};

/// The waiters `ready` is for, answered; the rest put back in the slot. Both made of the cells of
/// the one list, which the slot's lock keeps.
let split_waiters! !list_ !ready !woken !slot = if list_ == 0 { woken } else {
    let next = prim.load64! list_;
    if prim.load64! (list_ + 2 * word) & ready != 0 {
        prim.store64! list_ woken;
        split_waiters! next ready list_ slot
    } else {
        prim.store64! list_ (prim.load64! (slot + 2 * word));
        prim.store64! (slot + 2 * word) list_;
        split_waiters! next ready woken slot
    }
};

let wants_of! !list_ !acc = if list_ == 0 { acc } else { wants_of! (prim.load64! list_) (acc | prim.load64! (list_ + 2 * word)) };

/// Everyone waiting on `fd`, woken, and its slot forgotten: it is gone.
let fd_ready! !p !fd = {
    let slot = fd_slot! fd;
    spin_lock! slot;
    let waiters = prim.load64! (slot + 2 * word);
    prim.store64! (slot + word) 0;
    prim.store64! (slot + 2 * word) 0;
    prim.store64! (slot + 3 * word) 0;
    spin_unlock! slot;
    wake_fd_waiters! p waiters fd;
    id_free! p waiters
};

let wake_fd_waiters! !p !list_ !fd = if list_ == 0 { 0 } else {
    let pcb = table_at! p (prim.load64! (list_ + word));
    prim.xadd64! (world_at! w_fd_waiting) (0 - 1);
    // Killed while it waited, and reaped since: nobody to wake.
    if pcb != 0 {
        pcb_lock! pcb;
        if prim.load64! (pcb + pcb_wait_fd) == fd + 1 {
            prim.store64! (pcb + pcb_wait_fd) 0;
            prim.store64! (pcb + pcb_wait_write) 0;
        };
        pcb_unlock! pcb;
        wake! p pcb;
    };
    wake_fd_waiters! p (prim.load64! list_) fd
};

/// A descriptor closed: whoever waited on it is told by going round again and finding it closed.
let fd_closed! !p !fd = if fd < 0 || fd >= fd_slots { 0 } else { fd_ready! p fd; 0 };

/// A timer that has run out, under the process's lock, so that a new one it has just set is not
/// mistaken for this one.
let expire! !p !pcb !now = {
    pcb_lock! pcb;
    let at = prim.load64! (pcb + pcb_wake_at);
    if at >= 0 && at <= now {
        prim.store64! (pcb + pcb_wake_at) (0 - 1);
        if prim.load64! (pcb + pcb_state) == state_waiting {
            prim.store64! (pcb + pcb_state) state_ready;
            pcb_unlock! pcb;
            run_push! p pcb
        } else {
            prim.store64! (pcb + pcb_woken) 1;
            pcb_unlock! pcb;
            0
        }
    } else { pcb_unlock! pcb; 0 }
};

// --- waiting for the system -------------------------------------------------------------
//
// One worker at a time asks the system, with the scheduler's lock: without waiting when others
// are busy, now and then (`maybe_service!`), and waiting when it has nothing else, with the lock
// let go. The wake descriptor is in the set for good, and a new timer earlier than the wait writes
// to it (`interrupt_poll!`); a new descriptor needs no telling, as `epoll` sees it at once.

let wake_events! !p !buf !i !n = if i >= n { 0 } else {
    let fd = prim.load32! (buf + i * epoll_event_size! () + epoll_data_at! ());
    if fd == prim.load64! (world_at! w_wakefd) {
        prim.c3! "read" fd (prim.load64! (p + ctx_timebuf)) 8;
    } else { fd_event! p fd (prim.load32! (buf + i * epoll_event_size! ())); };
    wake_events! p buf (i + 1) n
};

/// With the scheduler's lock held: wake whoever the system or the clock has an answer for,
/// waiting up to `ms` for one (-1 for ever, 0 not at all).
let service_waiters! !p !ms = {
    expire_timers! p (now_ns! p);
    let at = earliest_timer! ();
    prim.store64! (world_at! w_earliest) at;
    let now = now_ns! p;
    let until_timer = if at < 0 { 0 - 1 } else if at <= now { 0 } else { (at - now) / 1000000 + 1 };
    let wait = if ms == 0 { 0 } else if until_timer < 0 { ms } else if ms < 0 { until_timer } else if until_timer < ms { until_timer } else { ms };
    let buf = poll_buffer! p (epoll_batch * epoll_event_size! ());
    let ep = prim.load64! (world_at! w_epfd);
    let n = if wait != 0 {
        prim.store64! (world_at! w_polling) 1;
        sched_unlock! p;
        let got = prim.sext32 (prim.c4! "epoll_wait" ep buf epoll_batch wait);
        // What it found is woken before the lock is taken again: a slot has a lock of its own.
        if got > 0 { wake_events! p buf 0 got; };
        sched_lock! p;
        prim.store64! (world_at! w_polling) 0;
        0
    } else if prim.load64! (world_at! w_fd_waiting) != 0 { prim.sext32 (prim.c4! "epoll_wait" ep buf epoll_batch 0) }
    else { 0 };
    if n > 0 { wake_events! p buf 0 n; };
    expire_timers! p (now_ns! p);
    prim.store64! (world_at! w_earliest) (earliest_timer! ());
    0
};

/// Between two processes, now and then: the clock and the system get a look in while there is
/// other work, though not at the price of a system call for every switch.
let maybe_service! !p = {
    let tick = prim.load64! (p + ctx_poll_tick) + 1;
    prim.store64! (p + ctx_poll_tick) tick;
    let e = prim.load64! (world_at! w_earliest);
    if (tick & 63 == 0 && prim.load64! (world_at! w_fd_waiting) != 0) || (e >= 0 && now_ns! p >= e) {
        let l = prim.load64! (world_at! w_sched_lock);
        if try_lock! l {
            prim.store64! (p + ctx_sched_held) 1;
            if prim.load64! (world_at! w_polling) == 0 { service_waiters! p 0; };
            sched_unlock! p;
        };
    };
    0
};

// --- the scheduler -----------------------------------------------------------------------

/// Run whoever is next. A process with a kill waiting does not resume: it starts
/// unwinding, and only its cleanups run.
// A process runs on a native stack of its own, the scheduler on the worker's: `dispatch!` switches
// to the process's and runs it there (`run_process!`), and whatever the process does that gives
// the worker back comes to `schedule!`, which switches back first, so that the switch in
// `dispatch!` returns and the scheduler goes on where it was. Nothing on a process's stack is
// needed once it has given the worker back -- what it is waiting to do is a frame on the stack the
// runtime keeps (`pcb_sp`) -- so a process is run again from the top of its native stack. The
// stack is the machine's own, reserved large and touched as needed, where code that calls rather
// than jumps keeps what it is in the middle of (dreams/docs/aot-direct.md).

/// How much of the address space a process's native stack is given: what the compiler decided
/// from what the program can reach (`machine.native_stack_of`), or less where a limit on the
/// address space (`ulimit -v`) will not give that much to every process alive at once --
/// reserved is not committed, but it counts all the same.
//
// Sixty-four kilobytes unless the program can call C that goes deeper, when it is a thread's
// eight megabytes. At eight megabytes for every program, the eighty thousand processes of
// `benchmark/native/procs.dr` could not all be given a stack under `ulimit -v 30000000`.
let native_stack_bytes! () = prim.load64! (prim.info "native_stack");
let least_native_stack = 65536;

/// A stack of `bytes` reserved, or of less if the system will not give it: `[base, bytes]`.
let reserved_stack! !bytes = {
    // PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE.
    let m = prim.c6! "mmap" 0 bytes 3 16418 (0 - 1) 0;
    if m != 0 - 1 { prim.store64! (world_at! w_stack_reserved) bytes; m }
    else if bytes > least_native_stack { reserved_stack! (bytes / 8) }
    else { fatal! "dream: no address space for a process's stack (is `ulimit -v` set low?)\n"; 0 }
};

let kept_native_stacks = 64;

/// `pcb`'s native stack's top, made the first time it runs.
let native_stack_top! !p !pcb = {
    let had = prim.load64! (pcb + pcb_nstack);
    let kept = prim.load64! (p + ctx_nstacks);
    let base = if had != 0 { had } else if kept != 0 {
        // One given back here: its pages are touched already and its guard is still in place,
        // so taking it costs no call to the kernel, where a fresh one was two and a fault for
        // each page it touched.
        prim.store64! (p + ctx_nstacks) (prim.load64! (kept + 4096));
        prim.store64! (p + ctx_nstack_count) (prim.load64! (p + ctx_nstack_count) - 1);
        prim.store64! (pcb + pcb_nstack) kept;
        prim.store64! (pcb + pcb_nstack_size) (prim.load64! (kept + 4096 + word));
        kept
    } else {
        // Reserved, not committed. Once one could not be had at full size, the rest are asked
        // for at the size that could.
        let want = prim.load64! (world_at! w_stack_reserved);
        let m = reserved_stack! (if want == 0 { native_stack_bytes! () } else { want });
        // The lowest page a guard: a recursion past the reservation stops there.
        prim.c3! "mprotect" m 4096 0;
        prim.store64! (pcb + pcb_nstack) m;
        prim.store64! (pcb + pcb_nstack_size) (prim.load64! (world_at! w_stack_reserved));
        m
    };
    base + prim.load64! (pcb + pcb_nstack_size)
};

/// `pcb`'s native stack given back once it has switched off it, if nothing on it is needed: when
/// it has finished, or has parked with nothing there to come back to (`pcb_nsp`), which under
/// code that jumps is every park -- fifty thousand processes waiting in `recv!` held fifty
/// thousand stacks, and each was a `mmap`, a `mprotect` and a `munmap`. It is kept for the next
/// process to run here, as many as `kept_native_stacks`, with its link and size just above its
/// guard page, and the rest go to the kernel.
let native_stack_done! !p !pcb = {
    let base = prim.load64! (pcb + pcb_nstack);
    let size = prim.load64! (pcb + pcb_nstack_size);
    if base != 0 && (prim.load64! (pcb + pcb_state) == state_done || prim.load64! (pcb + pcb_nsp) == 0) {
        if prim.load64! (p + ctx_nstack_count) < kept_native_stacks {
            prim.store64! (base + 4096) (prim.load64! (p + ctx_nstacks));
            prim.store64! (base + 4096 + word) size;
            prim.store64! (p + ctx_nstacks) base;
            prim.store64! (p + ctx_nstack_count) (prim.load64! (p + ctx_nstack_count) + 1);
        } else { prim.c2! "munmap" base size; };
        prim.store64! (pcb + pcb_nstack) 0;
    };
    0
};

/// Until whoever ran `pcb` last is off its stack.
let off_its_stack! !pcb !n = if prim.load_acq! (pcb + pcb_on_stack) == 0 { 0 } else {
    if n > 4096 { prim.c0! "sched_yield"; } else { prim.pause! (); };
    off_its_stack! pcb (n + 1)
};

let dispatch! !p !pcb !b !c !d !e = {
    make_current! p pcb;
    load_heap! p pcb;
    // Due to report to a census: at its first function entry.
    if prim.load64! (pcb + pcb_census_due) != 0 { prim.store64! (p + ctx_guard) (0 - 1); };
    prim.store64! (p + ctx_on_process) 1;
    off_its_stack! pcb 0;
    prim.store64! (pcb + pcb_on_stack) 1;
    let started = if timeline_on! () { timeline_now! () } else { 0 };
    prim.run_on! (native_stack_top! p pcb) p pcb (p + ctx_sched_sp);
    // Back on the scheduler's stack: the process has given the worker back.
    if timeline_on! () {
        let state = prim.load64! (pcb + pcb_state);
        timeline_line! p (115 * 256 + (if state == state_done { 104 } else if state == state_waiting { 112 } else { 121 }))
            (prim.load64! (pcb + pcb_id)) 0 started (timeline_now! ());
    };
    native_stack_done! p pcb;
    prim.store_rel! (pcb + pcb_on_stack) 0;
    schedule! p 0 0 0 0 0
};

/// What `dispatch!` runs on the process's own stack: the process, from where it was.
let run_process! !p !pcb !b !c !d !e = {
    let sp = prim.load64! (pcb + pcb_sp);
    let reason = prim.load64! (pcb + pcb_kill);
    if reason != 0 && prim.load64! (pcb + pcb_killing) == 0 {
        prim.store64! (pcb + pcb_killing) 1;
        unwind! p sp (error_new! p atom_killed reason) 0 0 0
    } else {
        return! p sp (prim.load64! (pcb + pcb_resume))
    }
};

let schedule! !p !a !b !c !d !e = if prim.load64! (p + ctx_on_process) != 0 {
    // From a process, on its stack: back to the scheduler's first, where `dispatch!` goes on.
    prim.store64! (p + ctx_on_process) 0;
    prim.return_to! (prim.load64! (p + ctx_sched_sp));
    0
} else {
    if waiting_on_system! () { maybe_service! p; };
    let next = run_pop! p;
    if next != 0 { more_to_share! p; dispatch! p next 0 0 0 0 }
    else {
        let stolen = steal! p;
        if stolen != 0 { more_to_share! p; dispatch! p stolen 0 0 0 0 }
        else {
            // A while spent looking before sleeping, since what wakes a sleeper is a system call
            // on both sides, and work often turns up in the time that takes.
            // Only a couple at a time, as every one reads the queues others write, and a crowd of
            // them slows down the very workers they are waiting on.
            if prim.xadd64! (world_at! w_spinning) 1 >= max_spinning {
                prim.xadd64! (world_at! w_spinning) (0 - 1);
                idle! p 0 0 0 0 0
            } else {
                let found = spin! p spin_rounds;
                prim.xadd64! (world_at! w_spinning) (0 - 1);
                if found != 0 { dispatch! p found 0 0 0 0 } else { idle! p 0 0 0 0 0 }
            }
        }
    }
};

/// About to run a process with more waiting behind it here: a worker asleep is woken to take some,
/// unless one is already looking. A push wakes one at most, and a worker woken took half of a queue
/// and ran it while the rest slept, so a compile that started forty processes at once ran them on
/// two cores of twenty-four. Each worker that starts one with more behind it wakes the next, and
/// the wake goes on for as long as there is work for another.
let more_to_share! !p =
    if prim.load64! (p + ctx_run_head) != 0 && prim.load_acq! (world_at! w_idle) != 0
       && prim.load_acq! (world_at! w_spinning) == 0 { nudge! p } else { 0 };

let spin_rounds = 2000;
let max_spinning = 2;

let spin! !p !n = if n == 0 || prim.load64! (world_at! w_started) <= 1 { 0 } else {
    let mine = run_pop! p;
    let got = if mine != 0 { mine } else { steal! p };
    if got != 0 { got } else {
        prim.pause! ();
        spin! p (n - 1)
    }
};

/// Where a worker's thread starts.
let worker_loop! !p !a !b !c !d !e = {
    note_context! p;
    schedule! p 0 0 0 0 0
};

/// Nothing is runnable here or anywhere this worker can see. The system or the clock may yet
/// make something so, and so may another worker; if nothing can, every process is waiting for
/// a message that cannot come.
let idle! !p !a !b !c !d !e = {
    sched_lock! p;
    // Counted asleep before looking, so that a push after the look is sure to wake someone.
    prim.xadd64! (world_at! w_idle) 1;
    let started = prim.load64! (world_at! w_started);
    if anything_queued! p 0 started {
        prim.xadd64! (world_at! w_idle) (0 - 1);
        sched_unlock! p;
        schedule! p 0 0 0 0 0
    } else {
        let n = if waiting_on_system! () { 1 } else { 0 };
        if prim.load64! (world_at! w_live) == 0 {
            // The last process to finish runs the end; there is nothing for this one to do.
            sleep_worker! p;
            schedule! p 0 0 0 0 0
        } else if n != 0 && prim.load64! (world_at! w_polling) == 0 {
            prim.xadd64! (world_at! w_idle) (0 - 1);
            service_waiters! p (0 - 1);
            sched_unlock! p;
            schedule! p 0 0 0 0 0
        } else if prim.load64! (world_at! w_idle) == started && prim.load64! (world_at! w_fd_waiting) == 0
                  && prim.load64! (world_at! w_pool_pending) == 0 && not (any_queue! 0 started)
                  && prim.load64! (world_at! w_polling) == 0 && live_timers! p 0 0 == 0 {
            sched_unlock! p;
            deadlock! p 0 0 0 0 0
        } else {
            sleep_worker! p;
            schedule! p 0 0 0 0 0
        }
    }
};

/// Asleep until a push, a new waiter or the end, with the scheduler's lock, which is let go.
/// It was counted idle by the caller.
let sleep_worker! !p = {
    prim.store64! (p + ctx_sched_held) 0;
    prim.c2! "pthread_cond_wait" (prim.load64! (world_at! w_cond)) (prim.load64! (world_at! w_sched_lock));
    prim.store64! (p + ctx_sched_held) 1;
    prim.xadd64! (world_at! w_idle) (0 - 1);
    sched_unlock! p;
    0
};

let deadlock! !p !a !b !c !d !e = {
    let s = "dream: deadlock -- every process is waiting for a message that cannot arrive\n";
    prim.c3! "write" 2 s (prim.str_len s);
    prim.c1! "exit" 1
};

/// Every process has finished. What failed with nobody to tell is reported by the
/// library, on the first process's stack, which has nothing else to do now.
let all_done! !p !a !b !c !d !e = {
    let pcb = table_at! p 1;
    load_heap! p pcb;
    let stack = map_memory! stack_bytes;
    prim.store64! (pcb + pcb_stack) stack;
    prim.store64! (pcb + pcb_stack_size) stack_bytes;
    make_current! p pcb;
    let top = stack + stack_bytes;
    prim.store64! (top - word) (prim.info "halt");
    prim.store64! (top - 2 * word) unit_word;
    apply! p (top - 2 * word) (prim.info "lib_finish") 1 0 0
};

let unjoined_from! !p !id !n !acc = if id >= n { acc } else {
    let pcb = table_at! p id;
    let failed = pcb != 0 && prim.load64! (pcb + pcb_failed) != 0 && prim.load64! (pcb + pcb_joined) == 0;
    unjoined_from! p (id + 1) n (if failed { new_cons! p (prim.load64! (pcb + pcb_result)) acc } else { acc })
};

/// The errors of processes that failed and were never joined.
let unjoined_failures! !p !unit = unjoined_from! p 2 (prim.load64! (world_at! w_next_id)) nil_word;

/// `[:down, pid, Result]`, to each monitor.
let new_result! !p !ok !v = {
    let r = new_record! p (if ok { atom_result_ok } else { atom_result_error }) 1;
    prim.store64! (r + 3 * word) v;
    r
};

/// `msg`, from the running process's heap, copied to the end of `pcb`'s mailbox. To one that
/// has ended it goes nowhere.
let deliver! !p !pcb !msg = {
    let value = copy_out! p msg xc_message;
    let segs = prim.load64! (p + ctx_xc_first);
    let bytes = prim.load64! (p + ctx_xc_bytes);
    let entry = cell_get! p;
    prim.store64! entry 0;
    prim.store64! (entry + mail_value) value;
    prim.store64! (entry + mail_segments) segs;
    prim.store64! (entry + mail_bytes) bytes;
    pcb_lock! pcb;
    let state = prim.load64! (pcb + pcb_state);
    if state == state_done {
        pcb_unlock! pcb;
        free_segments! p segs;
        cell_put! p entry;
        0
    } else {
        if prim.load64! (pcb + pcb_mail_head) == 0 { prim.store64! (pcb + pcb_mail_head) entry; }
        else { prim.store64! (prim.load64! (pcb + pcb_mail_tail)) entry; };
        prim.store64! (pcb + pcb_mail_tail) entry;
        if prim.load64! (pcb + pcb_mail_fresh) == 0 { prim.store64! (pcb + pcb_mail_fresh) entry; };
        prim.store64! (pcb + pcb_mail_count) (prim.load64! (pcb + pcb_mail_count) + 1);
        if state == state_waiting {
            prim.store64! (pcb + pcb_state) state_ready;
            prim.store64! (pcb + pcb_wake_at) (0 - 1);
            pcb_unlock! pcb;
            run_push! p pcb
        } else {
            prim.store64! (pcb + pcb_woken) 1;
            pcb_unlock! pcb;
            0
        }
    }
};

/// Every message waiting for the running process taken into its heap, before it reads one.
let take_mail! !p !entry = if entry == 0 { 0 } else {
    let segs = prim.load64! (entry + mail_segments);
    if segs != 0 {
        adopt_segments! p segs (prim.load64! (entry + mail_bytes));
        prim.store64! (entry + mail_segments) 0;
    };
    take_mail! p (prim.load64! entry)
};

/// The running process's mailbox, its lock taken and every message in it its own. The caller
/// lets go.
let my_mail! !p = {
    let pcb = current! p;
    pcb_lock! pcb;
    let fresh = prim.load64! (pcb + pcb_mail_fresh);
    if fresh != 0 {
        take_mail! p fresh;
        prim.store64! (pcb + pcb_mail_fresh) 0;
    };
    pcb
};

/// What is left in the mailbox of a process that has ended.
let drop_mail! !p !entry = if entry == 0 { 0 } else {
    let next = prim.load64! entry;
    free_segments! p (prim.load64! (entry + mail_segments));
    cell_put! p entry;
    drop_mail! p next
};

// A cell is four words, made by one worker and often freed by another: from `malloc`, every
// thread that frees one grows an arena of its own and the system call that does it was a fifth of
// a message-heavy run. Each worker keeps those freed on it, carved at first from slabs.

let cell_bytes = 32;

let cell_get! !p = {
    let c = prim.load64! (p + ctx_cells);
    if c != 0 {
        prim.store64! (p + ctx_cells) (prim.load64! c);
        c
    } else {
        // Carved as used, as a chunk is (`chunk_get!`), so that a fresh slab is not a fault a page.
        if prim.load64! (p + ctx_cell_cursor) + cell_bytes > prim.load64! (p + ctx_cell_end) {
            let slab = map_memory! slab_bytes;
            prim.store64! (p + ctx_cell_cursor) slab;
            prim.store64! (p + ctx_cell_end) (slab + slab_bytes);
        };
        let fresh_ = prim.load64! (p + ctx_cell_cursor);
        prim.store64! (p + ctx_cell_cursor) (fresh_ + cell_bytes);
        fresh_
    }
};

let cell_put! !p !c = {
    prim.store64! c (prim.load64! (p + ctx_cells));
    prim.store64! (p + ctx_cells) c;
    0
};

/// A list of process ids in raw memory, `[next, id]`, newest first.
let id_push! !p !list_ !id = {
    let cell = cell_get! p;
    prim.store64! cell list_;
    prim.store64! (cell + word) id;
    cell
};

let id_free! !p !list_ = if list_ == 0 { 0 } else {
    let next = prim.load64! list_;
    cell_put! p list_;
    id_free! p next
};

let id_without! !p !list_ !id = if list_ == 0 { 0 }
    else if prim.load64! (list_ + word) == id {
        let next = prim.load64! list_;
        cell_put! p list_;
        next
    }
    else {
        prim.store64! list_ (id_without! p (prim.load64! list_) id);
        list_
    };

let down_of! !p !pcb = new_cons! p atom_down (new_cons! p (new_pid! p (prim.load64! (pcb + pcb_id)))
    (new_cons! p (new_result! p (prim.load64! (pcb + pcb_failed) == 0) (prim.load64! (pcb + pcb_result))) nil_word));

let tell_monitors! !p !pcb !list_ = if list_ == 0 { 0 } else {
    let m = table_at! p (prim.load64! (list_ + word));
    if m != 0 { deliver! p m (down_of! p pcb); };
    tell_monitors! p pcb (prim.load64! list_)
};

let wake_list! !p !list_ = if list_ == 0 { 0 } else {
    let w = table_at! p (prim.load64! (list_ + word));
    if w != 0 { wake! p w; };
    wake_list! p (prim.load64! list_)
};

/// A process has its answer, or has failed. Its stack goes now, and its heap, the answer
/// having been promoted to the shared region. Its record stays, since a process may join it later.
let finish! !p !v !failed !d !e !f = {
    let pcb = current! p;
    let is_root = prim.load64! (pcb + pcb_id) == 1;
    let result = promote_short! p v;
    release_owned! p (tag_fix (prim.load64! (pcb + pcb_id)));
    pcb_lock! pcb;
    prim.store64! (pcb + pcb_result) result;
    prim.store64! (pcb + pcb_failed) failed;
    prim.store64! (pcb + pcb_state) state_done;
    let monitors = prim.load64! (pcb + pcb_monitors);
    let joiners = prim.load64! (pcb + pcb_joiners);
    prim.store64! (pcb + pcb_monitors) 0;
    prim.store64! (pcb + pcb_joiners) 0;
    pcb_unlock! pcb;
    tell_monitors! p pcb monitors;
    wake_list! p joiners;
    id_free! p monitors;
    id_free! p joiners;
    // Nobody delivers to it now: what is in its mailbox is its own to throw away.
    drop_mail! p (prim.load64! (pcb + pcb_mail_head));
    prim.store64! (pcb + pcb_mail_head) 0;
    prim.store64! (pcb + pcb_mail_tail) 0;
    prim.store64! (pcb + pcb_mail_fresh) 0;
    prim.store64! (pcb + pcb_mail_count) 0;
    stack_done! p (prim.load64! (pcb + pcb_stack)) (prim.load64! (pcb + pcb_stack_size));
    prim.store64! (pcb + pcb_stack) 0;
    prim.store64! (pcb + pcb_kept) 0;
    // The first process's heap is where what failed unseen is reported from, at the end.
    if is_root { save_heap! p pcb; } else { free_heap! p; };
    prim.store64! (pcb + pcb_worker) 0;
    prim.store64! (p + ctx_hp) 0;
    prim.store64! (p + ctx_limit) 0;
    census_gone! p pcb;
    prim.xadd64! (world_at! w_finished_since) 1;
    if prim.xadd64! (world_at! w_live) (0 - 1) == 1 { all_done! p 0 0 0 0 0 }
    else {
        census_maybe! p;
        schedule! p 0 0 0 0 0
    }
};

/// The bottom of every process's stack.
let code_halt! !p !sp !v !b !c !d = finish! p v 0 0 0 0;

/// Save this process with a frame that will call `code` again, and run another. The
/// frame is its whole state. A wake that came before the park, or a kill, means it goes round
/// again rather than sleeping.
let park! !p !sp !code !a !b !c = {
    let at = sp - 5 * word;
    prim.store64! at (prim.info "retry_call");
    prim.store64! (at + word) code;
    prim.store64! (at + 2 * word) a;
    prim.store64! (at + 3 * word) b;
    prim.store64! (at + 4 * word) c;
    let pcb = current! p;
    pcb_lock! pcb;
    if prim.load64! (pcb + pcb_kill) != 0 {
        prim.store64! (pcb + pcb_woken) 0;
        prim.store64! (pcb + pcb_sp) at;
        prim.store64! (pcb + pcb_resume) unit_word;
        prim.store64! (pcb + pcb_state) state_ready;
        pcb_unlock! pcb;
        leave! p pcb;
        run_push! p pcb;
        schedule! p 0 0 0 0 0
    } else if prim.load64! (pcb + pcb_woken) != 0 && prim.load64! (p + ctx_run_head) == 0 {
        prim.store64! (pcb + pcb_woken) 0;
        pcb_unlock! pcb;
        frame_retry_call! p at unit_word 0 0 0
    } else if prim.load64! (pcb + pcb_woken) != 0 {
        // Woken already, but others are waiting here: going round at once would never let this
        // worker reach its queue while two processes answer each other faster than either parks,
        // which on two workers kept a third from running at all. It goes to the back instead.
        prim.store64! (pcb + pcb_woken) 0;
        prim.store64! (pcb + pcb_sp) at;
        prim.store64! (pcb + pcb_resume) unit_word;
        prim.store64! (pcb + pcb_state) state_ready;
        pcb_unlock! pcb;
        leave! p pcb;
        run_push! p pcb;
        schedule! p 0 0 0 0 0
    } else {
        prim.store64! (pcb + pcb_sp) at;
        prim.store64! (pcb + pcb_resume) unit_word;
        save_heap! p pcb;
        prim.store64! (pcb + pcb_worker) 0;
        prim.store64! (pcb + pcb_state) state_waiting;
        pcb_unlock! pcb;
        prim.store64! (p + ctx_hp) 0;
        prim.store64! (p + ctx_limit) 0;
        schedule! p 0 0 0 0 0
    }
};

let frame_retry_call! !p !sp !v !b !c !d =
    prim.jump! (prim.load64! (sp + word)) p (sp + 5 * word) 0 (prim.load64! (sp + 2 * word))
        (prim.load64! (sp + 3 * word)) (prim.load64! (sp + 4 * word));

/// Give way, keeping the frame on top as it is.
let yield_now! !p !sp !v !b !c !d = {
    let pcb = current! p;
    prim.store64! (pcb + pcb_sp) sp;
    prim.store64! (pcb + pcb_resume) v;
    leave! p pcb;
    pcb_lock! pcb;
    prim.store64! (pcb + pcb_state) state_ready;
    pcb_unlock! pcb;
    run_push! p pcb;
    schedule! p 0 0 0 0 0
};

/// Where a function's entry goes when the guard says stop: see `collect_at_entry!`.
let frame_resume_entry! !p !sp !v !b !c !d = {
    let code = prim.load64! (sp + 2 * word);
    prim.jump! code p (sp + 8 * word) (prim.load64! (sp + 4 * word)) (prim.load64! (sp + 5 * word))
        (prim.load64! (sp + 6 * word)) (prim.load64! (sp + 7 * word))
};

/// A thunk that some other process is evaluating, waited for by coming back to it.
let frame_enter_again! !p !sp !v !b !c !d = enter! p (sp + 2 * word) (prim.load64! (sp + word));

/// A shared thunk waited for, entered again when its owner has finished or given it back.
let m_enter! !p !sp !self_ !s !c !d = enter! p sp s;

// --- the blocking pool --------------------------------------------------------------------
//
// What the system has no way to do without blocking -- looking up a name, above all, which can
// take seconds -- is handed to a few threads of its own, and the process parks until it is done,
// so that its worker runs others meanwhile. A job is raw memory, `[next, function, four
// arguments, result, process, done]`, and room after it for what the call writes. It may point
// into the process's heap, which does not move while the process is parked.

let job_fn = 8;
let job_args = 16;
let job_result = 48;
let job_pcb = 56;
let job_done = 64;
/// Where a job's own buffers start.
let job_room = 72;
let job_bytes = 256;
let pool_threads = 4;

let new_job! !f !a !b !c !d = {
    let job = prim.c2! "calloc" 1 job_bytes;
    prim.store64! (job + job_fn) f;
    prim.store64! (job + job_args) a;
    prim.store64! (job + job_args + word) b;
    prim.store64! (job + job_args + 2 * word) c;
    prim.store64! (job + job_args + 3 * word) d;
    job
};

/// `job` run by the pool for the running process, which is woken when it is done.
let submit_job! !p !job = {
    prim.store64! (job + job_pcb) (prim.load64! (current! p + pcb_id));
    prim.xadd64! (world_at! w_pool_pending) 1;
    let l = prim.load64! (world_at! w_pool_lock);
    lock! l;
    if prim.load64! (world_at! w_pool_started) == 0 {
        prim.store64! (world_at! w_pool_started) pool_threads;
        start_pool! 0 pool_threads;
    };
    prim.store64! job 0;
    let tail = prim.load64! (world_at! w_pool_tail);
    if tail == 0 { prim.store64! (world_at! w_pool_head) job; } else { prim.store64! tail job; };
    prim.store64! (world_at! w_pool_tail) job;
    prim.c1! "pthread_cond_signal" (prim.load64! (world_at! w_pool_cond));
    unlock! l;
    0
};

let start_pool! !i !n = if i >= n { 0 } else {
    let c = prim.c2! "calloc" 1 ctx_size;
    prim.store64! (c + ctx_classes) (prim.c2! "calloc" (small_class_count * class_words) word);
    prim.store64! (c + ctx_timebuf) (prim.c2! "calloc" 2 word);
    prim.store64! (c + ctx_run_lock) (new_lock! ());
    prim.start_pool! c;
    start_pool! (i + 1) n
};

let next_job! !l = {
    let job = prim.load64! (world_at! w_pool_head);
    if job == 0 {
        prim.c2! "pthread_cond_wait" (prim.load64! (world_at! w_pool_cond)) l;
        next_job! l
    } else {
        let next = prim.load64! job;
        prim.store64! (world_at! w_pool_head) next;
        if next == 0 { prim.store64! (world_at! w_pool_tail) 0; };
        job
    }
};

/// A pool thread: take a job, call it, wake whoever is waiting, for ever.
let pool_loop! !p !a !b !c !d !e = {
    let l = prim.load64! (world_at! w_pool_lock);
    lock! l;
    let job = next_job! l;
    unlock! l;
    let args = job + job_args;
    let r = prim.ptr4! (prim.load64! (job + job_fn)) (prim.load64! args) (prim.load64! (args + word))
        (prim.load64! (args + 2 * word)) (prim.load64! (args + 3 * word));
    prim.store64! (job + job_result) r;
    prim.store_rel! (job + job_done) 1;
    let pcb = table_at! p (prim.load64! (job + job_pcb));
    // Woken before it is no longer counted, so that nobody sees nothing left and nothing to run.
    if pcb != 0 { wake_from_pool! p pcb; };
    prim.xadd64! (world_at! w_pool_pending) (0 - 1);
    pool_loop! p 0 0 0 0 0
};

/// A wake from a thread that is no worker: onto a worker's queue, chosen by the process.
let wake_from_pool! !p !pcb = {
    pcb_lock! pcb;
    if prim.load64! (pcb + pcb_state) == state_waiting {
        prim.store64! (pcb + pcb_state) state_ready;
        pcb_unlock! pcb;
        let w = prim.load64! (prim.load64! (world_at! w_worker_ctx) + (prim.load64! (pcb + pcb_id) % prim.load64! (world_at! w_started)) * word);
        run_push_on! p w pcb
    } else {
        prim.store64! (pcb + pcb_woken) 1;
        pcb_unlock! pcb;
        0
    }
};

let job_is_done! !job = prim.load_acq! (job + job_done) != 0;

// --- workers ----------------------------------------------------------------------------
//
// One OS thread a core, each a context of its own and the scheduler, started at the first
// `spawn!`, so that a program of one process runs as it did. `DREAM_CORES` says how many, as it
// does for the VM; otherwise the cores this process may run on.

let max_workers = 256;

let new_worker_ctx! !index = {
    let w = prim.c2! "calloc" 1 ctx_size;
    prim.store64! (w + ctx_classes) (prim.c2! "calloc" (small_class_count * class_words) word);
    prim.store64! (w + ctx_timebuf) (prim.c2! "calloc" 2 word);
    prim.store64! (w + ctx_run_lock) (new_lock! ());
    prim.store64! (w + ctx_index) index;
    prim.store64! (prim.load64! (world_at! w_worker_ctx) + index * word) w;
    prim.store64! (prim.info "tick_targets" + index * word) (w + ctx_guard);
    w
};

let cores_wanted! !p = {
    let env = prim.c1! "getenv" "DREAM_CORES";
    let asked = if env == 0 { 0 } else { prim.c3! "strtol" env 0 10 };
    let n = if asked > 0 { asked } else {
        let set = prim.c2! "calloc" 1 128;
        let r = prim.sext32 (prim.c3! "sched_getaffinity" 0 128 set);
        let c = if r != 0 { 1 } else { count_bits! set 0 0 };
        prim.c1! "free" set;
        c
    };
    if n < 1 { 1 } else if n > max_workers { max_workers } else { n }
};

let count_bits! !set !i !n = if i >= 16 { n } else { count_bits! set (i + 1) (n + popcount (prim.load64! (set + i * word))) };

let start_workers! !p = if prim.load64! (world_at! w_started) > 1 || prim.load64! (world_at! w_wanted) != 0 { 0 } else {
    let n = cores_wanted! p;
    prim.store64! (world_at! w_wanted) n;
    make_workers! 1 n;
    prim.store_rel! (world_at! w_started) n;
    run_workers! 1 n;
    0
};

let make_workers! !i !n = if i >= n { 0 } else { new_worker_ctx! i; make_workers! (i + 1) n };

let run_workers! !i !n = if i >= n { 0 } else {
    prim.start_worker! (prim.load64! (prim.load64! (world_at! w_worker_ctx) + i * word));
    run_workers! (i + 1) n
};

let world_init! !p = {
    shared_init! ();
    prim.store64! (world_at! w_table) (map_memory! (table_cap * word));
    prim.store64! (world_at! w_table_cap) table_cap;
    prim.store64! (world_at! w_next_id) 1;
    prim.store64! (world_at! w_earliest) (0 - 1);
    prim.store64! (world_at! w_sched_lock) (new_lock! ());
    prim.store64! (world_at! w_shared_lock) (new_lock! ());
    prim.store64! (world_at! w_lock) (new_lock! ());
    prim.store64! (world_at! w_census_lock) (new_lock! ());
    prim.store64! (world_at! w_census_trace) (prim.c1! "getenv" "DREAM_CENSUS_TRACE");
    prim.store64! (world_at! w_pids_seen) (map_memory! (table_cap / 8));
    prim.store64! (world_at! w_foreign) (map_memory! (foreign_cap * word));
    prim.store64! (world_at! w_pool_lock) (new_lock! ());
    prim.store64! (world_at! w_pool_cond) (prim.c2! "calloc" 1 64);
    prim.store64! (world_at! w_cond) (prim.c2! "calloc" 1 64);
    // EFD_NONBLOCK | EFD_CLOEXEC
    prim.store64! (world_at! w_wakefd) (prim.sext32 (prim.c2! "eventfd" 0 526336));
    // EPOLL_CLOEXEC; the wake descriptor is in it for good, level-triggered.
    prim.store64! (world_at! w_epfd) (prim.sext32 (prim.c1! "epoll_create1" 524288));
    prim.store64! (world_at! w_fds) (map_memory! (fd_slots * slot_words * word));
    let ev = prim.load64! (p + ctx_timebuf);
    prim.store32! ev epoll_in;
    prim.store64! (ev + epoll_data_at! ()) (prim.load64! (world_at! w_wakefd));
    prim.c4! "epoll_ctl" (prim.load64! (world_at! w_epfd)) 1 (prim.load64! (world_at! w_wakefd)) ev;
    prim.store64! (world_at! w_worker_ctx) (prim.c2! "calloc" max_workers word);
    prim.c2! "pthread_key_create" (world_at! w_cb_key) 0;
    prim.store64! (p + ctx_run_lock) (new_lock! ());
    prim.store64! (p + ctx_index) 0;
    prim.store64! (prim.load64! (world_at! w_worker_ctx)) p;
    prim.store64! (prim.info "tick_targets") (p + ctx_guard);
    prim.store64! (world_at! w_started) 1;
    0
};

// --- what programs call -------------------------------------------------------------------

let spawn! !p !work = {
    let pcb = new_pcb! p;
    let spawn_at = if timeline_on! () { timeline_now! () } else { 0 };
    // Its work, copied into what will be its heap, and room to begin in: what is left of the
    // segment the copy ended in, when there is any to speak of. A program that starts a hundred
    // thousand processes at once touches a page for each of them otherwise.
    let copied = copy_out! p work xc_message;
    let segs = prim.load64! (p + ctx_xc_first);
    // A census that began after its record was in the table counts it, and one that began before
    // marks what the copy carries. One that began in between did neither if the copy above began
    // before it did: so, the record stored and fenced (`new_pcb!`), a round on now is one that may
    // not have counted this, and what the copy carries is marked here.
    prim.fence! ();
    if census_on! () && prim.load64! (pcb + pcb_census_due) == 0 {
        if segs == 0 { census_mark! p copied; } else { census_segments! p segs; };
        mark_drain! p;
    };
    let left = prim.load64! (p + ctx_xc_limit) - prim.load64! (p + ctx_xc_to);
    if segs != 0 && left >= 256 {
        prim.store64! (pcb + pcb_chunks) segs;
        prim.store64! (pcb + pcb_total) (prim.load64! (p + ctx_xc_bytes));
        prim.store64! (pcb + pcb_hp) (prim.load64! (p + ctx_xc_to));
        prim.store64! (pcb + pcb_limit) (prim.load64! (p + ctx_xc_limit));
    } else {
        let first = chunk_get! p first_budget;
        prim.store64! first segs;
        prim.store64! (first + word) first_budget;
        prim.store64! (first + 2 * word) 0;
        prim.store64! (pcb + pcb_chunks) first;
        prim.store64! (pcb + pcb_total) (first_budget + prim.load64! (p + ctx_xc_bytes));
        prim.store64! (pcb + pcb_hp) (first + chunk_header);
        prim.store64! (pcb + pcb_limit) (first + first_budget);
    };
    let sp = prim.load64! (pcb + pcb_sp) - 2 * word;
    prim.store64! sp (prim.info "start");
    prim.store64! (sp + word) copied;
    prim.store64! (pcb + pcb_sp) sp;
    prim.store64! (pcb + pcb_state) state_ready;
    start_workers! p;
    start_ticking! p;
    timeline_line! p (99 * 256 + 45) (prim.load64! (current! p + pcb_id)) (prim.load64! (pcb + pcb_id)) spawn_at (if timeline_on! () { timeline_now! () } else { 0 });
    run_push! p pcb;
    new_pid! p (prim.load64! (pcb + pcb_id))
};

/// A new process starts here: its work is evaluated, and applied if that is a function
/// waiting for nothing, which is what `$( .. )` makes.
let frame_start! !p !sp !v !b !c !d = {
    let work = prim.load64! (sp + word);
    let at = sp + 2 * word - 2 * word;
    prim.store64! at (prim.info "apply_rest");
    prim.store64! (at + word) (tag_fix 2);
    enter! p at work
};

let self! !p !unit = new_pid! p (prim.load64! (current! p + pcb_id));

let join_m! !p !sp !self_ !pid !c !d = {
    if not (is_kind! pid kind_process) {
        fail! p atom_type_error "join! needs a process";
        native_failed! p sp 0 0 0 0
    } else {
        let target = pcb_of_pid! p pid;
        pcb_lock! target;
        if prim.load64! (target + pcb_state) == state_done {
            prim.store64! (target + pcb_joined) 1;
            pcb_unlock! target;
            if prim.load64! (target + pcb_failed) != 0 { unwind! p sp (prim.load64! (target + pcb_result)) 0 0 0 }
            else { enter! p sp (prim.load64! (target + pcb_result)) }
        } else {
            prim.store64! (target + pcb_joiners) (id_push! p (prim.load64! (target + pcb_joiners)) (prim.load64! (current! p + pcb_id)));
            pcb_unlock! target;
            timeline_line! p (106 * 256 + 45) (prim.load64! (current! p + pcb_id)) (prim.load64! (target + pcb_id)) (if timeline_on! () { timeline_now! () } else { 0 }) 0;
            park! p sp (prim.load64! (prim.info "m_join")) pid unit_word unit_word
        }
    }
};

/// The first message, the mailbox's lock held.
let mail_pop! !p !pcb = {
    let entry = prim.load64! (pcb + pcb_mail_head);
    let next = prim.load64! entry;
    prim.store64! (pcb + pcb_mail_head) next;
    if next == 0 { prim.store64! (pcb + pcb_mail_tail) 0; };
    prim.store64! (pcb + pcb_mail_count) (prim.load64! (pcb + pcb_mail_count) - 1);
    let v = prim.load64! (entry + mail_value);
    cell_put! p entry;
    v
};

/// Whether a receive that could go straight on should give way first. Two processes answering each
/// other on two workers never park, so neither worker reached its queue and what was waiting there
/// ran only at the next tick -- ten milliseconds, in which a program polling for something a third
/// process does asked five hundred times and gave up. The VM gives way after so many reductions;
/// here it is after so many receives, when anything is waiting.
let fair_turn! !p = {
    let n = prim.load64! (p + ctx_quick) + 1;
    prim.store64! (p + ctx_quick) n;
    n & 63 == 0 && prim.load64! (p + ctx_run_head) != 0
};

/// A blocking call that could go on, put to the back of the queue instead, to be called again.
let give_way! !p !sp !code !a !b !c = {
    let at = sp - 5 * word;
    prim.store64! at (prim.info "retry_call");
    prim.store64! (at + word) code;
    prim.store64! (at + 2 * word) a;
    prim.store64! (at + 3 * word) b;
    prim.store64! (at + 4 * word) c;
    prim.store64! (p + ctx_quick) 1;
    yield_now! p at unit_word 0 0 0
};

let recv_m! !p !sp !self_ !a !c !d = if fair_turn! p {
    give_way! p sp (prim.load64! (prim.info "m_recv")) unit_word unit_word unit_word
} else {
    let pcb = my_mail! p;
    if prim.load64! (pcb + pcb_mail_count) != 0 {
        let v = mail_pop! p pcb;
        pcb_unlock! pcb;
        return! p sp v
    } else {
        pcb_unlock! pcb;
        park! p sp (prim.load64! (prim.info "m_recv")) unit_word unit_word unit_word
    }
};

/// `send!`, the library having forced the message.
let send_forced! !p !pid !msg = {
    if not (is_kind! pid kind_process) { fail! p atom_type_error "send! needs a process" }
    else {
        deliver! p (pcb_of_pid! p pid) msg;
        unit_word
    }
};

let entry_at! !e !i = if i == 0 { e } else { entry_at! (prim.load64! e) (i - 1) };

let mailbox_size! !p !unit = tag_fix (prim.load64! (current! p + pcb_mail_count));

let mailbox_peek! !p !i = {
    let pcb = my_mail! p;
    let at = untag_fix i;
    let found = if at < 0 || at >= prim.load64! (pcb + pcb_mail_count) { 0 }
        else { entry_at! (prim.load64! (pcb + pcb_mail_head)) at };
    pcb_unlock! pcb;
    if found == 0 { atom_none } else { new_result! p true (prim.load64! (found + mail_value)) }
};

let mailbox_take! !p !i = {
    let pcb = my_mail! p;
    let at = untag_fix i;
    let count = prim.load64! (pcb + pcb_mail_count);
    if at < 0 || at >= count {
        pcb_unlock! pcb;
        fail! p atom_out_of_bounds "mailbox_take!: no message at that position"
    } else {
        if at == 0 { mail_pop! p pcb; }
        else {
            let before = entry_at! (prim.load64! (pcb + pcb_mail_head)) (at - 1);
            let gone = prim.load64! before;
            prim.store64! before (prim.load64! gone);
            if prim.load64! gone == 0 { prim.store64! (pcb + pcb_mail_tail) before; };
            cell_put! p gone;
            prim.store64! (pcb + pcb_mail_count) (count - 1);
        };
        pcb_unlock! pcb;
        atom_ok
    }
};

/// A time to be woken at, under the process's lock, and noted where the scheduler looks.
let set_wake_at! !p !pcb !at = {
    pcb_lock! pcb;
    prim.store64! (pcb + pcb_wake_at) at;
    pcb_unlock! pcb;
    if at >= 0 { note_timer! p pcb at; };
    0
};

let await_message_m! !p !sp !self_ !n !deadline !d = if fair_turn! p {
    give_way! p sp (prim.load64! (prim.info "m_await")) n deadline unit_word
} else {
    let pcb = current! p;
    let at = untag_fix deadline;
    if prim.load64! (pcb + pcb_mail_count) > untag_fix n { return! p sp atom_ok }
    else if at >= 0 && now_ns! p >= at { return! p sp atom_timeout }
    else {
        set_wake_at! p pcb at;
        park! p sp (prim.load64! (prim.info "m_await")) n deadline unit_word
    }
};

let sleep_until_m! !p !sp !self_ !deadline !c !d = {
    let pcb = current! p;
    let at = untag_fix deadline;
    if now_ns! p >= at { return! p sp atom_ok }
    else {
        set_wake_at! p pcb at;
        park! p sp (prim.load64! (prim.info "m_sleep")) deadline unit_word unit_word
    }
};

let deadline_in! !p !ms = tag_fix (now_ns! p + untag_fix ms * 1000000);
let now_ns_value! !p !unit = tag_fix (now_ns! p);
let wall_ms! !p !unit = {
    let buf = prim.load64! (p + ctx_timebuf);
    prim.c2! "clock_gettime" 0 buf;
    tag_fix (prim.load64! buf * 1000 + prim.load64! (buf + word) / 1000000)
};

let monitor! !p !pid = {
    let target = pcb_of_pid! p pid;
    pcb_lock! target;
    if prim.load64! (target + pcb_state) == state_done {
        pcb_unlock! target;
        deliver! p (current! p) (down_of! p target);
    } else {
        prim.store64! (target + pcb_monitors) (id_push! p (prim.load64! (target + pcb_monitors)) (prim.load64! (current! p + pcb_id)));
        pcb_unlock! target;
    };
    atom_ok
};

let demonitor! !p !pid = {
    let target = pcb_of_pid! p pid;
    pcb_lock! target;
    prim.store64! (target + pcb_monitors) (id_without! p (prim.load64! (target + pcb_monitors)) (prim.load64! (current! p + pcb_id)));
    pcb_unlock! target;
    atom_ok
};

/// `kill!`, the library having forced the reason. Parked, the target has to run once
/// more to be stopped; running on some worker, it is stopped at its next function entry.
let kill_forced! !p !pid !reason = {
    let target = pcb_of_pid! p pid;
    let shared = promote_short! p reason;
    pcb_lock! target;
    let state = prim.load64! (target + pcb_state);
    if state != state_done && prim.load64! (target + pcb_kill) == 0 {
        prim.store64! (target + pcb_kill) shared;
        let w = prim.load64! (target + pcb_worker);
        if w != 0 { prim.store64! (w + ctx_guard) (0 - 1); };
        if state == state_waiting {
            prim.store64! (target + pcb_state) state_ready;
            pcb_unlock! target;
            run_push! p target;
        } else {
            prim.store64! (target + pcb_woken) 1;
            pcb_unlock! target;
        };
    } else { pcb_unlock! target; };
    atom_ok
};

let unique_value! !p !unit = tag_fix (prim.xadd64! (world_at! w_unique) 1 + 1);

/// `vm.per_process key init`: the value this process keeps under `key`, or `init`, as it
/// stands, kept from now on. dream/src/builtins.cpp says what it is for. The compiler hands
/// `init` over unforced and enters what this answers.
let per_process! !p !key !init = {
    let pcb = current! p;
    let kept = prim.load64! (pcb + pcb_kept);
    let found = kept_under! (if kept == 0 { nil_word } else { kept }) key;
    if found != 0 { prim.load64! (found + word) }
    else {
        let tail = prim.load64! (pcb + pcb_kept);
        prim.store64! (pcb + pcb_kept) (new_cons! p key (new_cons! p init (if tail == 0 { nil_word } else { tail })));
        init
    }
};

/// `vm.raised_at e places`: a copy of the error carrying `places` as where it was raised, which
/// a raise then keeps (`locate!`); dream/src/builtins.cpp says what it is for. A place here is
/// already the list `error.trace!` reads, so they are stored as they come.
let raised_at! !p !e !places = if is_object e && kind_of! e == kind_error {
    let o = alloc! p (4 * word);
    copy_words! e o 4;
    prim.store64! (o + 3 * word) places;
    o
} else { e };

/// The cell holding the value kept under `key`, or 0.
let kept_under! !l !key = if l == nil_word { 0 }
    else if prim.load64! (l + word) == key { prim.load64! (l + 2 * word) }
    else { kept_under! (prim.load64! (prim.load64! (l + 2 * word) + 2 * word)) key };

let start_ticking! !p = if prim.load64! (world_at! w_ticking) == 0 {
    prim.store64! (world_at! w_ticking) 1;
    // `DREAM_TICK_US`: a shorter tick, for running a program under more preemption than it meets.
    let us = prim.c1! "getenv" "DREAM_TICK_US";
    let n = if us == 0 { 0 } else { prim.c3! "strtol" us 0 10 };
    if n >= 50 { prim.store64! (prim.info "tick_us") n; };
    prim.store_rel! (prim.info "tick_count") (prim.load64! (world_at! w_started));
    prim.tick_thread! ()
} else { 0 };

let process_id! !p !v = prim.load64! (v + word);

// --- math -----------------------------------------------------------------------------

let math_sqrt! !p !v = if is_number! v { new_float! p (prim.d1! "sqrt" (float_bits! v)) } else { fail! p atom_type_error "sqrt needs a number" };
let math_exp! !p !v = if is_number! v { new_float! p (prim.d1! "exp" (float_bits! v)) } else { fail! p atom_type_error "exp needs a number" };
let math_log! !p !v = if is_number! v { new_float! p (prim.d1! "log" (float_bits! v)) } else { fail! p atom_type_error "log needs a number" };
let math_sin! !p !v = if is_number! v { new_float! p (prim.d1! "sin" (float_bits! v)) } else { fail! p atom_type_error "sin needs a number" };
let math_cos! !p !v = if is_number! v { new_float! p (prim.d1! "cos" (float_bits! v)) } else { fail! p atom_type_error "cos needs a number" };
let math_tan! !p !v = if is_number! v { new_float! p (prim.d1! "tan" (float_bits! v)) } else { fail! p atom_type_error "tan needs a number" };
let math_tanh! !p !v = if is_number! v { new_float! p (prim.d1! "tanh" (float_bits! v)) } else { fail! p atom_type_error "tanh needs a number" };
let math_atan! !p !v = if is_number! v { new_float! p (prim.d1! "atan" (float_bits! v)) } else { fail! p atom_type_error "atan needs a number" };
let math_pow! !p !a !b = if is_number! a && is_number! b { new_float! p (prim.d2! "pow" (float_bits! a) (float_bits! b)) } else { fail! p atom_type_error "pow needs two numbers" };

let math_abs! !p !v =
    if is_float! v { new_float! p (prim.fabs (prim.load64! (v + word))) }
    else if is_fix v { if untag_fix v < 0 { neg! p v } else { v } }
    else if is_big! v { if big_sign! v == 1 { neg! p v } else { v } }
    else { fail! p atom_type_error "abs needs a number" };

/// A float to the integer below it, past a fixnum if it has to be.
let float_to_int! !p !bits =
    if not (prim.feq bits bits) || prim.feq (prim.fabs bits) (prim.d1! "exp" (prim.i2f 800)) {
        fail! p atom_type_error "floor of an infinity or a NaN"
    }
    else if prim.flt (prim.fabs bits) (prim.i2f (1 << 62)) { tag_fix (prim.f2i bits) }
    else { float_to_big! p bits };

let math_floor! !p !v =
    if is_int! v { v }
    else if is_float! v { float_to_int! p (prim.d1! "floor" (prim.load64! (v + word))) }
    else { fail! p atom_type_error "floor needs a number" };

// --- handles ----------------------------------------------------------------------------
//
// A handle is a small integer, not a file descriptor, so that one closed stays closed
// after the system has given its number to something else. Standard input, output and
// error are the first three. A regular file is read and written where it is: the system
// has no way to say it would block. A stream is non-blocking, and a process that finds
// nothing to do parks until `poll` says otherwise.

let handle_words = 3;
let kind_file_handle = 0;
let kind_stream_handle = 1;
let kind_listener_handle = 2;

let fd_of! !p !h = {
    let table = prim.load64! (world_at! w_handles);
    let id = untag_fix h;
    if is_fix h && id >= 0 && id < prim.load64! (world_at! w_handle_count) && table != 0 {
        prim.load64! (table + id * handle_words * word)
    } else { 0 - 1 }
};

let handle_kind! !p !h = prim.load64! (prim.load64! (world_at! w_handles) + untag_fix h * handle_words * word + word);

// The table is mapped at its largest and touched as it fills, rather than grown, because a
// process on another worker may be reading it while a handle is added.
let handle_cap = 1048576;

let init_handles! !p = {
    let cap = handle_cap;
    let table = map_memory! (cap * handle_words * word);
    prim.store64! (world_at! w_handles) table;
    prim.store64! (world_at! w_handle_cap) cap;
    prim.store64! (world_at! w_handle_count) 3;
    prim.store64! table 0;
    prim.store64! (table + word) kind_stream_handle;
    prim.store64! (table + 3 * word) 1;
    prim.store64! (table + 4 * word) kind_stream_handle;
    prim.store64! (table + 6 * word) 2;
    prim.store64! (table + 7 * word) kind_stream_handle;
    0
};

let add_handle! !p !fd !kind = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let id = prim.load64! (world_at! w_handle_count);
    if id >= prim.load64! (world_at! w_handle_cap) { fatal! "dream: too many handles\n"; };
    let at = prim.load64! (world_at! w_handles) + id * handle_words * word;
    prim.store64! at fd;
    prim.store64! (at + word) kind;
    prim.store64! (at + 2 * word) 0;
    prim.store_rel! (world_at! w_handle_count) (id + 1);
    unlock! l;
    tag_fix id
};

let errno! () = prim.sext32 (prim.load32! (prim.c0! "__errno_location"));

let errno_kind !e =
    if e == 2 { prim.atom "not_found" }
    else if e == 13 || e == 1 { prim.atom "permission_denied" }
    else if e == 17 { prim.atom "already_exists" }
    else if e == 21 || e == 20 { prim.atom "wrong_kind" }
    else if e == 111 { prim.atom "connection_refused" }
    else if e == 104 || e == 32 { prim.atom "connection_lost" }
    else if e == 98 { prim.atom "address_in_use" }
    else if e == 110 { prim.atom "timed_out" }
    else { prim.atom "io_error" };

let c_text! !p !at = {
    let n = prim.c1! "strlen" at;
    let s = new_string! p n;
    prim.c3! "memcpy" (string_bytes s) at n;
    s
};

/// The system's reason, as `what: reason`. Its kind says what a program can do about it.
let fail_errno! !p !what = {
    let e = errno! ();
    fail_value! p (errno_kind e) (concat3! p what (text_of! p ": ") (c_text! p (prim.c1! "strerror" e)))
};

let fail_path! !p verb !path = fail_errno! p (concat3! p (text_of! p verb) (text_of! p " ") path);

let closed! !p s = fail! p (prim.atom "io_closed") s;

let set_nonblocking! !fd = prim.c3! "fcntl" fd 4 (prim.sext32 (prim.c2! "fcntl" fd 3) | 2048);

let io_stdin! !p !unit = tag_fix 0;

/// A stat's fields at this system's offsets.
// `struct stat`: the mode is at 24 on x86-64 and at 16 on aarch64's generic layout; the size and
// the modification time are where they are on both.
let stat_mode! !buf = prim.load32! (buf + (if prim.arch () == arch_aarch64 { 16 } else { stat_mode_at }));
let stat_size! !buf = prim.load64! (buf + stat_size_at);
let stat_mtime_ns! !buf = prim.load64! (buf + stat_mtime_at) * 1000000000 + prim.load64! (buf + stat_mtime_at + word);
let stat_mode_at = 24;
let stat_size_at = 48;
let stat_mtime_at = 88;
let stat_bytes = 256;

let is_regular !mode = mode & 61440 == 32768;
let is_directory !mode = mode & 61440 == 16384;
let is_symlink !mode = mode & 61440 == 40960;

let io_open! !p !path !mode =
    if not (is_string! path) { fail! p atom_type_error "open! needs a path" }
    else if mode & 255 != 26 { fail! p atom_type_error "open! needs a mode: :read, :write, :append or :update" }
    else {
        let flags =
            if mode == prim.atom "read" { 0 }
            else if mode == prim.atom "write" { 1 | 64 | 512 }
            else if mode == prim.atom "append" { 1 | 64 | 1024 }
            else if mode == prim.atom "update" { 2 | 64 }
            else { 0 - 1 };
        if flags < 0 {
            fail_value! p (prim.atom "bad_argument") (concat3! p (text_of! p "`:") (atom_name! p mode) (text_of! p "` is not a mode; use :read, :write, :append or :update"))
        } else {
            let fd = prim.sext32 (prim.c3! "open" (string_bytes path) (flags | 524288) 420);
            if fd < 0 { fail_path! p "open" path }
            else {
                let buf = scratch! p stat_bytes;
                prim.c2! "fstat" fd buf;
                if is_regular (stat_mode! buf) { add_handle! p fd kind_file_handle }
                else {
                    set_nonblocking! fd;
                    add_handle! p fd kind_stream_handle
                }
            }
        }
    };

let io_close! !p !h = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is already closed" }
    else {
        let s = session_of! p h;
        if s != 0 { tls_goodbye! p s fd; };
        prim.store64! (prim.load64! (world_at! w_handles) + untag_fix h * handle_words * word) (0 - 1);
        fd_closed! p fd;
        prim.c1! "close" fd;
        unit_word
    }
};

let is_open! !p !h = as_word (fd_of! p h >= 0);

/// Wait until `fd` can be read or written, by being called again.
/// Wait until `fd` can be read or written, by being called again. What the system cannot wait
/// on is tried again at once, after others have had a turn.
let wait_fd! !p !sp !code !a !b !fd = {
    let pcb = current! p;
    let write = prim.load64! (pcb + pcb_wait_write) != 0;
    pcb_lock! pcb;
    prim.store64! (pcb + pcb_wait_fd) (fd + 1);
    pcb_unlock! pcb;
    let answer = note_fd! p pcb fd write;
    if answer == wait_parked { park! p sp code a b unit_word }
    else {
        pcb_lock! pcb;
        prim.store64! (pcb + pcb_wait_fd) 0;
        prim.store64! (pcb + pcb_wait_write) 0;
        pcb_unlock! pcb;
        let at = sp - 5 * word;
        prim.store64! at (prim.info "retry_call");
        prim.store64! (at + word) code;
        prim.store64! (at + 2 * word) a;
        prim.store64! (at + 3 * word) b;
        prim.store64! (at + 4 * word) unit_word;
        yield_now! p at unit_word 0 0 0
    }
};

let io_read_m! !p !sp !self_ !h !n !d = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is closed, or was never opened"; native_failed! p sp 0 0 0 0 }
    else if not (is_fix n) || untag_fix n < 0 { fail! p atom_type_error "read! needs a byte count"; native_failed! p sp 0 0 0 0 }
    else if n == tag_fix 0 { return! p sp (text_of! p "") }
    else if session_of! p h != 0 { tls_read_m! p sp 0 h n 0 }
    else {
        let want = if untag_fix n > 16777216 { 16777216 } else { untag_fix n };
        let s = new_string! p want;
        let got = prim.c3! "read" fd (string_bytes s) want;
        if got >= 0 { string_cut! s want got; return! p sp s }
        else {
            let e = errno! ();
            if e == 11 { wait_fd! p sp (prim.load64! (prim.info "m_read")) h n fd }
            else if e == 4 { io_read_m! p sp 0 h n 0 }
            else if e == 5 { return! p sp (text_of! p "") }
            else { fail_errno! p (text_of! p "read"); native_failed! p sp 0 0 0 0 }
        }
    }
};

let io_write_m! !p !sp !self_ !h !s !d = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is closed, or was never opened"; native_failed! p sp 0 0 0 0 }
    else if not (is_string! s) { fail! p atom_type_error "write! needs a string"; native_failed! p sp 0 0 0 0 }
    else if string_len! s == 0 { return! p sp (tag_fix 0) }
    else if session_of! p h != 0 { tls_write_m! p sp 0 h s 0 }
    else {
        let put = prim.c3! "write" fd (string_bytes s) (string_len! s);
        if put >= 0 { return! p sp (tag_fix put) }
        else {
            let e = errno! ();
            if e == 11 {
                prim.store64! (current! p + pcb_wait_write) 1;
                wait_fd! p sp (prim.load64! (prim.info "m_write")) h s fd
            }
            else if e == 4 { io_write_m! p sp 0 h s 0 }
            else { fail_errno! p (text_of! p "write"); native_failed! p sp 0 0 0 0 }
        }
    }
};

let io_flush! !p !h = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is closed" }
    else {
        if handle_kind! p h == kind_file_handle && prim.sext32 (prim.c1! "fsync" fd) < 0 { fail_errno! p (text_of! p "flush") } else { unit_word }
    }
};

let io_seek! !p !h !off = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is closed" }
    else if not (is_fix off) { fail! p atom_type_error "seek! needs a byte offset" }
    else {
        let at = prim.c3! "lseek" fd (untag_fix off) 0;
        if at < 0 { fail_errno! p (text_of! p "seek") } else { tag_fix at }
    }
};

let io_size! !p !h = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this handle is closed" }
    else {
        let buf = scratch! p stat_bytes;
        if prim.sext32 (prim.c2! "fstat" fd buf) < 0 { fail_errno! p (text_of! p "size") } else { tag_fix (stat_size! buf) }
    }
};

let io_kind! !p !h = {
    if fd_of! p h < 0 { closed! p "this handle is closed" }
    else {
        let k = handle_kind! p h;
        if k == kind_file_handle { prim.atom "file" } else if k == kind_listener_handle { prim.atom "listener" } else { prim.atom "stream" }
    }
};

let io_is_terminal! !p !h = {
    let fd = fd_of! p h;
    as_word (fd >= 0 && prim.sext32 (prim.c1! "isatty" fd) == 1)
};

let io_enable_ansi! !p !h = true_word;

let stat_via! !p !path !link what = {
    let buf = scratch! p stat_bytes;
    let r = if link { prim.c2! "lstat" (string_bytes path) buf } else { prim.c2! "stat" (string_bytes path) buf };
    if prim.sext32 r != 0 {
        let e = errno! ();
        if e == 2 || e == 20 { unit_word } else { fail_path! p what path }
    } else {
        let mode = stat_mode! buf;
        let k = if is_symlink mode { prim.atom "link" }
                else if is_directory mode { prim.atom "dir" }
                else if is_regular mode { prim.atom "file" }
                else { prim.atom "other" };
        new_cons! p (tag_fix (stat_size! buf)) (new_cons! p (tag_fix (stat_mtime_ns! buf)) (new_cons! p k nil_word))
    }
};

let need_path! !p !v what = if is_string! v { 1 } else { fail! p atom_type_error what };

let io_stat! !p !path = if need_path! p path "stat! needs a path" == 0 { 0 } else { stat_via! p path false "stat" };
let io_lstat! !p !path = if need_path! p path "lstat! needs a path" == 0 { 0 } else { stat_via! p path true "lstat" };

let stat_kind! !p !path = {
    let buf = scratch! p stat_bytes;
    if prim.sext32 (prim.c2! "stat" (string_bytes path) buf) != 0 { 0 } else { stat_mode! buf }
};

let io_exists! !p !path = if not (is_string! path) { fail! p atom_type_error "exists! needs a path" } else {
    let buf = scratch! p stat_bytes;
    as_word (prim.sext32 (prim.c2! "stat" (string_bytes path) buf) == 0)
};

let io_is_dir! !p !path = if not (is_string! path) { fail! p atom_type_error "is_dir! needs a path" } else {
    as_word (is_directory (stat_kind! p path))
};

let io_is_link! !p !path = if not (is_string! path) { fail! p atom_type_error "is_link! needs a path" } else {
    let buf = scratch! p stat_bytes;
    as_word (prim.sext32 (prim.c2! "lstat" (string_bytes path) buf) == 0 && is_symlink (stat_mode! buf))
};

let io_mode! !p !path = if not (is_string! path) { fail! p atom_type_error "mode! needs a path" } else {
    let buf = scratch! p stat_bytes;
    if prim.sext32 (prim.c2! "stat" (string_bytes path) buf) != 0 {
        let e = errno! ();
        if e == 2 || e == 20 { unit_word } else { fail_path! p "mode" path }
    } else { tag_fix (stat_mode! buf & 4095) }
};

/// A call that answers -1 and sets `errno`, or unit.
let checked! !p !r verb !path = if prim.sext32 r != 0 { fail_path! p verb path } else { unit_word };

let io_remove! !p !path = {
    if not (is_string! path) { fail! p atom_type_error "remove! needs a path" }
    else { checked! p (prim.c1! "remove" (string_bytes path)) "remove" path }
};
let io_rename! !p !a !b = checked! p (prim.c2! "rename" (string_bytes a) (string_bytes b)) "rename" a;
let io_mkdir! !p !path = checked! p (prim.c2! "mkdir" (string_bytes path) 511) "mkdir" path;
let io_link! !p !a !b = if prim.sext32 (prim.c2! "link" (string_bytes a) (string_bytes b)) == 0 { prim.atom "linked" } else { fail_path! p "link" b };
let io_symlink! !p !a !b = checked! p (prim.c2! "symlink" (string_bytes a) (string_bytes b)) "symlink" b;
let io_chmod! !p !path !mode = checked! p (prim.c2! "chmod" (string_bytes path) (untag_fix mode)) "chmod" path;

let io_read_link! !p !path = {
    let buf = scratch! p 4100;
    let n = prim.c3! "readlink" (string_bytes path) buf 4096;
    if n < 0 {
        if errno! () == 22 { fail_value! p (prim.atom "wrong_kind") (concat2! p (text_of! p "read_link ") path) }
        else { fail_path! p "read_link" path }
    } else {
        let s = new_string! p n;
        prim.c3! "memcpy" (string_bytes s) buf n;
        s
    }
};

/// `dir/nameXXXXXX`, what `mkstemp` and `mkdtemp` fill in.
let temp_template! !p !dir !name = concat3! p (concat2! p dir (text_of! p "/")) name (text_of! p "XXXXXX");

let io_temp_file! !p !dir !name = {
    let t = temp_template! p dir name;
    let fd = prim.sext32 (prim.c1! "mkstemp" (string_bytes t));
    if fd < 0 { fail_path! p "temp_file" dir }
    else { new_cons! p t (new_cons! p (add_handle! p fd kind_file_handle) nil_word) }
};

let io_temp_dir! !p !dir !name = {
    let t = temp_template! p dir name;
    if prim.c1! "mkdtemp" (string_bytes t) == 0 { fail_path! p "temp_dir" dir } else { t }
};

let copy_fd! !from !to !buf = {
    let n = prim.c3! "read" from buf 65536;
    if n <= 0 { n } else {
        prim.c3! "write" to buf n;
        copy_fd! from to buf
    }
};

let io_copy! !p !a !b = {
    let from = prim.sext32 (prim.c3! "open" (string_bytes a) 524288 0);
    if from < 0 { fail_path! p "copy" a }
    else {
        let stat = scratch! p stat_bytes;
        prim.c2! "fstat" from stat;
        let to = prim.sext32 (prim.c3! "open" (string_bytes b) (1 | 64 | 512 | 524288) (stat_mode! stat & 4095));
        if to < 0 { prim.c1! "close" from; fail_path! p "copy" b }
        else {
            let buf = scratch! p 65536;
            copy_fd! from to buf;
            prim.c1! "close" from;
            prim.c1! "close" to;
            unit_word
        }
    }
};

// --- os ---------------------------------------------------------------------------------

let set_args! !p !argc !argv = {
    prim.store64! (world_at! w_argc) argc;
    prim.store64! (world_at! w_argv) argv;
    0
};

let args_from! !p !i !n !argv = if i >= n { nil_word } else {
    new_cons! p (c_text! p (prim.load64! (argv + i * word))) (args_from! p (i + 1) n argv)
};

/// What the program was given: the executable's own name is not one of them.
let os_args! !p !unit = args_from! p 1 (prim.load64! (world_at! w_argc)) (prim.load64! (world_at! w_argv));

let os_env! !p !name = if not (is_string! name) { fail! p atom_type_error "env! needs a name" } else {
    let v = prim.c1! "getenv" (string_bytes name);
    if v == 0 { unit_word } else { c_text! p v }
};

let os_set_env! !p !k !v = {
    prim.c3! "setenv" (string_bytes k) (string_bytes v) 1;
    unit_word
};

let os_cwd! !p !unit = {
    let buf = scratch! p 4100;
    if prim.c2! "getcwd" buf 4096 == 0 { fail! p (prim.atom "os_error") "getcwd failed" } else { c_text! p buf }
};

let os_chdir! !p !path = checked! p (prim.c1! "chdir" (string_bytes path)) "chdir" path;

let dir_names! !p !d !acc = {
    let entry = prim.c1! "readdir" d;
    if entry == 0 { acc } else {
        let name = entry + 19;
        let dot = prim.load8! name == 46 && (prim.load8! (name + 1) == 0 || (prim.load8! (name + 1) == 46 && prim.load8! (name + 2) == 0));
        dir_names! p d (if dot { acc } else { new_cons! p (c_text! p name) acc })
    }
};

/// Unsorted: the library sorts it, as it does everything that needs comparing.
let dir_list! !p !path = if not (is_string! path) { fail! p atom_type_error "list_dir! needs a path" } else {
    let d = prim.c1! "opendir" (string_bytes path);
    if d == 0 { fail_path! p "list_dir" path }
    else {
        let names = dir_names! p d nil_word;
        prim.c1! "closedir" d;
        names
    }
};

let os_monotonic! !p !unit = tag_fix (now_ns! p / 1000000);
let os_pid! !p !unit = tag_fix (prim.sext32 (prim.c0! "getpid"));
let os_platform! !p !unit = prim.atom "linux";
let os_arch! !p !unit = if prim.arch () == arch_aarch64 { prim.atom "aarch64" } else { prim.atom "x86_64" };
let os_exit! !p !code = if is_fix code {
    release_owned! p (tag_fix (prim.load64! (current! p + pcb_id)));
    prim.c1! "exit" (untag_fix code)
} else { fail! p atom_type_error "exit! needs an exit code" };

/// `$MINDV2_PATH`, or `~/.mindv2`: where an installation is, for a program with no VM
/// beside it to ask.
let os_install_dirs! !p !unit = {
    let set = prim.c1! "getenv" (string_bytes (text_of! p "MINDV2_PATH"));
    if set != 0 { new_cons! p (c_text! p set) nil_word }
    else {
        let home = prim.c1! "getenv" (string_bytes (text_of! p "HOME"));
        if home == 0 { nil_word } else { new_cons! p (concat2! p (c_text! p home) (text_of! p "/.mindv2")) nil_word }
    }
};

// --- a child process --------------------------------------------------------------------
//
// Its output is read through handles by the library, in ordinary processes, so a child
// blocks nothing. A failure to start is reported through a pipe that closes on exec:
// bytes arriving on it mean the exec did not happen.

let c_argv! !p !a !first = {
    let n = untag_fix (prim.load64! (a + word));
    let out = scratch! p ((n + 2) * word);
    prim.store64! out (string_bytes first);
    fill_argv! a out 0 n;
    prim.store64! (out + (n + 1) * word) 0;
    out
};

let fill_argv! !a !out !i !n = if i >= n { 0 } else {
    prim.store64! (out + (i + 1) * word) (string_bytes (prim.load64! (a + (2 + i) * word)));
    fill_argv! a out (i + 1) n
};

let child_env! !a !i !n = if i >= n { 0 } else {
    prim.c1! "putenv" (string_bytes (prim.load64! (a + (2 + i) * word)));
    child_env! a (i + 1) n
};

let pipe_pair! !p = {
    let buf = scratch! p word;
    prim.c2! "pipe2" buf 524288;
    buf
};

// A child is started by `posix_spawnp`, which shares the parent's memory until it has called
// `exec` rather than copying its page tables. `fork` copied them, and from many workers at once
// the copies queued on the kernel's lock for the address space: two hundred children started by
// as many processes took three times as long on 24 workers as on one.

/// The environment a child gets: `env`'s entries, then the parent's not named in them.
let child_envp! !p !env = {
    let n = untag_fix (prim.load64! (env + word));
    let environ = prim.load64! (prim.c2! "dlsym" 0 "environ");
    let inherited = count_words! environ 0;
    let out = scratch! p ((n + inherited + 1) * word);
    fill_argv_from! env out 0 n;
    let k = keep_unnamed! env environ out n 0 inherited;
    prim.store64! (out + k * word) 0;
    out
};

let count_words! !at !n = if prim.load64! (at + n * word) == 0 { n } else { count_words! at (n + 1) };

let fill_argv_from! !a !out !i !n = if i >= n { 0 } else {
    prim.store64! (out + i * word) (string_bytes (prim.load64! (a + (2 + i) * word)));
    fill_argv_from! a out (i + 1) n
};

/// The parent's entries whose name `env` does not give again, after the `k` already there.
let keep_unnamed! !env !environ !out !k !i !m = if i >= m { k } else {
    let entry = prim.load64! (environ + i * word);
    if names_one_of! env 0 (untag_fix (prim.load64! (env + word))) entry { keep_unnamed! env environ out k (i + 1) m }
    else {
        prim.store64! (out + k * word) entry;
        keep_unnamed! env environ out (k + 1) (i + 1) m
    }
};

let names_one_of! !env !i !n !entry = i < n && (same_name! (string_bytes (prim.load64! (env + (2 + i) * word))) entry 0 || names_one_of! env (i + 1) n entry);

/// Whether two `NAME=value` strings name the same variable.
let same_name! !a !b !i = {
    let x = prim.load8! (a + i);
    let y = prim.load8! (b + i);
    if x != y { false } else if x == 61 { true } else if x == 0 { false } else { same_name! a b (i + 1) }
};

/// `[pid, out handle, err handle]`. `env` and `args` are arrays of strings.
let spawn_child! !p !dir !env !program !args !joined = {
    let out = pipe_pair! p;
    let err = pipe_pair! p;
    let argv = c_argv! p args program;
    let envp = child_envp! p env;
    // posix_spawn_file_actions_t is 80 bytes on glibc; room to spare.
    let actions = scratch! p 128;
    prim.c1! "posix_spawn_file_actions_init" actions;
    prim.c3! "posix_spawn_file_actions_adddup2" actions (prim.load32! (out + 4)) 1;
    prim.c3! "posix_spawn_file_actions_adddup2" actions (if joined == true_word { prim.load32! (out + 4) } else { prim.load32! (err + 4) }) 2;
    if dir != unit_word { prim.c2! "posix_spawn_file_actions_addchdir_np" actions (string_bytes dir); };
    let pid_at = scratch! p word;
    let r = prim.sext32 (prim.c6! "posix_spawnp" pid_at (string_bytes program) actions 0 argv envp);
    prim.c1! "posix_spawn_file_actions_destroy" actions;
    prim.c1! "close" (prim.load32! (out + 4));
    prim.c1! "close" (prim.load32! (err + 4));
    if r != 0 {
        prim.c1! "close" (prim.load32! out);
        prim.c1! "close" (prim.load32! err);
        fail_value! p (prim.atom "not_found") (concat3! p (text_of! p "exec ") program (concat2! p (text_of! p ": ") (c_text! p (prim.c1! "strerror" r))))
    } else {
        let pid = prim.sext32 (prim.load32! pid_at);
        set_nonblocking! (prim.load32! out);
        set_nonblocking! (prim.load32! err);
        new_cons! p (tag_fix pid) (new_cons! p (add_handle! p (prim.load32! out) kind_stream_handle)
            (new_cons! p (add_handle! p (prim.load32! err) kind_stream_handle) nil_word))
    }
};

/// The exit code, or unit if it is still going.
let child_status! !p !pid = {
    let buf = scratch! p word;
    let r = prim.c3! "waitpid" (untag_fix pid) buf 1;
    if prim.sext32 r == 0 { unit_word }
    else {
        let status = prim.load32! buf;
        if status & 127 == 0 { tag_fix ((status >> 8) & 255) } else { tag_fix (128 + (status & 127)) }
    }
};

/// A child's exit status, waited for without holding a worker: on a `pidfd`, which the system
/// says is readable when the child has exited, and until `deadline` (in nanoseconds; 0 for none),
/// past which it answers `()`. The descriptor travels in the retry frame and is closed at the end.
let child_wait_m! !p !sp !self_ !pid !deadline !held = {
    let status = child_status! p pid;
    let at = untag_fix deadline;
    let late = at > 0 && now_ns! p >= at;
    if status != unit_word || late {
        // Told as closed first, so that no registration of it outlives it.
        if is_fix held { fd_closed! p (untag_fix held); prim.c1! "close" (untag_fix held); };
        return! p sp status
    } else {
        let fd = if is_fix held { untag_fix held } else { prim.sext32 (prim.c3! "syscall" 434 (untag_fix pid) 0) };
        let pcb = current! p;
        if at > 0 { set_wake_at! p pcb at; };
        let code = prim.load64! (prim.info "m_child");
        if fd < 0 {
            // A system without pidfds: look again in a millisecond.
            set_wake_at! p pcb (now_ns! p + 1000000);
            park! p sp code pid deadline unit_word
        } else {
            pcb_lock! pcb;
            prim.store64! (pcb + pcb_wait_fd) (fd + 1);
            prim.store64! (pcb + pcb_wait_write) 0;
            pcb_unlock! pcb;
            if note_fd! p pcb fd false == wait_again { prim.store64! (pcb + pcb_woken) 1; };
            park! p sp code pid deadline (tag_fix fd)
        }
    }
};

let child_kill! !p !pid = {
    prim.c2! "kill" (untag_fix pid) 9;
    unit_word
};

// --- sockets ----------------------------------------------------------------------------

let af_inet = 2;
let sock_stream = 1;
let sockaddr_bytes = 16;

/// The IPv4 address of `host` if it is written as one, in network order, or -1.
let numeric_ipv4! !p !host = {
    let buf = prim.load64! (p + ctx_timebuf);
    if prim.sext32 (prim.c3! "inet_pton" af_inet (string_bytes host) buf) == 1 { prim.load32! buf } else { 0 - 1 }
};

/// A lookup of `host` for the pool: `getaddrinfo` with its hints and its answer in the job.
let resolve_job! !p !host = {
    let job = new_job! (prim.c2! "dlsym" 0 "getaddrinfo") (string_bytes host) 0 0 0;
    let hints = job + job_room;
    prim.store32! (hints + 4) af_inet;
    prim.store32! (hints + 8) sock_stream;
    prim.store64! (job + job_args + 2 * word) hints;
    prim.store64! (job + job_args + 3 * word) (job + job_room + 64);
    job
};

/// What a finished lookup found, the job freed: an address or -1.
let resolved! !job = {
    let r = prim.sext32 (prim.load64! (job + job_result));
    let ip = if r != 0 { 0 - 1 } else {
        let info = prim.load64! (job + job_room + 64);
        let ip_ = prim.load32! (prim.load64! (info + 24) + 4);
        prim.c1! "freeaddrinfo" info;
        ip_
    };
    prim.c1! "free" job;
    ip
};

/// The IPv4 address of `host`, in network order, or -1. This one blocks its worker, and is for
/// what cannot park; a process that can uses the pool (`net_connect_m!`).
let resolve_ipv4! !p !host = {
    let hints = scratch! p 48;
    zero_words! hints 6;
    prim.store32! (hints + 4) af_inet;
    prim.store32! (hints + 8) sock_stream;
    let result = scratch! p word;
    let r = prim.sext32 (prim.c4! "getaddrinfo" (string_bytes host) 0 hints result);
    if r != 0 { 0 - 1 }
    else {
        let info = prim.load64! result;
        let addr = prim.load64! (info + 24);
        let ip = prim.load32! (addr + 4);
        prim.c1! "freeaddrinfo" info;
        ip
    }
};

let write_addr! !at !ip !port = {
    prim.store16! at af_inet;
    prim.store8! (at + 2) (port >> 8);
    prim.store8! (at + 3) (port & 255);
    prim.store32! (at + 4) ip;
    prim.store64! (at + 8) 0;
    0
};

let new_socket! () = prim.sext32 (prim.c3! "socket" af_inet (sock_stream | 2048 | 524288) 0);

let listen_at! !p !ip !port = {
    let fd = new_socket! ();
    if fd < 0 { fail_errno! p (text_of! p "socket") }
    else {
        let one = scratch! p word;
        prim.store32! one 1;
        prim.c5! "setsockopt" fd 1 2 one 4;
        let addr = scratch! p sockaddr_bytes;
        write_addr! addr ip port;
        if prim.sext32 (prim.c3! "bind" fd addr sockaddr_bytes) < 0 || prim.sext32 (prim.c2! "listen" fd 128) < 0 {
            let failure = fail_errno! p (text_of! p "listen");
            prim.c1! "close" fd;
            failure
        } else { add_handle! p fd kind_listener_handle }
    }
};

let port_ok !v = is_fix v && untag_fix v >= 0 && untag_fix v <= 65535;

let net_listen! !p !port = if port_ok port { listen_at! p 0 (untag_fix port) } else { fail! p (prim.atom "bad_argument") "listen! needs a port between 0 and 65535" };

let net_listen_on! !p !host !port =
    if not (is_string! host) { fail! p atom_type_error "listen_on! needs a host to bind" }
    else if not (port_ok port) { fail! p (prim.atom "bad_argument") "listen_on! needs a port between 0 and 65535" }
    else {
        let ip = resolve_ipv4! p host;
        if ip < 0 { fail_value! p (prim.atom "not_found") (concat2! p (text_of! p "cannot resolve ") host) }
        else { listen_at! p ip (untag_fix port) }
    };

let net_accept_m! !p !sp !self_ !h !c !d = {
    let fd = fd_of! p h;
    if fd < 0 { closed! p "this socket is closed"; native_failed! p sp 0 0 0 0 }
    else {
        let got = prim.sext32 (prim.c4! "accept4" fd 0 0 (2048 | 524288));
        if got >= 0 { return! p sp (add_handle! p got kind_stream_handle) }
        else {
            let e = errno! ();
            if e == 11 { wait_fd! p sp (prim.load64! (prim.info "m_accept")) h unit_word fd }
            else if e == 4 { net_accept_m! p sp 0 h 0 0 }
            else { fail_errno! p (text_of! p "accept"); native_failed! p sp 0 0 0 0 }
        }
    }
};

/// `connect!`. A name that is not an address is looked up by the pool, the process parked
/// meanwhile with the job, tagged, as its third word.
let net_connect_m! !p !sp !self_ !host !port !d =
    if not (is_string! host) || not (port_ok port) { fail! p atom_type_error "connect! needs a host and a port"; native_failed! p sp 0 0 0 0 }
    else {
        let numeric = numeric_ipv4! p host;
        if numeric >= 0 { connect_to! p sp host port numeric }
        else if is_fix d {
            let job = untag_fix d;
            if job_is_done! job { connect_to! p sp host port (resolved! job) }
            else { park! p sp (prim.load64! (prim.info "m_connect")) host port d }
        } else {
            let job = resolve_job! p host;
            submit_job! p job;
            park! p sp (prim.load64! (prim.info "m_connect")) host port (tag_fix job)
        }
    };

let connect_to! !p !sp !host !port !ip = {
    {
        if ip < 0 {
            fail_value! p (prim.atom "not_found") (concat2! p (text_of! p "cannot resolve ") host);
            native_failed! p sp 0 0 0 0
        } else {
            let fd = new_socket! ();
            let addr = scratch! p sockaddr_bytes;
            write_addr! addr ip (untag_fix port);
            let r = prim.sext32 (prim.c3! "connect" fd addr sockaddr_bytes);
            if r == 0 { return! p sp (add_handle! p fd kind_stream_handle) }
            else if errno! () == 115 {
                let h = add_handle! p fd kind_stream_handle;
                prim.store64! (current! p + pcb_wait_write) 1;
                wait_fd! p sp (prim.load64! (prim.info "m_connected")) h unit_word fd
            } else {
                fail_errno! p (concat2! p (text_of! p "connect ") host);
                prim.c1! "close" fd;
                native_failed! p sp 0 0 0 0
            }
        }
    }
};

/// A connection in progress has become writable, which says only that it is finished.
let net_connected_m! !p !sp !self_ !h !c !d = {
    let fd = fd_of! p h;
    let code = scratch! p word;
    let size = scratch! p word;
    prim.store32! size 4;
    prim.c5! "getsockopt" fd 1 4 code size;
    let e = prim.load32! code;
    if e == 0 { return! p sp h }
    else {
        fd_closed! p fd;
        prim.c1! "close" fd;
        prim.store64! (prim.load64! (world_at! w_handles) + untag_fix h * handle_words * word) (0 - 1);
        fail_value! p (errno_kind e) (concat2! p (text_of! p "connect: ") (c_text! p (prim.c1! "strerror" e)));
        native_failed! p sp 0 0 0 0
    }
};

let addr_port! !at = prim.load8! (at + 2) * 256 + prim.load8! (at + 3);

let name_of! !p !h !peer = {
    let fd = fd_of! p h;
    let addr = scratch! p sockaddr_bytes;
    let size = scratch! p word;
    prim.store32! size sockaddr_bytes;
    let r = if peer { prim.c3! "getpeername" fd addr size } else { prim.c3! "getsockname" fd addr size };
    if prim.sext32 r < 0 { 0 } else { addr }
};

let net_peer! !p !h = if fd_of! p h < 0 { closed! p "this socket is closed" } else {
    let addr = name_of! p h true;
    if addr == 0 { fail_errno! p (text_of! p "peer") }
    else {
        let text = scratch! p 32;
        prim.c4! "inet_ntop" af_inet (addr + 4) text 32;
        concat3! p (c_text! p text) (text_of! p ":") (int_to_string! p (tag_fix (addr_port! addr)))
    }
};

let net_port! !p !h = if fd_of! p h < 0 { closed! p "this socket is closed" } else {
    let addr = name_of! p h false;
    if addr == 0 { fail_errno! p (text_of! p "port") } else { tag_fix (addr_port! addr) }
};

let net_shutdown! !p !h = if fd_of! p h < 0 { closed! p "this socket is closed" } else {
    if session_of! p h != 0 { tls_goodbye! p (session_of! p h) (fd_of! p h); };
    prim.c2! "shutdown" (fd_of! p h) 1;
    unit_word
};

// --- crypto ------------------------------------------------------------------------------
//
// The hashes written out, on raw words, as RFC 1321 and FIPS 180 give them. The constants
// are hexadecimal text read once into memory, since the dialect has no static arrays and
// the 64-bit ones do not fit a literal.

let hex_digit !c = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };

let hex_words! !s !out !i !n !width = if i >= n { out } else {
    prim.store64! (out + i * word) (hex_word! (s + i * width) width 0);
    hex_words! s out (i + 1) n width
};

let hex_word! !s !left !acc = if left == 0 { acc } else {
    hex_word! (s + 1) (left - 1) ((acc << 4) | hex_digit (prim.load8! s))
};

let k512_text = "";
let h512_text = "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179";
let h384_text = "cbbb9d5dc1059ed8629a292a367cd5079159015a3070dd17152fecd8f70e593967332667ffc00b318eb44a8768581511db0c2e0d64f98fa747b5481dbefa4fa4";
let h256_text = "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19";

/// The 80 round constants, made once: SHA-256's are the first 64 of them, cut short.
let k512! !p = {
    let have = prim.load64! (world_at! w_k512);
    if have != 0 { have } else {
        let t = hex_words! k512_text (prim.c1! "malloc" (80 * word)) 0 80 16;
        prim.store_rel! (world_at! w_k512) t;
        t
    }
};

let mask32 = 4294967295;
let rotr32 !x !n = ((x >> n) | (x << (32 - n))) & mask32;
let rotl32 !x !n = ((x << n) | (x >> (32 - n))) & mask32;
let be32! !at = (prim.load8! at << 24) | (prim.load8! (at + 1) << 16) | (prim.load8! (at + 2) << 8) | prim.load8! (at + 3);
let le32! !at = prim.load32! at;
let be64! !at = (be32! at << 32) | be32! (at + 4);
let store_be32! !at !v = {
    prim.store8! at (prim.ushr v 24);
    prim.store8! (at + 1) (prim.ushr v 16);
    prim.store8! (at + 2) (prim.ushr v 8);
    prim.store8! (at + 3) v;
    0
};
let store_be64! !at !v = {
    store_be32! at (prim.ushr v 32);
    store_be32! (at + 4) v;
    0
};
let rotr64 !x !n = prim.ushr x n | (x << (64 - n));

/// The message and its padding: a 1 bit, zeros, and the length in the last bytes.
let padded! !p !data !n !block !len_bytes !big = {
    let total = (n + 1 + len_bytes + block - 1) / block * block;
    let m = scratch! p (total + word);
    prim.c3! "memset" m 0 total;
    prim.c3! "memcpy" m data n;
    prim.store8! (m + n) 128;
    let bits = n * 8;
    if big { store_be64! (m + total - 8) bits; }
    else { prim.store64! (m + total - 8) bits; };
    prim.store64! (p + ctx_scratch) total;
    m
};

let sha256_w! !w !i = if i >= 64 { 0 } else {
    let x = prim.load64! (w + (i - 15) * word);
    let y = prim.load64! (w + (i - 2) * word);
    let s0 = rotr32 x 7 ^ rotr32 x 18 ^ (x >> 3);
    let s1 = rotr32 y 17 ^ rotr32 y 19 ^ (y >> 10);
    prim.store64! (w + i * word) ((prim.load64! (w + (i - 16) * word) + s0 + prim.load64! (w + (i - 7) * word) + s1) & mask32);
    sha256_w! w (i + 1)
};

let sha256_load! !w !m !i = if i >= 16 { 0 } else {
    prim.store64! (w + i * word) (be32! (m + i * 4));
    sha256_load! w m (i + 1)
};

let sha256_rounds! !s !w !k !i = if i >= 64 { 0 } else {
    let a = prim.load64! s;
    let e = prim.load64! (s + 4 * word);
    let f = prim.load64! (s + 5 * word);
    let g = prim.load64! (s + 6 * word);
    let b = prim.load64! (s + word);
    let c = prim.load64! (s + 2 * word);
    let s1 = rotr32 e 6 ^ rotr32 e 11 ^ rotr32 e 25;
    let ch = (e & f) ^ ((e ^ mask32) & g);
    let t1 = prim.load64! (s + 7 * word) + s1 + ch + (prim.ushr (prim.load64! (k + i * word)) 32) + prim.load64! (w + i * word);
    let s0 = rotr32 a 2 ^ rotr32 a 13 ^ rotr32 a 22;
    let maj = (a & b) ^ (a & c) ^ (b & c);
    prim.store64! (s + 7 * word) g;
    prim.store64! (s + 6 * word) f;
    prim.store64! (s + 5 * word) e;
    prim.store64! (s + 4 * word) ((prim.load64! (s + 3 * word) + t1) & mask32);
    prim.store64! (s + 3 * word) c;
    prim.store64! (s + 2 * word) b;
    prim.store64! (s + word) a;
    prim.store64! s ((t1 + s0 + maj) & mask32);
    sha256_rounds! s w k (i + 1)
};

let add_state! !h !s !n !mask !i = if i >= n { 0 } else {
    prim.store64! (h + i * word) ((prim.load64! (h + i * word) + prim.load64! (s + i * word)) & mask);
    add_state! h s n mask (i + 1)
};

let sha256_blocks! !p !h !m !left !w !s = if left <= 0 { 0 } else {
    sha256_load! w m 0;
    sha256_w! w 16;
    copy_words! h s 8;
    sha256_rounds! s w (k512! p) 0;
    add_state! h s 8 mask32 0;
    sha256_blocks! p h (m + 64) (left - 64) w s
};

let out_be32! !out !h !i !n = if i >= n { 0 } else {
    store_be32! (out + i * 4) (prim.load64! (h + i * word));
    out_be32! out h (i + 1) n
};

let sha256! !p !data !n = {
    let m = padded! p data n 64 8 true;
    let total = prim.load64! (p + ctx_scratch);
    let h = hex_words! h256_text (scratch! p (8 * word)) 0 8 8;
    sha256_blocks! p h m total (scratch! p (64 * word)) (scratch! p (8 * word));
    let out = new_string! p 32;
    out_be32! (string_bytes out) h 0 8;
    out
};

let sha512_load! !w !m !i = if i >= 16 { 0 } else {
    prim.store64! (w + i * word) (be64! (m + i * 8));
    sha512_load! w m (i + 1)
};

let sha512_w! !w !i = if i >= 80 { 0 } else {
    let x = prim.load64! (w + (i - 15) * word);
    let y = prim.load64! (w + (i - 2) * word);
    let s0 = rotr64 x 1 ^ rotr64 x 8 ^ prim.ushr x 7;
    let s1 = rotr64 y 19 ^ rotr64 y 61 ^ prim.ushr y 6;
    prim.store64! (w + i * word) (prim.load64! (w + (i - 16) * word) + s0 + prim.load64! (w + (i - 7) * word) + s1);
    sha512_w! w (i + 1)
};

let sha512_rounds! !s !w !k !i = if i >= 80 { 0 } else {
    let a = prim.load64! s;
    let e = prim.load64! (s + 4 * word);
    let f = prim.load64! (s + 5 * word);
    let g = prim.load64! (s + 6 * word);
    let b = prim.load64! (s + word);
    let c = prim.load64! (s + 2 * word);
    let s1 = rotr64 e 14 ^ rotr64 e 18 ^ rotr64 e 41;
    let ch = (e & f) ^ ((e ^ (0 - 1)) & g);
    let t1 = prim.load64! (s + 7 * word) + s1 + ch + prim.load64! (k + i * word) + prim.load64! (w + i * word);
    let s0 = rotr64 a 28 ^ rotr64 a 34 ^ rotr64 a 39;
    let maj = (a & b) ^ (a & c) ^ (b & c);
    prim.store64! (s + 7 * word) g;
    prim.store64! (s + 6 * word) f;
    prim.store64! (s + 5 * word) e;
    prim.store64! (s + 4 * word) (prim.load64! (s + 3 * word) + t1);
    prim.store64! (s + 3 * word) c;
    prim.store64! (s + 2 * word) b;
    prim.store64! (s + word) a;
    prim.store64! s (t1 + s0 + maj);
    sha512_rounds! s w k (i + 1)
};

let sha512_blocks! !p !h !m !left !w !s = if left <= 0 { 0 } else {
    sha512_load! w m 0;
    sha512_w! w 16;
    copy_words! h s 8;
    sha512_rounds! s w (k512! p) 0;
    add_state! h s 8 (0 - 1) 0;
    sha512_blocks! p h (m + 128) (left - 128) w s
};

let out_be64! !out !h !i !n = if i >= n { 0 } else {
    store_be64! (out + i * 8) (prim.load64! (h + i * word));
    out_be64! out h (i + 1) n
};

let sha512_family! !p !data !n !init !size = {
    let m = padded! p data n 128 16 true;
    let total = prim.load64! (p + ctx_scratch);
    let h = hex_words! init (scratch! p (8 * word)) 0 8 16;
    sha512_blocks! p h m total (scratch! p (80 * word)) (scratch! p (8 * word));
    let out = new_string! p size;
    let wide = scratch! p 64;
    out_be64! wide h 0 8;
    prim.c3! "memcpy" (string_bytes out) wide size;
    out
};

let sha1_w! !w !i = if i >= 80 { 0 } else {
    prim.store64! (w + i * word) (rotl32 (prim.load64! (w + (i - 3) * word) ^ prim.load64! (w + (i - 8) * word) ^ prim.load64! (w + (i - 14) * word) ^ prim.load64! (w + (i - 16) * word)) 1);
    sha1_w! w (i + 1)
};

let sha1_rounds! !s !w !i = if i >= 80 { 0 } else {
    let a = prim.load64! s;
    let b = prim.load64! (s + word);
    let c = prim.load64! (s + 2 * word);
    let d = prim.load64! (s + 3 * word);
    let f = if i < 20 { (b & c) | ((b ^ mask32) & d) }
            else if i < 40 { b ^ c ^ d }
            else if i < 60 { (b & c) | (b & d) | (c & d) }
            else { b ^ c ^ d };
    let k = if i < 20 { 1518500249 } else if i < 40 { 1859775393 } else if i < 60 { 2400959708 } else { 3395469782 };
    let t = (rotl32 a 5 + f + prim.load64! (s + 4 * word) + k + prim.load64! (w + i * word)) & mask32;
    prim.store64! (s + 4 * word) d;
    prim.store64! (s + 3 * word) c;
    prim.store64! (s + 2 * word) (rotl32 b 30);
    prim.store64! (s + word) a;
    prim.store64! s t;
    sha1_rounds! s w (i + 1)
};

let sha1_blocks! !h !m !left !w !s = if left <= 0 { 0 } else {
    sha256_load! w m 0;
    sha1_w! w 16;
    copy_words! h s 5;
    sha1_rounds! s w 0;
    add_state! h s 5 mask32 0;
    sha1_blocks! h (m + 64) (left - 64) w s
};

let sha1! !p !data !n = {
    let m = padded! p data n 64 8 true;
    let total = prim.load64! (p + ctx_scratch);
    let h = scratch! p (5 * word);
    prim.store64! h 1732584193;
    prim.store64! (h + word) 4023233417;
    prim.store64! (h + 2 * word) 2562383102;
    prim.store64! (h + 3 * word) 271733878;
    prim.store64! (h + 4 * word) 3285377520;
    sha1_blocks! h m total (scratch! p (80 * word)) (scratch! p (5 * word));
    let out = new_string! p 20;
    out_be32! (string_bytes out) h 0 5;
    out
};

let md5_shift !i = {
    let group = i / 16;
    let at = i % 4;
    if group == 0 { if at == 0 { 7 } else if at == 1 { 12 } else if at == 2 { 17 } else { 22 } }
    else if group == 1 { if at == 0 { 5 } else if at == 1 { 9 } else if at == 2 { 14 } else { 20 } }
    else if group == 2 { if at == 0 { 4 } else if at == 1 { 11 } else if at == 2 { 16 } else { 23 } }
    else { if at == 0 { 6 } else if at == 1 { 10 } else if at == 2 { 15 } else { 21 } }
};

/// `floor(2^32 * |sin(i + 1)|)`, as RFC 1321 defines the table.
let md5_k! !i = prim.f2i (prim.fmul (prim.fabs (prim.d1! "sin" (prim.i2f (i + 1)))) (prim.i2f 4294967296));

let md5_rounds! !s !m !i = if i >= 64 { 0 } else {
    let a = prim.load64! s;
    let b = prim.load64! (s + word);
    let c = prim.load64! (s + 2 * word);
    let d = prim.load64! (s + 3 * word);
    let group = i / 16;
    let f = if group == 0 { (b & c) | ((b ^ mask32) & d) }
            else if group == 1 { (d & b) | ((d ^ mask32) & c) }
            else if group == 2 { b ^ c ^ d }
            else { c ^ (b | (d ^ mask32)) };
    let g = if group == 0 { i } else if group == 1 { (5 * i + 1) % 16 } else if group == 2 { (3 * i + 5) % 16 } else { (7 * i) % 16 };
    let t = (a + (f & mask32) + md5_k! i + le32! (m + g * 4)) & mask32;
    prim.store64! s d;
    prim.store64! (s + 3 * word) c;
    prim.store64! (s + 2 * word) b;
    prim.store64! (s + word) ((b + rotl32 t (md5_shift i)) & mask32);
    md5_rounds! s m (i + 1)
};

let md5_blocks! !h !m !left !s = if left <= 0 { 0 } else {
    copy_words! h s 4;
    md5_rounds! s m 0;
    add_state! h s 4 mask32 0;
    md5_blocks! h (m + 64) (left - 64) s
};

let md5! !p !data !n = {
    let m = padded! p data n 64 8 false;
    let total = prim.load64! (p + ctx_scratch);
    let h = scratch! p (4 * word);
    prim.store64! h 1732584193;
    prim.store64! (h + word) 4023233417;
    prim.store64! (h + 2 * word) 2562383102;
    prim.store64! (h + 3 * word) 271733878;
    md5_blocks! h m total (scratch! p (4 * word));
    let out = new_string! p 16;
    prim.store32! (string_bytes out) (prim.load64! h);
    prim.store32! (string_bytes out + 4) (prim.load64! (h + word));
    prim.store32! (string_bytes out + 8) (prim.load64! (h + 2 * word));
    prim.store32! (string_bytes out + 12) (prim.load64! (h + 3 * word));
    out
};

/// 0 for what is not a hash.
let alg_code !a =
    if a == prim.atom "sha256" { 1 } else if a == prim.atom "sha512" { 2 } else if a == prim.atom "sha384" { 3 }
    else if a == prim.atom "sha1" { 4 } else if a == prim.atom "md5" { 5 } else { 0 };

let hash_bytes! !p !alg !data !n =
    if alg == 1 { sha256! p data n }
    else if alg == 2 { sha512_family! p data n h512_text 64 }
    else if alg == 3 { sha512_family! p data n h384_text 48 }
    else if alg == 4 { sha1! p data n }
    else { md5! p data n };

let block_size !alg = if alg == 2 || alg == 3 { 128 } else { 64 };

let hash_string! !p !alg !s = hash_bytes! p alg (string_bytes s) (string_len! s);

let bad_alg! !p fn_name = fail_value! p atom_type_error (concat2! p (text_of! p fn_name) (text_of! p " needs a hash: :md5, :sha1, :sha256, :sha384 or :sha512"));

let crypto_md5! !p !s = if is_string! s { hash_string! p 5 s } else { type_fail! p "digest needs a string" };
let crypto_sha1! !p !s = if is_string! s { hash_string! p 4 s } else { type_fail! p "digest needs a string" };
let crypto_sha256! !p !s = if is_string! s { hash_string! p 1 s } else { type_fail! p "digest needs a string" };
let crypto_sha384! !p !s = if is_string! s { hash_string! p 3 s } else { type_fail! p "digest needs a string" };
let crypto_sha512! !p !s = if is_string! s { hash_string! p 2 s } else { type_fail! p "digest needs a string" };

let crypto_digest! !p !a !s = {
    let alg = alg_code a;
    if alg == 0 { bad_alg! p "digest" } else if is_string! s { hash_string! p alg s } else { type_fail! p "digest needs a string" }
};

let xor_block! !to !from !n !v = if n == 0 { 0 } else {
    prim.store8! to (prim.load8! from ^ v);
    xor_block! (to + 1) (from + 1) (n - 1) v
};

/// `H(k ^ opad, H(k ^ ipad, m))`, a key longer than a block being hashed first.
let hmac_bytes! !p !alg !key !msg !n = {
    let block = block_size alg;
    let short = if string_len! key > block { hash_string! p alg key } else { key };
    let padded_key = scratch! p (block + word);
    prim.c3! "memset" padded_key 0 block;
    prim.c3! "memcpy" padded_key (string_bytes short) (string_len! short);
    let inner = scratch! p (block + n + word);
    xor_block! inner padded_key block 54;
    prim.c3! "memcpy" (inner + block) msg n;
    let first = hash_bytes! p alg inner (block + n);
    let outer = scratch! p (block + string_len! first + word);
    xor_block! outer padded_key block 92;
    prim.c3! "memcpy" (outer + block) (string_bytes first) (string_len! first);
    hash_bytes! p alg outer (block + string_len! first)
};

let crypto_hmac! !p !a !key !msg = {
    let alg = alg_code a;
    if alg == 0 { bad_alg! p "hmac" }
    else if not (is_string! key && is_string! msg) { type_fail! p "hmac needs a key and a message, both strings" }
    else { hmac_bytes! p alg key (string_bytes msg) (string_len! msg) }
};

let pbkdf2_iter! !p !alg !key !u !t !left = if left == 0 { 0 } else {
    let next = hmac_bytes! p alg key (string_bytes u) (string_len! u);
    xor_into! (string_bytes t) (string_bytes next) (string_len! next);
    pbkdf2_iter! p alg key next t (left - 1)
};

let xor_into! !to !from !n = if n == 0 { 0 } else {
    prim.store8! to (prim.load8! to ^ prim.load8! from);
    xor_into! (to + 1) (from + 1) (n - 1)
};

let pbkdf2_blocks! !p !a !key !salt !iters !state = {
    let out = prim.load64! state;
    let wanted = prim.load64! (state + word);
    let done = prim.load64! (state + 2 * word);
    if done >= wanted { 0 } else {
        let alg = alg_code a;
        let index = prim.load64! (state + 3 * word);
        let m = scratch! p (string_len! salt + 8 + word);
        prim.c3! "memcpy" m (string_bytes salt) (string_len! salt);
        store_be32! (m + string_len! salt) index;
        let first = hmac_bytes! p alg key m (string_len! salt + 4);
        let t = str_slice_any! p first (tag_fix 0) (tag_fix (string_len! first));
        pbkdf2_iter! p alg key first t (iters - 1);
        let take = if wanted - done < string_len! t { wanted - done } else { string_len! t };
        prim.c3! "memcpy" (out + done) (string_bytes t) take;
        prim.store64! (state + 2 * word) (done + take);
        prim.store64! (state + 3 * word) (index + 1);
        pbkdf2_blocks! p a key salt iters state
    }
};

let crypto_pbkdf2! !p !a !password !salt !iters !len = {
    if alg_code a == 0 { bad_alg! p "pbkdf2" }
    else if not (is_string! password && is_string! salt) { type_fail! p "pbkdf2 needs a password and a salt, both strings" }
    else if not (is_fix iters) || untag_fix iters <= 0 { type_fail! p "pbkdf2 needs a positive iteration count" }
    else if not (is_fix len) || untag_fix len <= 0 || untag_fix len > 16777216 { type_fail! p "pbkdf2 needs a key length between 1 and 2^24 bytes" }
    else {
        let out = new_string! p (untag_fix len);
        let state = scratch! p (4 * word);
        prim.store64! state (string_bytes out);
        prim.store64! (state + word) (untag_fix len);
        prim.store64! (state + 2 * word) 0;
        prim.store64! (state + 3 * word) 1;
        pbkdf2_blocks! p a password salt (untag_fix iters) state;
        out
    }
};

let hkdf_expand! !p !alg !prk !info !out_state = {
    let out = prim.load64! out_state;
    let wanted = prim.load64! (out_state + word);
    let done = prim.load64! (out_state + 2 * word);
    if done >= wanted { 0 } else {
        let previous = prim.load64! (out_state + 3 * word);
        let index = prim.load64! (out_state + 4 * word);
        let before = string_len! previous;
        let m = scratch! p (before + string_len! info + 1 + word);
        prim.c3! "memcpy" m (string_bytes previous) before;
        prim.c3! "memcpy" (m + before) (string_bytes info) (string_len! info);
        prim.store8! (m + before + string_len! info) index;
        let t = hmac_bytes! p alg prk m (before + string_len! info + 1);
        let take = if wanted - done < string_len! t { wanted - done } else { string_len! t };
        prim.c3! "memcpy" (out + done) (string_bytes t) take;
        prim.store64! (out_state + 2 * word) (done + take);
        prim.store64! (out_state + 3 * word) t;
        prim.store64! (out_state + 4 * word) (index + 1);
        hkdf_expand! p alg prk info out_state
    }
};

let digest_size !alg = if alg == 1 { 32 } else if alg == 2 { 64 } else if alg == 3 { 48 } else if alg == 4 { 20 } else { 16 };

let crypto_hkdf! !p !a !key !salt !info !len = {
    let alg = alg_code a;
    if alg == 0 { bad_alg! p "hkdf" }
    else if not (is_string! key && is_string! salt && is_string! info) { type_fail! p "hkdf needs a key, a salt and an info, all strings" }
    else if not (is_fix len) || untag_fix len <= 0 || untag_fix len > 255 * digest_size alg { type_fail! p "hkdf needs a length between 1 and 255 hash lengths" }
    else {
        // An empty salt is a block of zeros, which HMAC pads to the same thing.
        let prk = hmac_bytes! p alg salt (string_bytes key) (string_len! key);
        let out = new_string! p (untag_fix len);
        let state = scratch! p (5 * word);
        prim.store64! state (string_bytes out);
        prim.store64! (state + word) (untag_fix len);
        prim.store64! (state + 2 * word) 0;
        prim.store64! (state + 3 * word) (text_of! p "");
        prim.store64! (state + 4 * word) 1;
        hkdf_expand! p alg prk info state;
        out
    }
};

let diff_bytes! !a !b !n !acc = if n == 0 { acc } else {
    diff_bytes! (a + 1) (b + 1) (n - 1) (acc | (prim.load8! a ^ prim.load8! b))
};

/// In time that depends on the length only.
let crypto_equal! !p !a !b =
    if not (is_string! a && is_string! b) { type_fail! p "equal needs two strings" }
    else if string_len! a != string_len! b { false_word }
    else { as_word (diff_bytes! (string_bytes a) (string_bytes b) (string_len! a) 0 == 0) };

let crypto_xor! !p !a !b =
    if not (is_string! a && is_string! b) { type_fail! p "xor needs two strings" }
    else if string_len! a != string_len! b { type_fail! p "xor needs two strings of one length" }
    else {
        let out = str_slice_any! p a (tag_fix 0) (tag_fix (string_len! a));
        xor_into! (string_bytes out) (string_bytes b) (string_len! b);
        out
    };

let hex_char !v = if v < 10 { 48 + v } else { 87 + v };

let hex_into! !from !to !n = if n == 0 { 0 } else {
    let b = prim.load8! from;
    prim.store8! to (hex_char (b >> 4));
    prim.store8! (to + 1) (hex_char (b & 15));
    hex_into! (from + 1) (to + 2) (n - 1)
};

let crypto_hex! !p !s = if not (is_string! s) { type_fail! p "hex needs a string" } else {
    let out = new_string! p (string_len! s * 2);
    hex_into! (string_bytes s) (string_bytes out) (string_len! s);
    out
};

let nibble !c = if c >= 48 && c <= 57 { c - 48 } else if c >= 97 && c <= 102 { c - 87 } else if c >= 65 && c <= 70 { c - 55 } else { 0 - 1 };

let unhex_into! !from !to !n = if n == 0 { 1 } else {
    let hi = nibble (prim.load8! from);
    let lo = nibble (prim.load8! (from + 1));
    if hi < 0 || lo < 0 { 0 } else {
        prim.store8! to (hi * 16 + lo);
        unhex_into! (from + 2) (to + 1) (n - 1)
    }
};

let crypto_unhex! !p !s =
    if not (is_string! s) { type_fail! p "unhex needs a string" }
    else if string_len! s % 2 != 0 { unit_word }
    else {
        let out = new_string! p (string_len! s / 2);
        if unhex_into! (string_bytes s) (string_bytes out) (string_len! s / 2) == 0 { unit_word } else { out }
    };

let base64_char !v =
    if v < 26 { 65 + v } else if v < 52 { 71 + v } else if v < 62 { v - 4 } else if v == 62 { 43 } else { 47 };

let base64_into! !from !to !n = if n <= 0 { 0 } else {
    let a = prim.load8! from;
    let b = if n > 1 { prim.load8! (from + 1) } else { 0 };
    let c = if n > 2 { prim.load8! (from + 2) } else { 0 };
    prim.store8! to (base64_char (a >> 2));
    prim.store8! (to + 1) (base64_char (((a & 3) << 4) | (b >> 4)));
    prim.store8! (to + 2) (if n > 1 { base64_char (((b & 15) << 2) | (c >> 6)) } else { 61 });
    prim.store8! (to + 3) (if n > 2 { base64_char (c & 63) } else { 61 });
    base64_into! (from + 3) (to + 4) (n - 3)
};

let crypto_base64! !p !s = if not (is_string! s) { type_fail! p "base64 needs a string" } else {
    let out = new_string! p ((string_len! s + 2) / 3 * 4);
    base64_into! (string_bytes s) (string_bytes out) (string_len! s);
    out
};

let sextet !c =
    if c >= 65 && c <= 90 { c - 65 } else if c >= 97 && c <= 122 { c - 71 } else if c >= 48 && c <= 57 { c + 4 }
    else if c == 43 { 62 } else if c == 47 { 63 } else { 0 - 1 };

/// Answers how many bytes it wrote, or -1 for what is not base64.
let unbase64_into! !from !to !left !written =
    if left == 0 { written }
    else {
        let a = sextet (prim.load8! from);
        let b = sextet (prim.load8! (from + 1));
        let c3 = prim.load8! (from + 2);
        let c4 = prim.load8! (from + 3);
        let c = sextet c3;
        let d = sextet c4;
        let pad3 = c3 == 61;
        let pad4 = c4 == 61;
        if a < 0 || b < 0 || (c < 0 && not pad3) || (d < 0 && not pad4) || (pad3 && not pad4) || ((pad3 || pad4) && left != 4) { 0 - 1 }
        else {
            prim.store8! to ((a << 2) | (b >> 4));
            if not pad3 { prim.store8! (to + 1) (((b & 15) << 4) | (c >> 2)); };
            if not pad4 { prim.store8! (to + 2) (((c & 3) << 6) | d); };
            unbase64_into! (from + 4) (to + 3) (left - 4) (written + (if pad3 { 1 } else if pad4 { 2 } else { 3 }))
        }
    };

let crypto_unbase64! !p !s =
    if not (is_string! s) { type_fail! p "unbase64 needs a string" }
    else if string_len! s % 4 != 0 { unit_word }
    else {
        let out = new_string! p (string_len! s / 4 * 3 + 3);
        let n = unbase64_into! (string_bytes s) (string_bytes out) (string_len! s) 0;
        if n < 0 { unit_word } else { str_slice_any! p out (tag_fix 0) (tag_fix n) }
    };

let fill_random! !at !n = if n <= 0 { 0 } else {
    let got = prim.c3! "getrandom" at n 0;
    if got <= 0 { fill_random! at n } else { fill_random! (at + got) (n - got) }
};

let crypto_random_bytes! !p !n =
    if not (is_fix n) || untag_fix n < 0 || untag_fix n > 16777216 { type_fail! p "random_bytes! needs a count between 0 and 2^24" }
    else {
        let out = new_string! p (untag_fix n);
        fill_random! (string_bytes out) (untag_fix n);
        out
    };

/// The contents of a file, read whole: what `digest!` and `digest_file!` hash.
let read_file_bytes! !p !path = {
    let fd = prim.sext32 (prim.c3! "open" (string_bytes path) 524288 0);
    if fd < 0 { 0 } else {
        let stat = scratch! p stat_bytes;
        prim.c2! "fstat" fd stat;
        let size = stat_size! stat;
        let s = new_string! p size;
        read_fully! fd (string_bytes s) size;
        prim.c1! "close" fd;
        s
    }
};

let read_fully! !fd !at !left = if left <= 0 { 0 } else {
    let got = prim.c3! "read" fd at left;
    if got <= 0 { 0 } else { read_fully! fd (at + got) (left - got) }
};

let crypto_digest_file! !p !a !path = {
    let alg = alg_code a;
    if alg == 0 { bad_alg! p "digest_file!" }
    else if not (is_string! path) { type_fail! p "digest_file! needs a path" }
    else {
        if is_directory (stat_kind! p path) {
            fail_value! p (prim.atom "wrong_kind") (concat2! p (text_of! p "digest_file!: a directory: ") path)
        } else {
            let s = read_file_bytes! p path;
            if s == 0 { fail_path! p "digest_file!" path } else { hash_string! p alg s }
        }
    }
};

let io_digest_file! !p !path = if not (is_string! path) { type_fail! p "digest! needs a path" } else {
    let s = read_file_bytes! p path;
    if s == 0 { fail_path! p "digest" path } else { crypto_hex! p (hash_string! p 1 s) }
};

let io_digest! !p !s = if is_string! s { crypto_hex! p (hash_string! p 1 s) } else { type_fail! p "digest needs a string" };

let int_of_le_bytes! !p !s !i !acc = if i < 0 { acc } else {
    int_of_le_bytes! p s (i - 1) (int_or_float_op! p 0 (int_or_float_op! p 2 acc (tag_fix 256)) (tag_fix (prim.load8! (string_bytes s + i))))
};

/// A little-endian byte string as an integer, for the arithmetic of ed25519.
let le_int! !p !s = int_of_le_bytes! p s (string_len! s - 1) (tag_fix 0);

// --- trunks --------------------------------------------------------------------------------
//
// A window on a map from positions to elements: `[first, length, map]`. A push, a prepend
// and a set are a path copied, and a slice shares everything. The VM's trunks choose a
// representation by watching the program; this one is the same everywhere, and is what
// the operations promise, which is that an old version still reads as it was.

let new_trunk! !p !first !n !m = {
    let o = alloc! p (4 * word);
    prim.store64! o (prim.info "trunk");
    prim.store64! (o + word) first;
    prim.store64! (o + 2 * word) n;
    prim.store64! (o + 3 * word) m;
    o
};

let is_trunk! !v = is_kind! v kind_trunk;
let trunk_first! !t = untag_fix (prim.load64! (t + word));
let trunk_size! !t = untag_fix (prim.load64! (t + 2 * word));
let trunk_map! !t = prim.load64! (t + 3 * word);

let trunk_empty! !p !unit = new_trunk! p (tag_fix 0) (tag_fix 0) (map_empty! p);

let trunk_len! !p !t = if is_trunk! t { prim.load64! (t + 2 * word) } else { type_fail! p "trunk.len needs a trunk" };

/// The element, unforced.
let trunk_read! !p !i !t = {
    if not (is_trunk! t) { type_fail! p "trunk.at needs a trunk" }
    else if not (is_fix i) || untag_fix i < 0 || untag_fix i >= trunk_size! t {
        fail! p atom_out_of_bounds "trunk.at: no element at that position"
    } else {
        let k = tag_fix (trunk_first! t + untag_fix i);
        prim.load64! (map_find! (trunk_map! t) (key_hash! k) k 0 + 3 * word)
    }
};

let trunk_push! !p !x !t = if not (is_trunk! t) { type_fail! p "trunk.push needs a trunk" } else {
    new_trunk! p (prim.load64! (t + word)) (tag_fix (trunk_size! t + 1))
        (map_put! p (trunk_map! t) (tag_fix (trunk_first! t + trunk_size! t)) x)
};

let trunk_cons! !p !x !t = if not (is_trunk! t) { type_fail! p "trunk.cons needs a trunk" } else {
    new_trunk! p (tag_fix (trunk_first! t - 1)) (tag_fix (trunk_size! t + 1))
        (map_put! p (trunk_map! t) (tag_fix (trunk_first! t - 1)) x)
};

let trunk_set! !p !i !x !t = {
    if not (is_trunk! t) { type_fail! p "trunk.set needs a trunk" }
    else if not (is_fix i) || untag_fix i < 0 || untag_fix i >= trunk_size! t {
        fail! p atom_out_of_bounds "trunk.set: no element at that position"
    } else {
        new_trunk! p (prim.load64! (t + word)) (prim.load64! (t + 2 * word))
            (map_put! p (trunk_map! t) (tag_fix (trunk_first! t + untag_fix i)) x)
    }
};

let trunk_slice! !p !a !b !t = {
    if not (is_trunk! t) { type_fail! p "trunk.slice needs a trunk" }
    else if not (is_fix a && is_fix b) { type_fail! p "trunk.slice needs integer bounds" }
    else {
        let n = trunk_size! t;
        let from = clamp (untag_fix a) 0 n;
        let to = clamp (untag_fix b) from n;
        new_trunk! p (tag_fix (trunk_first! t + from)) (tag_fix (to - from)) (trunk_map! t)
    }
};

let trunk_list_from! !p !t !i !tail = if i < 0 { tail } else {
    let k = tag_fix (trunk_first! t + i);
    trunk_list_from! p t (i - 1) (new_cons! p (prim.load64! (map_find! (trunk_map! t) (key_hash! k) k 0 + 3 * word)) tail)
};

let trunk_to_list! !p !t = if is_trunk! t { trunk_list_from! p t (trunk_size! t - 1) nil_word } else { type_fail! p "trunk.to_list needs a trunk" };

let esc_size! !s !n !acc = if n == 0 { acc } else {
    let b = prim.load8! s;
    esc_size! (s + 1) (n - 1) (acc + (if b == 34 || b == 92 || b == 10 || b == 9 { 2 } else { 1 }))
};

let esc_into! !from !to !n = if n == 0 { 0 } else {
    let b = prim.load8! from;
    if b == 34 || b == 92 || b == 10 || b == 9 {
        prim.store8! to 92;
        prim.store8! (to + 1) (if b == 10 { 110 } else if b == 9 { 116 } else { b });
        esc_into! (from + 1) (to + 2) (n - 1)
    } else {
        prim.store8! to b;
        esc_into! (from + 1) (to + 1) (n - 1)
    }
};

/// What a string is inside a list: a quote, a backslash, a newline and a tab said as
/// they are written.
let escape_string! !p !v = {
    let out = new_string! p (esc_size! (string_bytes v) (string_len! v) 0);
    esc_into! (string_bytes v) (string_bytes out) (string_len! v);
    out
};

let to_existing_atom! !p !v = if not (is_string! v) { type_fail! p "to_existing_atom needs a string" } else { atom_named_from! p v };
let atom_named_from! !p !v = {
    let fixed = atom_named! p v 0 (prim.load64! (prim.info "atom_count"));
    if fixed != unit_word { fixed } else { atom_made! p v 0 (prim.load_acq! (world_at! w_atoms_more_n)) }
};

/// One of the atoms made while running, by name, or unit.
let atom_made! !p !v !i !n =
    if i >= n { unit_word }
    else if string_eq! v (prim.load64! (prim.load64! (world_at! w_atoms_more) + i * word)) { (prim.load64! (prim.info "atom_count") + i) * 256 + 26 }
    else { atom_made! p v (i + 1) n };

let atoms_more_cap = 1048576;

/// `vm.intern_atom! name`: the atom of that name, made if there is none, which is what loading
/// an image does with its atoms (dre). Its name is promoted where every process can read it and
/// kept a root of the census, as an atom is never forgotten.
let vm_intern_atom! !p !name = if not (is_string! name) { type_fail! p "intern_atom! needs a name" } else {
    let found = atom_named_from! p name;
    if found != unit_word { found } else {
        // Kept before the lock is taken, because a promotion may start a census.
        let kept = keep_forever! p name;
        let l = prim.load64! (world_at! w_lock);
        lock! l;
        let again = atom_made! p name 0 (prim.load64! (world_at! w_atoms_more_n));
        let answer = if again != unit_word { again } else {
            if prim.load64! (world_at! w_atoms_more) == 0 { prim.store64! (world_at! w_atoms_more) (map_memory! (atoms_more_cap * word)); };
            let n = prim.load64! (world_at! w_atoms_more_n);
            if n >= atoms_more_cap { fatal! "dream: too many atoms\n"; };
            prim.store64! (prim.load64! (world_at! w_atoms_more) + n * word) kept;
            prim.store_rel! (world_at! w_atoms_more_n) (n + 1);
            (prim.load64! (prim.info "atom_count") + n) * 256 + 26
        };
        unlock! l;
        answer
    }
};

let atom_named! !p !v !i !n =
    if i >= n { unit_word }
    else if string_eq! v (prim.load64! (prim.info "atoms" + i * word)) { i * 256 + 26 }
    else { atom_named! p v (i + 1) n };

/// Natives the library stands in for when it has nothing faster: `()` sends `json.parse`
/// to its own walk, which is exact, and is the whole of what a decoder needs to be.
let json_decode! !p !text = unit_word;

let no_shared_bytes! !p !unit = tag_fix 0;
let release_nothing! !p !v = unit_word;

// --- regular expressions --------------------------------------------------------------------
//
// `vm.regex_run code subject from mode`, whose program `std.regex` compiles (the layout is
// at the head of dream/src/regex.cpp, which is the same format). A Pike VM: threads in
// lockstep in a sparse set with a row of captures each, so it is linear in the text and
// never backtracks. The VM also keeps a lazy DFA for speed; that is a thing to add here
// when a program measures it, not a difference in what a match is.

let rx_prog = 0;
let rx_ninsts = 8;
let rx_classes = 16;
let rx_ncap = 24;
let rx_s = 32;
let rx_n = 40;
let rx_a = 48;
let rx_b = 56;
let rx_work = 64;
let rx_best = 72;
let rx_stack = 80;
let rx_starts = 88;
let rx_prefix = 96;
let rx_prefix_len = 104;
let rx_bytes = 112;

let rx_u32! !at = prim.load32! at;
let rx_i32! !at = prim.sext32 (prim.load32! at);

let inst_at !r !pc = r + pc * 9;
let inst_op! !insts !pc = prim.load8! (insts + pc * 9);
let inst_a! !insts !pc = rx_i32! (insts + pc * 9 + 1);
let inst_b! !insts !pc = rx_i32! (insts + pc * 9 + 5);

/// The address of each class, walked once at the start of a run.
let rx_walk_classes! !table !at !i !n = if i >= n { at } else {
    prim.store64! (table + i * word) at;
    rx_walk_classes! table (at + 5 + rx_u32! (at + 1) * 8) (i + 1) n
};

let in_ranges! !at !c !left = left > 0 && ((rx_u32! at <= c && c <= rx_u32! (at + 4)) || in_ranges! (at + 8) c (left - 1));

let class_has! !cls !c = {
    let found = in_ranges! (cls + 5) c (rx_u32! (cls + 1));
    if prim.load8! cls != 0 { not found } else { found }
};

let consumes! !r !pc !c = {
    let insts = prim.load64! (r + rx_prog);
    let op = inst_op! insts pc;
    if op == 0 { inst_a! insts pc == c }
    else if op == 1 { c != 10 }
    else if op == 2 { true }
    else if op == 3 { class_has! (prim.load64! (prim.load64! (r + rx_classes) + inst_a! insts pc * word)) c }
    else { false }
};

let list_new! !p !ninsts !ncap = {
    let l = scratch! p (4 * word);
    prim.store64! l 0;
    prim.store64! (l + word) (scratch! p (ninsts * word));
    prim.store64! (l + 2 * word) (scratch! p (ninsts * word));
    prim.store64! (l + 3 * word) (scratch! p (ninsts * ncap * word + word));
    l
};

let list_has! !l !pc = {
    let at = prim.load64! (prim.load64! (l + word) + pc * word);
    prim.ult at (prim.load64! l) && prim.load64! (prim.load64! (l + 2 * word) + at * word) == pc
};

let list_insert! !l !pc = {
    let at = prim.load64! l;
    prim.store64! (prim.load64! (l + word) + pc * word) at;
    prim.store64! (prim.load64! (l + 2 * word) + at * word) pc;
    prim.store64! l (at + 1);
    at
};

let is_word_byte! !s !n !i = i >= 0 && i < n && {
    let b = prim.load8! (s + i);
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
};

let holds! !r !kind !pos = {
    let s = prim.load64! (r + rx_s);
    let n = prim.load64! (r + rx_n);
    if kind == 0 { pos == 0 }
    else if kind == 1 { pos >= n }
    else if kind == 2 { pos == 0 || prim.load8! (s + pos - 1) == 10 }
    else if kind == 3 { pos >= n || prim.load8! (s + pos) == 10 }
    else if kind == 4 { is_word_byte! s n (pos - 1) != is_word_byte! s n pos }
    else { is_word_byte! s n (pos - 1) == is_word_byte! s n pos }
};

/// Everything from `pc` that needs no character. `stack` holds `[pc, slot, value]`, a
/// slot of -1 meaning nothing to restore: `a{0,1000}` is a chain of a thousand splits, and
/// this walks them without a machine stack to run out of.
let rx_add! !r !l !pos !sp = {
    let stack = prim.load64! (r + rx_stack);
    if sp == 0 { 0 } else {
        let at = stack + (sp - 1) * 3 * word;
        let pc = prim.load64! at;
        let slot = prim.load64! (at + word);
        let saved = prim.load64! (at + 2 * word);
        let work = prim.load64! (r + rx_work);
        if slot >= 0 { prim.store64! (work + slot * word) saved; };
        if slot >= 0 || list_has! l pc { rx_add! r l pos (sp - 1) }
        else {
            let row = list_insert! l pc;
            let insts = prim.load64! (r + rx_prog);
            let op = inst_op! insts pc;
            if op == 5 {
                rx_push! stack (sp - 1) (inst_a! insts pc) (0 - 1) 0;
                rx_add! r l pos sp
            } else if op == 4 {
                rx_push! stack (sp - 1) (inst_b! insts pc) (0 - 1) 0;
                rx_push! stack sp (inst_a! insts pc) (0 - 1) 0;
                rx_add! r l pos (sp + 1)
            } else if op == 6 {
                let cap = inst_a! insts pc;
                rx_push! stack (sp - 1) 0 cap (prim.load64! (work + cap * word));
                prim.store64! (work + cap * word) pos;
                rx_push! stack sp (pc + 1) (0 - 1) 0;
                rx_add! r l pos (sp + 1)
            } else if op == 7 {
                if holds! r (inst_a! insts pc) pos {
                    rx_push! stack (sp - 1) (pc + 1) (0 - 1) 0;
                    rx_add! r l pos sp
                } else { rx_add! r l pos (sp - 1) }
            } else {
                let ncap = prim.load64! (r + rx_ncap);
                copy_words! work (prim.load64! (l + 3 * word) + row * ncap * word) ncap;
                rx_add! r l pos (sp - 1)
            }
        }
    }
};

let rx_push! !stack !sp !pc !slot !value = {
    let at = stack + sp * 3 * word;
    prim.store64! at pc;
    prim.store64! (at + word) slot;
    prim.store64! (at + 2 * word) value;
    0
};

let rx_start_thread! !r !l !pc !pos = {
    rx_push! (prim.load64! (r + rx_stack)) 0 pc (0 - 1) 0;
    rx_add! r l pos 1
};

/// One step of every thread on the character at `pos`. Answers whether any matched.
let rx_step! !r !clist !nlist !i !c !meta = {
    // `meta` holds pos, width and at_end, since this already takes all the registers.
    if i >= prim.load64! clist { 0 } else {
        let pc = prim.load64! (prim.load64! (clist + 2 * word) + i * word);
        let ncap = prim.load64! (r + rx_ncap);
        let row = prim.load64! (clist + 3 * word) + i * ncap * word;
        if inst_op! (prim.load64! (r + rx_prog)) pc == 8 {
            copy_words! row (prim.load64! (r + rx_best)) ncap;
            1
        } else {
            if prim.load64! (meta + 2 * word) == 0 && consumes! r pc c {
                copy_words! row (prim.load64! (r + rx_work)) ncap;
                rx_start_thread! r nlist (pc + 1) (prim.load64! meta + prim.load64! (meta + word));
            };
            rx_step! r clist nlist (i + 1) c meta
        }
    }
};

let rx_next_start! !r !pos = {
    let starts = prim.load64! (r + rx_starts);
    let s = prim.load64! (r + rx_s);
    let n = prim.load64! (r + rx_n);
    if starts == 0 || pos >= n { pos }
    else {
        let b = prim.load8! (s + pos);
        if prim.load8! (starts + b / 8) >> (b % 8) & 1 == 1 { pos } else { rx_next_start! r (pos + 1) }
    }
};

let rx_fill! !at !n !v = if n == 0 { 0 } else {
    prim.store64! at v;
    rx_fill! (at + word) (n - 1) v
};

/// The loop of a search: threads are carried in `state`, because a loop with this much in
/// hand does not fit in registers. Answers whether something matched.
let rx_loop! !r !from !anchored !pos !matched !clist = {
    let n = prim.load64! (r + rx_n);
    let other = if clist == prim.load64! (r + rx_a) { prim.load64! (r + rx_b) } else { prim.load64! (r + rx_a) };
    let idle = prim.load64! clist == 0 && matched == 0;
    if idle && anchored != 0 && pos != from { 0 }
    else {
        let at = if idle && anchored == 0 { rx_next_start! r pos } else { pos };
        if at > n { 0 } else {
            if matched == 0 && (anchored == 0 || at == from) {
                rx_fill! (prim.load64! (r + rx_work)) (prim.load64! (r + rx_ncap)) (0 - 1);
                rx_start_thread! r clist 0 at;
            };
            let s = prim.load64! (r + rx_s);
            let at_end = at >= n;
            let width = if at_end { 0 } else { utf8_len! s n at };
            let c = if at_end { 0 } else { utf8_value! s at width };
            prim.store64! other 0;
            let meta = r + rx_bytes;
            prim.store64! meta at;
            prim.store64! (meta + word) width;
            prim.store64! (meta + 2 * word) (if at_end { 1 } else { 0 });
            let hit = rx_step! r clist other 0 c meta;
            let now = if hit != 0 { 1 } else { matched };
            if at_end { now }
            else if prim.load64! other == 0 && now != 0 { now }
            else { rx_loop! r from anchored (at + width) now other }
        }
    }
};

let rx_search! !r !from !anchored = {
    prim.store64! (prim.load64! (r + rx_a)) 0;
    prim.store64! (prim.load64! (r + rx_b)) 0;
    rx_loop! r from anchored from 0 (prim.load64! (r + rx_a))
};

/// The program read, and everything a run needs, or 0 for bytes that are not one.
let rx_open! !p !code !s = {
    let c = string_bytes code;
    if string_len! code < 12 || prim.load32! c != 827871812 { 0 } else {
        let groups = rx_u32! (c + 4);
        let ninsts = rx_u32! (c + 8);
        let ncap = 2 * groups;
        let r = scratch! p (rx_bytes + 3 * word);
        let insts = c + 12;
        prim.store64! (r + rx_prog) insts;
        prim.store64! (r + rx_ninsts) ninsts;
        prim.store64! (r + rx_ncap) ncap;
        let classes_at = insts + ninsts * 9;
        let nclasses = rx_u32! classes_at;
        let table = scratch! p (nclasses * word + word);
        prim.store64! (r + rx_classes) table;
        let after = rx_walk_classes! table (classes_at + 4) 0 nclasses;
        let prefix_len = rx_u32! after;
        let has_starts_at = after + 4 + prefix_len;
        prim.store64! (r + rx_starts) (if prim.load8! has_starts_at != 0 { has_starts_at + 1 } else { 0 });
        prim.store64! (r + rx_s) (string_bytes s);
        prim.store64! (r + rx_n) (string_len! s);
        prim.store64! (r + rx_a) (list_new! p ninsts ncap);
        prim.store64! (r + rx_b) (list_new! p ninsts ncap);
        prim.store64! (r + rx_work) (scratch! p (ncap * word + word));
        prim.store64! (r + rx_best) (scratch! p (ncap * word + word));
        prim.store64! (r + rx_stack) (scratch! p ((2 * ninsts + ncap + 8) * 3 * word));
        r
    }
};

let rx_captures! !p !r = {
    let ncap = prim.load64! (r + rx_ncap);
    let a = new_array! p ncap;
    rx_copy_caps! (prim.load64! (r + rx_best)) (a + 2 * word) ncap;
    a
};

let rx_copy_caps! !from !to !n = if n == 0 { 0 } else {
    prim.store64! to (tag_fix (prim.load64! from));
    rx_copy_caps! (from + word) (to + word) (n - 1)
};

/// After an empty match the next search starts a character on, so `a*` over "baa" finds
/// "", "aa" and "". Answers the next place, or -1 when there is no more text.
let rx_after! !r = {
    let best = prim.load64! (r + rx_best);
    let start = prim.load64! best;
    let stop = prim.load64! (best + word);
    let n = prim.load64! (r + rx_n);
    if stop > start { stop }
    else if stop < n { stop + utf8_len! (prim.load64! (r + rx_s)) n stop }
    else { 0 - 1 }
};

let rx_all! !p !r !at !mode !count !found =
    if at < 0 || at > prim.load64! (r + rx_n) || rx_search! r at 0 == 0 {
        if mode == 3 { tag_fix count } else { reverse_onto! p found nil_word }
    } else {
        let next = rx_after! r;
        rx_all! p r next mode (count + 1) (if mode == 2 { new_cons! p (rx_captures! p r) found } else { found })
    };

let reverse_onto! !p !xs !acc = if xs == nil_word { acc } else {
    reverse_onto! p (prim.load64! (xs + 2 * word)) (new_cons! p (prim.load64! (xs + word)) acc)
};

let regex_run! !p !code !s !from !mode = {
    if not (is_string! code) { type_fail! p "regex_run needs a compiled program" }
    else if not (is_string! s) { type_fail! p "regex_run needs a string to search" }
    else if not (is_fix from && is_fix mode) { type_fail! p "regex_run needs an offset and a mode" }
    else {
        let at = untag_fix from;
        let m = untag_fix mode;
        let r = rx_open! p code s;
        if r == 0 { type_fail! p "regex_run was given bytes that are not a compiled pattern" }
        else if at < 0 || at > string_len! s {
            if m == 0 { false_word } else if m == 2 { nil_word } else if m == 3 { tag_fix 0 } else { unit_word }
        }
        else if m == 0 { as_word (rx_search! r at 0) }
        else if m == 1 { if rx_search! r at 0 != 0 { rx_captures! p r } else { unit_word } }
        else if m == 4 { if rx_search! r at 1 != 0 { rx_captures! p r } else { unit_word } }
        else { rx_all! p r at m 0 nil_word }
    }
};

// --- tensors ----------------------------------------------------------------------------------
//
// Doubles with a shape, inside the object: `[info, n, rank, 6 dims, count, numbers..]`, the
// `n` tagged and counting what follows it, all of it raw to the collector. The kernels are
// loops over raw words that LLVM is left to vectorize, and everything about lists, shapes
// and what to say when they are wrong is the library's. Nothing is deferred: a chain of
// operations is that many passes. That is a difference in speed against the VM's fused
// kernels, not in any answer, and is worth doing here only when a program measures it.

let t_rank_at = 2;
let t_dims_at = 3;
let t_count_at = 9;
let t_data_at = 10;
let t_max_rank = 6;

let is_tensor! !v = is_kind! v kind_tensor;
let t_rank! !t = prim.load64! (t + t_rank_at * word);
let t_dim! !t !i = prim.load64! (t + (t_dims_at + i) * word);
let t_count! !t = prim.load64! (t + t_count_at * word);
let t_data !t = t + t_data_at * word;

let t_blank! !p !rank !count = {
    let n = t_data_at - 2 + count;
    let o = alloc! p ((n + 2) * word);
    prim.store64! o (prim.info "tensor");
    prim.store64! (o + word) (tag_fix n);
    prim.store64! (o + t_rank_at * word) rank;
    prim.store64! (o + t_count_at * word) count;
    o
};

let t_set_dim! !t !i !d = prim.store64! (t + (t_dims_at + i) * word) d;

/// The same shape as `t`, its numbers not written yet.
let t_like! !p !t = {
    let o = t_blank! p (t_rank! t) (t_count! t);
    copy_words! (t + t_dims_at * word) (o + t_dims_at * word) t_max_rank;
    o
};

let product_of! !a !i !n !acc = if i >= n { acc } else {
    product_of! a (i + 1) n (acc * untag_fix (prim.load64! (a + (2 + i) * word)))
};

let t_dims_from! !t !a !i !n = if i >= n { 0 } else {
    t_set_dim! t i (untag_fix (prim.load64! (a + (2 + i) * word)));
    t_dims_from! t a (i + 1) n
};

/// A new tensor of the shape in an array of integers.
let t_new! !p !shape = {
    let rank = untag_fix (prim.load64! (shape + word));
    let t = t_blank! p rank (product_of! shape 0 rank 1);
    t_dims_from! t shape 0 rank;
    t
};

let t_shape_list! !p !t !i = if i >= t_rank! t { nil_word } else {
    new_cons! p (tag_fix (t_dim! t i)) (t_shape_list! p t (i + 1))
};
let tensor_shape! !p !t = t_shape_list! p t 0;
let tensor_rank! !p !t = tag_fix (t_rank! t);
let tensor_size! !p !t = tag_fix (t_count! t);
let tensor_len! !p !t = tag_fix (t_dim! t 0);
let is_tensor_value! !p !v = as_word (is_tensor! v);

/// From a flat array of forced numbers.
let t_store_numbers! !to !a !i !n = if i >= n { 0 } else {
    prim.store64! (to + i * word) (float_bits! (prim.load64! (a + (2 + i) * word)));
    t_store_numbers! to a (i + 1) n
};

let tensor_of_flat! !p !shape !numbers = {
    let t = t_new! p shape;
    t_store_numbers! (t_data t) numbers 0 (t_count! t);
    t
};

let tensor_fill! !p !shape !x = {
    let t = t_new! p shape;
    fill_words! (t_data t) (t_count! t) (float_bits! x);
    t
};

let tensor_fill_like! !p !t !x = {
    let o = t_like! p t;
    fill_words! (t_data o) (t_count! o) (float_bits! x);
    o
};

let write_range! !at !i !n = if i >= n { 0 } else {
    prim.store64! (at + i * word) (prim.i2f i);
    write_range! at (i + 1) n
};

let tensor_range! !p !shape = {
    let t = t_new! p shape;
    write_range! (t_data t) 0 (t_count! t);
    t
};

let write_identity! !at !n !i = if i >= n { 0 } else {
    prim.store64! (at + (i * n + i) * word) (prim.i2f 1);
    write_identity! at n (i + 1)
};

let tensor_identity! !p !shape = {
    let t = t_new! p shape;
    fill_words! (t_data t) (t_count! t) (prim.i2f 0);
    write_identity! (t_data t) (t_dim! t 0) 0;
    t
};

// The stream `random` and `normal` draw from: SplitMix64, so that one seed is one tensor on
// every machine and in every kind of build.

let splitmix_gamma = (2654435769 << 32) | 2135587861;
let splitmix_a = (3210233709 << 32) | 484763065;
let splitmix_b = (2496678331 << 32) | 321982955;

let splitmix !x = {
    let z1 = (x ^ prim.ushr x 30) * splitmix_a;
    let z2 = (z1 ^ prim.ushr z1 27) * splitmix_b;
    z2 ^ prim.ushr z2 31
};

/// `[0, 1)`: 53 bits, each step's state being `x + gamma * (i + 1)`.
let uniform_bits !state = prim.fmul (prim.i2f (prim.ushr (splitmix state) 11)) (prim.fdiv (prim.i2f 1) (prim.i2f 9007199254740992));

let write_random! !at !i !n !x = if i >= n { 0 } else {
    let next = x + splitmix_gamma;
    prim.store64! (at + i * word) (uniform_bits next);
    write_random! at (i + 1) n next
};

let tensor_random! !p !seed !shape = {
    let t = t_new! p shape;
    write_random! (t_data t) 0 (t_count! t) (untag_fix seed);
    t
};

let tensor_random_like! !p !seed !t = {
    let o = t_like! p t;
    write_random! (t_data o) 0 (t_count! o) (untag_fix seed);
    o
};

let prim_two_pi! () = prim.fmul (prim.i2f 8) (prim.d1! "atan" (prim.i2f 1));

let write_normal! !at !i !n !x = if i >= n { 0 } else {
    let x1 = x + splitmix_gamma;
    let x2 = x1 + splitmix_gamma;
    let u1 = prim.fsub (prim.i2f 1) (uniform_bits x1);
    let u2 = uniform_bits x2;
    let r = prim.d1! "sqrt" (prim.fmul (prim.fneg (prim.i2f 2)) (prim.d1! "log" u1));
    let angle = prim.fmul (prim_two_pi! ()) u2;
    prim.store64! (at + i * word) (prim.fmul r (prim.d1! "cos" angle));
    if i + 1 < n { prim.store64! (at + (i + 1) * word) (prim.fmul r (prim.d1! "sin" angle)); };
    write_normal! at (i + 2) n x2
};

let tensor_normal! !p !seed !shape = {
    let t = t_new! p shape;
    write_normal! (t_data t) 0 (t_count! t) (untag_fix seed ^ ((1779033703 << 32) | 4089235721));
    t
};

let tensor_at! !p !t !offset = new_float! p (prim.load64! (t_data t + untag_fix offset * word));

let t_vector! !p !at !n !tail = if n == 0 { tail } else {
    t_vector! p at (n - 1) (new_cons! p (new_float! p (prim.load64! (at + (n - 1) * word))) tail)
};

/// One axis of `tensor.to_list`, its rows made by the library when there are any.
let tensor_flat! !p !t = t_vector! p (t_data t) (t_count! t) nil_word;

// --- elementwise ------------------------------------------------------------------------------

let kernel_add! !out !a !astep !b !bstep !n = if n == 0 { 0 } else {
    prim.store64! out (prim.fadd (prim.load64! a) (prim.load64! b));
    kernel_add! (out + word) (a + astep) astep (b + bstep) bstep (n - 1)
};
let kernel_sub! !out !a !astep !b !bstep !n = if n == 0 { 0 } else {
    prim.store64! out (prim.fsub (prim.load64! a) (prim.load64! b));
    kernel_sub! (out + word) (a + astep) astep (b + bstep) bstep (n - 1)
};
let kernel_mul! !out !a !astep !b !bstep !n = if n == 0 { 0 } else {
    prim.store64! out (prim.fmul (prim.load64! a) (prim.load64! b));
    kernel_mul! (out + word) (a + astep) astep (b + bstep) bstep (n - 1)
};
let kernel_div! !out !a !astep !b !bstep !n = if n == 0 { 0 } else {
    prim.store64! out (prim.fdiv (prim.load64! a) (prim.load64! b));
    kernel_div! (out + word) (a + astep) astep (b + bstep) bstep (n - 1)
};

let one_or_zero !bit = prim.i2f (if bit { 1 } else { 0 });

let t_op! !op !x !y =
    if op == 4 { prim.d2! "fmod" x y }
    else if op == 5 { if prim.flt x y { y } else { x } }
    else if op == 6 { if prim.flt y x { y } else { x } }
    else if op == 7 { prim.d2! "pow" x y }
    else if op == 8 { one_or_zero (prim.flt x y) }
    else if op == 9 { one_or_zero (prim.flt x y || prim.feq x y) }
    else if op == 10 { one_or_zero (prim.flt y x) }
    else if op == 11 { one_or_zero (prim.flt y x || prim.feq x y) }
    else if op == 12 { one_or_zero (prim.feq x y) }
    else { one_or_zero (not (prim.feq x y)) };

let kernel_op! !out !a !b !op !n !steps = if n == 0 { 0 } else {
    prim.store64! out (t_op! op (prim.load64! a) (prim.load64! b));
    kernel_op! (out + word) (a + prim.load64! steps) (b + prim.load64! (steps + word)) op (n - 1) steps
};

/// The numbers of a trailing shape come round again, so an index modulo its count is what
/// repeating it is.
let broadcast_op! !out !a !ca !b !cb !op = broadcast_from! out a ca b cb (op * 4294967296);

let broadcast_from! !out !a !ca !b !cb !state = {
    let i = state & 4294967295;
    let op = prim.ushr state 32;
    let n = prim.load64! (out - word);
    if i >= n { 0 } else {
        let x = prim.load64! (a + (i % ca) * word);
        let y = prim.load64! (b + (i % cb) * word);
        let r = if op == 0 { prim.fadd x y } else if op == 1 { prim.fsub x y } else if op == 2 { prim.fmul x y }
                else if op == 3 { prim.fdiv x y } else { t_op! op x y };
        prim.store64! (out + i * word) r;
        broadcast_from! out a ca b cb (state + 1)
    }
};

/// Equal shapes, or one the trailing part of the other. 0 for neither.
let trailing_of! !a !b !i = {
    let ra = t_rank! a;
    let rb = t_rank! b;
    if i >= rb { true }
    else { t_dim! a (ra - rb + i) == t_dim! b i && trailing_of! a b (i + 1) }
};

let shape_compatible! !a !b =
    if t_rank! a >= t_rank! b { trailing_of! a b 0 } else { trailing_of! b a 0 };

let t_dispatch! !out !a !astep !b !bstep !state = {
    let op = prim.ushr state 32;
    let n = state & 4294967295;
    if op == 0 { kernel_add! out a astep b bstep n }
    else if op == 1 { kernel_sub! out a astep b bstep n }
    else if op == 2 { kernel_mul! out a astep b bstep n }
    else if op == 3 { kernel_div! out a astep b bstep n }
    else {
        let steps = out - 2 * word;
        kernel_op_stepped! out a astep b bstep state
    }
};

let kernel_op_stepped! !out !a !astep !b !bstep !state = {
    let op = prim.ushr state 32;
    let n = state & 4294967295;
    if n == 0 { 0 } else {
        prim.store64! out (t_op! op (prim.load64! a) (prim.load64! b));
        kernel_op_stepped! (out + word) (a + astep) astep (b + bstep) bstep (state - 1)
    }
};

let op_state !op !n = (op << 32) | n;

/// `a op b`, each a tensor or a number; 0 means the shapes do not go together, which the
/// caller says in its own words.
let t_binary! !p !op !a !b = {
    let ta = is_tensor! a;
    let tb = is_tensor! b;
    if ta && tb {
        if not (shape_compatible! a b) { 0 }
        else if t_count! a == t_count! b {
            let o = t_like! p (if t_rank! a >= t_rank! b { a } else { b });
            t_dispatch! (t_data o) (t_data a) word (t_data b) word (op_state op (t_count! o));
            o
        } else {
            let big = if t_count! a > t_count! b { a } else { b };
            let o = t_like! p big;
            // The word below the numbers is `count`, which is what the loop runs to.
            broadcast_op! (t_data o) (t_data a) (t_count! a) (t_data b) (t_count! b) op;
            o
        }
    } else if ta {
        let cell = scratch! p word;
        prim.store64! cell (float_bits! b);
        let o = t_like! p a;
        t_dispatch! (t_data o) (t_data a) word cell 0 (op_state op (t_count! o));
        o
    } else {
        let cell = scratch! p word;
        prim.store64! cell (float_bits! a);
        let o = t_like! p b;
        t_dispatch! (t_data o) cell 0 (t_data b) word (op_state op (t_count! o));
        o
    }
};

let shape_text! !p !t = {
    let n = t_rank! t;
    concat3! p (text_of! p "[") (shape_parts! p t 0 n) (text_of! p "]")
};

let shape_parts! !p !t !i !n = if i >= n { text_of! p "" }
    else if i == n - 1 { int_to_string! p (tag_fix (t_dim! t i)) }
    else { concat3! p (int_to_string! p (tag_fix (t_dim! t i))) (text_of! p ", ") (shape_parts! p t (i + 1) n) };

let describe_operand! !p !v = if is_tensor! v { concat2! p (text_of! p "tensor of shape ") (shape_text! p v) } else { describe! p v };

let op_name_text! !p !op = text_of! p (
    if op == 0 { "add" } else if op == 1 { "sub" } else if op == 2 { "mul" } else if op == 3 { "div" }
    else if op == 4 { "mod" } else if op == 5 { "max" } else if op == 6 { "min" } else if op == 7 { "pow" }
    else if op == 8 { "lt" } else if op == 9 { "le" } else if op == 10 { "gt" } else if op == 11 { "ge" }
    else if op == 12 { "eq" } else { "ne" });

/// `+` and the rest, when an operand is a tensor.
let tensor_op! !p !op !a !b = {
    if not ((is_tensor! a || is_number! a) && (is_tensor! b || is_number! b)) {
        fail_value! p atom_type_error (concat2! p (concat3! p (text_of! p "cannot apply `") (op_name_text! p op) (text_of! p "` to "))
            (concat3! p (describe! p a) (text_of! p " and ") (describe! p b)))
    } else {
        let r = t_binary! p op a b;
        if r != 0 { r } else {
            fail_value! p (prim.atom "shape_error") (concat3! p (concat3! p (text_of! p "`") (op_name_text! p op) (text_of! p "` needs shapes that match, not "))
                (shape_text! p a) (concat2! p (text_of! p " and ") (shape_text! p b)))
        }
    }
};

let tensor_binary! !p !op !a !b = tensor_op! p (untag_fix op) a b;

let t_unary_value! !f !x =
    if f == 0 { prim.d1! "sqrt" x } else if f == 1 { prim.d1! "exp" x } else if f == 2 { prim.d1! "log" x }
    else if f == 3 { prim.fabs x } else if f == 4 { prim.d1! "tanh" x } else if f == 5 { prim.d1! "sin" x }
    else if f == 6 { prim.d1! "cos" x }
    else if f == 7 { if prim.flt (prim.i2f 0) x { x } else { prim.i2f 0 } }
    else if f == 8 { prim.fdiv (prim.i2f 1) (prim.fadd (prim.i2f 1) (prim.d1! "exp" (prim.fneg x))) }
    else if f == 9 { prim.d1! "floor" x } else if f == 10 { prim.d1! "ceil" x } else if f == 11 { prim.d1! "round" x }
    else if f == 12 {
        if prim.flt (prim.i2f 0) x { prim.i2f 1 } else if prim.flt x (prim.i2f 0) { prim.fneg (prim.i2f 1) } else { x }
    }
    else if f == 13 { prim.d1! "erf" x }
    else { prim.fneg x };

let kernel_unary! !out !a !n !f = if n == 0 { 0 } else {
    prim.store64! out (t_unary_value! f (prim.load64! a));
    kernel_unary! (out + word) (a + word) (n - 1) f
};

let tensor_unary! !p !f !t = {
    let o = t_like! p t;
    kernel_unary! (t_data o) (t_data t) (t_count! t) (untag_fix f);
    o
};

let tensor_neg! !p !t = {
    let o = t_like! p t;
    kernel_unary! (t_data o) (t_data t) (t_count! t) 14;
    o
};

let sum_from! !a !n !acc = if n == 0 { acc } else { sum_from! (a + word) (n - 1) (prim.fadd acc (prim.load64! a)) };
let min_from! !a !n !acc = if n == 0 { acc } else {
    let x = prim.load64! a;
    min_from! (a + word) (n - 1) (if prim.flt x acc { x } else { acc })
};
let max_from! !a !n !acc = if n == 0 { acc } else {
    let x = prim.load64! a;
    max_from! (a + word) (n - 1) (if prim.flt acc x { x } else { acc })
};

let tensor_sum! !p !t = new_float! p (sum_from! (t_data t) (t_count! t) (prim.i2f 0));
let tensor_min! !p !t = new_float! p (min_from! (t_data t) (t_count! t) (prim.load64! (t_data t)));
let tensor_max! !p !t = new_float! p (max_from! (t_data t) (t_count! t) (prim.load64! (t_data t)));
let tensor_mean! !p !t = new_float! p (prim.fdiv (sum_from! (t_data t) (t_count! t) (prim.i2f 0)) (prim.i2f (t_count! t)));

let squares_from! !a !n !acc = if n == 0 { acc } else {
    let x = prim.load64! a;
    squares_from! (a + word) (n - 1) (prim.fadd acc (prim.fmul x x))
};
let tensor_norm! !p !t = new_float! p (prim.d1! "sqrt" (squares_from! (t_data t) (t_count! t) (prim.i2f 0)));

// One axis out: `outer` blocks of `len` runs of `inner` numbers. Ops: 0 sum, 1 min, 2 max,
// 3 argmin, 4 argmax, the first place winning a tie.

let axis_one! !src !stride !len !op = axis_walk! src stride 1 len op (prim.load64! src) ;

let axis_walk! !src !stride !i !len !op !best = axis_with_at! src stride (i * 4294967296 + len) op best 0;

let axis_with_at! !src !stride !counts !op !best !at = {
    let i = prim.ushr counts 32;
    let len = counts & 4294967295;
    if i >= len {
        if op >= 3 { prim.i2f at } else { best }
    } else {
        let x = prim.load64! (src + i * stride);
        let better = if op == 0 { false } else if op == 1 || op == 3 { prim.flt x best } else { prim.flt best x };
        axis_with_at! src stride (counts + 4294967296) op
            (if op == 0 { prim.fadd best x } else if better { x } else { best })
            (if better { i } else { at })
    }
};

let axis_cells! !out !src !inner !len !op !counts = {
    let cell = counts & 4294967295;
    if cell >= inner { 0 } else {
        prim.store64! (out + cell * word) (axis_one! (src + cell * word) (inner * word) len op);
        axis_cells! out src inner len op (counts + 1)
    }
};

let axis_blocks! !out !src !inner !len !op !left = if left == 0 { 0 } else {
    axis_cells! out src inner len op 0;
    axis_blocks! (out + inner * word) (src + inner * len * word) inner len op (left - 1)
};

let tail_product! !t !from = if from >= t_rank! t { 1 } else { t_dim! t from * tail_product! t (from + 1) };

let drop_axis_dims! !o !t !axis !i !at = if i >= t_rank! t { 0 } else {
    if i != axis { t_set_dim! o at (t_dim! t i); };
    drop_axis_dims! o t axis (i + 1) (if i != axis { at + 1 } else { at })
};

let tensor_axis! !p !op !axis !t = {
    let a = untag_fix axis;
    let len = t_dim! t a;
    let inner = tail_product! t (a + 1);
    let o = t_blank! p (t_rank! t - 1) (t_count! t / len);
    drop_axis_dims! o t a 0 0;
    axis_blocks! (t_data o) (t_data t) inner len (untag_fix op) (t_count! t / (inner * len));
    o
};

// --- shape ------------------------------------------------------------------------------------

let tensor_reshape! !p !shape !t = {
    let o = t_new! p shape;
    copy_words! (t_data t) (t_data o) (t_count! t);
    o
};

let transpose_rows! !out !src !m !n !i = if i >= m { 0 } else {
    transpose_row! (out + i * word) n (src + i * n * word) m 0;
    transpose_rows! out src m n (i + 1)
};

let transpose_row! !out !n !src !m !j = if j >= n { 0 } else {
    prim.store64! (out + j * m * word) (prim.load64! (src + j * word));
    transpose_row! out n src m (j + 1)
};

let tensor_transpose! !p !t = if t_rank! t == 1 { t } else {
    let m = t_dim! t 0;
    let n = t_dim! t 1;
    let o = t_blank! p 2 (m * n);
    t_set_dim! o 0 n;
    t_set_dim! o 1 m;
    transpose_rows! (t_data o) (t_data t) m n 0;
    o
};

/// A row of a matrix, or the number at a place in a vector.
let tensor_index! !p !t !k = {
    let i = untag_fix k;
    if t_rank! t == 1 { new_float! p (prim.load64! (t_data t + i * word)) }
    else {
        let per = t_count! t / t_dim! t 0;
        let o = t_blank! p (t_rank! t - 1) per;
        copy_words! (t + (t_dims_at + 1) * word) (o + t_dims_at * word) (t_max_rank - 1);
        copy_words! (t_data t + i * per * word) (t_data o) per;
        o
    }
};

let copy_rows! !out !src !rows !i !n !per = if i >= n { 0 } else {
    copy_words! (src + untag_fix (prim.load64! (rows + (2 + i) * word)) * per * word) out per;
    copy_rows! (out + per * word) src rows (i + 1) n per
};

/// The rows named, as an array of integers, in that order.
let tensor_take! !p !rows !t = {
    let n = untag_fix (prim.load64! (rows + word));
    let per = t_count! t / t_dim! t 0;
    let o = t_blank! p (t_rank! t) (n * per);
    copy_words! (t + t_dims_at * word) (o + t_dims_at * word) t_max_rank;
    t_set_dim! o 0 n;
    copy_rows! (t_data o) (t_data t) rows 0 n per;
    o
};

let concat_rows! !out !parts !i !n = if i >= n { 0 } else {
    let t = prim.load64! (parts + (2 + i) * word);
    copy_words! (t_data t) out (t_count! t);
    concat_rows! (out + t_count! t * word) parts (i + 1) n
};

let rows_total! !parts !i !n !acc = if i >= n { acc } else {
    rows_total! parts (i + 1) n (acc + t_dim! (prim.load64! (parts + (2 + i) * word)) 0)
};

let tensor_concat! !p !parts = {
    let n = untag_fix (prim.load64! (parts + word));
    let first = prim.load64! (parts + 2 * word);
    let rows = rows_total! parts 0 n 0;
    let o = t_blank! p (t_rank! first) (t_count! first / t_dim! first 0 * rows);
    copy_words! (first + t_dims_at * word) (o + t_dims_at * word) t_max_rank;
    t_set_dim! o 0 rows;
    concat_rows! (t_data o) parts 0 n;
    o
};

let one_hot_rows! !out !rows !i !n !width = if i >= n { 0 } else {
    prim.store64! (out + (i * width + untag_fix (prim.load64! (rows + (2 + i) * word))) * word) (prim.i2f 1);
    one_hot_rows! out rows (i + 1) n width
};

let tensor_one_hot! !p !width !rows = {
    let n = untag_fix (prim.load64! (rows + word));
    let w = untag_fix width;
    let o = t_blank! p 2 (n * w);
    t_set_dim! o 0 n;
    t_set_dim! o 1 w;
    fill_words! (t_data o) (n * w) (prim.i2f 0);
    one_hot_rows! (t_data o) rows 0 n w;
    o
};

let repeat_each! !out !src !left !n = if left == 0 { 0 } else {
    fill_words! out n (prim.load64! src);
    repeat_each! (out + n * word) (src + word) (left - 1) n
};

let tensor_repeat! !p !n !t = {
    let k = untag_fix n;
    let o = t_blank! p (t_rank! t + 1) (t_count! t * k);
    copy_words! (t + t_dims_at * word) (o + t_dims_at * word) t_max_rank;
    t_set_dim! o (t_rank! t) k;
    repeat_each! (t_data o) (t_data t) (t_count! t) k;
    o
};

/// Axis `k` of the answer is axis `axes[k]` of `t`. `idx` counts through the answer's
/// places, and each number's place in `t` is found from it through the strides.
let permute_copy! !out !src !o !strides !idx !i = if i >= t_count! o { 0 } else {
    prim.store64! (out + i * word) (prim.load64! (src + permute_offset! idx strides 0 (t_rank! o) * word));
    permute_advance! o idx (t_rank! o - 1);
    permute_copy! out src o strides idx (i + 1)
};

let permute_offset! !idx !strides !k !n = if k >= n { 0 } else {
    prim.load64! (idx + k * word) * prim.load64! (strides + k * word) + permute_offset! idx strides (k + 1) n
};

let permute_advance! !o !idx !k = if k < 0 { 0 } else {
    let v = prim.load64! (idx + k * word) + 1;
    if v < t_dim! o k { prim.store64! (idx + k * word) v; 0 }
    else {
        prim.store64! (idx + k * word) 0;
        permute_advance! o idx (k - 1)
    }
};

let permute_setup! !o !t !axes !strides !k = if k >= t_rank! t { 0 } else {
    let from = untag_fix (prim.load64! (axes + (2 + k) * word));
    t_set_dim! o k (t_dim! t from);
    prim.store64! (strides + k * word) (tail_product! t (from + 1));
    permute_setup! o t axes strides (k + 1)
};

let tensor_permute! !p !axes !t = {
    let o = t_like! p t;
    let strides = scratch! p (t_max_rank * word);
    let idx = scratch! p (t_max_rank * word);
    zero_words! idx t_max_rank;
    permute_setup! o t axes strides 0;
    permute_copy! (t_data o) (t_data t) o strides idx 0;
    o
};

let tensor_to_bytes! !p !t = {
    let s = new_string! p (t_count! t * word);
    prim.c3! "memcpy" (string_bytes s) (t_data t) (t_count! t * word);
    s
};

let tensor_of_bytes! !p !shape !b = {
    let t = t_new! p shape;
    prim.c3! "memcpy" (t_data t) (string_bytes b) (t_count! t * word);
    t
};

// --- products -----------------------------------------------------------------------------------

let saxpy! !out !row !x !n = if n == 0 { 0 } else {
    prim.store64! out (prim.fadd (prim.load64! out) (prim.fmul x (prim.load64! row)));
    saxpy! (out + word) (row + word) x (n - 1)
};

let product_row! !out !a !b !k !n !p_ = if p_ >= k { 0 } else {
    saxpy! out (b + p_ * n * word) (prim.load64! (a + p_ * word)) n;
    product_row! out a b k n (p_ + 1)
};

/// `[m, k] @ [k, n]`, row by row: the order that reads memory in the order it lies.
let product_rows! !out !a !b !m !k !n = if m == 0 { 0 } else {
    product_row! out a b k n 0;
    product_rows! (out + n * word) (a + k * word) b (m - 1) k n
};

let dot_from! !a !b !n !acc = if n == 0 { acc } else {
    dot_from! (a + word) (b + word) (n - 1) (prim.fadd acc (prim.fmul (prim.load64! a) (prim.load64! b)))
};

/// The shapes have been checked. A vector counts as one row, or one column, as `@` says.
let tensor_matmul! !p !a !b = {
    let ra = t_rank! a;
    let rb = t_rank! b;
    if ra == 1 && rb == 1 { new_float! p (dot_from! (t_data a) (t_data b) (t_count! a) (prim.i2f 0)) }
    else if ra == 3 {
        let batch = t_dim! a 0;
        let m = t_dim! a 1;
        let k = t_dim! a 2;
        let n = if rb == 3 { t_dim! b 2 } else { t_dim! b 1 };
        let o = t_blank! p 3 (batch * m * n);
        t_set_dim! o 0 batch;
        t_set_dim! o 1 m;
        t_set_dim! o 2 n;
        fill_words! (t_data o) (t_count! o) (prim.i2f 0);
        batched! (t_data o) (t_data a) (t_data b) (batch * 4294967296 + (if rb == 3 { k * n } else { 0 })) ((m << 40) | (k << 20) | n) 0;
        o
    } else {
        let m = if ra == 2 { t_dim! a 0 } else { 1 };
        let k = if ra == 2 { t_dim! a 1 } else { t_dim! a 0 };
        let n = if rb == 2 { t_dim! b 1 } else { 1 };
        let o = if ra == 2 && rb == 2 {
            let m2 = t_blank! p 2 (m * n);
            t_set_dim! m2 0 m;
            t_set_dim! m2 1 n;
            m2
        } else {
            let v = t_blank! p 1 (m * n);
            t_set_dim! v 0 (m * n);
            v
        };
        fill_words! (t_data o) (t_count! o) (prim.i2f 0);
        product_rows! (t_data o) (t_data a) (t_data b) m k n;
        o
    }
};

let batched! !out !a !b !state !sizes !unused = {
    let left = prim.ushr state 32;
    let b_step = state & 4294967295;
    let m = prim.ushr sizes 40;
    let k = (sizes >> 20) & 1048575;
    let n = sizes & 1048575;
    if left == 0 { 0 } else {
        product_rows! out a b m k n;
        batched! (out + m * n * word) (a + m * k * word) (b + b_step * word) (state - 4294967296) sizes 0
    }
};

// --- windows of images, for convolutions -----------------------------------------------------------

let win_n = 0;
let win_h = 8;
let win_w = 16;
let win_c = 24;
let win_kh = 32;
let win_kw = 40;
let win_stride = 48;
let win_pad = 56;
let win_oh = 64;
let win_ow = 72;
let win_bytes = 80;

let window_of! !p !n !h !w !c !spec = {
    let g = scratch! p win_bytes;
    let kh = untag_fix (prim.load64! (spec + 2 * word));
    let kw = untag_fix (prim.load64! (spec + 3 * word));
    let stride = untag_fix (prim.load64! (spec + 4 * word));
    let pad = untag_fix (prim.load64! (spec + 5 * word));
    prim.store64! (g + win_n) n;
    prim.store64! (g + win_h) h;
    prim.store64! (g + win_w) w;
    prim.store64! (g + win_c) c;
    prim.store64! (g + win_kh) kh;
    prim.store64! (g + win_kw) kw;
    prim.store64! (g + win_stride) stride;
    prim.store64! (g + win_pad) pad;
    prim.store64! (g + win_oh) ((h + 2 * pad - kh) / stride + 1);
    prim.store64! (g + win_ow) ((w + 2 * pad - kw) / stride + 1);
    g
};

/// The offset in the images of one window element, or -1 when padding is what is there.
let window_at! !g !b !oy !ox !ky !kx = {
    let iy = oy * prim.load64! (g + win_stride) + ky - prim.load64! (g + win_pad);
    let ix = ox * prim.load64! (g + win_stride) + kx - prim.load64! (g + win_pad);
    let h = prim.load64! (g + win_h);
    let w = prim.load64! (g + win_w);
    if iy < 0 || iy >= h || ix < 0 || ix >= w { 0 - 1 }
    else { ((b * h + iy) * w + ix) * prim.load64! (g + win_c) }
};

let im2col_elements! !g !images !out !row !k !total = if k >= total { 0 } else {
    let oh = prim.load64! (g + win_oh);
    let ow = prim.load64! (g + win_ow);
    let c = prim.load64! (g + win_c);
    let kh = prim.load64! (g + win_kh);
    let kw = prim.load64! (g + win_kw);
    let ch = k % c;
    let kx = (k / c) % kw;
    let ky = k / c / kw;
    let at = window_at! g (row / (ow * oh)) ((row / ow) % oh) (row % ow) ky kx;
    prim.store64! (out + k * word) (if at < 0 { prim.i2f 0 } else { prim.load64! (images + (at + ch) * word) });
    im2col_elements! g images out row (k + 1) total
};

let im2col_rows! !g !images !out !row !rows !k = if row >= rows { 0 } else {
    im2col_elements! g images out row 0 k;
    im2col_rows! g images (out + k * word) (row + 1) rows k
};

/// `spec` is `[kh, kw, stride, pad]`, checked. Each row of the answer is one window.
let tensor_im2col! !p !spec !x = {
    let g = window_of! p (t_dim! x 0) (t_dim! x 1) (t_dim! x 2) (t_dim! x 3) spec;
    let rows = prim.load64! (g + win_n) * prim.load64! (g + win_oh) * prim.load64! (g + win_ow);
    let k = prim.load64! (g + win_kh) * prim.load64! (g + win_kw) * prim.load64! (g + win_c);
    let o = t_blank! p 2 (rows * k);
    t_set_dim! o 0 rows;
    t_set_dim! o 1 k;
    im2col_rows! g (t_data x) (t_data o) 0 rows k;
    o
};

let col2im_elements! !g !images !src !row !k !total = if k >= total { 0 } else {
    let oh = prim.load64! (g + win_oh);
    let ow = prim.load64! (g + win_ow);
    let c = prim.load64! (g + win_c);
    let kw = prim.load64! (g + win_kw);
    let ch = k % c;
    let kx = (k / c) % kw;
    let ky = k / c / kw;
    let at = window_at! g (row / (ow * oh)) ((row / ow) % oh) (row % ow) ky kx;
    if at >= 0 {
        let place = images + (at + ch) * word;
        prim.store64! place (prim.fadd (prim.load64! place) (prim.load64! (src + k * word)));
    };
    col2im_elements! g images src row (k + 1) total
};

let col2im_rows! !g !images !src !row !rows !k = if row >= rows { 0 } else {
    col2im_elements! g images src row 0 k;
    col2im_rows! g images (src + k * word) (row + 1) rows k
};

/// The reverse: each number the sum of the places `im2col` copied it to.
let tensor_col2im! !p !shape !spec !cols = {
    let o = t_new! p shape;
    fill_words! (t_data o) (t_count! o) (prim.i2f 0);
    let g = window_of! p (t_dim! o 0) (t_dim! o 1) (t_dim! o 2) (t_dim! o 3) spec;
    let rows = t_dim! cols 0;
    let k = t_dim! cols 1;
    col2im_rows! g (t_data o) (t_data cols) 0 rows k;
    o
};

let tensor_equal! !p !a !b = {
    if t_rank! a != t_rank! b || t_count! a != t_count! b || not (same_dims! a b 0) { false_word }
    else { as_word (same_numbers! (t_data a) (t_data b) (t_count! a)) }
};

let same_dims! !a !b !i = i >= t_rank! a || (t_dim! a i == t_dim! b i && same_dims! a b (i + 1));
let same_numbers! !a !b !n = n == 0 || (prim.feq (prim.load64! a) (prim.load64! b) && same_numbers! (a + word) (b + word) (n - 1));

let is_number_value! !p !v = as_word (is_number! v);
let describe_value! !p !v = describe! p v;

let char_code_of! !p !c = tag_fix (c >> 8);

/// A member a host module does not have, reached: the VM's error, in the VM's words.
let no_such_member! !p !module_ !member = fail_value! p (prim.atom "no_such_member")
    (concat2! p (concat3! p (text_of! p "module `") module_ (text_of! p "` has no member `")) (concat2! p member (text_of! p "`")));

// What `std.vm` reports about the machine. Those about the VM's own structures have no
// counterpart here, and say so by being empty.
let processes_live! !p !unit = tag_fix (prim.load64! (world_at! w_live));
let collections_done! !p !unit = tag_fix (prim.load64! (p + ctx_collections));
let heap_bytes! !p !unit = tag_fix (prim.load64! (p + ctx_total));
let zero_of! !p !v = tag_fix 0;
let true_of! !p !v = true_word;
let unit_of! !p !v = unit_word;
let nil_of! !p !v = nil_word;
let empty_map_of! !p !v = map_empty! p;

/// `.member` of a value: a module's function, by the map `core.module_value` makes.
let member_of! !p !o !name = {
    if is_kind! o kind_module {
        let m = prim.load64! (o + word);
        let l = map_find! m (key_hash! name) name 0;
        if l != 0 { prim.load64! (l + 3 * word) }
        else {
            let n = string_len! name;
            let bare = if n > 0 && prim.load8! (string_bytes name + n - 1) == 33 { str_slice_any! p name (tag_fix 0) (tag_fix (n - 1)) } else { concat2! p name (text_of! p "!") };
            let twin = map_find! m (key_hash! bare) bare 0;
            if twin != 0 { prim.load64! (twin + 3 * word) }
            else { fail_value! p (prim.atom "no_such_member") (concat3! p (text_of! p "this module has no member `") name (text_of! p "`")) }
        }
    }
    else { fail_value! p atom_type_error (concat3! p (describe! p o) (text_of! p " has no member `") (concat2! p name (text_of! p "`"))) }
};

let module_of! !p !m !name = {
    let o = alloc! p (3 * word);
    prim.store64! o (prim.info "module");
    prim.store64! (o + word) m;
    prim.store64! (o + 2 * word) name;
    o
};

let module_name! !p !o = prim.load64! (o + 2 * word);

// --- tls ----------------------------------------------------------------------------------------
//
// On a socket, upgraded in place: the handle stays and `read!`/`write!` on it carry plaintext.
// The library is the system's OpenSSL, opened with `dlopen` the first time a program asks, so
// a program that never does needs nothing, and no C++ is involved. It is driven from memory,
// as dream/src/tls.hpp lays out: ciphertext goes in and out of BIOs, and the socket and parking
// are what the rest of this file does for any stream. A C callback cannot be written in the
// dialect, so the two OpenSSL wants are in the machine's text (`machine.tls_text`).
//
// What the VM's backend does that this does not: it reads a stapled OCSP response.

let tls_handles_at = 2;

let s_ssl = 0;
let s_in = 8;
let s_out = 16;
let s_state = 24;
let s_buf = 32;
let s_buf_len = 40;
let s_buf_off = 48;
let s_eof = 56;
let s_accepted = 64;
let s_kind = 72;
let s_message = 80;
let s_server = 88;
/// The process using the session now, or 0 (`session_hold!`).
let s_holder = 96;
let s_bytes = 104;

// A session is one OpenSSL object and its buffers, and two processes on two workers may use one
// connection at once -- one reading, one writing, as HTTP/2 and WebSockets do. So a call holds the
// session for the stretch of work between two parks: by the process's id, so that a call going
// round again holds it already, and given up before every park, answer and failure. A process
// that finds it held waits for that stretch, which never waits for anything itself.

let session_hold! !p !s = {
    let me = prim.load64! (current! p + pcb_id);
    if prim.load_acq! (s + s_holder) == me { 0 } else { session_take! s me 0 }
};

let session_take! !s !me !n =
    if prim.cas64! (s + s_holder) 0 me == 0 { 0 }
    else {
        if n > 4096 { prim.c0! "sched_yield"; } else { prim.pause! (); };
        session_take! s me (n + 1)
    };

let session_let_go! !s = if s != 0 { prim.store_rel! (s + s_holder) 0 } else { 0 };

let tls_return! !p !sp !s !v = { session_let_go! s; return! p sp v };
/// `wait_fd!` for a TLS handle `h`, whose session is let go first.
let tls_wait_fd2! !p !sp !code !h !b !fd = { session_let_go! (session_of! p h); wait_fd! p sp code h b fd };
let tls_failed_exit! !p !sp !s = { session_let_go! s; native_failed! p sp 0 0 0 0 };

let tls_handshaking = 0;
let tls_ready = 1;
let tls_failed = 2;

let session_of! !p !h = prim.load64! (prim.load64! (world_at! w_handles) + untag_fix h * handle_words * word + tls_handles_at * word);
let set_session! !p !h !s = prim.store64! (prim.load64! (world_at! w_handles) + untag_fix h * handle_words * word + tls_handles_at * word) s;

let open_first! !a !b !c = {
    let one = prim.c2! "dlopen" a 258;
    if one != 0 { one } else {
        let two = prim.c2! "dlopen" b 258;
        if two != 0 { two } else { prim.c2! "dlopen" c 258 }
    }
};

let ssl_names_tried! !dir !len_ = {
    let buf = prim.c1! "malloc" 4096;
    let h = ssl_in! buf dir len_ "libssl.so.3";
    let h2 = if h != 0 { h } else { ssl_in! buf dir len_ "libssl.so.1.1" };
    let h3 = if h2 != 0 { h2 } else { ssl_in! buf dir len_ "libssl.so" };
    prim.c1! "free" buf;
    h3
};

let ssl_in! !buf !dir !len_ !name = {
    prim.c6! "snprintf" buf 4096 "%.*s/%s" len_ dir name;
    prim.c2! "dlopen" buf 258
};

/// Each directory of a colon-separated list, from `at`, until one has the library.
let ssl_in_list! !at = if at == 0 || prim.load8! at == 0 { 0 } else {
    let n = until_colon! at 0;
    let h = if n == 0 { 0 } else { ssl_names_tried! at n };
    if h != 0 { h } else if prim.load8! (at + n) == 0 { 0 } else { ssl_in_list! (at + n + 1) }
};

let until_colon! !at !n = { let c = prim.load8! (at + n); if c == 0 || c == 58 { n } else { until_colon! at (n + 1) } };

/// `$VAR` and `rest` joined, tried as a directory.
let ssl_under! !var !rest = {
    let base = prim.c1! "getenv" var;
    if base == 0 { 0 } else {
        let dir = prim.c1! "malloc" 4096;
        prim.c5! "snprintf" dir 4096 "%s%s" base rest;
        let h = ssl_names_tried! dir (prim.c1! "strlen" dir);
        prim.c1! "free" dir;
        h
    }
};

let find_ssl! () = {
    let a = ssl_in_list! (prim.c1! "getenv" "DREAM_LIBRARY_PATH");
    let b = if a != 0 { a } else { ssl_under! "MINDV2_PATH" "/lib" };
    let c = if b != 0 { b } else { ssl_under! "HOME" "/.mindv2/lib" };
    let d = if c != 0 { c } else { open_first! "libssl.so.3" "libssl.so.1.1" "libssl.so" };
    let e = if d != 0 { d } else { ssl_under! "HOME" "/.nix-profile/lib" };
    let f = if e != 0 { e } else { ssl_user_profile! () };
    let g = if f != 0 { f } else { ssl_names_tried! "/run/current-system/sw/lib" 26 };
    if g != 0 { g } else { ssl_names_tried! "/nix/var/nix/profiles/default/lib" 33 }
};

/// NixOS's profile of the user's own packages.
let ssl_user_profile! () = {
    let user = prim.c1! "getenv" "USER";
    if user == 0 { 0 } else {
        let dir = prim.c1! "malloc" 4096;
        prim.c4! "snprintf" dir 4096 "/etc/profiles/per-user/%s/lib" user;
        let h = ssl_names_tried! dir (prim.c1! "strlen" dir);
        prim.c1! "free" dir;
        h
    }
};

/// The library's handle, opened once, or 0.
let ssl_lib! !p = {
    let have = prim.load64! (world_at! w_ssl);
    if have != 0 { have } else {
        // Looked for as the VM looks for a library on the system ("Finding a library" in
        // dream/src/ffi.cpp): the file named, then what was set up on purpose, then the loader,
        // then where a platform keeps what is installed but tells no loader -- Nix's profiles.
        let named = prim.c1! "getenv" "DREAM_OPENSSL_LIB";
        let h = if named != 0 { prim.c2! "dlopen" named 258 } else { find_ssl! () };
        if h != 0 {
            prim.store64! (prim.info "tls_get_error") (prim.c2! "dlsym" h "X509_STORE_CTX_get_error");
            prim.store64! (prim.info "tls_set_error") (prim.c2! "dlsym" h "X509_STORE_CTX_set_error");
            prim.store64! (prim.info "tls_next_proto") (prim.c2! "dlsym" h "SSL_select_next_proto");
        };
        // Last, so that whoever sees the handle sees what was found in it. Two processes opening
        // it at once is harmless: the loader counts, and both get the one library.
        prim.store_rel! (world_at! w_ssl) h;
        h
    }
};

let sym! !p name = prim.c2! "dlsym" (prim.load64! (world_at! w_ssl)) name;

let last_ssl_error! !p fallback = {
    let code = prim.ptr0! (sym! p "ERR_get_error");
    if code == 0 { text_of! p fallback } else {
        let buf = scratch! p 256;
        prim.ptr3! (sym! p "ERR_error_string_n") code buf 256;
        c_text! p buf
    }
};

let clear_ssl_errors! !p = prim.ptr0! (sym! p "ERR_clear_error");

let new_mem_bio! !p = prim.ptr1! (sym! p "BIO_new") (prim.ptr0! (sym! p "BIO_s_mem"));

let bio_of_string! !p !s = prim.ptr2! (sym! p "BIO_new_mem_buf") (string_bytes s) (string_len! s);

let load_ca_certs! !p !store !bio !count = {
    let cert = prim.ptr4! (sym! p "PEM_read_bio_X509") bio 0 0 0;
    if cert == 0 { count } else {
        prim.ptr2! (sym! p "X509_STORE_add_cert") store cert;
        prim.ptr1! (sym! p "X509_free") cert;
        load_ca_certs! p store bio (count + 1)
    }
};

let tls_config_fail! !p s = fail! p (prim.atom "tls_config") s;

let load_ca! !p !ctx !pem = {
    let store = prim.ptr0! (sym! p "X509_STORE_new");
    let bio = bio_of_string! p pem;
    let count = load_ca_certs! p store bio 0;
    prim.ptr1! (sym! p "BIO_free") bio;
    clear_ssl_errors! p;
    if count == 0 {
        prim.ptr1! (sym! p "X509_STORE_free") store;
        tls_config_fail! p "`ca` holds no PEM certificate"
    } else {
        prim.ptr2! (sym! p "SSL_CTX_set_cert_store") ctx store;
        1
    }
};

let load_crl_entries! !p !store !bio !count = {
    let crl = prim.ptr4! (sym! p "PEM_read_bio_X509_CRL") bio 0 0 0;
    if crl == 0 { count } else {
        prim.ptr2! (sym! p "X509_STORE_add_crl") store crl;
        prim.ptr1! (sym! p "X509_CRL_free") crl;
        load_crl_entries! p store bio (count + 1)
    }
};

let load_crls! !p !ctx !pem = {
    let store = prim.ptr1! (sym! p "SSL_CTX_get_cert_store") ctx;
    let bio = bio_of_string! p pem;
    let count = load_crl_entries! p store bio 0;
    prim.ptr1! (sym! p "BIO_free") bio;
    clear_ssl_errors! p;
    if count == 0 { tls_config_fail! p "`crl` holds no PEM certificate revocation list" }
    else {
        prim.ptr2! (sym! p "X509_STORE_set_flags") store 4;
        1
    }
};

let add_chain! !p !ctx !chain !i !n = if i >= n { 1 } else {
    let cert = prim.ptr2! (sym! p "OPENSSL_sk_value") chain i;
    if prim.sext32 (prim.ptr4! (sym! p "SSL_CTX_ctrl") ctx 89 1 cert) != 1 { 0 }
    else { add_chain! p ctx chain (i + 1) n }
};

let load_identity! !p !ctx !bundle_bytes !password = {
    let bio = bio_of_string! p bundle_bytes;
    let bundle = prim.ptr2! (sym! p "d2i_PKCS12_bio") bio 0;
    prim.ptr1! (sym! p "BIO_free") bio;
    if bundle == 0 {
        fail_value! p (prim.atom "tls_config") (concat2! p (text_of! p "`identity` is not a PKCS#12 bundle: ") (last_ssl_error! p "unreadable"))
    } else {
        let out = scratch! p (3 * word);
        zero_words! out 3;
        let parsed = prim.sext32 (prim.ptr5! (sym! p "PKCS12_parse") bundle (string_bytes password) out (out + word) (out + 2 * word)) == 1;
        prim.ptr1! (sym! p "PKCS12_free") bundle;
        let key = prim.load64! out;
        let cert = prim.load64! (out + word);
        let chain = prim.load64! (out + 2 * word);
        if not parsed || key == 0 || cert == 0 {
            fail_value! p (prim.atom "tls_config") (concat2! p (text_of! p "cannot open the PKCS#12 identity (is the password right?): ") (last_ssl_error! p "no key or certificate in it"))
        } else {
            let used = prim.sext32 (prim.ptr2! (sym! p "SSL_CTX_use_certificate") ctx cert) == 1
                && prim.sext32 (prim.ptr2! (sym! p "SSL_CTX_use_PrivateKey") ctx key) == 1
                && prim.sext32 (prim.ptr1! (sym! p "SSL_CTX_check_private_key") ctx) == 1
                && (chain == 0 || add_chain! p ctx chain 0 (prim.sext32 (prim.ptr1! (sym! p "OPENSSL_sk_num") chain)) == 1);
            if used { 1 } else {
                fail_value! p (prim.atom "tls_config") (concat2! p (text_of! p "cannot use the PKCS#12 identity: ") (last_ssl_error! p "rejected"))
            }
        }
    }
};

/// The wire form of the protocols, kept for as long as the program runs: a server's context
/// holds on to it, and nothing here frees a context either.
let malloc_copy! !s = {
    let n = string_len! s;
    let at = prim.c1! "malloc" (n + word + 1);
    prim.store64! at n;
    prim.c3! "memcpy" (at + word) (string_bytes s) n;
    at
};

/// `config` is `[host, ca, crl, identity, password, verify, check_name, alpn]`: strings or
/// unit, two booleans, and the protocols already in wire form, or unit.
let cfg! !c !i = prim.load64! (c + (2 + i) * word);

let new_context! !p !server !c = {
    let method_ = if server { prim.ptr0! (sym! p "TLS_server_method") } else { prim.ptr0! (sym! p "TLS_client_method") };
    let ctx = prim.ptr1! (sym! p "SSL_CTX_new") method_;
    if ctx == 0 { fail_value! p (prim.atom "tls_error") (last_ssl_error! p "SSL_CTX_new failed") }
    else {
        // TLS 1.2 is the oldest spoken: SSL_CTX_set_min_proto_version, a macro in C.
        prim.ptr4! (sym! p "SSL_CTX_ctrl") ctx 123 771 0;
        let roots_ok =
            if cfg! c 1 != unit_word { load_ca! p ctx (cfg! c 1) }
            else if server { 1 }
            else if prim.sext32 (prim.ptr1! (sym! p "SSL_CTX_set_default_verify_paths") ctx) != 1 {
                fail_value! p (prim.atom "tls_config") (concat2! p (text_of! p "cannot load the system's trusted certificates: ") (last_ssl_error! p "no default paths"))
            } else { 1 };
        if roots_ok == 0 { 0 }
        else if cfg! c 2 != unit_word && load_crls! p ctx (cfg! c 2) == 0 { 0 }
        else if cfg! c 3 != unit_word && load_identity! p ctx (cfg! c 3) (if cfg! c 4 == unit_word { text_of! p "" } else { cfg! c 4 }) == 0 { 0 }
        else {
            if server && cfg! c 7 != unit_word {
                prim.ptr3! (sym! p "SSL_CTX_set_alpn_select_cb") ctx (prim.info "alpn_stub") (malloc_copy! (cfg! c 7));
            };
            ctx
        }
    }
};

let client_identity! !p !ssl !c = {
    let host = cfg! c 0;
    let verify = cfg! c 5 == true_word;
    let check_name = cfg! c 6 == true_word;
    if host != unit_word {
        let param = prim.ptr1! (sym! p "SSL_get0_param") ssl;
        let address = prim.sext32 (prim.ptr2! (sym! p "X509_VERIFY_PARAM_set1_ip_asc") param (string_bytes host)) == 1;
        clear_ssl_errors! p;
        if address && not check_name { prim.ptr3! (sym! p "X509_VERIFY_PARAM_set1_ip") param 0 0; };
        if not address {
            // SSL_set_tlsext_host_name, a macro in C.
            prim.ptr4! (sym! p "SSL_ctrl") ssl 55 0 (string_bytes host);
            if check_name { prim.ptr2! (sym! p "SSL_set1_host") ssl (string_bytes host); };
        };
    };
    prim.ptr3! (sym! p "SSL_set_verify") ssl (if verify { 1 } else { 0 }) (prim.info "verify_stub");
    if cfg! c 7 != unit_word {
        prim.ptr3! (sym! p "SSL_set_alpn_protos") ssl (string_bytes (cfg! c 7)) (string_len! (cfg! c 7));
    };
    1
};

/// A session on this handle, its handshake not begun. 0 with the reason in the context.
let tls_start! !p !h !server !c = {
    if fd_of! p h < 0 { closed! p "this handle is closed" }
    else if handle_kind! p h != kind_stream_handle {
        fail! p (prim.atom "wrong_kind") (if server == true_word { "tls.accept! needs an accepted connection" } else { "tls.connect! needs a connected socket" })
    }
    else if session_of! p h != 0 { h }
    else if ssl_lib! p == 0 { fail! p (prim.atom "tls_error") "no OpenSSL could be opened: looked for libssl.so.3, libssl.so.1.1 and libssl.so in $DREAM_LIBRARY_PATH, the installation's lib, on the loader's path and in Nix's profiles; $DREAM_OPENSSL_LIB names the file" }
    else {
        let is_server = server == true_word;
        let ctx = new_context! p is_server c;
        if ctx == 0 { 0 } else {
            let ssl = prim.ptr1! (sym! p "SSL_new") ctx;
            let s = prim.c2! "calloc" 1 s_bytes;
            let in_ = new_mem_bio! p;
            let out = new_mem_bio! p;
            // BIO_set_mem_eof_return: an empty BIO says "not yet", not "the end".
            prim.ptr4! (sym! p "BIO_ctrl") in_ 130 (0 - 1) 0;
            prim.ptr3! (sym! p "SSL_set_bio") ssl in_ out;
            prim.store64! (s + s_ssl) ssl;
            prim.store64! (s + s_in) in_;
            prim.store64! (s + s_out) out;
            prim.store64! (s + s_server) (if is_server { 1 } else { 0 });
            if is_server {
                prim.ptr1! (sym! p "SSL_set_accept_state") ssl;
                if cfg! c 5 == true_word && cfg! c 1 != unit_word {
                    prim.ptr3! (sym! p "SSL_set_verify") ssl 3 (prim.info "verify_stub");
                };
            } else {
                prim.ptr1! (sym! p "SSL_set_connect_state") ssl;
                client_identity! p ssl c;
            };
            set_session! p h s;
            h
        }
    }
};

/// What OpenSSL has written, moved to the session's buffer of what the socket has not taken.
let take_output! !p !s = {
    let buf = scratch! p 16384;
    let n = prim.sext32 (prim.ptr3! (sym! p "BIO_read") (prim.load64! (s + s_out)) buf 16384);
    if n <= 0 { 0 } else {
        let off = prim.load64! (s + s_buf_off);
        let len = prim.load64! (s + s_buf_len);
        let keep = len - off;
        let old = prim.load64! (s + s_buf);
        let grown = prim.c1! "malloc" (keep + n + 1);
        if keep > 0 { prim.c3! "memcpy" grown (old + off) keep; };
        prim.c3! "memcpy" (grown + keep) buf n;
        if old != 0 { prim.c1! "free" old; };
        prim.store64! (s + s_buf) grown;
        prim.store64! (s + s_buf_off) 0;
        prim.store64! (s + s_buf_len) (keep + n);
        take_output! p s
    }
};

/// 0 all sent, 1 the socket is full, 2 it failed.
let flush_tls! !p !s !fd = {
    let off = prim.load64! (s + s_buf_off);
    let len = prim.load64! (s + s_buf_len);
    if off >= len { 0 } else {
        let put = prim.c3! "write" fd (prim.load64! (s + s_buf) + off) (len - off);
        if put > 0 {
            prim.store64! (s + s_buf_off) (off + put);
            flush_tls! p s fd
        }
        else {
            let e = errno! ();
            if e == 11 { 1 } else if e == 4 { flush_tls! p s fd } else { 2 }
        }
    }
};

/// 0 something came in, 1 nothing yet, 2 it failed.
let pull_tls! !p !s !fd = {
    let buf = scratch! p 16384;
    let got = prim.c3! "read" fd buf 16384;
    if got > 0 {
        prim.ptr3! (sym! p "BIO_write") (prim.load64! (s + s_in)) buf got;
        0
    } else if got == 0 {
        prim.store64! (s + s_eof) 1;
        prim.ptr4! (sym! p "BIO_ctrl") (prim.load64! (s + s_in)) 130 0 0;
        0
    } else {
        let e = errno! ();
        if e == 11 { 1 } else if e == 4 { pull_tls! p s fd } else { 2 }
    }
};

let session_failed! !p !s !fd !kind !message = {
    prim.store64! (s + s_state) tls_failed;
    prim.store64! (s + s_kind) kind;
    prim.store64! (s + s_message) (malloc_copy! message);
    take_output! p s;
    flush_tls! p s fd;
    prim.c2! "shutdown" fd 1;
    fail_value! p kind message
};

let refused! !p !s = {
    let m = prim.load64! (s + s_message);
    if prim.load64! (s + s_state) == tls_handshaking { fail! p (prim.atom "tls_error") "this connection's TLS handshake has not finished" }
    else {
        let text = new_string! p (prim.load64! m);
        prim.c3! "memcpy" (string_bytes text) (m + word) (prim.load64! m);
        fail_value! p (prim.load64! (s + s_kind)) (concat2! p (text_of! p "TLS on this connection already failed: ") text)
    }
};

let verify_failed! !p !s !fd !code = {
    let why = c_text! p (prim.ptr1! (sym! p "X509_verify_cert_error_string") code);
    if code == 62 || code == 64 { session_failed! p s fd (prim.atom "hostname_mismatch") (concat2! p (text_of! p "the certificate is not for this host: ") why) }
    else if code == 23 { session_failed! p s fd (prim.atom "certificate_revoked") (concat2! p (text_of! p "the certificate has been revoked: ") why) }
    else if code == 10 || code == 9 { session_failed! p s fd (prim.atom "certificate_expired") (concat2! p (text_of! p "the certificate is outside its validity period: ") why) }
    else { session_failed! p s fd (prim.atom "certificate_untrusted") (concat2! p (text_of! p "the certificate is not trusted: ") why) }
};

/// What an OpenSSL call that did not succeed comes to: 2 wants more of the network, 3 the
/// peer closed, and 0 failed with the reason in the context.
let ssl_outcome! !p !s !fd !r !handshaking = {
    let err = prim.sext32 (prim.ptr2! (sym! p "SSL_get_error") (prim.load64! (s + s_ssl)) r);
    if err == 2 || err == 3 { 2 }
    else if err == 6 { 3 }
    else if err == 1 || err == 5 {
        let verify = if handshaking { prim.ptr1! (sym! p "SSL_get_verify_result") (prim.load64! (s + s_ssl)) } else { 0 };
        if handshaking && verify != 0 { verify_failed! p s fd verify }
        else {
            let code = prim.ptr0! (sym! p "ERR_peek_error");
            if not handshaking && code == 0 { 3 }
            else if handshaking && code == 0 {
                session_failed! p s fd (prim.atom "handshake_failed") (text_of! p "the peer closed the connection during the handshake")
            }
            else if handshaking {
                session_failed! p s fd (prim.atom "handshake_failed") (last_ssl_error! p "TLS failed")
            }
            else { session_failed! p s fd (prim.atom "tls_error") (last_ssl_error! p "TLS failed") }
        }
    }
    else { session_failed! p s fd (prim.atom "tls_error") (text_of! p "an unexpected TLS state") }
};

let tls_handshake_m! !p !sp !self_ !h !c !d = {
    let fd = fd_of! p h;
    let s = session_of! p h;
    if s != 0 { session_hold! p s; };
    if fd < 0 || s == 0 { closed! p "this handle is closed"; tls_failed_exit! p sp s }
    else if prim.load64! (s + s_state) == tls_failed { refused! p s; tls_failed_exit! p sp s }
    else {
        let flushed = flush_tls! p s fd;
        if flushed == 1 {
            prim.store64! (current! p + pcb_wait_write) 1;
            tls_wait_fd2! p sp (prim.load64! (prim.info "m_tls_handshake")) h unit_word fd
        }
        else if flushed == 2 {
            session_failed! p s fd (prim.atom "handshake_failed") (text_of! p "the connection failed");
            tls_failed_exit! p sp s
        }
        else if prim.load64! (s + s_state) == tls_ready { tls_return! p sp s h }
        else {
            clear_ssl_errors! p;
            let r = prim.sext32 (prim.ptr1! (sym! p "SSL_do_handshake") (prim.load64! (s + s_ssl)));
            take_output! p s;
            if r == 1 {
                prim.store64! (s + s_state) tls_ready;
                tls_handshake_m! p sp 0 h 0 0
            } else {
                let o = ssl_outcome! p s fd r true;
                if o == 0 { tls_failed_exit! p sp s }
                else if o == 3 {
                    session_failed! p s fd (prim.atom "handshake_failed") (text_of! p "the peer closed the connection during the handshake");
                    tls_failed_exit! p sp s
                }
                else {
                    let more = flush_tls! p s fd;
                    if more == 1 {
                        prim.store64! (current! p + pcb_wait_write) 1;
                        tls_wait_fd2! p sp (prim.load64! (prim.info "m_tls_handshake")) h unit_word fd
                    }
                    else {
                        let pulled = pull_tls! p s fd;
                        if pulled == 1 { tls_wait_fd2! p sp (prim.load64! (prim.info "m_tls_handshake")) h unit_word fd }
                        else if pulled == 2 {
                            session_failed! p s fd (prim.atom "handshake_failed") (text_of! p "the connection failed");
                            tls_failed_exit! p sp s
                        }
                        else { tls_handshake_m! p sp 0 h 0 0 }
                    }
                }
            }
        }
    }
};

let tls_read_m! !p !sp !self_ !h !n !d = {
    let fd = fd_of! p h;
    let s = session_of! p h;
    if s != 0 { session_hold! p s; };
    if prim.load64! (s + s_state) != tls_ready { refused! p s; tls_failed_exit! p sp s }
    else {
        let flushed = flush_tls! p s fd;
        if flushed == 1 {
            prim.store64! (current! p + pcb_wait_write) 1;
            tls_wait_fd2! p sp (prim.load64! (prim.info "m_read")) h n fd
        }
        else if flushed == 2 { fail_errno! p (text_of! p "write"); tls_failed_exit! p sp s }
        else {
            let want = if untag_fix n > 16777216 { 16777216 } else { untag_fix n };
            let out = new_string! p want;
            let got = scratch! p word;
            clear_ssl_errors! p;
            let r = prim.sext32 (prim.ptr4! (sym! p "SSL_read_ex") (prim.load64! (s + s_ssl)) (string_bytes out) want got);
            take_output! p s;
            if r == 1 {
                let count = prim.load64! got;
                string_cut! out want count;
                tls_return! p sp s out
            } else {
                let o = ssl_outcome! p s fd 0 false;
                if o == 0 { tls_failed_exit! p sp s }
                else if o == 3 || prim.load64! (s + s_eof) != 0 { tls_return! p sp s (text_of! p "") }
                else {
                    let more = flush_tls! p s fd;
                    if more == 1 {
                        prim.store64! (current! p + pcb_wait_write) 1;
                        tls_wait_fd2! p sp (prim.load64! (prim.info "m_read")) h n fd
                    }
                    else {
                        let pulled = pull_tls! p s fd;
                        if pulled == 1 { tls_wait_fd2! p sp (prim.load64! (prim.info "m_read")) h n fd }
                        else if pulled == 2 { fail_errno! p (text_of! p "read"); tls_failed_exit! p sp s }
                        else { tls_read_m! p sp 0 h n 0 }
                    }
                }
            }
        }
    }
};

let tls_write_m! !p !sp !self_ !h !text !d = {
    let fd = fd_of! p h;
    let s = session_of! p h;
    if s != 0 { session_hold! p s; };
    if prim.load64! (s + s_state) != tls_ready { refused! p s; tls_failed_exit! p sp s }
    else {
        let flushed = flush_tls! p s fd;
        if flushed == 1 {
            prim.store64! (current! p + pcb_wait_write) 1;
            tls_wait_fd2! p sp (prim.load64! (prim.info "m_write")) h text fd
        }
        else if flushed == 2 { fail_errno! p (text_of! p "write"); tls_failed_exit! p sp s }
        else if prim.load64! (s + s_accepted) != 0 {
            let n = prim.load64! (s + s_accepted);
            prim.store64! (s + s_accepted) 0;
            tls_return! p sp s (tag_fix n)
        }
        else {
            let take = if string_len! text > 65536 { 65536 } else { string_len! text };
            let done = scratch! p word;
            clear_ssl_errors! p;
            let r = prim.sext32 (prim.ptr4! (sym! p "SSL_write_ex") (prim.load64! (s + s_ssl)) (string_bytes text) take done);
            take_output! p s;
            if r != 1 && take != 0 {
                let o = ssl_outcome! p s fd 0 false;
                if o == 0 { tls_failed_exit! p sp s }
                else { fail! p (prim.atom "connection_lost") "the connection closed during a write"; tls_failed_exit! p sp s }
            } else {
                prim.store64! (s + s_accepted) take;
                if take == 0 { prim.store64! (s + s_accepted) 0; tls_return! p sp s (tag_fix 0) }
                else { tls_write_m! p sp 0 h text 0 }
            }
        }
    }
};

/// The close alert, sent if it can be without waiting.
let tls_goodbye! !p !s !fd = if prim.load64! (s + s_state) == tls_ready {
    session_hold! p s;
    clear_ssl_errors! p;
    prim.ptr1! (sym! p "SSL_shutdown") (prim.load64! (s + s_ssl));
    clear_ssl_errors! p;
    take_output! p s;
    flush_tls! p s fd;
    session_let_go! s;
    0
} else { 0 };

let tls_text_of! !p !at = if at == 0 { unit_word } else { c_text! p at };

/// `[version, cipher, alpn, peer]`, the library making a map of it.
let tls_info_parts! !p !h = {
    if fd_of! p h < 0 { closed! p "this handle is closed" }
    else {
        let s = session_of! p h;
        if s == 0 { unit_word } else {
            let ssl = prim.load64! (s + s_ssl);
            let version = tls_text_of! p (prim.ptr1! (sym! p "SSL_get_version") ssl);
            let cipher_at = prim.ptr1! (sym! p "SSL_get_current_cipher") ssl;
            let cipher = if cipher_at == 0 { unit_word } else { tls_text_of! p (prim.ptr1! (sym! p "SSL_CIPHER_get_name") cipher_at) };
            let alpn_at = scratch! p (2 * word);
            zero_words! alpn_at 2;
            prim.ptr3! (sym! p "SSL_get0_alpn_selected") ssl alpn_at (alpn_at + word);
            let alpn_bytes = prim.load64! alpn_at;
            let alpn = if alpn_bytes == 0 { unit_word } else {
                let n = prim.load32! (alpn_at + word);
                let t = new_string! p n;
                prim.c3! "memcpy" (string_bytes t) alpn_bytes n;
                t
            };
            let getter = sym! p "SSL_get1_peer_certificate";
            let peer_cert = prim.ptr1! (if getter != 0 { getter } else { sym! p "SSL_get_peer_certificate" }) ssl;
            let peer = if peer_cert == 0 { unit_word } else {
                let bio = new_mem_bio! p;
                prim.ptr4! (sym! p "X509_NAME_print_ex") bio (prim.ptr1! (sym! p "X509_get_subject_name") peer_cert) 0 17892119;
                let text = scratch! p word;
                prim.store64! text 0;
                let n = prim.ptr4! (sym! p "BIO_ctrl") bio 3 0 text;
                let t = new_string! p n;
                if n > 0 { prim.c3! "memcpy" (string_bytes t) (prim.load64! text) n; };
                prim.ptr1! (sym! p "BIO_free") bio;
                prim.ptr1! (sym! p "X509_free") peer_cert;
                t
            };
            new_cons! p version (new_cons! p cipher (new_cons! p alpn (new_cons! p peer nil_word)))
        }
    }
};

let tls_backend! !p !unit = {
    if ssl_lib! p == 0 { text_of! p "no OpenSSL could be opened" }
    else { c_text! p (prim.ptr1! (sym! p "OpenSSL_version") 0) }
};

// --- calling C ---------------------------------------------------------------------------------
//
// `std.ffi`. Almost all of it is in the library, in Dream: signatures are data, and a handle is
// `[:foreign, tag, id]` whose id names an entry in the table here. What cannot be Dream is the
// call itself. C's calling convention puts whole-number arguments and floating ones in two
// separate rows of registers, independent of each other, so loading every register of both rows
// and calling the address reaches every signature of up to six and eight of them; arguments past
// six words go on the machine stack, which is where C looks next. So there is no libffi and no
// table of shapes. A C function reads what it was declared to read and ignores the rest.
//
// A C callback into Dream is the one thing this does not do: see `lib.dr`.

// The table of foreign handles: what C made, who owns it, how to destroy it, what it was made
// from. It is every process's, and changes as handles are made and released, so it is raw memory
// rather than a value: an array of entries by id, mapped at its largest and touched as it fills,
// each entry `[prev, next, id, owner, tag, pointer, destructor, size, parent count, parents..]`
// made with `malloc` and freed on release, and the live ones linked oldest first. A map in the
// shared region, promoted at each change, kept every version of it, as that region is not
// collected. All of it is under the world's lock. Every field is a word with no object behind it
// -- an id, an atom, an integer -- and one that is not (an address past a fixnum) is promoted, which
// is then the only thing a handle leaves behind.

let foreign_cap = 16777216;
let fe_prev = 0;
let fe_next = 8;
let fe_id = 16;
let fe_fields = 24;
let fe_parents = 72;

let foreign_slot! !id = prim.load64! (world_at! w_foreign) + id * word;

let foreign_new_id! !p !unit = tag_fix (prim.xadd64! (world_at! w_foreign_next) 1 + 1);

let fe_field! !p !v = if is_heap_object! v { promote! p v } else { v };

/// `[owner, tag, pointer, destructor, size, parents]`, forced, for handle `id`.
let foreign_put! !p !id !e = {
    let i = untag_fix id;
    if i <= 0 || i >= foreign_cap { fail! p (prim.atom "ffi_error") "too many foreign handles" } else {
        let parents = prim.load64! (e + 7 * word);
        let n = list_count! parents 0;
        let entry = prim.c1! "malloc" (fe_parents + n * word);
        prim.store64! (entry + fe_id) id;
        prim.store64! (entry + fe_fields) (fe_field! p (prim.load64! (e + 2 * word)));
        prim.store64! (entry + fe_fields + word) (fe_field! p (prim.load64! (e + 3 * word)));
        prim.store64! (entry + fe_fields + 2 * word) (fe_field! p (prim.load64! (e + 4 * word)));
        prim.store64! (entry + fe_fields + 3 * word) (fe_field! p (prim.load64! (e + 5 * word)));
        prim.store64! (entry + fe_fields + 4 * word) (fe_field! p (prim.load64! (e + 6 * word)));
        prim.store64! (entry + fe_parents - word) n;
        fill_parents! p entry parents 0;
        let l = prim.load64! (world_at! w_lock);
        lock! l;
        let tail = prim.load64! (world_at! w_foreign_tail);
        prim.store64! (entry + fe_prev) tail;
        prim.store64! (entry + fe_next) 0;
        if tail == 0 { prim.store64! (world_at! w_foreign_head) entry; } else { prim.store64! (tail + fe_next) entry; };
        prim.store64! (world_at! w_foreign_tail) entry;
        prim.store64! (foreign_slot! i) entry;
        unlock! l;
        unit_word
    }
};

let list_count! !l !n = if is_kind! l kind_cons { list_count! (prim.load64! (l + 2 * word)) (n + 1) } else { n };

let fill_parents! !p !entry !l !i = if is_kind! l kind_cons {
    prim.store64! (entry + fe_parents + i * word) (fe_field! p (prim.load64! (l + word)));
    fill_parents! p entry (prim.load64! (l + 2 * word)) (i + 1)
} else { 0 };

/// The entry for `id`, the world's lock held, or 0.
let foreign_entry! !id = {
    let i = untag_fix id;
    if not (is_fix id) || i <= 0 || i >= foreign_cap { 0 } else { prim.load64! (foreign_slot! i) }
};

/// An entry as the library reads one, an array in this process's heap.
let entry_value! !p !entry = {
    let parents = parents_list! p entry (prim.load64! (entry + fe_parents - word)) nil_word;
    let a = array_new! p (tag_fix 6) unit_word;
    array_store! p a (tag_fix 0) (prim.load64! (entry + fe_fields));
    array_store! p a (tag_fix 1) (prim.load64! (entry + fe_fields + word));
    array_store! p a (tag_fix 2) (prim.load64! (entry + fe_fields + 2 * word));
    array_store! p a (tag_fix 3) (prim.load64! (entry + fe_fields + 3 * word));
    array_store! p a (tag_fix 4) (prim.load64! (entry + fe_fields + 4 * word));
    array_store! p a (tag_fix 5) parents;
    a
};

let parents_list! !p !entry !i !acc = if i <= 0 { acc } else {
    parents_list! p entry (i - 1) (new_cons! p (prim.load64! (entry + fe_parents + (i - 1) * word)) acc)
};

/// The entry for `id` as an array, or `()` if it has been released or never was.
let foreign_get! !p !id = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let entry = foreign_entry! id;
    let v = if entry == 0 { unit_word } else { entry_value! p entry };
    unlock! l;
    v
};

let foreign_drop! !p !id = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let entry = foreign_entry! id;
    if entry != 0 {
        let prev = prim.load64! (entry + fe_prev);
        let next = prim.load64! (entry + fe_next);
        if prev == 0 { prim.store64! (world_at! w_foreign_head) next; } else { prim.store64! (prev + fe_next) next; };
        if next == 0 { prim.store64! (world_at! w_foreign_tail) prev; } else { prim.store64! (next + fe_prev) prev; };
        prim.store64! (foreign_slot! (untag_fix id)) 0;
        prim.c1! "free" entry;
    };
    unlock! l;
    unit_word
};

/// The ids of the live handles made from `id`, oldest first.
let foreign_children! !p !id = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let out = children_from! p (prim.load64! (world_at! w_foreign_tail)) id nil_word;
    unlock! l;
    out
};

let children_from! !p !entry !id !acc = if entry == 0 { acc } else {
    let hit = has_parent! entry id 0 (prim.load64! (entry + fe_parents - word));
    children_from! p (prim.load64! (entry + fe_prev)) id (if hit { new_cons! p (prim.load64! (entry + fe_id)) acc } else { acc })
};

let has_parent! !entry !id !i !n = i < n && (prim.load64! (entry + fe_parents + i * word) == id || has_parent! entry id (i + 1) n);

/// `[:foreign, tag, id]` for each live handle `owner` owns, oldest first.
let foreign_owned! !p !owner = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let out = owned_from! p (prim.load64! (world_at! w_foreign_tail)) owner nil_word;
    unlock! l;
    out
};

let owned_from! !p !entry !owner !acc = if entry == 0 { acc } else {
    let mine = prim.load64! (entry + fe_fields) == owner;
    owned_from! p (prim.load64! (entry + fe_prev)) owner
        (if mine { new_cons! p (new_cons! p (prim.atom "foreign") (new_cons! p (prim.load64! (entry + fe_fields + word))
            (new_cons! p (prim.load64! (entry + fe_id)) nil_word))) acc } else { acc })
};

let current_pid_id! !p !unit = tag_fix (prim.load64! (current! p + pcb_id));

/// Move what a value is for C into the registers' rows. `codes`: 0 a word, 1 a double, 2 a
/// float, 3 the bytes of a string, 4 somewhere inside one, the offset the next value.
let ffi_load! !values !codes !ints !doubles !state = {
    let i = state & 255;
    let ni = (state >> 8) & 255;
    let nd = (state >> 16) & 255;
    let n = untag_fix (prim.load64! (values + word));
    if i >= n { 0 } else {
        let v = prim.load64! (values + (2 + i) * word);
        let code = untag_fix (prim.load64! (codes + (2 + i) * word));
        if code == 5 {
            prim.store64! (ints + ni * word) (callback_stub! v);
            ffi_load! values codes ints doubles (state + 1 + 256)
        } else if code == 1 {
            prim.store64! (doubles + nd * word) (float_bits! v);
            ffi_load! values codes ints doubles (state + 1 + 65536)
        } else if code == 2 {
            prim.store64! (doubles + nd * word) (prim.to_f32 (float_bits! v));
            ffi_load! values codes ints doubles (state + 1 + 65536)
        } else {
            prim.store64! (ints + ni * word) (ffi_word! v code);
            ffi_load! values codes ints doubles (state + 1 + 256)
        }
    }
};

let ffi_word! !v !code =
    if code == 3 { if v == unit_word || v == nil_word { 0 } else { string_bytes v } }
    else if is_fix v { untag_fix v }
    else if is_big! v { prim.load64! (limb_at v 0) | (big_limb! v 1 << 32) | 0 }
    else if is_float! v { prim.f2i (prim.load64! (v + word)) }
    else if v == true_word { 1 }
    else { 0 };

/// A word C answered, as the integer it stands for: narrowed by the `kind`, whose number is
/// the library's (`ffi_kind_code`).
let int_of_word! !p !w = {
    if w >= 0 - (1 << 62) && w < (1 << 62) { tag_fix w }
    else if w < 0 { neg! p (word_big! p (0 - w)) }
    else { word_big! p w }
};

let word_big! !p !m = {
    let b = new_big! p 2 0;
    prim.store64! (limb_at b 0) (m & limb_mask);
    prim.store64! (limb_at b 1) (prim.ushr m 32);
    big_fix! b
};

let u64_of_word! !p !w = if w >= 0 && w < (1 << 62) { tag_fix w } else {
    let b = new_big! p 2 0;
    prim.store64! (limb_at b 0) (w & limb_mask);
    prim.store64! (limb_at b 1) (prim.ushr w 32);
    big_fix! b
};

/// Kinds: 0 void, 1 bool, 2-5 signed 8 to 64, 6-9 unsigned, 10 float, 11 double, 12 a pointer,
/// 13 a C string. `w` is the raw word C left, for all but the floating ones.
let ffi_answer! !p !k !w =
    if k == 0 { unit_word }
    else if k == 1 { as_word (w & 255 != 0) }
    else if k == 2 { tag_fix ((w << 56) >> 56) }
    else if k == 3 { tag_fix ((w << 48) >> 48) }
    else if k == 4 { tag_fix ((w << 32) >> 32) }
    else if k == 5 { int_of_word! p w }
    else if k == 6 { tag_fix (w & 255) }
    else if k == 7 { tag_fix (w & 65535) }
    else if k == 8 { tag_fix (w & 4294967295) }
    else if k == 9 { u64_of_word! p w }
    else if k == 12 { if w == 0 { unit_word } else { int_of_word! p w } }
    else if k == 13 { if w == 0 { unit_word } else { c_text! p w } }
    else { unit_word };

/// `spec` is `[values, codes, kind]`. A machine function, because a callback from C runs on
/// this process's stack, below where this stands.
let ffi_call_m! !p !sp0 !self_ !f !spec !d = {
    // A library may keep state for the thread that called it -- a GUI toolkit, a GL context, a
    // thread-local error -- so a process that calls C stays on this worker from now on.
    let me = current! p;
    if prim.load64! (me + pcb_pinned) == 0 { prim.store64! (me + pcb_pinned) p; };
    // C may call back, onto this stack, which cannot move while it does.
    let sp = if prim.load64! (current! p + pcb_stack_size) < 1048576 && prim.load64! (p + ctx_in_callback) == 0 { move_stack! p sp0 1048576 } else { sp0 };
    let values = prim.load64! (spec + 2 * word);
    let codes = prim.load64! (spec + 3 * word);
    let k = untag_fix (prim.load64! (spec + 4 * word));
    let ints = scratch! p (12 * word);
    let doubles = scratch! p (8 * word);
    zero_words! ints 12;
    zero_words! doubles 8;
    let outer_sp = prim.load64! (p + ctx_ffi_sp);
    prim.store64! (p + ctx_ffi_sp) sp;
    ffi_load! values codes ints doubles 0;
    let address = word_of_int! f;
    let raw = if k == 11 || k == 10 { prim.ffi_double! address ints doubles } else { prim.ffi_word! address ints doubles };
    prim.store64! (p + ctx_ffi_sp) outer_sp;
    let failed = prim.load64! (p + ctx_cb_error);
    if prim.load_acq! (world_at! w_cb_refused) != 0 && prim.xchg64! (world_at! w_cb_refused) 0 != 0 {
        // Said of the C function, as the VM says it: the fourth of the call's description.
        let name = prim.load64! (spec + 5 * word);
        fail_value! p (prim.atom "ffi_error") (concat3! p (text_of! p "in a callback passed to `") (if is_string! name { name } else { text_of! p "?" })
            (text_of! p "`: a callback was called from a thread other than the one that passed it"));
        native_failed! p sp 0 0 0 0
    } else if failed != 0 {
        prim.store64! (p + ctx_cb_error) 0;
        unwind! p sp failed 0 0 0
    } else if prim.load64! (p + ctx_cb_text) != 0 {
        let text = prim.load64! (p + ctx_cb_text);
        prim.store64! (p + ctx_cb_text) 0;
        fail_value! p (prim.atom "ffi_error") text;
        native_failed! p sp 0 0 0 0
    } else {
        if prim.load64! (p + ctx_want_gc) != 0 { prim.store64! (p + ctx_guard) (0 - 1); };
        return! p sp (
            if k == 11 { new_float! p raw }
            else if k == 10 { new_float! p (prim.from_f32 raw) }
            else { ffi_answer! p k raw })
    }
};

let word_of_int! !v = if is_fix v { untag_fix v } else { big_limb! v 0 | (big_limb! v 1 << 32) };

/// What is at an address, by the same kinds.
let ffi_load_at! !p !k !at =
    if k == 1 { as_word (prim.load8! at != 0) }
    else if k == 2 || k == 6 { ffi_answer! p k (prim.load8! at) }
    else if k == 3 || k == 7 { ffi_answer! p k (prim.load16! at) }
    else if k == 4 || k == 8 { ffi_answer! p k (prim.load32! at) }
    else if k == 10 { new_float! p (prim.from_f32 (prim.load32! at)) }
    else if k == 11 { new_float! p (prim.load64! at) }
    else { ffi_answer! p k (prim.load64! at) };

let ffi_peek_at! !p !kind !address = ffi_load_at! p (untag_fix kind) (word_of_int! address);

let ffi_store_at! !p !kind !address !v = {
    let k = untag_fix kind;
    let at = word_of_int! address;
    if k == 1 { prim.store8! at (if v == true_word { 1 } else { 0 }); }
    else if k == 2 || k == 6 { prim.store8! at (ffi_word! v 0); }
    else if k == 3 || k == 7 { prim.store16! at (ffi_word! v 0); }
    else if k == 4 || k == 8 { prim.store32! at (ffi_word! v 0); }
    else if k == 10 { prim.store32! at (prim.to_f32 (float_bits! v)); }
    else if k == 11 { prim.store64! at (float_bits! v); }
    else { prim.store64! at (ffi_word! v 0); };
    unit_word
};

let ffi_read_bytes! !p !address !n = {
    let s = new_string! p (untag_fix n);
    prim.c3! "memcpy" (string_bytes s) (word_of_int! address) (untag_fix n);
    s
};

let ffi_write_bytes! !p !address !s = {
    prim.c3! "memcpy" (word_of_int! address) (string_bytes s) (string_len! s);
    unit_word
};

let ffi_read_text! !p !address = c_text! p (word_of_int! address);
let ffi_calloc! !p !n = int_of_word! p (prim.c2! "calloc" (if untag_fix n == 0 { 1 } else { untag_fix n }) 1);
let ffi_malloc! !p !n = int_of_word! p (prim.c1! "malloc" (if untag_fix n == 0 { 1 } else { untag_fix n }));
let ffi_raw_free! !p !address = {
    prim.c1! "free" (word_of_int! address);
    unit_word
};

let ffi_dlopen! !p !path =
    int_of_word! p (if path == unit_word || string_len! path == 0 { prim.c2! "dlopen" 0 258 } else { prim.c2! "dlopen" (string_bytes path) 258 });

let ffi_dlerror! !p !unit = {
    let e = prim.c0! "dlerror";
    if e == 0 { text_of! p "unknown error" } else { c_text! p e }
};

let ffi_dlsym! !p !handle !name = int_of_word! p (prim.c2! "dlsym" (word_of_int! handle) (string_bytes name));

/// A library that is a payload's bytes: a file with no name, opened through its descriptor.
/// A library carried as a payload is opened once. Each `dlopen` of a new memfd is a new copy of
/// the library with its own globals, so a function and the destructor bound to its result would
/// otherwise not be talking about the same state. A payload's index is the key.
/// Under the world's lock, so that two workers opening one payload get one copy of it.
let ffi_open_bytes! !p !text !index = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let h = ffi_open_bytes_locked! p text index;
    unlock! l;
    h
};

let ffi_open_bytes_locked! !p !text !index = {
    let found = ffi_opened! (prim.load64! (world_at! w_opened)) index;
    if found != 0 { int_of_word! p found } else {
        let fd = prim.sext32 (prim.c2! "memfd_create" (string_bytes (text_of! p "library")) 0);
        if fd < 0 { tag_fix 0 } else {
            prim.c3! "write" fd (string_bytes text) (string_len! text);
            let path = concat2! p (text_of! p "/proc/self/fd/") (int_to_string! p (tag_fix fd));
            let h = prim.c2! "dlopen" (string_bytes path) 258;
            if h != 0 {
                let cell = prim.c1! "malloc" (3 * word);
                prim.store64! cell index;
                prim.store64! (cell + word) h;
                prim.store64! (cell + 2 * word) (prim.load64! (world_at! w_opened));
                prim.store64! (world_at! w_opened) cell;
            };
            int_of_word! p h
        }
    }
};

let ffi_opened! !cell !index =
    if cell == 0 { 0 }
    else if prim.load64! cell == index { prim.load64! (cell + word) }
    else { ffi_opened! (prim.load64! (cell + 2 * word)) index };

/// A destructor, called with what it is to destroy; what it answers is nobody's concern.
let ffi_destroy! !p !dtor !ptr = {
    if word_of_int! dtor != 0 { prim.ptr1! (word_of_int! dtor) (word_of_int! ptr); };
    unit_word
};

/// What a process owned, destroyed when it ends: newest first, because what is made from a thing
/// is newer than it and must go before it. Nothing here forces, and the fields were forced when
/// the handle was made (`ffi_adopt!`). The ids are taken under the lock, and each is destroyed
/// and dropped after, as a destructor is C and may take its time.
let release_owned! !p !owner = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let n = owned_total! (prim.load64! (world_at! w_foreign_head)) owner 0;
    let table = if n == 0 { 0 } else { prim.c1! "malloc" (word * n) };
    if n > 0 { owned_ids! (prim.load64! (world_at! w_foreign_tail)) owner table 0; };
    unlock! l;
    if n > 0 {
        release_each! p table 0 n;
        prim.c1! "free" table;
    };
    0
};

let owned_total! !entry !owner !n = if entry == 0 { n }
    else { owned_total! (prim.load64! (entry + fe_next)) owner (if prim.load64! (entry + fe_fields) == owner { n + 1 } else { n }) };

/// Newest first, from the tail.
let owned_ids! !entry !owner !t !i = if entry == 0 { 0 }
    else if prim.load64! (entry + fe_fields) == owner {
        prim.store64! (t + i * word) (prim.load64! (entry + fe_id));
        owned_ids! (prim.load64! (entry + fe_prev)) owner t (i + 1)
    } else { owned_ids! (prim.load64! (entry + fe_prev)) owner t i };

let release_each! !p !t !i !n = if i >= n { 0 } else {
    let id = prim.load64! (t + i * word);
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let entry = foreign_entry! id;
    let dtor = if entry == 0 { 0 } else { prim.load64! (entry + fe_fields + 3 * word) };
    let ptr = if entry == 0 { 0 } else { prim.load64! (entry + fe_fields + 2 * word) };
    unlock! l;
    if entry != 0 { ffi_destroy! p dtor ptr; foreign_drop! p id; };
    release_each! p t (i + 1) n
};

// --- large data ----------------------------------------------------------------------------------

/// How many data the program was built with.
let data_count! !p !unit = tag_fix (prim.load64! (prim.info "payload_table"));

/// One, as a string. The VM hands out a view of the mapped file; here it is copied, once per
/// ask, which costs what its size costs and is the same bytes.
let data_at! !p !i = {
    let n = prim.load64! (prim.info "payload_table");
    let k = untag_fix i;
    if not (is_fix i) || k < 0 || k >= n {
        fail_value! p atom_out_of_bounds (concat2! p (concat_parts! p "no datum " (describe! p i) ": this program carries ") (int_to_string! p (tag_fix n)))
    } else {
        let t = prim.info "payload_table" + word + k * 3 * word;
        let s = new_string! p (prim.load64! (t + word));
        prim.c3! "memcpy" (string_bytes s) (prim.info "payload" + prim.load64! t) (prim.load64! (t + word));
        s
    }
};

let data_named! !p !name !i = {
    let n = prim.load64! (prim.info "payload_table");
    if i >= n { tag_fix (0 - 1) }
    else {
        let t = prim.info "payload_table" + word + i * 3 * word;
        let label = prim.load64! (t + 2 * word);
        if label != 0 && string_eq! label name { tag_fix i } else { data_named! p name (i + 1) }
    }
};

let payload_index! !p !name = {
    let found = data_named! p name 0;
    if found == tag_fix (0 - 1) { unit_word } else { found }
};

// --- C calling back -----------------------------------------------------------------------------
//
// A C function given a Dream function gets the address of a stub made for the call: load the
// callback's record, jump to `dream_cb_common` in the machine's text, which saves the argument
// registers and calls `cb_enter!`. That pushes a frame on the stack of the process that made the
// call and applies the function, and the frame's code answers C: everything until then has been
// tail calls, so returning from it returns from `cb_enter!`. A collection would move what C
// was given, so none runs until C has returned, and neither does any other process, which is
// why a callback must be pure: it cannot wait for anything. A raise is kept and raised once C
// has returned, as the VM does, and C is told zero meanwhile.

let cb_record_bytes = 40;

let callback_stub! !spec = {
    let p = prim.c1! "pthread_getspecific" (prim.load64! (world_at! w_cb_key));
    let kinds = prim.load64! (spec + 3 * word);
    let rec_ = prim.c1! "malloc" cb_record_bytes;
    prim.store64! rec_ p;
    // The function, where any worker's process that C calls back on can reach it, and no
    // collection moves it.
    let f = promote! p (prim.load64! (spec + 2 * word));
    prim.store64! (rec_ + word) f;
    // A root of the census for as long as the run: C may call it at any time.
    let l = prim.load64! (world_at! w_shared_lock);
    lock! l;
    let cell = prim.c1! "malloc" (2 * word);
    prim.store64! cell (prim.load64! (world_at! w_cb_roots));
    prim.store64! (cell + word) f;
    prim.store64! (world_at! w_cb_roots) cell;
    unlock! l;
    prim.store64! (rec_ + 2 * word) kinds;
    prim.store64! (rec_ + 3 * word) (untag_fix (prim.load64! (spec + 4 * word)));
    let code = prim.c6! "mmap" 0 4096 7 34 (0 - 1) 0;
    if prim.arch () == arch_aarch64 {
        // ldr x16, =record; ldr x17, =common; br x17; nop; then the two addresses.
        prim.store32! code 1476395152;
        prim.store32! (code + 4) 1476395185;
        prim.store32! (code + 8) 3592356384;
        prim.store32! (code + 12) 3573751839;
        prim.store64! (code + 16) rec_;
        prim.store64! (code + 24) (prim.info "cb_common");
        // Written as data, run as code: aarch64 keeps no promise between the two caches.
        prim.c1! "dream_flush_code" code;
    } else {
        // movabs r10, record; movabs r11, common; jmp r11
        prim.store8! code 73;
        prim.store8! (code + 1) 186;
        prim.store64! (code + 2) rec_;
        prim.store8! (code + 10) 73;
        prim.store8! (code + 11) 187;
        prim.store64! (code + 12) (prim.info "cb_common");
        prim.store8! (code + 20) 65;
        prim.store8! (code + 21) 255;
        prim.store8! (code + 22) 227;
    };
    code
};

/// One argument, from the saved registers: six words, then eight floating.
let cb_argument! !p !k !regs !state = {
    let ni = state & 255;
    let nd = state >> 8;
    // The saved registers: the integer ones, six on x86-64 and eight on aarch64, then eight doubles.
    let doubles = if prim.arch () == arch_aarch64 { 8 } else { 6 };
    if k == 10 { new_float! p (prim.from_f32 (prim.load64! (regs + (doubles + nd) * word))) }
    else if k == 11 { new_float! p (prim.load64! (regs + (doubles + nd) * word)) }
    else { ffi_answer! p k (prim.load64! (regs + ni * word)) }
};

let cb_args! !p !kinds !regs !i !n !state = if i >= n { nil_word } else {
    let k = untag_fix (prim.load64! (kinds + (2 + i) * word));
    let next = if k == 10 || k == 11 { state + 256 } else { state + 1 };
    new_cons! p (cb_argument! p k regs state) (cb_args! p kinds regs (i + 1) n next)
};

let cb_push! !sp !args = if args == nil_word { sp } else {
    let below = cb_push! sp (prim.load64! (args + 2 * word));
    let at = below - word;
    prim.store64! at (prim.load64! (args + word));
    at
};

let cb_enter! !rec_ !regs = {
    // The context of the worker C called back on, which must be in a call to C: a callback runs on
    // the stack of the process that made the call. From any other thread -- one the library made,
    // or a worker running something else -- it is refused without running anything and answers
    // zero, as on the VM, and the call to C raises once it returns (`w_cb_refused`).
    let mine = prim.c1! "pthread_getspecific" (prim.load64! (world_at! w_cb_key));
    if mine == 0 || prim.load64! (mine + ctx_ffi_sp) == 0 {
        prim.store_rel! (world_at! w_cb_refused) 1;
        0
    } else { cb_run! mine rec_ regs }
};

let cb_run! !p !rec_ !regs = {
    let f = prim.load64! (rec_ + word);
    let kinds = prim.load64! (rec_ + 2 * word);
    let n = untag_fix (prim.load64! (kinds + word));
    prim.store64! (p + ctx_in_callback) (prim.load64! (p + ctx_in_callback) + 1);
    let sp = prim.load64! (p + ctx_ffi_sp);
    if prim.load64! (p + ctx_cb_error) != 0 { 0 } else {
        let frame = sp - 2 * word;
        prim.store64! frame (prim.info "cb_return");
        prim.store64! (frame + word) (tag_fix (prim.load64! (rec_ + 3 * word)));
        let args = if n == 0 { new_cons! p unit_word nil_word } else { cb_args! p kinds regs 0 n 0 };
        let below = cb_push! frame args;
        apply! p below f (if n == 0 { 1 } else { n }) 0 0
    }
};

let frame_cb_return! !p !sp !v !b !c !d = {
    let k = untag_fix (prim.load64! (sp + word));
    prim.store64! (p + ctx_in_callback) (prim.load64! (p + ctx_in_callback) - 1);
    if k == 0 { 0 }
    else if k == 10 { prim.to_f32 (float_bits! v) }
    else if k == 11 { float_bits! v }
    else { ffi_word! v 0 }
};

let cb_raised! !p !sp !e !b !c !d = {
    prim.store64! (p + ctx_in_callback) (prim.load64! (p + ctx_in_callback) - 1);
    prim.store64! (p + ctx_cb_error) e;
    0
};

/// Which worker this thread is, for a callback from C to find.
let note_context! !p = {
    prim.store64! (prim.info "cb_context") p;
    prim.c2! "pthread_setspecific" (prim.load64! (world_at! w_cb_key)) p;
    0
};

// --- sorting what needs no calling out ------------------------------------------------------------
//
// A stable bottom-up merge over `[key, index]` pairs in memory of its own, for `sort_keyed`. Keys are
// words here, so a collection could not move them anyway: none can run, as nothing allocates until
// the answer is built.

let sort_key_at! !t !i = prim.load64! (t + i * 2 * word);

let text_below! !a !b = {
    let la = string_len! a;
    let lb = string_len! b;
    let c = prim.sext32 (prim.c3! "memcmp" (string_bytes a) (string_bytes b) (if la < lb { la } else { lb }));
    c < 0 || (c == 0 && la < lb)
};

/// Whether `b` goes before `a`, which is all stability lets it ask.
let sort_before! !texts !b !a = if texts { text_below! b a } else { b < a };

/// `run` is five words: whether keys are strings, the source, the destination, where the first
/// half stops and where the second does, since a dialect function has six parameters at most.
let merge_run! !run !i !j !out = {
    let texts = prim.load64! run != 0;
    let src = prim.load64! (run + word);
    let dst = prim.load64! (run + 2 * word);
    let mid = prim.load64! (run + 3 * word);
    let stop = prim.load64! (run + 4 * word);
    if i >= mid && j >= stop { 0 }
    else if i < mid && (j >= stop || not (sort_before! texts (sort_key_at! src j) (sort_key_at! src i))) {
        prim.store64! (dst + out * 2 * word) (sort_key_at! src i);
        prim.store64! (dst + out * 2 * word + word) (prim.load64! (src + i * 2 * word + word));
        merge_run! run (i + 1) j (out + 1)
    } else {
        prim.store64! (dst + out * 2 * word) (sort_key_at! src j);
        prim.store64! (dst + out * 2 * word + word) (prim.load64! (src + j * 2 * word + word));
        merge_run! run i (j + 1) (out + 1)
    }
};

let merge_width! !run !n !width !at = if at >= n { 0 } else {
    let mid = if at + width < n { at + width } else { n };
    let stop = if at + 2 * width < n { at + 2 * width } else { n };
    prim.store64! (run + 3 * word) mid;
    prim.store64! (run + 4 * word) stop;
    merge_run! run at mid at;
    merge_width! run n width stop
};

/// Which table holds the answer.
let merge_all! !run !src !dst !n !width = if width >= n { src } else {
    prim.store64! (run + word) src;
    prim.store64! (run + 2 * word) dst;
    merge_width! run n width 0;
    merge_all! run dst src n (width * 2)
};

let sort_class! !keys !i !n !fixes !texts = if i >= n { if fixes { 1 } else if texts { 2 } else { 0 } } else {
    let k = prim.load64! (keys + (2 + i) * word);
    sort_class! keys (i + 1) n (fixes && is_fix k) (texts && is_string! k)
};

let sort_fill! !keys !t !i !n = if i >= n { 0 } else {
    prim.store64! (t + i * 2 * word) (prim.load64! (keys + (2 + i) * word));
    prim.store64! (t + i * 2 * word + word) i;
    sort_fill! keys t (i + 1) n
};

let sorted_list! !p !items !t !i !tail = if i < 0 { tail } else {
    sorted_list! p items t (i - 1)
        (new_cons! p (prim.load64! (items + (2 + prim.load64! (t + i * 2 * word + word)) * word)) tail)
};

let sort_prim! !p !keys !items = {
    let n = untag_fix (prim.load64! (keys + word));
    let class = sort_class! keys 0 n true true;
    if n == 0 || class == 0 { unit_word } else {
        let a = prim.c1! "malloc" (2 * word * n);
        let b = prim.c1! "malloc" (2 * word * n);
        sort_fill! keys a 0 n;
        let run = prim.c1! "malloc" (5 * word);
        prim.store64! run (if class == 2 { 1 } else { 0 });
        let answer = merge_all! run a b n 1;
        prim.c1! "free" run;
        let out = sorted_list! p items answer (n - 1) nil_word;
        prim.c1! "free" a;
        prim.c1! "free" b;
        out
    }
};

// --- a program on a terminal of its own, and replacing this one -----------------------------------
//
// As `os_pty_spawn` in dream/src/os.cpp, in the same order and for the same reasons: the far side is
// opened here too and held until the child has run, because a reader that got in first on a master
// nobody else has open is told the session ended. The numbers are Linux's.

let tiocswinsz = 21524;
let tiocsctty = 21518;

let pty_window! !p !cols !rows = {
    let ws = scratch! p word;
    prim.store64! ws 0;
    prim.store16! ws (untag_fix rows);
    prim.store16! (ws + 2) (untag_fix cols);
    ws
};

let reset_signals! !n = if n >= 32 { 0 } else {
    prim.c2! "signal" n 0;
    reset_signals! (n + 1)
};

let report_child! !p !fd !step = {
    let e = scratch! p word;
    prim.store32! e step;
    prim.store32! (e + 4) (errno! ());
    prim.c3! "write" fd e 8;
    prim.c1! "_exit" 127
};

/// In the child, past `fork`. Each step that fails says which it was.
let pty_child! !p !master !slave !spec !report = {
    reset_signals! 1;
    if prim.sext32 (prim.c0! "setsid") < 0 { report_child! p report 0 };
    if prim.sext32 (prim.c3! "ioctl" slave tiocsctty 0) < 0 { report_child! p report 1 };
    prim.c2! "dup2" slave 0;
    prim.c2! "dup2" slave 1;
    prim.c2! "dup2" slave 2;
    if slave > 2 { prim.c1! "close" slave; };
    prim.c1! "close" master;
    let dir = prim.load64! (spec + (2 + 3) * word);
    if string_len! dir != 0 && prim.sext32 (prim.c1! "chdir" (string_bytes dir)) != 0 { report_child! p report 3 };
    let env = prim.load64! (spec + (2 + 2) * word);
    child_env! env 0 (untag_fix (prim.load64! (env + word)));
    let program = prim.load64! (spec + 2 * word);
    prim.c2! "execvp" (string_bytes program) (c_argv! p (prim.load64! (spec + (2 + 1) * word)) program);
    report_child! p report 4
};

let pty_refused! !p !program !step !code = fail_value! p (if code == 2 { prim.atom "not_found" } else if code == 13 { prim.atom "permission_denied" } else { prim.atom "io_error" })
    (concat3! p (text_of! p "cannot run `") program
        (text_of! p (if code == 2 { "`: it is not on PATH" } else if step == 3 { "`: cannot enter its directory" } else if step < 3 { "`: cannot give it its terminal" } else { "`: cannot run it" })));

/// `spec` is `[program, args, env, dir, cols, rows]`, all forced. `[handle, pid]`.
let pty_start! !p !spec = {
    let program = prim.load64! (spec + 2 * word);
    let master = prim.sext32 (prim.c1! "posix_openpt" 258);
    let name = scratch! p 128;
    if master < 0 || prim.sext32 (prim.c1! "grantpt" master) != 0 || prim.sext32 (prim.c1! "unlockpt" master) != 0
        || prim.sext32 (prim.c3! "ptsname_r" master name 128) != 0 {
        fail_value! p (prim.atom "io_error") (text_of! p "cannot open a terminal")
    } else {
        prim.c3! "fcntl" master 2 1;
        prim.c3! "ioctl" master tiocswinsz (pty_window! p (prim.load64! (spec + (2 + 4) * word)) (prim.load64! (spec + (2 + 5) * word)));
        let slave = prim.sext32 (prim.c2! "open" name (258 + 524288));
        let report = pipe_pair! p;
        let pid = prim.sext32 (prim.c0! "fork");
        if pid == 0 { pty_child! p master slave spec (prim.load32! (report + 4)) }
        else {
            prim.c1! "close" (prim.load32! (report + 4));
            let told = scratch! p word;
            let got = prim.sext32 (prim.c3! "read" (prim.load32! report) told 8);
            prim.c1! "close" (prim.load32! report);
            prim.c1! "close" slave;
            if pid < 0 { prim.c1! "close" master; fail_value! p (prim.atom "io_error") (text_of! p "cannot start a process") }
            else if got == 8 {
                prim.c3! "waitpid" pid 0 0;
                prim.c1! "close" master;
                pty_refused! p program (prim.load32! told) (prim.load32! (told + 4))
            } else {
                pty_note! p pid;
                set_nonblocking! master;
                new_cons! p (add_handle! p master kind_stream_handle) (new_cons! p (tag_fix pid) nil_word)
            }
        }
    }
};

/// Which children are terminals' programs: a pid that is not one names nothing here, and must not
/// be signalled. A list in memory of its own, as there are never many.
let pty_note! !p !pid = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let cell = prim.c1! "malloc" (2 * word);
    prim.store64! cell pid;
    prim.store64! (cell + word) (prim.load64! (world_at! w_ptys));
    prim.store64! (world_at! w_ptys) cell;
    unlock! l;
    0
};

let pty_known_in! !cell !pid = cell != 0 && (prim.load64! cell == pid || pty_known_in! (prim.load64! (cell + word)) pid);

/// Under the world's lock, as another worker may be forgetting one.
let pty_known! !cell_ !pid = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    let known = pty_known_in! (prim.load64! (world_at! w_ptys)) pid;
    unlock! l;
    known
};

let pty_drop! !pid = {
    let l = prim.load64! (world_at! w_lock);
    lock! l;
    pty_forget! (world_at! w_ptys) (prim.load64! (world_at! w_ptys)) pid;
    unlock! l;
    0
};

let pty_forget! !link !cell !pid = if cell == 0 { 0 }
    else if prim.load64! cell == pid {
        prim.store64! link (prim.load64! (cell + word));
        prim.c1! "free" cell;
        0
    } else { pty_forget! (cell + word) (prim.load64! (cell + word)) pid };

let pty_unknown! !p = fail_value! p (prim.atom "not_found") (text_of! p "no terminal's program has this pid");

let pty_resize! !p !h !cols !rows = {
    let fd = fd_of! p h;
    if fd < 0 { fail_value! p (prim.atom "io_closed") (text_of! p "this terminal is closed") }
    else {
        prim.c3! "ioctl" fd tiocswinsz (pty_window! p cols rows);
        unit_word
    }
};

let pty_status! !p !pid = {
    let id = untag_fix pid;
    if not (pty_known! (prim.load64! (world_at! w_ptys)) id) { pty_unknown! p } else {
        let buf = scratch! p word;
        let got = prim.sext32 (prim.c3! "waitpid" id buf 1);
        if got == 0 { unit_word } else {
            pty_drop! id;
            let status = prim.load32! buf;
            if got < 0 { tag_fix (0 - 1) }
            else if status & 127 != 0 { tag_fix (0 - (status & 127)) }
            else { tag_fix ((status >> 8) & 255) }
        }
    }
};

let signal_number! !name =
    if name == prim.atom "hangup" { 1 } else if name == prim.atom "interrupt" { 2 } else if name == prim.atom "quit" { 3 }
    else if name == prim.atom "kill" { 9 } else if name == prim.atom "terminate" { 15 }
    else if name == prim.atom "continue" { 18 } else if name == prim.atom "stop" { 19 } else { 0 };

let pty_signal! !p !pid !name = {
    let id = untag_fix pid;
    let n = signal_number! name;
    if not (pty_known! (prim.load64! (world_at! w_ptys)) id) { pty_unknown! p }
    else if n == 0 { fail_value! p (prim.atom "bad_argument") (text_of! p "that is not a signal pty_signal! sends") }
    else {
        // The whole session's process group, as closing a terminal's window does.
        if prim.sext32 (prim.c2! "kill" (0 - id) n) != 0 { prim.c2! "kill" id n; };
        unit_word
    }
};

let pty_foreground! !p !h = {
    let fd = fd_of! p h;
    if fd < 0 { fail_value! p (prim.atom "io_closed") (text_of! p "this terminal is closed") }
    else {
        let group = prim.sext32 (prim.c1! "tcgetpgrp" fd);
        if group > 0 { tag_fix group } else { unit_word }
    }
};

/// `os.replace!`: the arguments are an array of strings, and only a failure comes back.
let replace_start! !p !program !args = {
    prim.c2! "execvp" (string_bytes program) (c_argv! p args program);
    fail_path! p "replace" program
};
