// Stylesheets written in Dream.
//
//     import std.graphics.css;
//
//     let styles = [
//         css.vars %{ "--accent" => "#5b5bd6" },
//         css.rule ".card" %{ "padding" => "1rem", "border-radius" => "8px" },
//         css.rule ".card:hover" %{ "outline" => "2px solid var(--accent)" },
//         css.media "(max-width: 600px)" [css.rule ".card" %{ "padding" => "0.5rem" }],
//     ];
//     let app = ui.App.new () |> ui.App.set_styles styles |> ..;
//
// A rule is its text, so a stylesheet is a list of strings and anything here
// is an ordinary value: a theme is a function from colours to rules, and a
// component's styles live beside its view. The page installs the program's
// stylesheet once, as a `<style>` of its own. Declarations in a map are
// written in key order; where order matters -- a shorthand and then one of
// its longhands -- `rule_in_order` takes them as pairs.
//
// This is the program's own CSS, so it may do anything CSS does, `url()`
// included (an image the application ships is at its own path). Inline styles
// (`html.style`) are values a view computes from data and are held to less:
// the page refuses `url()` and `@import` in one. A file of CSS written by hand
// is `build.py --css`, linked before this, so these rules win a tie.
import std.list;
import std.map;
import std.str;

/// `selector { name: value; .. }`.
let rule : :string -> %{:string => :string} -> :string;
let rule selector declarations = rule_in_order selector (map.sorted_pairs declarations);

let rule_in_order : :string -> [[:string]] -> :string;
let rule_in_order selector pairs = selector + " { " + declare pairs + "}";

/// Custom properties on `:root`, for the rest to read with `var(--name)`.
let vars : %{:string => :string} -> :string;
let vars values = rule ":root" values;

/// `@media query { rules }`.
let media : :string -> [:string] -> :string;
let media query rules = "@media " + query + " {\n" + sheet rules + "\n}";

/// `@keyframes name { stop { .. } .. }`, each stop a `["from" | "50%" | "to", declarations]`.
let keyframes : :string -> [[:any]] -> :string;
let keyframes name stops = "@keyframes " + name + " {\n"
    + str.join_str "\n" (list.map (fn s -> match s { [at, ds] => rule at ds }) stops) + "\n}";

/// `@font-face { .. }`, for a font the application ships (`build.py --asset`).
let font_face : %{:string => :string} -> :string;
let font_face declarations = rule "@font-face" declarations;

/// Text as written, for whatever has no function here.
let raw : :string -> :string;
let raw text = text;

/// Rules as one stylesheet.
let sheet : [:string] -> :string;
let sheet rules = str.join_str "\n" rules;

priv let declare pairs = str.concat_all (list.map (fn pair -> match pair {
    [name, value] => name + ": " + value + "; ",
}) pairs);

// --- values ------------------------------------------------------------------

let px : :any -> :string;
let px n = to_string n + "px";
let rem : :any -> :string;
let rem n = to_string n + "rem";
let em : :any -> :string;
let em n = to_string n + "em";
let pct : :any -> :string;
let pct n = to_string n + "%";
let rgb : :integer -> :integer -> :integer -> :string;
let rgb r g b = "rgb(" + to_string r + " " + to_string g + " " + to_string b + ")";
/// `alpha` from 0.0 to 1.0.
let rgba : :integer -> :integer -> :integer -> :float -> :string;
let rgba r g b alpha = "rgb(" + to_string r + " " + to_string g + " " + to_string b + " / " + to_string alpha + ")";
/// Hue in degrees, saturation and lightness in percent.
let hsl : :any -> :any -> :any -> :string;
let hsl h s l = "hsl(" + to_string h + " " + to_string s + "% " + to_string l + "%)";

when test {
    import std.test;
    let tests = [
        test.case "a rule is its text" $(test.eq! ".a { color: red; margin: 0; }"
            (rule ".a" %{ "margin" => "0", "color" => "red" })),
        test.case "order kept where it matters" $(test.eq! "p { margin: 0; margin-top: 1rem; }"
            (rule_in_order "p" [["margin", "0"], ["margin-top", "1rem"]])),
        test.case "media and keyframes nest rules" $({
            test.eq! "@media (max-width: 600px) {\n.a { gap: 1px; }\n}" (media "(max-width: 600px)" [rule ".a" %{"gap" => px 1}])
            test.eq! "@keyframes spin {\nfrom { rotate: 0deg; }\nto { rotate: 360deg; }\n}"
                (keyframes "spin" [["from", %{"rotate" => "0deg"}], ["to", %{"rotate" => "360deg"}]])
        }),
        test.case "colours" $(test.eq! ["rgb(1 2 3)", "hsl(200 50% 40%)"] [rgb 1 2 3, hsl 200 50 40])
    ];
}
