// Payloads: the files an image carries.
//
// `dreams --payload [NAME=]FILE` puts a file's bytes in the image, and these
// read them back in the order they were given. A payload is answered as a big
// string -- a view of the bytes where the image was mapped, copied nowhere --
// which `str.byte`, `str.slice`, `str.span` and `str.upto` read but nothing
// that would decode it does. `std.foreign` is the main reader: it is how a C
// library carried this way is found (`foreign.embedded`).

import std.ffi;
import std.list;
import std.str;

/// How many payloads the image carries.
let count : :unit -> :integer;
let count u = _data_count u;

/// The `i`th payload, counting from 0.
let at : :integer -> :bigstr;
let at i = _data_at i;

/// Which payload is called `name` -- the name `--payload NAME=FILE` or a
/// manifest's `[payload]` gave it -- or `none` when none is.
let index : :string -> Option :integer;
let index name = Option.of (ffi.payload_index name);

/// The payload called `name`, or `none` when the image carries none by that
/// name. How a program reads a file its manifest lists:
/// `[payload] logo = "assets/logo.png"` is `payload.named "logo"`.
let named : :string -> Option :bigstr;
let named name = Option.map (fn i -> _data_at i) (index name);

/// The payload called `name` copied into an ordinary string, or `none` when
/// there is none: what a small data file -- a template, a table, a config --
/// is read as, so that `+`, `str.find` and printing work on it. A copy, a
/// byte at a time, so it is for kilobytes; a large payload is read where it
/// lies, through `named` and `str.slice`, `str.byte` and `io.write!`.
let text : :string -> Option :string;
let text name = Option.map (fn b -> str.of_bytes (map (fn i -> str.byte i b) (list.range 0 (len b)))) (named name);

/// The licences the program carries: those of its package and of every
/// package it was built from, each under a line naming the package and the
/// file, as a release build made by `mind` gathers them; or `none` when it was
/// built without them. What a program's `--licenses` prints.
let licenses : :unit -> Option :string;
let licenses u = text "licenses";

when test {
    import std.test;

    let tests = [
        test.case "an image built for tests carries none" $( test.eq! 0 (count ()) ),
        test.case "nothing is found by a name it does not carry" $( test.eq! [Option.none, Option.none, Option.none] [index "logo", named "logo", text "logo"] ),
    ];
}
