// Every builtin as a value, at the position that is its ID: what a program that
// runs images rather than compiling them needs to give a `builtin` node its
// meaning (dre, the VM written in Dream). The list is the compiler's, in
// dreams/src/builtins.dr, and its order is the runtime's: append-only, which is
// why this is a table by position and why a name is never removed from it.
//
// `defer!` is not a function the language lets be named as a value -- it is
// syntax around one -- and stands here as `()`, for a reader to handle itself.
//
// An action rather than a value because half of these are impure, and naming
// an impure function is itself an effect a pure value may not have.

/// The builtins, by ID.
let table! : :array;
let table! = #[
    spawn!,
    join!,
    send!,
    recv!,
    self!,
    raise!,
    type_of,
    to_string,
    len,
    strict!,
    _match_is_cons,
    _match_head,
    _match_tail,
    _match_at,
    _match_key,
    type_assert,
    _list_tail,
    _list_cons,
    _list_is_empty,
    _str_chars,
    _str_of_chars,
    _str_of_bytes,
    _str_concat,
    _error_new,
    _error_kind,
    _error_payload,
    _str_slice,
    _str_find,
    _str_byte,
    _str_le,
    _str_span,
    _str_upto,
    _char_code,
    _char_of_code,
    _to_float,
    _float_bytes,
    _float_of_bytes,
    _to_int,
    _parse_int,
    _parse_float,
    _to_existing_atom,
    _array_new,
    _array_of_list,
    _array_to_list,
    _map_has,
    _map_remove,
    _map_pairs,
    _data_count,
    _data_at,
    compare,
    _sort_keyed,
    _tensor_matmul,
    _str_interp,
    _mailbox_peek!,
    _mailbox_take!,
    _await_message!,
    _deadline_in!,
    _match_fail,
    _error_trace!,
    _tensor_of_bytes,
    _record_is,
    _record_id,
    _record_fields,
    _record_of,
    _pow,
    _str_char_count,
    _str_ascii_case,
    _str_span_back,
    _str_rfind,
    _settled,
    _forced,
    (),
    _indexed,
    _append_rev,
    _rev_onto,
    _str_append_rev,
    _set_of,
    _set_add,
    _set_lookup,
    _set_refresh,
    _memo_cells,
    _tally,
    _tally_lookup,
    _list_drop,
    _index_new,
    _index_find,
    _heap_of,
    _heap_push,
    _heap_empty,
    _heap_min,
    _heap_pop,
    _trunk_of,
    _trunk_to_list,
    _trunk_lookup,
    _trunk_at,
    _trunk_push,
    _trunk_set,
    _trunk_recall
];

/// How many there are: what a reader checks an image's IDs against.
let count : :integer;
let count = 98;
