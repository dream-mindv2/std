// Parsers: small functions over text that combine into big ones.
//
//     import std.parse as p;
//
//     // "3, 4" -> [3, 4]
//     let pair = p.succeed (fn a b -> [a, b])
//         |> p.keep p.integer
//         |> p.skip (p.symbol ",")
//         |> p.keep p.integer;
//
//     p.run pair "3, 4"              // [:ok, [3, 4]]
//     p.run pair "3; 4"              // [:error, error]: line 1, column 2: expected ","
//
//     // arithmetic, with precedence and associativity from a table
//     let rec expr = p.operators (p.lexeme p.integer |> p.or (p.parens (p.lazy (fn () -> expr))))
//         [[:left, [["+", fn a b -> a + b], ["-", fn a b -> a - b]]],
//          [:left, [["*", fn a b -> a * b], ["/", fn a b -> a / b]]],
//          [:prefix, [["-", fn a -> 0 - a]]]];
//
// **A parser is a function** from the text and a byte offset to a reply: the
// value and the offset after it, or a failure. Everything here builds such a
// function out of smaller ones, so a grammar is ordinary Dream -- named with
// `let`, recursive through `lazy`, parameterised by ordinary arguments -- and
// there is no grammar language to learn and nothing to generate. It is pure,
// so a parser runs in a pure function and under `comp`.
//
// **Offsets are bytes**, as everywhere strings are concerned here, so a
// parser moves with `str.span` and `str.find` -- loops the runtime runs --
// rather than a character at a time. What reads a character decodes the
// UTF-8 at the offset itself, so text that is not ASCII is read as
// characters, never split.
//
// **Choice backtracks, and errors are the furthest failure.** `or` tries its
// second parser at the same offset when the first fails, however far the
// first got, so a grammar needs no lookahead annotations. What makes that
// usable is the error: every failure records how far into the text it
// happened and what was expected there, and the one reported is the one that
// got furthest, with the expectations of every alternative that failed at
// that same place merged -- `expected digit, "." or ")"`. Even a success
// carries the furthest failure it stepped around (`many digit` stopped at
// "x" because "x" is not a digit), so the parser after it can say so.
//
// **Pipelines read as the grammar.** `succeed f |> keep a |> skip b |> keep
// c` applies `f` to what `a` and `c` produced, checking `b` between them, in
// the order the text has them. It is Elm's parser idiom, and in Dream it is
// just currying and `|>`.

import std.char;
import std.list;
import std.map;
import std.num;
import std.str;

// --- replies -----------------------------------------------------------------------

/// The furthest place something failed, and what would have done instead:
/// each expectation a string (`"digit"`, `"\")\""`) or `[:message, text]`
/// from `fail`.
struct Problem {
    at : :integer
    expected : [:any]
}

/// What a parser answers: the value, the offset after it, and the furthest
/// failure stepped around on the way (or `()`); or why it failed.
///
/// A union, and not the tagged arrays it was: a parser matches a reply at
/// every step it takes, and a variant is told apart by its record's identity
/// and its fields read where they lie, where an array's shape was a type
/// test, a length, a comparison of its first element and a suspension per
/// name bound -- most of what a large parse had been spending.
union Reply a {
    ok(value : a, next : :integer, problem)
    fail(problem : Problem)
}

/// A parser: the text and the byte offset to start at, to a reply.
type Parser a = :string -> :integer -> Reply a;

/// Construct a successful parser reply with its value, ending offset and accumulated
/// problem.
priv let ok : a -> :integer -> Problem | :unit -> Reply a;
priv let ok value !at !problem =
    if problem == () { (Reply.ok value at ()) } else { match ahead problem at { kept => (Reply.ok value at kept) } };

/// What of a problem a success ending at `next` still has to carry. Once a
/// parse has got to `next`, any failure it can still report is at `next` or
/// further on, and the furthest is the one reported -- so a problem short of
/// `next` can never be it, and is dropped where the success is made rather
/// than merged, step after step, all the way up. Most steps then carry none,
/// which is most of what a parse of a large document had been spending.
priv let ahead : Problem | :unit -> :integer -> Problem | :unit;
priv let ahead problem next = match problem { Problem(where, _) if where >= next => problem, _ => () };

/// Construct a failed parser reply at a byte offset with an expected value.
priv let fail_at : :integer -> :any -> Reply :any;
priv let fail_at at expected = (Reply.fail (Problem.make at [expected]));

/// A failure with a problem already made. Every reply is built strictly: a
/// suspended value or problem would be a suspension per step of every parse,
/// each holding its frame, and the result a tree of them -- which is what a
/// parse of a large document spent most of its time and memory on.
priv let failed : Problem -> Reply :any;
priv let failed problem = (Reply.fail problem);

/// The furthest of two problems, merging what they expected when they are
/// equally far. A failure always has a problem, so where the second is a
/// failure's the answer is one too -- which is what lets a `Reply.fail` built
/// from it be a `Reply`.
priv let furthest : Problem | :unit -> Problem -> Problem;
priv let furthest a b = match [a, b] {
    [(), _] => b,
    [Problem(ia, ea), Problem(ib, eb)] =>
        if ia > ib { (Problem.make ia ea) } else if ib > ia { b } else { (Problem.make ia (ea + list.filter (fn e -> not (list.contains e ea)) eb)) },
};

/// The same where either may be missing, as a success's may.
priv let merge : Problem | :unit -> Problem | :unit -> Problem | :unit;
priv let merge a b = if b == () { a } else if a == () { b } else { furthest a b };

/// Extract the furthest problem recorded in a parser reply.
priv let reply_problem : Reply :any -> Problem | :unit;
priv let reply_problem r = match r { Reply.ok(_, _, p) => p, Reply.fail(p) => p };

// --- running ------------------------------------------------------------------------

/// What a failed parse says: where, and what it wanted.
mapping Error {
    offset : :integer
    line : :integer
    column : :integer
    expected : [:string]
    found : :string
    message : :string
}

/// `[:ok, value]` when the parser reads the whole text, or `[:error, Error]`
/// saying where and why it did not.
let run : Parser a -> :string -> Result a :map;
let run parser text = match (skip end parser) text 0 {
    Reply.ok(v, _, _) => Result.ok v,
    Reply.fail(problem) => Result.error (error_of text problem),
};

/// `run`, with the error as a message: `line 2, column 5: expected digit,
/// found "x"`.
let run_text : Parser a -> :string -> Result a :string;
let run_text parser text = map_error describe (run parser text);

/// The value and the offset after it, without requiring the parser to read
/// everything: `[:ok, [value, next]]`.
let run_prefix : Parser a -> :string -> :integer -> Result [a, :integer] :map;
let run_prefix parser text at = match parser text at {
    Reply.ok(v, next, _) => Result.ok [v, next],
    Reply.fail(problem) => Result.error (error_of text problem),
};

/// Whether the parser reads the whole text.
let matches : Parser :any -> :string -> :bool;
let matches parser text = Result.is_ok (run parser text);

/// Add source line, column and context to a parser problem.
priv let error_of : :string -> Problem -> :map;
priv let error_of text problem = {
    let Problem(at, expectations) = problem;
    let [line, column] = line_col text at;
    let messages = list.filter (fn e -> type_of e == :list) expectations;
    let wanted = list.unique (list.filter (fn e -> type_of e == :string) expectations);
    let found = if at >= len text { "the end of the text" } else { quote (char_text text at) };
    let message = match messages {
        [[_, m], .._] => m,
        [] => "expected " + one_of_text wanted + ", found " + found,
    };
    Error.make at line column wanted found message
};

/// Format alternative expected tokens for a diagnostic.
priv let one_of_text : [:string] -> :string;
priv let one_of_text names = match names {
    [] => "something else",
    [a] => a,
    [a, b] => a + " or " + b,
    _ => str.join_str ", " (list.take (list.length names - 1) names) + " or " + list.last names,
};

/// `line N, column M: message`.
let describe : :map -> :string;
let describe e = "line " + to_string (Error.line e) + ", column " + to_string (Error.column e) + ": " + Error.message e;

/// The message with the line it happened on and a caret under the place:
///
///     line 1, column 9: expected digit, found "x"
///       1 | (1 + 2 * x)
///         |         ^
let explain : :map -> :string -> :string;
let explain e text = {
    let at = Error.offset e;
    let start = line_start text at;
    let stop = str.upto "\n" at text;
    let gutter = to_string (Error.line e);
    let pad = str.repeat (len gutter) " ";
    describe e + "\n  " + gutter + " | " + str.slice start (stop - start) text + "\n  " + pad + " | "
        + str.repeat (Error.column e - 1) " " + "^"
};

/// The 1-based line and column (in characters) of a byte offset.
let line_col : :string -> :integer -> [:integer, :integer];
let line_col text at = {
    let rec count_lines i !n = { let nl = str.find_from i "\n" text; if nl < 0 || nl >= at { n } else { count_lines (nl + 1) (n + 1) } };
    let start = line_start text at;
    [count_lines 0 1, str.length (str.slice start (at - start) text) + 1]
};

/// Find the byte offset of the start of the line containing an offset.
priv let line_start : :string -> :integer -> :integer;
priv let rec line_start text at =
    if at <= 0 { 0 } else if str.byte (at - 1) text == 10 { at } else { line_start text (at - 1) };

/// Quote a token for use in a parser diagnostic.
priv let quote : :string -> :string;
priv let quote s = match s { "\n" => "a line break", "\t" => "a tab", "\"" => "'\"'", _ => "\"" + s + "\"" };

// --- characters ------------------------------------------------------------------------

/// The character at byte `at` and its width in bytes, decoded from the UTF-8
/// there: `[char, width]`, or `()` at the end. A malformed byte reads as
/// U+FFFD, one byte wide, so a parser can step past it.
let char_at : :string -> :integer -> :any;
let char_at s at = {
    let b0 = str.byte at s;
    let cont k = str.byte (at + k) s % 64;
    if b0 < 0 { () }
    else if b0 < 128 { [char.of_code b0, 1] }
    else if b0 >= 194 && b0 < 224 { [char.of_code ((b0 - 192) * 64 + cont 1), 2] }
    else if b0 >= 224 && b0 < 240 { decoded ((b0 - 224) * 4096 + cont 1 * 64 + cont 2) 3 }
    else if b0 >= 240 && b0 < 245 { decoded ((b0 - 240) * 262144 + cont 1 * 4096 + cont 2 * 64 + cont 3) 4 }
    else { ['\u{FFFD}', 1] }
};

/// Pair a decoded Unicode code point with the offset after it.
priv let decoded : :integer -> :integer -> [:any, :integer];
priv let decoded code width =
    if (code >= 55296 && code <= 57343) || code > 1114111 { ['\u{FFFD}', 1] } else { [char.of_code code, width] };

/// Convert a Unicode character to a one-character string.
priv let char_text : :string -> :integer -> :string;
priv let char_text s at = match char_at s at { () => "", [c, w] => str.slice at w s };

/// One character that `ok` accepts, called `name` in an error.
let satisfy : :string -> (:char -> :bool) -> Parser :char;
let satisfy name accept s at = match char_at s at {
    [c, w] if accept c => ok c (at + w) (),
    _ => fail_at at name,
};

/// Exactly this character. An ASCII one is a byte compared where it stands,
/// with no decoding: a grammar's punctuation is read as often as anything.
let char : :char -> Parser :char;
let char c s at = {
    let code = char.code c;
    if code < 128 {
        if str.byte at s == code { ok c (at + 1) () } else { fail_at at (quote (str.of_chars [c])) }
    } else { satisfy (quote (str.of_chars [c])) (fn d -> d == c) s at }
};

/// Any one character.
let any_char : Parser :char;
let any_char s at = satisfy "any character" (fn c -> true) s at;

/// One character from `set`.
let char_in : :string -> Parser :char;
let char_in set s at = satisfy ("one of " + quote set) (fn c -> str.contains c set) s at;

/// One character not in `set`.
let char_not_in : :string -> Parser :char;
let char_not_in set s at = satisfy ("anything but " + quote set) (fn c -> not (str.contains c set)) s at;

/// Parse one ASCII digit.
let digit : Parser :char;
let digit s at = satisfy "digit" char.is_digit s at;

/// Parse one letter accepted by `is_letter`.
let letter : Parser :char;
let letter s at = satisfy "letter" is_letter s at;

/// Test whether a character is an ASCII letter.
priv let is_letter : :char -> :bool;
priv let is_letter c = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || char.code c >= 128;

// --- text --------------------------------------------------------------------------------

/// Exactly this text.
let text : :string -> Parser :string;
let text t s at = if str.slice at (len t) s == t { ok t (at + len t) () } else { fail_at at (quote t) };

/// This text in any ASCII case; answers it as written in the input.
let text_ci : :string -> Parser :string;
let text_ci t s at = {
    let got = str.slice at (len t) s;
    if str.lower got == str.lower t { ok got (at + len t) () } else { fail_at at (quote t) }
};

/// The longest run, possibly empty, of bytes from `set` -- `span " \t"` --
/// done by the runtime in one step. For ASCII sets.
let span : :string -> Parser :string;
let span set s at = { let stop = str.span set at s; ok (str.slice at (stop - at) s) stop () };

/// The same, but at least one byte, called `name` when there is none.
let span1 : :string -> :string -> Parser :string;
let span1 name set s at = {
    let stop = str.span set at s;
    if stop == at { fail_at at name } else { ok (str.slice at (stop - at) s) stop (Problem.make stop [name]) }
};

/// The characters, possibly none, that `keep` accepts.
let take_while : (:char -> :bool) -> Parser :string;
let take_while keep s at = { let stop = while_chars keep s at; ok (str.slice at (stop - at) s) stop () };

/// At least one character that `keep` accepts.
let take_while1 : :string -> (:char -> :bool) -> Parser :string;
let take_while1 name keep s at = {
    let stop = while_chars keep s at;
    if stop == at { fail_at at name } else { ok (str.slice at (stop - at) s) stop (Problem.make stop [name]) }
};

/// Advance a byte offset while decoded characters satisfy a predicate.
priv let while_chars : (:char -> :bool) -> :string -> :integer -> :integer;
priv let rec while_chars keep s at = match char_at s at {
    [c, w] if keep c => while_chars keep s (at + w),
    _ => at,
};

/// Everything up to `delimiter`, which is not consumed; fails when it never
/// comes.
let until : :string -> Parser :string;
let until delimiter s at = {
    let found = str.find_from at delimiter s;
    if found < 0 { fail_at (len s) (quote delimiter) } else { ok (str.slice at (found - at) s) found () }
};

/// Everything up to the end of the line, not including the line break.
let rest_of_line : Parser :string;
let rest_of_line s at = { let stop = str.upto "\n" at s; ok (str.slice at (stop - at) s) stop () };

/// Everything that is left.
let rest : Parser :string;
let rest s at = ok (str.slice at (len s - at) s) (len s) ();

/// The end of the text.
let end : Parser :unit;
let end s at = if at >= len s { ok () at () } else { fail_at at "the end of the text" };

/// The current byte offset, consuming nothing.
let position : Parser :integer;
let position s at = ok at at ();

// --- the usual tokens -------------------------------------------------------------------------

/// Zero or more spaces, tabs and line breaks.
let spaces : Parser :string;
let spaces s at = span " \t\r\n" s at;

/// At least one.
let spaces1 : Parser :string;
let spaces1 s at = span1 "white space" " \t\r\n" s at;

/// `\n` or `\r\n`.
let newline : Parser :string;
let newline s at = or (text "\r\n") (text "\n") s at |> relabel at "a line break";

/// Decimal digits, as written.
let digits : Parser :string;
let digits s at = span1 "digit" "0123456789" s at;

/// A decimal integer, with an optional sign.
let integer : Parser :integer;
let integer s at = {
    let b = str.byte at s;
    let from = if b == 45 || b == 43 { at + 1 } else { at };
    let stop = str.span "0123456789" from s;
    if stop == from { fail_at at "an integer" }
    else {
        let n = whole_number (str.slice from (stop - from) s);
        ok (if b == 45 { 0 - n } else { n }) stop (Problem.make stop ["digit"])
    }
};

/// A non-negative decimal integer, no sign.
let natural : Parser :integer;
let natural s at = {
    let stop = str.span "0123456789" at s;
    if stop == at { fail_at at "a number" } else { ok (whole_number (str.slice at (stop - at) s)) stop (Problem.make stop ["digit"]) }
};

/// A number as JSON writes one -- sign, digits, fraction, exponent -- as an
/// integer when it has neither fraction nor exponent, otherwise a float. As
/// in JSON, a number does not begin with `0` unless it is `0`: `012` reads
/// as `0`, and whatever follows it is the next parser's to refuse.
let number : Parser (:integer | :float) ;
let number s at = {
    let b = str.byte at s;
    let from = if b == 45 { at + 1 } else { at };
    let int_end = if str.byte from s == 48 { from + 1 } else { str.span "0123456789" from s };
    if int_end == from { fail_at at "a number" }
    else {
        let frac_end = if str.byte int_end s == 46 && str.span "0123456789" (int_end + 1) s > int_end + 1 {
            str.span "0123456789" (int_end + 1) s } else { int_end };
        let e = str.byte frac_end s;
        let exp_end = if e == 101 || e == 69 {
            let sb = str.byte (frac_end + 1) s;
            let digits_from = if sb == 43 || sb == 45 { frac_end + 2 } else { frac_end + 1 };
            let de = str.span "0123456789" digits_from s;
            if de > digits_from { de } else { frac_end }
        } else { frac_end };
        let written = str.slice at (exp_end - at) s;
        if exp_end == int_end { ok (whole_number written) exp_end (Problem.make exp_end ["digit"]) }
        else { ok (match num.parse_float written { () => 0.0, f => f }) exp_end () }
    }
};

/// Digits already checked to be digits, as their value.
priv let whole_number : :string -> :integer;
priv let whole_number written = match num.parse_int written { () => 0, n => n };

/// A name as most languages write one: a letter or `_`, then letters,
/// digits and `_`.
let identifier : Parser :string;
let identifier s at = match char_at s at {
    [c, w] if is_letter c || c == '_' => {
        let stop = while_chars (fn d -> is_letter d || char.is_digit d || d == '_') s (at + w);
        ok (str.slice at (stop - at) s) stop ()
    },
    _ => fail_at at "a name",
};

/// A string in double quotes with JSON's escapes (`\n`, `\"`, `\\`, `é`),
/// answering what it spells. A character beyond the first 65536 is escaped
/// as two halves, `\ud83d\ude00`, which are joined; a half with no partner
/// becomes U+FFFD, as malformed UTF-8 does, rather than failing the text.
let quoted : Parser :string;
let quoted s at =
    if str.byte at s != 34 { fail_at at "a quoted string" }
    else { quoted_body s (at + 1) [] };

/// Parse the body of a quoted string, collecting decoded pieces.
priv let quoted_body : :string -> :integer -> [:string] -> Reply :string;
priv let rec quoted_body s at acc = {
    let stop = str.upto "\"\\" at s;
    let piece = str.slice at (stop - at) s;
    if stop >= len s { fail_at stop "a closing quote" }
    else if str.byte stop s == 34 { ok (str.concat_all (list.reverse (piece :: acc))) (stop + 1) () }
    else {
        let e = str.byte (stop + 1) s;
        let simple = match e { 110 => "\n", 116 => "\t", 114 => "\r", 98 => "\u{8}", 102 => "\u{c}",
                               34 => "\"", 92 => "\\", 47 => "/", _ => () };
        if simple != () { quoted_body s (stop + 2) (simple :: piece :: acc) }
        else if e == 117 {
            match hex_value (str.slice (stop + 2) 4 s) {
                () => fail_at (stop + 2) "four hex digits",
                code => {
                    let [c, after] = escaped_char s code (stop + 6);
                    quoted_body s after (str.of_chars [c] :: piece :: acc)
                },
            }
        } else { fail_at (stop + 1) "an escape" }
    }
};

/// The character a `\u` escape of `code` stands for, and the offset after it:
/// a high surrogate is joined with the low one escaped right after it, and a
/// half on its own -- `char.of_code` refuses one -- is U+FFFD.
priv let escaped_char : :string -> :integer -> :integer -> [:char, :integer];
priv let escaped_char s code at =
    if code < 55296 || code > 57343 { [char.of_code code, at] }
    else if code > 56319 || str.slice at 2 s != "\\u" { ['\u{FFFD}', at] }
    else {
        match hex_value (str.slice (at + 2) 4 s) {
            low if low != () && low >= 56320 && low <= 57343 =>
                [char.of_code (65536 + (code - 55296) * 1024 + (low - 56320)), at + 6],
            _ => ['\u{FFFD}', at],
        }
    };

/// Decode hexadecimal text, returning `()` for an invalid digit.
priv let hex_value : :string -> :any;
priv let hex_value h =
    if len h != 4 || str.span "0123456789abcdefABCDEF" 0 h != 4 { () }
    else { num.parse_base 16 h };

// --- combining --------------------------------------------------------------------------------

/// A success, for a parser written by hand: `value`, and the offset after it.
/// A parser is a function of the text and an offset, so one that is clearer
/// as a loop, or that wraps another engine (`std.regex`), answers with
/// `found` and `expected` and composes with everything here.
let found : a -> :integer -> Reply a;
let found value next = ok value next ();

/// A failure, for a parser written by hand: at `at`, `what` was expected.
let expected : :integer -> :string -> Reply :any;
let expected at what = fail_at at what;

/// Always `value`, consuming nothing.
let succeed : a -> Parser a;
let succeed value s at = ok value at ();

/// Always fails, saying `message`.
let fail : :string -> Parser :any;
let fail message s at = failed (Problem.make at [[:message, message]]);

/// `p`, with its value changed by `f`.
let map : (a -> b) -> Parser a -> Parser b;
let map f p s at = match p s at {
    Reply.ok(v, next, pr) => ok (f v) next pr,
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`, answering `value` instead: `keyword "true" |> to true`.
let to : b -> Parser a -> Parser b;
let to value p s at = map (fn _ -> value) p s at;

/// Both, in order, combined by `f`.
let map2 : (a -> b -> c) -> Parser a -> Parser b -> Parser c;
let map2 f pa pb s at = match pa s at {
    Reply.ok(a, n1, pr1) => match pb s n1 {
        Reply.ok(b, n2, pr2) => if pr1 == () && pr2 == () { ok (f a b) n2 () } else { ok (f a b) n2 (merge (ahead pr1 n2) pr2) },
        Reply.fail(pr2) => failed (furthest pr1 pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// Parse three values in order and combine them with `f`.
let map3 : (a -> b -> c -> d) -> Parser a -> Parser b -> Parser c -> Parser d;
let map3 f pa pb pc s at = map2 (fn g c -> g c) (map2 f pa pb) pc s at;

/// The pipeline's step that keeps a value: `succeed f |> keep p` is `f`
/// applied to what `p` read.
let keep : Parser a -> Parser (a -> b) -> Parser b;
let keep p pf s at = match pf s at {
    Reply.ok(f, n1, pr1) => match p s n1 {
        Reply.ok(v, n2, pr2) => if pr1 == () && pr2 == () { ok (f v) n2 () } else { ok (f v) n2 (merge (ahead pr1 n2) pr2) },
        Reply.fail(pr2) => failed (furthest pr1 pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// The pipeline's step that only checks: `p` must match here, and what it
/// read is dropped.
let skip : Parser :any -> Parser a -> Parser a;
let skip p pa s at = match pa s at {
    Reply.ok(a, n1, pr1) => match p s n1 {
        Reply.ok(_, n2, pr2) => if pr1 == () && pr2 == () { Reply.ok a n2 () } else { ok a n2 (merge (ahead pr1 n2) pr2) },
        Reply.fail(pr2) => failed (furthest pr1 pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`, then `q`, keeping what `q` read.
let then : Parser b -> Parser a -> Parser b;
let then q p s at = match p s at {
    Reply.ok(_, n1, pr1) => match q s n1 {
        Reply.ok(b, n2, pr2) => if pr1 == () && pr2 == () { Reply.ok b n2 () } else { ok b n2 (merge (ahead pr1 n2) pr2) },
        Reply.fail(pr2) => failed (furthest pr1 pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// Every parser in order, their values as a list.
let seq : [Parser :any] -> Parser [:any];
let seq ps s at = match ps {
    [] => ok [] at (),
    [p, ..rest] => map2 (fn v vs -> v :: vs) p (seq rest) s at,
};

/// A parser chosen by a value already read: `and_then (fn n -> count n
/// any_char) natural` reads a length and then that many characters.
let and_then : (a -> Parser b) -> Parser a -> Parser b;
let and_then f p s at = match p s at {
    Reply.ok(v, next, pr) => match (f v) s next {
        Reply.ok(v2, n2, pr2) => ok v2 n2 (merge pr pr2),
        Reply.fail(pr2) => failed (furthest pr pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`, or when it fails, `q` from the same place. Written to read in a
/// pipeline: `p |> or q`.
let or : Parser a -> Parser a -> Parser a;
let or q p s at = match p s at {
    Reply.fail(pr1) => match q s at {
        Reply.ok(v, next, pr2) => ok v next (merge pr1 pr2),
        Reply.fail(pr2) => failed (furthest pr1 pr2),
    },
    success => success,
};

/// The parser the next byte chooses, with nothing else tried: `choose`
/// answers one for a byte (`-1` at the end of the text), or `()` for none,
/// and then this fails expecting `name`. A grammar whose alternatives each
/// begin their own way -- JSON, most data formats -- reads as fast with it as
/// written by hand, where `choice` would try each alternative in turn.
let switch : :string -> (:integer -> (Parser a | :unit)) -> Parser a;
let switch name choose s at = match choose (str.byte at s) {
    () => fail_at at name,
    p => p s at,
};

/// The first of the parsers that matches.
let choice : [Parser a] -> Parser a;
let choice ps s at = match ps {
    [] => fail_at at "something else",
    [p] => p s at,
    [p, ..rest] => or (choice rest) p s at,
};

/// `p`, or `()` without consuming anything.
let optional : Parser a -> Parser (a | :unit);
let optional p s at = or (succeed ()) p s at;

/// `p`, or `value` without consuming anything.
let default : a -> Parser a -> Parser a;
let default value p s at = or (succeed value) p s at;

/// As many as match, possibly none. Stops without consuming when `p` would
/// match the empty text, so it cannot loop.
let many : Parser a -> Parser [a];
let many p s at = many_from p s at [] ();

/// Repeatedly apply a parser, collecting results and the furthest failure.
priv let many_from : Parser a -> :string -> :integer -> [a] -> :any -> Reply [a];
priv let rec many_from p s at !acc !pr = match p s at {
    Reply.ok(v, next, pr2) if next > at => many_from p s next (v :: acc) (merge pr pr2),
    Reply.ok(_, _, pr2) => ok (list.reverse acc) at (merge pr pr2),
    Reply.fail(pr2) => ok (list.reverse acc) at (merge pr pr2),
};

/// At least one.
let many1 : Parser a -> Parser [a];
let many1 p s at = map2 (fn v vs -> v :: vs) p (many p) s at;

/// Exactly `n`.
let count : :integer -> Parser a -> Parser [a];
let count n p s at = if n <= 0 { ok [] at () } else { map2 (fn v vs -> v :: vs) p (count (n - 1) p) s at };

/// Zero or more `p`, with `sep` between them: `sep_by (symbol ",") integer`.
let sep_by : Parser :any -> Parser a -> Parser [a];
let sep_by sep p s at = or (succeed []) (sep_by1 sep p) s at;

/// One or more `p`, with `sep` between them.
let sep_by1 : Parser :any -> Parser a -> Parser [a];
let sep_by1 sep p s at = map2 (fn v vs -> v :: vs) p (many (then p sep)) s at;

/// Zero or more `p`, each followed by `terminator`.
let end_by : Parser :any -> Parser a -> Parser [a];
let end_by terminator p s at = many (skip terminator p) s at;

/// `p` repeated until `stop` matches, which is consumed; the values of `p`.
let many_till : Parser :any -> Parser a -> Parser [a];
let many_till stop p s at = {
    let rec go at2 acc pr = match stop s at2 {
        Reply.ok(_, next, pr2) => ok (list.reverse acc) next (merge pr pr2),
        Reply.fail(pr2) => match p s at2 {
            Reply.ok(v, next, pr3) => go next (v :: acc) (merge pr (merge pr2 pr3)),
            Reply.fail(pr3) => failed (furthest pr (furthest pr2 pr3)),
        },
    };
    go at [] ()
};

/// `p` between an opening and a closing parser, keeping what `p` read.
let between : Parser :any -> Parser :any -> Parser a -> Parser a;
let between open close p s at = skip close (then p open) s at;

/// `p` in parentheses, with space allowed inside them.
let parens : Parser a -> Parser a;
let parens p s at = between (symbol "(") (symbol ")") p s at;

/// `p` in square brackets.
let brackets : Parser a -> Parser a;
let brackets p s at = between (symbol "[") (symbol "]") p s at;

/// `p` in braces.
let braces : Parser a -> Parser a;
let braces p s at = between (symbol "{") (symbol "}") p s at;

/// `p` and the white space after it: how a token is read when space between
/// tokens does not matter.
let lexeme : Parser a -> Parser a;
let lexeme p s at = skip spaces p s at;

/// This text as a token: `lexeme (text t)`.
let symbol : :string -> Parser :string;
let symbol t s at = lexeme (text t) s at;

/// This word as a token, and not the start of a longer name: `keyword "if"`
/// does not match the front of `iffy`.
let keyword : :string -> Parser :string;
let keyword w s at = lexeme (skip (not_followed_by (satisfy "letter" (fn c -> is_letter c || char.is_digit c || c == '_'))) (text w)) s at;

/// `p`, called `name` in an error when it fails where it started. A failure
/// further in is left as it is, because what went wrong there is more use
/// than the name of the thing that contained it.
let label : :string -> Parser a -> Parser a;
let label name p s at = p s at |> relabel at name;

/// Replace the expected-token label on a failure at the given offset.
priv let relabel : :integer -> :string -> Reply :any -> Reply :any;
priv let relabel at name r = match r {
    Reply.fail(Problem(where, _)) if where == at => failed (Problem.make at [name]),
    Reply.ok(v, next, Problem(where, _)) if where == at => ok v next (Problem.make at [name]),
    other => other,
};

/// `p`, forgetting what could have continued it where it stopped. A long
/// repetition that ends where anything at all could have gone on otherwise
/// reports every one of those things; after `quiet`, an error just past it
/// names only what the grammar needed next. A failure *further in* than
/// where `p` stopped -- a group left unclosed inside it -- is kept, because
/// that is the error.
let quiet : Parser a -> Parser a;
let quiet p s at = match p s at {
    Reply.ok(v, next, Problem(where, e)) if where > next => ok v next (Problem.make where e),
    Reply.ok(v, next, _) => ok v next (),
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`'s value, consuming nothing.
let lookahead : Parser a -> Parser a;
let lookahead p s at = match p s at { Reply.ok(v, _, _) => ok v at (), Reply.fail(pr) => Reply.fail pr };

/// Succeeds, consuming nothing, only where `p` does not match.
let not_followed_by : Parser :any -> Parser :unit;
let not_followed_by p s at = match p s at {
    Reply.ok(_, _, _) => fail_at at "something else",
    _ => ok () at (),
};

/// The text `p` read, instead of its value.
let capture : Parser :any -> Parser :string;
let capture p s at = match p s at {
    Reply.ok(_, next, pr) => ok (str.slice at (next - at) s) next pr,
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`'s value with the byte offsets it was read between: `[value, from, to]`.
let spanned : Parser a -> Parser [a, :integer, :integer];
let spanned p s at = match p s at {
    Reply.ok(v, next, pr) => ok [v, at, next] next pr,
    Reply.fail(pr) => (Reply.fail pr),
};

/// A parser built when it is first used, for a grammar that refers to
/// itself: `let rec value = choice [.., brackets (sep_by comma (lazy (fn ()
/// -> value)))]`.
let lazy : (:unit -> Parser a) -> Parser a;
let lazy make s at = (make ()) s at;

/// `p`, and then a check of its value: `where_ok (fn n -> n <= 255) "a byte"
/// natural` fails, saying "a byte", on 300.
let where_ok : (a -> :bool) -> :string -> Parser a -> Parser a;
let where_ok accept name p s at = match p s at {
    Reply.ok(v, next, pr) => if accept v { ok v next pr } else { fail_at at name },
    Reply.fail(pr) => (Reply.fail pr),
};

/// `p`, whose value is a result: an `[:error, message]` fails the parse
/// there with that message.
let try_map : (a -> Result b :string) -> Parser a -> Parser b;
let try_map f p s at = match p s at {
    Reply.ok(v, next, pr) => match f v {
        Result.ok(v2) => ok v2 next pr,
        Result.error(why) => failed (Problem.make at [[:message, why]]),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

// --- operators -----------------------------------------------------------------------------------

/// `p` separated by `op`, combined left to right: `1 - 2 - 3` is `(1 - 2) - 3`.
/// `op` reads an operator and answers the function that combines its two sides.
let chain_left : Parser (a -> a -> a) -> Parser a -> Parser a;
let chain_left op p s at = match p s at {
    Reply.ok(first, next, pr) => {
        let rec go acc at2 pr2 = match op s at2 {
            Reply.ok(f, n1, pr3) => match p s n1 {
                Reply.ok(v, n2, pr4) => go (f acc v) n2 (merge pr2 (merge pr3 pr4)),
                Reply.fail(pr4) => (Reply.fail (furthest pr2 (furthest pr3 pr4))),
            },
            Reply.fail(pr3) => ok acc at2 (merge pr2 pr3),
        };
        go first next pr
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// The same, combined right to left: `2 ^ 3 ^ 2` is `2 ^ (3 ^ 2)`.
let chain_right : Parser (a -> a -> a) -> Parser a -> Parser a;
let chain_right op p s at = match p s at {
    Reply.ok(first, next, pr) => match op s next {
        Reply.ok(f, n1, pr2) => match chain_right op p s n1 {
            Reply.ok(rest, n2, pr3) => ok (f first rest) n2 (merge pr (merge pr2 pr3)),
            Reply.fail(pr3) => failed (furthest pr (furthest pr2 pr3)),
        },
        Reply.fail(pr2) => ok first next (merge pr pr2),
    },
    Reply.fail(pr) => (Reply.fail pr),
};

/// An expression grammar from a table of operators, loosest first. Each row
/// is `[fixity, [[symbol, function], ..]]`, the fixity `:left`, `:right`,
/// `:prefix` or `:postfix`; the operators are read as `symbol`s, so space is
/// allowed around them, and `atom` is what they apply to -- usually a number
/// or a name, or an expression in parentheses through `lazy`.
///
///     operators atom [[:left, [["+", add], ["-", sub]]],
///                     [:left, [["*", mul]]],
///                     [:right, [["^", pow]]],
///                     [:prefix, [["-", negate]]]]
let operators : Parser a -> [[:any]] -> Parser a;
let operators atom table s at = (list.fold_right level atom table) s at;

/// Build a parser for one operator-precedence level around its operand parser.
priv let level : [:any] -> Parser :any -> Parser :any;
priv let level [fixity, ops] tighter = {
    let op = choice (list.map (fn [sym, f] -> to f (symbol sym)) (longest_first ops));
    match fixity {
        :left => chain_left op tighter,
        :right => chain_right op tighter,
        :prefix => { let rec prefixed s at = or tighter (map2 (fn f v -> f v) op prefixed) s at; prefixed },
        :postfix => map2 (fn v fs -> fold (fn acc f -> f acc) v fs) tighter (many op),
    }
};

/// Operators sharing a prefix (`<` and `<=`) must try the longer first.
priv let longest_first : [[:any]] -> [[:any]];
priv let longest_first ops = list.sort_by (fn a b -> len (b.[0]) < len (a.[0])) ops;

// --- compiling a grammar -------------------------------------------------------------------
//
// The combinators above are functions, and a parser built from them is a tree
// of closures: every step a call, every call a reply to match. That is as fast
// as a grammar that is read once in a while needs, and about half as fast as
// a hand-written reader -- the measured cost of the combinators themselves on
// a JSON document was twice the reading. `expand parse.compile p` removes it:
//
//     let value : parse.Parser :any;
//     let value = expand parse.compile (ws |> parse.then (parse.switch "a value" (fn b -> match b { .. })));
//
// The grammar is the same expression, and what the macro answers is one
// function over the text and an offset with the combinators gone: each step
// written out where it happens, continuing straight into the next, with no
// reply made between two steps that cannot fail. It reads each combinator by
// its name here, through whatever the caller imported this module as, and
// rewrites the ones defined from others (`sep_by`, `between`, `lexeme`, ..)
// into what they are defined from first, so the compiled grammar accepts,
// answers and fails exactly as the combinators do -- the same values, and the
// same errors, merged the same way. Anything it does not know -- `quoted`, a
// parser of the caller's, another rule -- is called as the parser it is, so a
// grammar is compiled one rule at a time and rules name each other as usual.
//
// A continuation needed in two places -- both sides of an `or`, every arm of
// a `switch` -- is made a local function and called from each, so the code
// grows with the grammar and not with the number of ways through it.
//
// The functions below `compiled` are what the generated code calls. They are
// public because the code is written into the caller's module, not this one,
// and are not meant to be called by hand.

/// What a compiled grammar is passed through, once, when it is defined: it
/// answers the parser as it is, and naming it means a grammar compiled
/// against a module that is not this one fails to compile rather than having
/// its `then` misread.
let compiled : Parser a -> Parser a;
let compiled p = p;

/// The byte at `at`, or `-1` past the end.
let byte_at : :string -> :integer -> :integer;
let byte_at s at = str.byte at s;

/// The offset after the run, possibly empty, of bytes from `set` at `at`.
let span_end : :string -> :integer -> :string -> :integer;
let span_end s at set = str.span set at s;

/// The text from one offset to another.
let text_between : :string -> :integer -> :integer -> :string;
let text_between s from to = str.slice from (to - from) s;

/// Whether `t` is the text at `at`.
let text_at : :string -> :integer -> :string -> :bool;
let text_at s at t = str.slice at (len t) s == t;

/// The problem carried past a step that ended at `next`: what was carried
/// before it that is still ahead, merged with the step's own.
let carry : Problem | :unit -> Problem | :unit -> :integer -> Problem | :unit;
let carry before step next = if before == () { step } else { merge (ahead before next) step };

/// Two problems merged: the furthest, or both expectations when they tie.
let merged : Problem | :unit -> Problem | :unit -> Problem | :unit;
let merged a b = merge a b;

/// A failure, with what was carried before it.
let failing : Problem | :unit -> Problem -> Reply :any;
let failing before problem = Reply.fail (furthest before problem);

/// A failure where `what` was expected at `at`, with what was carried.
let missing : Problem | :unit -> :integer -> :any -> Reply :any;
let missing before at what = failing before (Problem.make at [what]);

/// A problem: at `at`, `what` was expected.
let problem_at : :integer -> :any -> Problem;
let problem_at at what = Problem.make at [what];

/// The furthest of two problems, each possibly none.
let failing_problem : Problem | :unit -> Problem -> Problem;
let failing_problem a b = furthest a b;

/// A list built in reverse, put right.
let reversed : [a] -> [a];
let reversed xs = list.reverse xs;

/// `p`, compiled: see "compiling a grammar" above.
macro compile p = compile_grammar p;

// What follows runs while compiling: it reads syntax and writes syntax, the
// tagged lists `dreams/src/ast.dr` defines.

priv let g_span = [0, 0];
priv let g_name : :string -> :any;
priv let g_name n = [:name, n, g_span];
priv let g_call : :any -> [:any] -> :any;
priv let g_call f args = [:apply, f, args, g_span];
priv let g_int : :integer -> :any;
priv let g_int n = [:int, n, g_span];
priv let g_str : :string -> :any;
priv let g_str t = [:str, t, g_span];
priv let g_unit = [:unit, g_span];
priv let g_bin : :atom -> :any -> :any -> :any;
priv let g_bin op a b = [:binary, op, a, b, g_span];
priv let g_if : :any -> :any -> :any -> :any;
priv let g_if c a b = [:if, c, a, b, g_span];
priv let g_match : :any -> [:any] -> :any;
priv let g_match e arms = [:match, e, arms, g_span];
priv let g_arm : :any -> :any -> :any;
priv let g_arm pattern body = [pattern, (), body, g_span];
priv let g_guarded : :any -> :any -> :any -> :any;
priv let g_guarded pattern guard body = [pattern, guard, body, g_span];
priv let g_bind : :string -> :any;
priv let g_bind n = [:bind, n, g_span];
priv let g_wild = [:wildcard, g_span];
priv let g_block : [:any] -> :any;
priv let g_block stmts = [:block, stmts, g_span];
priv let g_fun : :string -> [:string] -> :any -> :bool -> :any;
priv let g_fun n params body is_rec = [:let, n, list.map (fn p -> [p, g_span]) params, body, is_rec, g_span];
priv let g_strict_fun : :string -> :string -> [:string] -> :any -> :any;
priv let g_strict_fun n first rest body =
    [:let, n, list.cons [first, g_span] (list.map (fn p -> [p, g_span, (), :strict]) rest), body, true, g_span];
priv let g_lambda : [:string] -> :any -> :any;
priv let g_lambda params body = [:lambda, list.map (fn p -> [p, g_span]) params, body, g_span];
/// `name = e` bound strictly, then `body`: a match's subject is evaluated where
/// it stands, which a `let` would suspend.
priv let g_with : :string -> :any -> :any -> :any;
priv let g_with n e body = g_match e [g_arm (g_bind n) body];

/// What generation reads and writes: the module's name in the caller, the
/// name of the text, and a path in the grammar to make names from.
mapping Gen {
    alias : :string
    text : :string
    path : :string
}

/// A member of this module as the caller names it: `alias.m`, or `m` alone
/// where the grammar names the combinators unqualified -- this module's own
/// tests, or a caller that imported them by name.
priv let member : Gen -> :string -> :any;
priv let member g m = if Gen.alias g == "" { g_name m } else { [:field, g_name (Gen.alias g), m, g_span] };
priv let helper : Gen -> :string -> [:any] -> :any;
priv let helper g m args = g_call (member g m) args;
priv let reply_ok_p : Gen -> [:any] -> :any;
priv let reply_ok_p g pats = [:record_p, [:field, member g "Reply", "ok", g_span], pats, g_span];
priv let reply_fail_p : Gen -> [:any] -> :any;
priv let reply_fail_p g pats = [:record_p, [:field, member g "Reply", "fail", g_span], pats, g_span];
priv let reply_ok : Gen -> :any -> :any -> :any -> :any;
priv let reply_ok g v n pr = g_call [:field, member g "Reply", "ok", g_span] [v, n, pr];
/// A name no caller can write, from where in the grammar it is made.
priv let fresh : Gen -> :string -> :string;
priv let fresh g label = "<parse " + Gen.path g + " " + label + ">";
priv let deeper : Gen -> :string -> Gen;
priv let deeper g step = Gen.set_path (Gen.path g + "." + step) g;

/// A problem known to be none while compiling, or the syntax of one.
priv let unit_or : :any -> :any;
priv let unit_or carried = match carried { :none => g_unit, c => c };

// --- reading the grammar --------------------------------------------------

/// The combinators this compiles, and how many arguments each takes before
/// the text and the offset.
priv let arities : %{ :string => :integer };
priv let arities = %{ "then" => 2, "skip" => 2, "keep" => 2, "map" => 2, "map2" => 3, "to" => 2,
                      "succeed" => 1, "or" => 2, "choice" => 1, "optional" => 1, "default" => 2,
                      "many" => 1, "many1" => 1, "sep_by" => 2, "sep_by1" => 2, "between" => 3,
                      "parens" => 1, "brackets" => 1, "braces" => 1, "lexeme" => 1, "symbol" => 1,
                      "char" => 1, "text" => 1, "span" => 1, "switch" => 2, "lazy" => 1, "spaces" => 0 };

/// `a |> f x` as the call it is, `f x a`, everywhere in a tree.
priv let unpipe : :any -> :any;
priv let rec unpipe e = match e {
    [:pipe, lhs, [:apply, f, args, sp], _] => [:apply, unpipe f, list.append (list.map unpipe args) [unpipe lhs], sp],
    [:pipe, lhs, f, sp] => [:apply, unpipe f, [unpipe lhs], sp],
    [:apply, f, args, sp] => [:apply, unpipe f, list.map unpipe args, sp],
    other => other,
};

/// The name the caller gave this module: the qualifier most of the
/// combinator calls in the grammar use, or `""` when they are unqualified.
priv let alias_of : :any -> :string | :unit;
priv let alias_of e = {
    let rec found t = match t {
        [:field, [:name, q, _], m, _] if map.has m arities => [q],
        items if type_of items == :list => list.flat_map found items,
        _ => [],
    };
    let rec bare t = match t {
        [:apply, [:name, m, _], _, _] if map.has m arities => true,
        [:name, "spaces", _] => true,
        items if type_of items == :list => list.any bare items,
        _ => false,
    };
    match found e {
        [] => if bare e { "" } else { () },
        qs => list.head (list.sort_on (fn q -> 0 - list.length (list.filter (fn x -> x == q) qs)) qs),
    }
};

/// The grammar in the core forms generation knows, or `[:opaque, e]` for
/// what it does not.
priv let core : :string -> :any -> :any;
priv let rec core alias e = {
    let d x = core alias x;
    let cons_f = g_lambda ["<parse x>", "<parse xs>"] (g_bin :cons (g_name "<parse x>") (g_name "<parse xs>"));
    let spaces = [:span, " \t\r\n"];
    let lexeme p = [:skip, d p, spaces];
    let token t = [:skip, [:text, t], spaces];
    let between o c p = [:skip, [:then, o, d p], c];
    let sep_by1 sep p = [:map2, cons_f, d p, [:many, [:then, d sep, d p]]];
    let rec choice ps = match ps { [p] => d p, [p, ..rest] => [:or, d p, choice rest], [] => [:opaque, e] };
    let named = match e {
        [:field, [:name, q, _], m, _] if q == alias => m,
        [:name, m, _] if alias == "" => m,
        _ => (),
    };
    let called = match e {
        [:apply, [:field, [:name, q, _], m, _], args, _] if q == alias => [m, args],
        [:apply, [:name, m, _], args, _] if alias == "" => [m, args],
        _ => (),
    };
    match [named, called] {
        ["spaces", _] => spaces,
        [_, [m, args]] if arities.[m else ()] == list.length args =>
            match [m, args] {
                ["then", [q2, p]] => [:then, d p, d q2],
                ["skip", [check, p]] => [:skip, d p, d check],
                ["keep", [p, pf]] => [:keep, d pf, d p],
                ["map", [f, p]] => [:map, f, d p],
                ["map2", [f, a, b]] => [:map2, f, d a, d b],
                ["to", [v, p]] => [:to, v, d p],
                ["succeed", [v]] => [:succeed, v],
                ["or", [q2, p]] => [:or, d p, d q2],
                ["choice", [[:list, ps, _]]] => choice ps,
                ["optional", [p]] => [:or, d p, [:succeed, g_unit]],
                ["default", [v, p]] => [:or, d p, [:succeed, v]],
                ["many", [p]] => [:many, d p],
                ["many1", [p]] => [:map2, cons_f, d p, [:many, d p]],
                ["sep_by", [sep, p]] => [:or, sep_by1 sep p, [:succeed, [:list, [], g_span]]],
                ["sep_by1", [sep, p]] => sep_by1 sep p,
                ["between", [o, c, p]] => between (d o) (d c) p,
                ["parens", [p]] => between (token "(") (token ")") p,
                ["brackets", [p]] => between (token "[") (token "]") p,
                ["braces", [p]] => between (token "{") (token "}") p,
                ["lexeme", [p]] => lexeme p,
                ["symbol", [[:str, t, _]]] => token t,
                ["char", [[:char, c, _]]] if char.code c < 128 => [:char, c],
                ["text", [[:str, t, _]]] => [:text, t],
                ["span", [[:str, set, _]]] => [:span, set],
                ["switch", [name, [:lambda, [[b, _]], [:match, [:name, b2, _], arms, _], _]]] if b == b2 =>
                    [:switch, name, b, list.map (fn [pat, guard, body, sp] -> [pat, guard, match body { [:unit, _] => (), x => d x }]) arms],
                ["lazy", [[:lambda, [[(), _]], body, _]]] => d body,
                _ => [:opaque, e],
            },
        _ => [:opaque, e],
    }
};

// --- writing the parser ---------------------------------------------------
//
// `generate g c at carried k fk` is code that parses `c` from offset `at`.
// Where it succeeds it carries on as `k value next carried` says; where it
// fails, as `fk problem` does, `problem` being the step's own -- what was
// carried before it is the caller's to add. `carried` is the syntax of the
// problem carried so far, or `:none` when it is known while compiling to be
// none, which most of the time it is.
//
// Two continuations, so that what backtracks -- `or`, `many` -- goes straight
// on to the other side or out of the loop, with no reply made to say which.

/// Code for `body` of where a step that ended at `next` leaves the carried
/// problem, given a problem of the step's own (`:none` for none). The usual
/// case, nothing carried, is decided inline; the merge is a call only when
/// there is something to merge.
priv let carried_after : Gen -> :any -> :any -> :any -> (:any -> :any) -> :any;
priv let carried_after g carried step next body = match [carried, step] {
    [:none, :none] => body :none,
    [:none, st] => body st,
    [c, st] => {
        let n = fresh g "c";
        g_with n (g_if (g_bin :eq c g_unit) (unit_or st) (helper g "carry" [c, unit_or st, next])) (body (g_name n))
    },
};

/// How a rule, or a side of a choice, ends: a reply.
priv let reply_k : Gen -> :any -> :any -> :any -> :any;
priv let reply_k g v n cc = reply_ok g v n (unit_or cc);

/// The failure that ends a rule, with what was carried before it.
priv let failure : Gen -> :any -> :any -> :any;
priv let failure g carried problem = match carried {
    :none => g_call [:field, member g "Reply", "fail", g_span] [problem],
    c => helper g "failing" [c, problem],
};

/// How many nodes a piece of syntax has: what decides whether a continuation
/// is copied into each place it is needed or made a function they call.
priv let size : :any -> :integer;
priv let rec size t = if type_of t == :list { list.fold (fn n x -> n + size x) 1 t } else { 0 };

/// A continuation that is needed in several places, ready to be used there:
/// itself when it is small, else a local function `join` and calls of it.
/// Answers `[statements to put first, the continuation to use]`.
priv let shared : Gen -> (:any -> :any -> :any -> :any) -> [[:any], :any -> :any -> :any -> :any];
priv let shared g k = {
    let [v, n, cc] = [fresh g "v", fresh g "n", fresh g "cc"];
    let body = k (g_name v) (g_name n) (g_name cc);
    if size body < 160 { [[], k] }
    else {
        let join = fresh g "join";
        [[g_fun join [v, n, cc] body false], fn rv rn rc -> g_call (g_name join) [rv, rn, unit_or rc]]
    }
};

/// Code that parses core form `c` from `at`, continuing as `k` on success and
/// `fk` on failure: see "writing the parser" above.
priv let generate : Gen -> :any -> :any -> :any -> (:any -> :any -> :any -> :any) -> (:any -> :any) -> :any;
priv let rec generate g c at carried k fk = {
    let s = g_name (Gen.text g);
    let expected what = helper g "problem_at" [at, what];
    match c {
        [:char, ch] => {
            let n = fresh g "n";
            g_if (g_bin :eq (helper g "byte_at" [s, at]) (g_int (char.code ch)))
                 (g_with n (g_bin :add at (g_int 1))
                         (carried_after g carried :none (g_name n) (fn cc -> k [:char, ch, g_span] (g_name n) cc)))
                 (fk (expected (g_str (quote (str.of_chars [ch])))))
        },
        [:text, t] => {
            let n = fresh g "n";
            g_if (helper g "text_at" [s, at, g_str t])
                 (g_with n (g_bin :add at (g_int (len t)))
                         (carried_after g carried :none (g_name n) (fn cc -> k (g_str t) (g_name n) cc)))
                 (fk (expected (g_str (quote t))))
        },
        [:span, set] => {
            let n = fresh g "n";
            g_with n (helper g "span_end" [s, at, g_str set])
                   (carried_after g carried :none (g_name n)
                                  (fn cc -> k (helper g "text_between" [s, at, g_name n]) (g_name n) cc))
        },
        [:succeed, v] => k v at carried,
        [:map, f, p] => generate (deeper g "m") p at carried (fn v n cc -> k (g_call f [v]) n cc) fk,
        [:to, v, p] => generate (deeper g "t") p at carried (fn _ n cc -> k v n cc) fk,
        // A failure in the second half of a sequence carries what the first
        // half stepped around: the problem it adds is the carried one's.
        [:then, p, q] => generate (deeper g "a") p at carried
                                  (fn _ n cc -> generate (deeper g "b") q n cc k (fn pr -> fk (with_carried g cc pr))) fk,
        [:skip, p, q] => generate (deeper g "a") p at carried
                                  (fn v n cc -> generate (deeper g "b") q n cc (fn _ n2 cc2 -> k v n2 cc2)
                                                         (fn pr -> fk (with_carried g cc pr))) fk,
        [:keep, pf, p] => generate (deeper g "a") pf at carried
                                   (fn f n cc -> generate (deeper g "b") p n cc (fn v n2 cc2 -> k (g_call f [v]) n2 cc2)
                                                          (fn pr -> fk (with_carried g cc pr))) fk,
        [:map2, f, a, b] => generate (deeper g "a") a at carried
                                     (fn x n cc -> generate (deeper g "b") b n cc (fn y n2 cc2 -> k (g_call f [x, y]) n2 cc2)
                                                            (fn pr -> fk (with_carried g cc pr))) fk,
        [:opaque, e] => {
            let [v, n, pr] = [fresh g "v", fresh g "n", fresh g "p"];
            g_match (g_call e [s, at]) [
                g_arm (reply_ok_p g [g_bind v, g_bind n, g_bind pr])
                      (carried_after g carried (g_name pr) (g_name n) (fn cc -> k (g_name v) (g_name n) cc)),
                g_arm (reply_fail_p g [g_bind pr]) (fk (g_name pr)),
            ]
        },
        [:or, p, q] => {
            // Both sides from the same place with nothing carried, as `or`
            // tries them; the left side's failure is what the right side's
            // success or failure is merged with.
            let [first, k2] = shared g k;
            let p1 = fresh g "p1";
            let after pr n v = carried_after g carried pr n (fn c2 -> k2 v n c2);
            g_block (list.append first [
                generate (deeper g "l") p at :none
                         (fn v n cc -> after (unit_or cc) n v)
                         (fn left -> g_with p1 left
                             (generate (deeper g "r") q at :none
                                       (fn v n cc -> after (helper g "carry" [g_name p1, unit_or cc, n]) n v)
                                       (fn right -> fk (helper g "failing_problem" [g_name p1, right])))),
            ])
        },
        [:many, p] => {
            // `many_from`, written out: a local loop, which parses one more
            // element or stops where one fails or stands still, and answers
            // what it collected.
            let [loop, here, acc, pr, vs, n, pp] = list.map (fresh g) ["loop", "here", "acc", "pr", "vs", "n", "pp"];
            let done = fn last -> reply_ok g (helper g "reversed" [g_name acc]) (g_name here)
                                             (helper g "carry" [g_name pr, last, g_name here]);
            g_block [
                g_strict_fun loop here [acc, pr]
                    (generate (deeper g "e") p (g_name here) :none
                              (fn v nn cc -> g_if (g_bin :gt nn (g_name here))
                                                  (g_call (g_name loop) [nn, g_bin :cons v (g_name acc),
                                                                         helper g "merged" [g_name pr, unit_or cc]])
                                                  (done (unit_or cc)))
                              (fn failed -> done failed)),
                g_match (g_call (g_name loop) [at, [:list, [], g_span], g_unit]) [
                    g_arm (reply_ok_p g [g_bind vs, g_bind n, g_bind pp])
                          (carried_after g carried (g_name pp) (g_name n) (fn cc -> k (g_name vs) (g_name n) cc)),
                    g_arm g_wild (fk g_unit),
                ],
            ]
        },
        [:switch, name, b, arms] => {
            let [first, k2] = shared g k;
            let arm_code i [pat, guard, body] =
                g_guarded pat guard (match body {
                    () => fk (expected name),
                    parser => generate (deeper g ("s" + to_string i)) parser at carried k2 fk,
                });
            g_block (list.append first [
                g_with b (helper g "byte_at" [s, at])
                       (g_match (g_name b) (list.map (fn [i, a] -> arm_code i a) (list.enumerate arms))),
            ])
        },
        _ => [:unit, g_span],
    }
};

/// A step's problem with what was carried into it: a failure part way
/// through a sequence reports the furthest of the two.
priv let with_carried : Gen -> :any -> :any -> :any;
priv let with_carried g carried problem = match carried {
    :none => problem,
    c => helper g "failing_problem" [c, problem],
};

/// The parser `p` compiles to, or why it cannot be: a macro answers its
/// syntax as it is, and only a failure as a result.
priv let compile_grammar : :any -> :any;
priv let compile_grammar p = {
    let e = unpipe p;
    match alias_of e {
        () => Result.error "std.parse.compile: no std.parse combinator to compile here",
        alias => {
            let g = Gen.make alias "<parse text>" "r";
            let at = "<parse at>";
            let body = generate g (core alias e) (g_name at) :none (fn v n cc -> reply_k g v n cc) (fn pr -> failure g :none pr);
            g_call (member g "compiled") [g_lambda [Gen.text g, at] body]
        },
    }
};

when test {
    import std.test;

    let pair = succeed (fn a b -> [a, b]) |> keep integer |> skip (symbol ",") |> keep integer;
    let rec expr s at = operators (lexeme number |> or (parens (lazy (fn () -> expr))))
        [[:left, [["+", fn a b -> a + b], ["-", fn a b -> a - b]]],
         [:left, [["*", fn a b -> a * b], ["/", fn a b -> a / b]]],
         [:right, [["^", fn a b -> num.pow a b]]],
         [:prefix, [["-", fn a -> 0 - a]]]] s at;
    let calc t = run (then expr spaces) t;
    let message r = match r { Result.error(e) => Error.message e, _ => "" };
    let where r = match r { Result.error(e) => [Error.line e, Error.column e], _ => [] };

    // A JSON reader in a dozen lines: the test that the pieces compose.
    let rec json_value s at = lexeme (choice [
        map (fn _ -> ()) (keyword "null"), to true (keyword "true"), to false (keyword "false"),
        number, quoted,
        brackets (sep_by (symbol ",") (lazy (fn () -> json_value))),
        map map.from_pairs (braces (sep_by (symbol ",")
            (succeed (fn k v -> [k, v]) |> keep (lexeme quoted) |> skip (symbol ":") |> keep (lazy (fn () -> json_value))))),
    ]) s at;

    // A grammar written twice, as combinators and compiled: every answer,
    // error and all, must be the same. It covers every core form the
    // compiler writes out and an opaque parser in each position.
    let tg_item : Parser :any;
    let tg_item = spaces |> then (switch "an tg_item" (fn b -> match b {
        91 => tg_list_of,
        40 => to :unit (text "()"),
        34 => quoted,
        _ if b >= 48 && b <= 57 => number,
        _ => (),
    }));
    let tg_list_of : Parser [:any];
    let tg_list_of = char '[' |> then (sep_by (spaces |> then (char ',')) tg_item) |> skip spaces |> skip (char ']');
    let tg_pair : Parser [:any];
    let tg_pair = succeed (fn k v -> [k, v]) |> keep (lexeme identifier) |> skip (symbol "=") |> keep tg_item;
    let tg_words : Parser [:any];
    let tg_words = many1 (lexeme identifier) |> or (to [] (text "-"));
    let tg_maybe : Parser :any;
    let tg_maybe = optional (char '!') |> then (default :none (to :some (text "x")));

    let tg_item_c : Parser :any;
    let tg_item_c = expand compile (spaces |> then (switch "an tg_item" (fn b -> match b {
        91 => tg_list_of_c,
        40 => to :unit (text "()"),
        34 => quoted,
        _ if b >= 48 && b <= 57 => number,
        _ => (),
    })));
    let tg_list_of_c : Parser [:any];
    let tg_list_of_c = expand compile (char '[' |> then (sep_by (spaces |> then (char ',')) tg_item_c) |> skip spaces |> skip (char ']'));
    let tg_pair_c : Parser [:any];
    let tg_pair_c = expand compile (succeed (fn k v -> [k, v]) |> keep (lexeme identifier) |> skip (symbol "=") |> keep tg_item_c);
    let tg_words_c : Parser [:any];
    let tg_words_c = expand compile (many1 (lexeme identifier) |> or (to [] (text "-")));
    let tg_maybe_c : Parser :any;
    let tg_maybe_c = expand compile (optional (char '!') |> then (default :none (to :some (text "x"))));

    let agree p c inputs = list.filter (fn t -> run_text p t != run_text c t) inputs;
    let tests = [
        test.case "a compiled grammar answers as its combinators do, errors included"
            $( test.eq! [[], [], [], []]
                        [agree tg_item tg_item_c ["1", "[1, 2]", "[[1],[2, \"x\"]]", " ()", "[1,]", "[1", "[", "x", "", "[1 2]",
                                             "\"\\ud83d\\ude00\"", "[(), (]", "012", "[ 3 , [ ] ]"],
                         agree tg_pair tg_pair_c ["a = 1", "a=[2]", "a 1", "= 1", "a =", "a = x"],
                         agree tg_words tg_words_c ["a b c", "-", "", "a -", "  a"],
                         agree tg_maybe tg_maybe_c ["", "!", "x", "!x", "!!", "y"]] ),
        test.case "a surrogate pair is one character, and a lone half is U+FFFD"
            $( test.eq! [Result.ok "\u{1f600}", Result.ok "\u{fffd}A", Result.ok "\u{fffd}A", Result.ok "\u{fffd}"]
                        (list.map (fn t -> run_text quoted t)
                                  ["\"\\ud83d\\ude00\"", "\"\\ud83dA\"", "\"\\ud83d\\u0041\"", "\"\\ude00\""]) ),
        test.case "a number does not begin with 0 unless it is 0"
            $( test.eq! [Result.ok 0, Result.ok 0.5, false] [run_text number "0", run_text number "0.5", matches number "012"] ),
        test.case "switch takes the parser its byte chooses, and names what it wanted"
            $( {
                   let pick b = match b { 40 => to :paren (text "("), 91 => to :bracket (text "["), _ => () };
                   test.eq! [Result.ok :paren, Result.ok :bracket, "expected an opener, found \"x\""]
                            [run_text (switch "an opener" pick) "(", run_text (switch "an opener" pick) "[",
                             match run (switch "an opener" pick) "x" { Result.error(e) => Error.message e, _ => "" }]
               } ),
        test.case "a pipeline"                $( test.eq! (Result.ok [3, 4]) (run pair "3, 4") ),
        test.case "a pipeline's error"        $( test.eq! "expected digit or \",\", found \";\"" (message (run pair "3; 4")) ),
        test.case "precedence"                $( test.eq! (Result.ok 7) (calc "1 + 2 * 3") ),
        test.case "left associativity"        $( test.eq! (Result.ok 4) (calc "10 - 3 - 3") ),
        test.case "right associativity"       $( test.eq! (Result.ok 512) (calc "2 ^ 3 ^ 2") ),
        test.case "prefix and parentheses"    $( test.eq! (Result.ok (0 - 9)) (calc "-(1 + 2) * 3") ),
        test.case "where an error is"         $( test.eq! [1, 11] (where (calc "(1 + 2 * 3x")) ),
        test.case "what was expected there"   $( test.eq! "expected digit, \"^\", \"*\", \"/\", \"+\", \"-\" or \")\", found \"x\""
                                                   (message (calc "(1 + 2 * 3x")) ),
        test.case "the end is required"       $( test.eq! "expected digit, \"^\", \"*\", \"/\", \"+\", \"-\" or the end of the text, found \")\""
                                                   (message (calc "1 + 2)")) ),
        test.case "explain draws a caret"     $( test.eq! "line 2, column 3: expected white space or a number, found \"x\"\n  2 | 4 x\n    |   ^"
                                                   (match run (sep_by1 spaces1 natural) "1\n4 x" { Result.error(e) => explain e "1\n4 x", _ => "" }) ),
        test.case "JSON"                      $( test.eq! (Result.ok %{ "a" => [1, 2.5, true, ()], "b" => "x\ny" })
                                                   (run (then json_value spaces) "{\"a\": [1, 2.5, true, null], \"b\": \"x\\ny\"}") ),
        test.case "unicode is read as characters" $( test.eq! (Result.ok "héllo") (run (take_while1 "letter" is_letter) "héllo") ),
        test.case "columns count characters"  $( test.eq! [1, 3] (where (run (text "é" |> then (text "a") |> then (text "b")) "éaX")) ),
        test.case "keywords are whole words"  $( test.eq! [true, false] [matches (keyword "if") "if", matches (keyword "if") "iffy"] ),
        test.case "many cannot loop"          $( test.eq! (Result.ok []) (run (many (span "x")) "") ),
        test.case "label names what failed"   $( test.eq! "expected a port, found \"x\"" (message (run (label "a port" natural) "x")) ),
        test.case "where_ok checks a value"   $( test.eq! "expected a byte, found \"3\"" (message (run (where_ok (fn n -> n <= 255) "a byte" natural) "300")) ),
        test.case "try_map reports a message" $( test.eq! "too big" (message (run (try_map (fn n -> if n > 9 { err "too big" } else { Result.ok n }) natural) "10")) ),
        test.case "until and capture"         $( test.eq! (Result.ok ["key", "a = b"])
                                                   (run (seq [until " =", capture (seq [text " =", rest])] |> map (fn [k, r] -> [k, "a" + r])) "key = b") ),
        test.case "many_till"                 $( test.eq! (Result.ok ['a', 'b']) (run (many_till (text "-->") any_char) "ab-->") ),
        test.case "numbers"                   $( test.eq! (Result.ok [1, 0 - 2, 2.5, 100.0, 0.5])
                                                   (run (sep_by (symbol ",") number) "1, -2, 2.5, 1e2, 5E-1") ),
        test.case "a quoted string's escapes" $( test.eq! (Result.ok "a\"b\u{e9}") (run quoted "\"a\\\"b\\u00e9\"") ),
        test.case "an unclosed string"        $( test.eq! "expected a closing quote, found the end of the text" (message (run quoted "\"abc")) ),
        test.case "lines and columns"         $( test.eq! [[1, 1], [2, 1], [2, 4]] [line_col "ab\ncd" 0, line_col "ab\ncd" 3, line_col "ab\ncde" 6] ),
        test.case "spanned"                   $( test.eq! (Result.ok ["ab", 1, 3]) (run (then (spanned (text "ab")) (text " ")) " ab") ),
        test.case "postfix"                   $( test.eq! (Result.ok 6) (run (operators natural [[:postfix, [["!", fn n -> n * 3]]]]) "2!") ),
    ];
}
